---
// Nedladdningsrutan på metodsidan. Orden ska stämma med innehållet: "Allt om metoden" är
// beskrivningen, planeringsmallarna och lathunden i en Word-fil; de andra två filerna är delar av den.
// Filerna byggs vid bygget av src/pages/stodundervisning/[id].docx.ts, [id]-mallar.docx.ts och [id]-lathund.docx.ts.
interface Props { id: string; harMallar: boolean; harLathund: boolean }
const { id, harMallar, harLathund } = Astro.props;
const delar = ['metodbeskrivningen', harMallar && 'planeringsmallarna', harLathund && 'lathunden'].filter(Boolean) as string[];
const delarText = delar.length > 1 ? `${delar.slice(0, -1).join(', ')} och ${delar[delar.length - 1]}` : delar[0];
---
<aside class="nedladdning" aria-labelledby={`nedladdning-${id}`}>
  <h2 id={`nedladdning-${id}`}>Ladda ner och skriv ut</h2>
  {harLathund && <p>Lathunden är fyra sidor att ha bredvid sig under passet, med egen utskrift i liggande A4.</p>}
  <ul class="nedladdning-lista">
    {harLathund && <li><a class="knapp" href={`/stodundervisning/${id}/lathund`}>Öppna lathunden</a></li>}
    <li><a class={harLathund ? 'knapp sekundar' : 'knapp'} href={`/stodundervisning/${id}.docx`} download={`${id}.docx`}>Allt om metoden (docx)</a></li>
  </ul>
  <ul class="lankrad-lista nedladdning-rad">
    {harLathund && <li><a href={`/stodundervisning/${id}-lathund.docx`} download={`${id}-lathund.docx`}>Bara lathunden (docx)</a></li>}
    {harMallar && <li><a href={`/stodundervisning/${id}-mallar.docx`} download={`${id}-mallar.docx`}>Bara planeringsmallarna (docx)</a></li>}
    <li class="bara-js"><button type="button" class="lank" data-skriv-ut>Skriv ut hela beskrivningen</button></li>
  </ul>
  <p class="meta">Allt om metoden: {delarText}. Alla filer bär © Niclas Fohlin.</p>
</aside>

<script>
  // Utskriftsknappen visas bara när html har klassen js; utan JavaScript skriver läsaren ut som vanligt.
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-skriv-ut]')) {
    knapp.addEventListener('click', () => window.print());
  }
</script>
