---
// Nedladdningsrutan på metodsidan. Orden ska stämma med innehållet: "Allt om metoden" är
// beskrivningen, planeringsmallarna och lathunden i en Word-fil; de andra två filerna är delar av den.
// Filerna byggs vid bygget av src/pages/stodundervisning/[id].docx.ts, [id]-mallar.docx.ts och
// [id]-lathund.docx.ts; lathundens pdf ligger i public/stodundervisning/ (scripts/lathund-pdf.mjs).
// Varje fil erbjuds med samma val (Word, Drive, pdf) genom Filval.astro.
import Filval from './Filval.astro';
import { site } from '../data/site';
interface Props { id: string; harMallar: boolean; harLathund: boolean }
const { id, harMallar, harLathund } = Astro.props;
const drive = Boolean(site.driveKlientId);
const delar = ['metodbeskrivningen', harMallar && 'planeringsmallarna', harLathund && 'lathunden'].filter(Boolean) as string[];
const delarText = delar.length > 1 ? `${delar.slice(0, -1).join(', ')} och ${delar[delar.length - 1]}` : delar[0];
const bas = `/stodundervisning/${id}`;
---
<aside class="nedladdning" aria-labelledby={`nedladdning-${id}`}>
  <h2 id={`nedladdning-${id}`}>Ladda ner och skriv ut</h2>
  {harLathund && <p>Lathunden är fyra sidor att ha bredvid sig under passet, med egen utskrift i liggande A4.</p>}
  <ul class="nedladdning-lista">
    {harLathund && <li><a class="knapp" href={`${bas}/lathund`}>Öppna lathunden</a></li>}
    <li class="bara-js"><button type="button" class={harLathund ? 'knapp sekundar' : 'knapp'} data-skriv-ut>Skriv ut hela beskrivningen</button></li>
  </ul>
  <ul class="filrader">
    <li><span class="filrubrik">Allt om metoden</span> <Filval fil={bas} namn={id} rubrik="Allt om metoden" /></li>
    {harLathund && <li><span class="filrubrik">Bara lathunden</span> <Filval fil={`${bas}-lathund`} namn={`${id}-lathund`} rubrik="Lathunden" pdf /></li>}
    {harMallar && <li><span class="filrubrik">Bara planeringsmallarna</span> <Filval fil={`${bas}-mallar`} namn={`${id}-mallar`} rubrik="Planeringsmallarna" /></li>}
  </ul>
  <p class="meta">Allt om metoden: {delarText}. Alla filer bär © Niclas Fohlin.{drive && ' Drive sparar en Word-kopia i din egen Google Drive.'}</p>
</aside>

<script>
  // Utskriftsknappen visas bara när html har klassen js; utan JavaScript skriver läsaren ut som vanligt.
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-skriv-ut]')) {
    knapp.addEventListener('click', () => window.print());
  }
</script>
