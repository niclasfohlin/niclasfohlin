---
// Nedladdningsrutan på metodsidan. Orden ska stämma med innehållet: "Allt om metoden" är
// beskrivningen, planeringsmallarna och lathunden i en Word-fil; de andra två filerna är delar av den.
// Filerna byggs vid bygget av src/pages/stodundervisning/[id].docx.ts, [id]-mallar.docx.ts,
// [id]-lathund.docx.ts och [id]-lathund.pptx.ts; lathundens pdf ligger i public/stodundervisning/ och görs om
// automatiskt ur lathundens PowerPoint-kod i A4 liggande av npm run validera (scripts/lathund-pdf.mjs --vid-behov). Varje fil erbjuds med samma val (Word, PowerPoint, Drive, pdf) genom Filval.astro.
// Metodens filmer är en egen rad, Filmerna (Niclas 2026-10-07): en zip-fil med filmerna som mp4, byggd av
// src/pages/stodundervisning/[id]-filmer.zip.ts ur mp4-filerna som scripts/filmmp4.mjs gör ur svg-filmerna. Raden heter
// inte Bara filmerna: de andra raderna med Bara är delar av Allt om metoden, och filmerna ligger inte i den filen.
import Filval from './Filval.astro';
import Bankfiler from './Bankfiler.astro';
import Nivafiler from './Nivafiler.astro';
import Bladfiler from './Bladfiler.astro';
import type { Bladmaterial } from '../lib/bladmaterial';
import type { Ovrigtfil } from '../lib/ovrigt';
import type { Nivamaterial } from '../lib/nivamaterial';
import type { Bank } from '../lib/bank';
import SkrivUtPdf from './SkrivUtPdf.astro';
import Lektionskortknapp from './Lektionskortknapp.astro';
import type { Lektionskort } from '../lib/lektionskort';
// ramar: namnet på metodens ramar (läslistorna, berättelseramarna) när de ligger i planeringsmallarna, så att knappen säger det.
// Har namnet ett och i sig (böckerna och materialet) står det efter ett komma, så att raden inte får två och.
// titel: metodens titel, för besöksstatistiken ("Upprepad läsning: lathunden som pdf").
// filmer: hur många filmer metoden har; noll ger ingen rad.
// bank: metodens bank (src/lib/bank.ts): problemen eller texterna finns också i egna filer, i en tabell sist i rutan
// (Bankfiler.astro; Niclas 2026-10-10: "tidigt i metoden en extra nedladdningsruta i någon form av enkel tabell"). Allt om
// metoden och planeringsmallarna har dem som i andra metoder: banken lägger till filer och tar inget bort.
// nivamaterial: metodens material i nivåer (src/lib/nivamaterial.ts): nivåernas filer i en tabell sist i rutan, som bankens.
// bladmaterial: metodens ramar med blad, som modellerna (src/lib/bladmaterial.ts): bladen och sidorna i en tabell efter
// bankens (Bladfiler.astro).
// ovrigt: filen med det material som inte står på något av de ställena (src/lib/ovrigt.ts, fältet ramar.ovrigt), under
// metodens eget namn för det, som Bladen och korten. Rutans tabeller följer då de delar metoden säger att materialet har.
// harMaterial: metoden har material (src/lib/material.ts), och då finns knappen Metoden och filen med bara metoden.
// lektionskort: metodens lektionskort (src/lib/lektionskort.ts), blå knappar bredvid Öppna lathunden (Niclas 2026-10-17:
// "Blå knappar bredvid lathunden"), och först i rutan i en lektion utan lathund.
interface Props { id: string; titel: string; harMallar: boolean; harLathund: boolean; harMaterial: boolean; ramar?: string; filmer?: number; bank?: Bank; farger?: Record<string, string>; nivamaterial?: Nivamaterial; bladmaterial?: Bladmaterial; ovrigt?: Ovrigtfil; lektionskort?: Lektionskort[] }
const { id, titel, harMallar, harLathund, harMaterial, ramar, filmer = 0, bank, farger = {}, nivamaterial, bladmaterial, ovrigt, lektionskort = [] } = Astro.props;
const filmord = filmer === 1 ? 'filmen' : 'filmerna';
// Rutan har bara rubriker och knappar (Niclas 2026-10-10: "rensa text som inte behövs eller förklarar sig själv med bara
// knapparna och rubriker"): ingen mening om lathunden och inget stycke under knapparna. Det knapparna gör står i deras
// titel (Filval.astro).
const bas = `/stodundervisning/${id}`;
const skrivareSvg = '<svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M5.5 7.5v-4h9v4M5.5 14.5h-2v-7h13v7h-2M5.5 11.5h9v5h-9z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>';
---
<aside class="nedladdning" aria-labelledby={`nedladdning-${id}`}>
  <h2 id={`nedladdning-${id}`}>Ladda ner och skriv ut</h2>
  {(harLathund || lektionskort.length > 0) && (
    <ul class="nedladdning-lista">
      {harLathund && <li><a class="knapp" href={`${bas}/lathund`}>Öppna lathunden</a></li>}
      {lektionskort.map((k) => <li><Lektionskortknapp k={k} titel={titel} /></li>)}
    </ul>
  )}
  <ul class="filrader">
    {/* Skriv ut: Allt är Word-filen med allt som pdf, och Metoden Word-filen med bara metoden, utan metodens material
        (src/lib/material.ts; Niclas 2026-10-10: "Skriv ut: Hela metoden (allt), Bara metodbeskrivningen", och 2026-10-12
        om knappens namn: "Så det blir Allt och Metoden?"). Knapparna är länkar till pdf:erna (SkrivUtPdf.astro; Niclas
        2026-10-13: ett system för utskriftsknapparna, som alltid blir 1:1 med Word-filen). Metoden finns bara när
        metoden har material att lämna utanför. Raden visas bara där knappen ger utskriftsrutan (SkrivUtPdf.astro): annars
        gjorde den samma sak som Pdf på raden under. */}
    <li data-bara-direkt hidden>
      <span class="filrubrik" id={`skriv-ut-${id}`}>Skriv ut</span>{' '}
      <span class="filval" role="group" aria-labelledby={`skriv-ut-${id}`}>
        <a href={`${bas}.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf="allt" title="Word-filen med allt som pdf" data-goatcounter-click={`utskrift:${id}`} data-goatcounter-title={`${titel}: utskrift av allt`}><Fragment set:html={skrivareSvg} /><span class="skriv-ut-namn">Allt</span></a>
        {harMaterial && <a href={`${bas}-metoden.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf="metoden" title="Word-filen med bara metoden som pdf" data-goatcounter-click={`utskrift:${id}:beskrivning`} data-goatcounter-title={`${titel}: utskrift av beskrivningen`}><Fragment set:html={skrivareSvg} /><span class="skriv-ut-namn">Metoden</span></a>}
      </span>
    </li>
    <li><span class="filrubrik">Allt om metoden</span> <Filval fil={bas} namn={id} rubrik="Allt om metoden" statistik={`${titel}: allt om metoden`} pdf pdfTitel="Ladda ner som pdf" /></li>
    {/* Bara metoden: Word-filen utan metodens material, samma fil som knappen Metoden skriver ut (METODER.md under Utskriften). */}
    {harMaterial && <li><span class="filrubrik">Bara metoden</span> <Filval fil={`${bas}-metoden`} namn={`${id}-metoden`} rubrik="Bara metoden" statistik={`${titel}: bara metoden`} pdf pdfTitel="Ladda ner som pdf" /></li>}
    {harLathund && <li><span class="filrubrik">Bara lathunden</span> <Filval fil={`${bas}-lathund`} namn={`${id}-lathund`} rubrik="Lathunden" statistik={`${titel}: lathunden`} pdf pptx /></li>}
    {harMallar && <li><span class="filrubrik">Bara planeringsmallarna{ramar && (ramar.includes(' och ') ? `, ${ramar}` : ` och ${ramar}`)}</span> <Filval fil={`${bas}-mallar`} namn={`${id}-mallar`} rubrik="Planeringsmallarna" statistik={`${titel}: planeringsmallarna`} /></li>}
    {filmer > 0 && (
      <li>
        <span class="filrubrik">{filmer === 1 ? 'Filmen' : 'Filmerna'}</span>{' '}
        <span class="filval" role="group" aria-label={`${filmer === 1 ? 'Filmen' : 'Filmerna'}: ladda ner`}>
          <a href={`${bas}-filmer.zip`} download={`${id}-filmer.zip`} title={filmer === 1 ? 'Ladda ner filmen som mp4 i en zip-fil' : `Ladda ner metodens ${filmer} filmer som mp4 i en zip-fil`} data-goatcounter-click={`fil:${id}-filmer.zip`} data-goatcounter-title={`${titel}: ${filmord} som zip`}>
            <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><rect x="3" y="3.5" width="14" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4.5 7.5v9h11v-9M8 11h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Zip<span class="visually-hidden">: {filmord} som mp4</span>
          </a>
        </span>
      </li>
    )}
  </ul>
  {bank && <Bankfiler id={id} titel={titel} bank={bank} farger={farger} />}
  {nivamaterial && <Nivafiler id={id} titel={titel} nm={nivamaterial} />}
  {bladmaterial && <Bladfiler id={id} titel={titel} bm={bladmaterial} />}
  {ovrigt && (
    <table class="bankfiler nivafiler ovrigtfil">
      <caption>{ovrigt.rubrik} att skriva ut</caption>
      <tbody><tr><td><Filval fil={`/stodundervisning/${ovrigt.namn}`} namn={ovrigt.namn} rubrik={ovrigt.rubrik} statistik={`${titel}: ${ovrigt.rubrik.toLowerCase()}`} pdf pdfTitel="Ladda ner som pdf" utanDrive liten /></td></tr></tbody>
    </table>
  )}
</aside>

<SkrivUtPdf />

<script>
  // Den som skriver ut sidan med webbläsarens egen meny får bilderna som bara står i utskriften hämtade när utskriften
  // börjar (filmens stillbilder, Filmbilder.astro, bankens blad, Bank.astro). Knapparna i rutan skriver inte ut sidan:
  // de öppnar Word-filens pdf (SkrivUtPdf.astro).
  window.addEventListener('beforeprint', () => {
    for (const b of document.querySelectorAll<HTMLImageElement>('img[data-utskriftsbild]')) b.loading = 'eager';
  });
</script>
