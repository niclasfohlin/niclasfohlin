---
// Nedladdningsrutan på metodsidan. Orden ska stämma med innehållet: "Allt om metoden" är
// beskrivningen, planeringsmallarna och lathunden i en Word-fil; de andra två filerna är delar av den.
// Filerna byggs vid bygget av src/pages/stodundervisning/[id].docx.ts, [id]-mallar.docx.ts,
// [id]-lathund.docx.ts och [id]-lathund.pptx.ts; lathundens pdf ligger i public/stodundervisning/ och görs om
// automatiskt ur lathundens PowerPoint-kod i A4 liggande av npm run validera (scripts/lathund-pdf.mjs --vid-behov). Varje fil erbjuds med samma val (Word, PowerPoint, Drive, pdf) genom Filval.astro.
// Metodens filmer är en egen rad, Filmerna (Niclas 2026-10-07): en zip-fil med filmerna som mp4, byggd av
// src/pages/stodundervisning/[id]-filmer.zip.ts ur mp4-filerna som scripts/filmmp4.mjs gör ur svg-filmerna. Raden heter
// inte Bara filmerna: de andra raderna med Bara är delar av Allt om metoden, och filmerna ligger inte i den filen.
import Filval from './Filval.astro';
import Bankfiler from './Bankfiler.astro';
import type { Bank } from '../lib/bank';
// ramar: namnet på metodens ramar (läslistorna, berättelseramarna) när de ligger i planeringsmallarna, så att knappen säger det.
// titel: metodens titel, för besöksstatistiken ("Upprepad läsning: lathunden som pdf").
// filmer: hur många filmer metoden har; noll ger ingen rad.
// bank: metodens bank (src/lib/bank.ts): problemen eller texterna finns också i egna filer, i en tabell sist i rutan
// (Bankfiler.astro; Niclas 2026-10-10: "tidigt i metoden en extra nedladdningsruta i någon form av enkel tabell"). Allt om
// metoden och planeringsmallarna har dem som i andra metoder: banken lägger till filer och tar inget bort.
interface Props { id: string; titel: string; harMallar: boolean; harLathund: boolean; ramar?: string; filmer?: number; bank?: Bank; farger?: Record<string, string> }
const { id, titel, harMallar, harLathund, ramar, filmer = 0, bank, farger = {} } = Astro.props;
const filmord = filmer === 1 ? 'filmen' : 'filmerna';
// Rutan har bara rubriker och knappar (Niclas 2026-10-10: "rensa text som inte behövs eller förklarar sig själv med bara
// knapparna och rubriker"): ingen mening om lathunden och inget stycke under knapparna. Det knapparna gör står i deras
// titel (Filval.astro).
const bas = `/stodundervisning/${id}`;
const skrivareSvg = '<svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M5.5 7.5v-4h9v4M5.5 14.5h-2v-7h13v7h-2M5.5 11.5h9v5h-9z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>';
---
<aside class="nedladdning" aria-labelledby={`nedladdning-${id}`}>
  <h2 id={`nedladdning-${id}`}>Ladda ner och skriv ut</h2>
  {harLathund && (
    <ul class="nedladdning-lista">
      <li><a class="knapp" href={`${bas}/lathund`}>Öppna lathunden</a></li>
    </ul>
  )}
  <ul class="filrader">
    {/* Skriv ut: Allt är hela sidan, och Bara beskrivningen sidan utan metodens material (data-material i Metod.astro; Niclas
        2026-10-10: "Skriv ut: Hela metoden (allt), Bara metodbeskrivningen"). Stilmallen visar knappen Bara beskrivningen
        bara när sidan har material, så att gränsen står på ett ställe och en ny metod får knapparna utan eget arbete. */}
    <li class="bara-js">
      <span class="filrubrik" id={`skriv-ut-${id}`}>Skriv ut</span>{' '}
      <span class="filval" role="group" aria-labelledby={`skriv-ut-${id}`}>
        <button type="button" data-skriv-ut="allt" data-goatcounter-click={`utskrift:${id}`} data-goatcounter-title={`${titel}: utskrift av allt`}><Fragment set:html={skrivareSvg} /><span class="visually-hidden">Skriv ut </span><span class="skriv-ut-namn">Allt</span></button>
        <button type="button" data-skriv-ut="beskrivning" data-goatcounter-click={`utskrift:${id}:beskrivning`} data-goatcounter-title={`${titel}: utskrift av beskrivningen`}><Fragment set:html={skrivareSvg} /><span class="visually-hidden">Skriv ut </span><span class="skriv-ut-namn">Bara beskrivningen</span></button>
      </span>
    </li>
    <li><span class="filrubrik">Allt om metoden</span> <Filval fil={bas} namn={id} rubrik="Allt om metoden" statistik={`${titel}: allt om metoden`} /></li>
    {harLathund && <li><span class="filrubrik">Bara lathunden</span> <Filval fil={`${bas}-lathund`} namn={`${id}-lathund`} rubrik="Lathunden" statistik={`${titel}: lathunden`} pdf pptx /></li>}
    {harMallar && <li><span class="filrubrik">Bara planeringsmallarna{ramar && ` och ${ramar}`}</span> <Filval fil={`${bas}-mallar`} namn={`${id}-mallar`} rubrik="Planeringsmallarna" statistik={`${titel}: planeringsmallarna`} /></li>}
    {filmer > 0 && (
      <li>
        <span class="filrubrik">{filmer === 1 ? 'Filmen' : 'Filmerna'}</span>{' '}
        <span class="filval" role="group" aria-label={`${filmer === 1 ? 'Filmen' : 'Filmerna'}: ladda ner`}>
          <a href={`${bas}-filmer.zip`} download={`${id}-filmer.zip`} title={filmer === 1 ? 'Ladda ner filmen som mp4 i en zip-fil' : `Ladda ner metodens ${filmer} filmer som mp4 i en zip-fil`} data-goatcounter-click={`fil:${id}-filmer.zip`} data-goatcounter-title={`${titel}: ${filmord} som zip`}>
            <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><rect x="3" y="3.5" width="14" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4.5 7.5v9h11v-9M8 11h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Zip<span class="visually-hidden">: {filmord} som mp4</span>
          </a>
        </span>
      </li>
    )}
  </ul>
  {bank && <Bankfiler id={id} titel={titel} bank={bank} farger={farger} />}
</aside>

<script>
  // Utskriftsknapparna visas bara när html har klassen js; utan JavaScript skriver läsaren ut som vanligt.
  // Bilder som bara står i utskriften (filmens stillbilder, Filmbilder.astro, bankens blad, Bank.astro) hämtas först nu:
  // knappen väntar in dem, högst tjugo sekunder, och säger under tiden hur många som är kvar (granskningen 2026-10-10: en
  // bank har ett hundratal bilder). Den som skriver ut med webbläsarens meny får dem hämtade när utskriften börjar.
  const utskriftsbilder = () => [...document.querySelectorAll<HTMLImageElement>('img[data-utskriftsbild]')];
  // Bara beskrivningen: sidan utan metodens material (data-material i Metod.astro, global.css), och bilderna där hämtas inte.
  const DOLT = '[data-material]';
  const hamta = () => Promise.all(utskriftsbilder().filter((b) => document.documentElement.dataset.utskrift !== 'beskrivning' || !b.closest(DOLT)).map((b) => {
    b.loading = 'eager';
    return b.naturalWidth > 0 ? undefined : new Promise((klar) => { b.addEventListener('load', klar, { once: true }); b.addEventListener('error', klar, { once: true }); });
  }));
  window.addEventListener('beforeprint', () => { hamta(); });
  window.addEventListener('afterprint', () => { delete document.documentElement.dataset.utskrift; });
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-skriv-ut]')) {
    knapp.addEventListener('click', async () => {
      if (knapp.dataset.skrivUt === 'beskrivning') document.documentElement.dataset.utskrift = 'beskrivning';
      else delete document.documentElement.dataset.utskrift;
      const namn = knapp.querySelector<HTMLElement>('.skriv-ut-namn');
      const forut = namn?.textContent ?? '';
      const kvar = () => utskriftsbilder().filter((b) => b.naturalWidth === 0 && (document.documentElement.dataset.utskrift !== 'beskrivning' || !b.closest(DOLT))).length;
      knapp.setAttribute('aria-busy', 'true');
      const visa = window.setInterval(() => { const n = kvar(); if (namn && n) namn.textContent = `Hämtar bilder, ${n} kvar`; }, 250);
      await Promise.race([hamta(), new Promise((klar) => setTimeout(klar, 20000))]);
      window.clearInterval(visa);
      if (namn) namn.textContent = forut;
      knapp.removeAttribute('aria-busy');
      window.print();
    });
  }
</script>
