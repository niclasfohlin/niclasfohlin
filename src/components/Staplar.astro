---
// Fem staplar för en nivå 0 till 5 på metodkortet (K-623, K-641), en rot för alla staplar på sidan och i banken. Gröna för
// evidensen, där mer är bättre. Neutrala för Svårighet och Kostnad, där mer betyder mer arbete, så att fem där inte läses
// som bra (Niclas 2026-10-29: "Svårighet och kostnad kan väl också vara staplar, eller staplar och ett ord? 1-5").
// Staplarna är dolda för skärmläsare; ordet och talet bredvid läses upp.
interface Props { niva: number; neutral?: boolean }
const { niva, neutral = false } = Astro.props;
---
<span class={`mp-staplar${neutral ? ' mp-neutral' : ''}`} aria-hidden="true">{[1, 2, 3, 4, 5].map((i) => <i class={i <= niva ? 'pa' : undefined}></i>)}</span>
