---
// En films fyra stillbilder i sidans utskrift (src/lib/film.ts), alltid genom Filmruta.astro, på samma plats som filmen
// på skärmen och stillbilderna i Word-filen (filmBarn i metoddocx.ts): rubriken, ingressen och en text under varje bild.
// På skärmen står filmen, och rutan syns inte; bilderna hämtas först när sidan skrivs ut (Nedladdning.astro), så att den
// som bara öppnar sidan inte laddar dem (Niclas 2026-09-30: rutan kom inte med i Skriv ut hela beskrivningen).
import { STILLBILD_MATT, stillbilder, type MetodFilm } from '../lib/film';
interface Props { f: MetodFilm }
const { f } = Astro.props;
const bilder = stillbilder(f);
---
<section class:list={['film-bilder', { extra: !f.huvud }]} aria-hidden="true">
  <h2>{f.film.rubrik}</h2>
  <p class="film-bilder-ingress">{f.film.ingress}</p>
  <ol>
    {f.film.stillbilder.map((b, i) => (
      <li>
        <img data-utskriftsbild src={bilder[i]} alt="" width={STILLBILD_MATT.bredd} height={STILLBILD_MATT.hojd} loading="lazy" decoding="async" />
        <p><b>{i + 1} · </b>{b.text}</p>
      </li>
    ))}
  </ol>
</section>
