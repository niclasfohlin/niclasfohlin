---
// Hela metoden i modellens ordning, med kompendiets designelement: rutor, tabeller med rubrikrad,
// band, gör/undvik och bockar. Samma element och ordning som i docx-filen (src/lib/metoddocx.ts).
import MetodTabell from './MetodTabell.astro';
import Tavla from './Tavla.astro';
import Elevlista from './Elevlista.astro';
import Kortlista from './Kortlista.astro';
import Laskort from './Laskort.astro';
import MallBild from './MallBild.astro';
import Lektionsbank from './Lektionsbank.astro';
import Vikkort from './Vikkort.astro';
import Bokstavskort from './Bokstavskort.astro';
import Bokstavskarta from './Bokstavskarta.astro';
import Bildlista from './Bildlista.astro';
import Golvbokstaver from './Golvbokstaver.astro';
import Serierutor from './Serierutor.astro';
import { ANDIKA_ADRESS, arBildlista, harElevtypsnitt, ljudform, upphovBilder } from '../lib/ljudkort';
import { arElevensBlad, lastexter, protokollDelas, strukturAv, textparAv, textparLarare, type Struktur as StrukturForm, type Textpar as TextparForm } from '../lib/ramform';
import Filmruta from './Filmruta.astro';
import Boksida from './Boksida.astro';
import Struktur from './Struktur.astro';
import Textpar from './Textpar.astro';
import Ramindex from './Ramindex.astro';
import { filmerVid, grundUpphov, metodensFilmer, stegDelar, type FilmPlats } from '../lib/film';
import type { SerieKoppling } from '../lib/serie';
import type { MetodData } from '../lib/metod';
import { ejBryt, ramArTom, passGrupper, passOrd, passOversikt, stegTexter, laskortKolumn, arEttKort } from '../lib/metod';
import { kortInfo } from '../lib/brak';
import { arTarning, sagoUpphov } from '../lib/sagoblad';
import { arkAdress, arSerieMall, mallEtiketter, mallRutor as mallRutorAdresser, rutansText, serieRutor as serieRutorAdresser, svgMatt } from '../lib/bildserier';
import { serieantal, serieFiler } from '../lib/bildserier-bygge';
import { metodensPaBordet, paBordetVid } from '../lib/pabordet';
import { listansNiva } from '../lib/nivaer';
import { bladNamn, delensRad, kartan, metodensBlad, radensDel } from '../lib/karta';
import { veckanRyms } from '../lib/veckosida';
import { veckansLista, veckomaterial } from '../lib/veckomaterial';
// "Åk 4–5" hålls ihop i ramarnas rubriker och länkar: hårt mellanslag efter Åk, ordfog efter tankstrecket.
const hel = (s: string) => ejBryt(s.replace(/(Åk|åk) (?=\d)/g, '$1 '));
// koppling: den generella metodens serie med lektionsbanken, eller lektionens plats i den (src/lib/serie.ts).
interface Props { d: MetodData; id: string; koppling?: SerieKoppling }
const { d, id, koppling } = Astro.props;
// Bildserierna, arken och seriemallarna (Seriesamtal, src/lib/bildserier.ts): filerna som bygget ritar ur metodens
// scenfil, med sina mått, och rutornas alternativtext ur berättelsen, samma som i Word.
const seriefiler = serieFiler({ id, data: d });
const antalRutor = serieantal({ id, data: d });
const ruta = (src: string, alt: string) => ({ src, alt, ...svgMatt(seriefiler.get(src)!) });
type SerieRam = NonNullable<MetodData['ramar']>['ramar'][number];
const serieBlad = (ram: SerieRam) => serieRutorAdresser(id, ram.serie!, antalRutor[ram.serie!]).map((src, i, alla) => ruta(src, rutansText(ram, i + 1, alla.length)));
const mallBlad = (m: MetodData['mallar'][number]) => mallRutorAdresser(id, m).map((src, i) => ruta(src, `${m.rubrik}, ${mallEtiketter(m)?.[i] ?? `ruta ${i + 1}`}, tom att rita i`));
// Lektionsbanken står på den generella metodens sida efter urvalet, där texten säger var lektionerna finns.
const bank = koppling && !koppling.lektion ? koppling.serie : undefined;
// Ljudlekens kort (src/lib/ljudkort.ts): elevens typsnitt på korten och bladen, upphovet för bilderna en gång under
// materialet, och en rad till läraren om typsnittet, som hen kan använda till egna kort.
const elevtypsnitt = harElevtypsnitt(d);
// Sagobladen och tärningarna (src/lib/sagoblad.ts) har bildbankens bilder i Word-filerna, så upphovet står här också.
const bildUpphov = upphovBilder(d) ?? sagoUpphov(d);
// Sagobladen och tärningarna står i sin form bara i planeringsmallarna (Word): sidan säger det vid ramen, och utskriften
// visar inte tärningarnas ordkort, som inte går att göra en tärning av (granskningen 2026-10-02, P1).
const sagoNamn = { skyltar: 'Skyltarna', kort: 'Korten' } as Record<string, string>;
const mallarLank = `/stodundervisning/${id}-mallar.docx`;
const andikaNamnt = (d.ramar?.text ?? []).some((s) => s.includes('Andika'));
const efterInledning = d.tabeller.filter((t) => t.plats === 'efter-inledning');
const efterTidsschema = d.tabeller.filter((t) => t.plats === 'efter-tidsschema');
const efterSteg = d.tabeller.filter((t) => t.plats === 'efter-steg');
const efterArbetsform = d.tabeller.filter((t) => t.plats === 'efter-arbetsform');
const efterUrval = d.tabeller.filter((t) => t.plats === 'efter-urval');
const efterFastnar = d.tabeller.filter((t) => t.plats === 'efter-fastnar');
const efterGrund = d.tabeller.filter((t) => t.plats === 'efter-grund');
// En översikt med bara korta celler (en ordlista, en bokstavslista) får lika breda kolumner (klassen tat)
// och plats även på mobil; bara översikter med längre text och fler än tre kolumner staplas.
const kortaCeller = (rader: string[][]) => rader.every((r) => r.every((c) => c.length <= 12));
// Faserna en arbetsform spänner över, som en uppräkning: "Läs, Hitta draget, Vår text och Läraren skriver".
const radaUpp = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} och ${xs[xs.length - 1]}` : xs[0] ?? '');
// Exemplet berättas rakt; replikerna (”…”) sätts kursiva, som exempelfraserna i stegtabellen, så att en lärare hittar det som sägs.
const repliker = (s: string) => s.split(/(”[^”]*”)/).filter(Boolean).map((text) => ({ text, replik: text.startsWith('”') }));
// En fri tabell med tre kolumner och längre text staplas på mobil, som de med fler kolumner; tre korta kolumner får plats.
const friKlass = (t: { kolumner: string[]; rader: string[][] }) => (t.kolumner.length > 3 || (t.kolumner.length === 3 && t.rader.some((r) => r.some((c) => c.length > 40))) ? 'fri stapla' : 'fri');
// Passöversikten: rutin, tidsschema och arbetsform i en bild när stegen har faser.
const pass = passOversikt(d);
// Extrafilmerna (src/lib/film.ts, fältet filmer) står vid momentet de förklarar: sist i ett avsnitt, efter en fri tabell
// eller en ram, efter ett steg eller efter ett stycke. Word-filen frågar på samma platser (metoddocx.ts, metodBarn). Huvudfilmen står i [id].astro.
// Bilderna På bordet (src/lib/pabordet.ts) står på samma platser och ritas av samma Filmruta.astro, och dessutom efter en
// del i en ram (del: <rubrik>, en vecka).
const filmer = metodensFilmer(d, id);
const bilderPaBordet = metodensPaBordet(d, id);
const vid = (p: FilmPlats) => [...filmerVid(filmer, p), ...paBordetVid(bilderPaBordet, p)];
const ord = passOrd(d);
const tavla = d.exempel?.tavla ? d.lathund?.mall.block.find((b) => b.typ === 'tavla') : undefined;
const fraserRubrik = d.steg?.fraserRubrik ?? '';
// En radbrytning i ett ramfält blir en ny rad, som i tabellcellerna.
const linjer = (t: string) => t.split('\n');
// Mallarna: det hela är lika långt i bråkplanket och på tallinjen från 0 till 1, och det säger sidan när båda finns.
const planketOchLinjen = d.mallar.some((m) => m.typ === 'brakplank') && d.mallar.some((m) => m.typ === 'tallinjer');
const helaCm = d.mallar.find((m) => m.typ === 'brakplank')?.langdCm ?? 26;
// Är lathundens tredje sida ett blad (en tom tabell, som talsortsmattan) står det också sist i planeringsmallarna.
const lathundBlad = d.lathund && d.lathund.mall.block.filter((b) => b.typ !== 'not').length === 1 && d.lathund.mall.block.some((b) => b.typ === 'tabell' && b.rader.every((r) => r.every((c) => !c.trim()))) ? d.lathund.mall.rubrik : undefined;
// Bråk i elevmaterialet staplas i matematik (src/lib/brak.ts); i andra ämnen står ett snedstreck kvar, som i ett datum.
const brak = d.omrade === 'Matematik';
// Sidnavigationen: de avsnitt som finns, i modellens ordning, med korta namn.
// Urvalsavsnittets rubrik är en fråga ("Var hittar du materialet och talen?"); menyn tar dess kärna ("Materialet och
// talen"), så att posten säger vad avsnittet gäller och inte krockar med ramarnas "Material per årskurs" (K-034).
const urvalNamn = (rubrik: string) => {
  const karna = (rubrik.match(/^Var hittar du (.+?)\??$/i) ?? rubrik.match(/^Var (.+?) finns\??$/i))?.[1] ?? rubrik;
  return karna.charAt(0).toLocaleUpperCase('sv') + karna.slice(1);
};
const avsnitt = [
  d.passrutin && { id: 'passrutin', namn: pass ? 'Passet' : 'Passrutin' },
  d.tidsschema && !pass && { id: 'tidsschema', namn: 'Tidsschema' },
  d.steg && { id: 'steg', namn: ord.stegen },
  d.arbetsform && { id: 'arbetsform', namn: 'Arbetsform' },
  d.exempel && { id: 'exempel', namn: 'Exempel' },
  d.fastnar && { id: 'fastnar', namn: 'När det fastnar' },
  d.roll && { id: 'roll', namn: 'Lärarens roll' },
  d.urval && { id: 'urval', namn: urvalNamn(d.urval.rubrik) },
  bank && { id: 'lektionsbank', namn: bank.ord.meny },
  d.hem && { id: 'hem', namn: 'Hem och skola' },
  d.progression && { id: 'progression', namn: 'Progression' },
  d.uppfoljning && { id: 'uppfoljning', namn: 'Uppföljning' },
  d.mal && { id: 'mal', namn: 'Mål' },
  d.snabbmall && { id: 'snabbmall', namn: 'Snabbmall' },
  d.checklista && { id: 'checklista', namn: 'Checklista' },
  d.grund && { id: 'grund', namn: 'Grunden' },
  d.ramar && { id: 'ramar', namn: d.ramar.rubrik },
  d.diplom && { id: 'diplom', namn: d.diplom.rubrik },
  d.mallar.length > 0 && { id: 'mallar', namn: 'Mallar' },
].filter((a): a is { id: string; namn: string } => Boolean(a));
// Stabila ankare för rutorna, de fria tabellerna och ramarna, så att en lektion kan länka till avsnittet i den generella
// metoden (Ljudlek i grupp, Seriefot och skriptet i [id].astro): rubrikens första led i gemener, som "Ordbanken" #ordbanken
// och "Dagens ljud: bokstävernas ordning" #dagens-ljud. Ett ankare som redan finns får en siffra efter sig.
const ankarnamn = (s: string) => s.split(':')[0].toLowerCase().replace(/[åä]/g, 'a').replace(/ö/g, 'o').replace(/é/g, 'e').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const upptagna = new Set([...avsnitt.map((a) => a.id), 'upplagg', 'gruppen', 'principer', 'lektionsbank', 'ramar', ...(d.ramar?.ramar ?? []).map((_, i) => `ram-${i + 1}`)]);
const ankare = (s: string) => { let id = ankarnamn(s) || 'avsnitt'; for (let n = 2; upptagna.has(id); n++) id = `${ankarnamn(s)}-${n}`; upptagna.add(id); return id; };
const tabellAnkare = new Map(d.tabeller.map((t) => [t, ankare(t.rubrik)]));
const ramAnkare = (d.ramar?.ramar ?? []).map((r) => ankare(r.rubrik));
// Veckorna som lektioner (en ram med lektioner, De fyra räknesätten, Niclas 2026-10-04): varje del har ett eget ankare, som
// korten överst i ramen leder till, och ramen står i menyn med namnet efter kolon ("Till läraren: veckorna" blir Veckorna).
const delAnkare = (d.ramar?.ramar ?? []).map((r) => (r.lektioner ? r.delar.map((del) => ankare(del.rubrik)) : []));
const versalt = (s: string) => (s ? s.charAt(0).toLocaleUpperCase('sv') + s.slice(1) : s);
const menyLektioner = (d.ramar?.ramar ?? []).flatMap((r, ri) => (r.lektioner ? [{ id: `ram-${ri + 1}`, namn: versalt((r.rubrik.split(':')[1] ?? r.rubrik).trim()) }] : []));
// Kartan (src/lib/karta.ts): tabellen med karta leder till veckorna och räknebladen, och varje vecka visar sin rad.
// Räknebladen får ett ankare var, som bladens namn i kartan leder till.
const karta = kartan(d);
const blad = metodensBlad(d);
const bladAnkare = new Map([...blad].map(([namn, plats]) => [`${plats.ri}-${plats.li}`, ankare(`blad ${namn}`)]));
const kartLankar = { vecka: (rad: string[]) => { const p = radensDel(d, rad); return p ? `#${delAnkare[p.ri][p.di]}` : undefined; }, blad: (namn: string) => { const p = blad.get(namn); return p ? `#${bladAnkare.get(`${p.ri}-${p.li}`)}` : undefined; }, namn: new Set(blad.keys()), nivaer: d.nivaer };
const radLankar = { ...kartLankar, vecka: undefined };
// Veckans material (src/lib/veckomaterial.ts, Niclas 2026-10-06: "Man måste leta omkring för att hitta vecka 2 på 3
// ställen"): i en kurs med veckor står det material som nämner en enda vecka direkt efter veckans sida, i filens
// ordning, som i Word (metoddocx.ts). Ramarna ritas därför som punkter i den ordning de står på sidan: ramen med
// lektioner först utan veckorna (huvud), och sedan en vecka i taget (vecka) med sitt material efter sig: en hel ram,
// som förlagan, eller en lista med kort ur en ram (material), som veckans ordkort. Allt annat står kvar i filens
// ordning: en ram vars listor står vid veckorna (Ordkorten) ritas utan dem, med sin text och sin ruta Till läraren.
// Utan veckornas material är punkterna ramarna som de står i filen. En lista vid en vecka får ett eget ankare, som
// materialets lista leder till, och på skärmen en länk till sin ram, där läraren läser hur korten görs i ordning.
const vm = veckomaterial(d);
const ramarna: SerieRam[] = d.ramar?.ramar ?? [];
const listAnkare = new Map<string, string>();
if (vm) for (const [ri, lagda] of vm.listor) for (const li of lagda.keys()) listAnkare.set(`${ri}-${li}`, ankare(ramarna[ri].listor![li].rubrik ?? `${ramarna[ri].rubrik} ${li + 1}`));
type Punkt = { ram: SerieRam; ri: number; lage?: 'huvud' | 'vecka' | 'material'; vecka?: number; lista?: number; efter?: string; par?: TextparForm; helaKursen?: boolean };
const punkter: Punkt[] = [];
let sistaVeckan = -1;
ramarna.forEach((ram, ri) => {
  if (!vm) { punkter.push({ ram, ri }); return; }
  if (vm.ramar.has(ri)) return;
  if (ri !== vm.ri) {
    const lagda = vm.listor.get(ri);
    punkter.push({ ram: lagda ? { ...ram, listor: ram.listor!.filter((_, li) => !lagda.has(li)) } : ram, ri });
    return;
  }
  punkter.push({ ram, ri, lage: 'huvud' });
  for (const v of vm.veckor) {
    punkter.push({ ram: { ...ram, text: [], huvud: undefined, oversikt: undefined }, ri, lage: 'vecka', vecka: v.di });
    for (const x of v.saker) {
      punkter.push(x.typ === 'ram'
        ? { ram: ramarna[x.ri], ri: x.ri }
        : { ram: veckansLista(ramarna[x.ri], x.li), ri: x.ri, lage: 'material', lista: x.li });
    }
  }
  // En film eller bild som står efter ramen med lektioner står efter den sista veckans material.
  punkter[punkter.length - 1].efter = ram.rubrik;
  sistaVeckan = punkter.length - 1;
});
// Det som gäller hela kursen börjar på en ny sida i utskriften, som i Word, också när den sista veckans material är en
// hel ram (Inbjudan till läsaren i Skrivkurs: sagoboken; granskningen 2026-10-10).
if (sistaVeckan >= 0 && punkter[sistaVeckan + 1]) punkter[sistaVeckan + 1].helaKursen = true;
// Två texter (src/lib/ramform.ts, textparAv): ramen ritas som lärarens sida, med texterna och rutorna men utan frågorna och
// med en rad om elevens sida, och elevens sida (Textpar.astro) står efter den, som i Word.
for (const p of punkter) {
  const par = p.lage ? null : textparAv(p.ram);
  if (par) { p.par = par; p.ram = textparLarare(p.ram); }
}
// En kooperativ struktur (strukturAv) är en sida (Struktur.astro) med den första bilden På bordet som hör till ramen; fler
// bilder till ramen (bild A och bild B i Lika och olika) står efter sidan, som i Word.
const strukturer = new Map<SerieRam, StrukturForm>(ramarna.flatMap((r) => { const s = strukturAv(r); return s ? [[r, s] as [SerieRam, StrukturForm]] : []; }));
const indexAnkare = { del: (nr: number, di: number) => delAnkare[nr - 1]?.[di], lista: (nr: number, li: number) => listAnkare.get(`${nr - 1}-${li}`) };
// Lästexterna blir boksidor (Boksida.astro, K-148), med nivåns färg i den ordning nivåerna först kommer, som i Word.
const boksidor = lastexter(d.ramar?.ramar ?? []);
const BOKNIVA = ['#4e7a43', '#a8742a', '#6e3450'];
// Lärarens sidor till lästexterna (riggens namn: Lärarens sida och Lärarens sidor) ryms på ett A4 i Word och får ett eget
// blad i utskriften, lika tätt (global.css, .m-lararsida). Ramen till en bildserie med flera rutor är också lärarens sida
// (Seriesamtal: texten, berättelsen och rutan Till läraren), med elevens blad på ett eget liggande A4 efter.
const arLararsida = (ram: { rubrik: string; serie?: string }) => /^Lärarens sid(a|or)\b/.test(ram.rubrik) || (!!ram.serie && (antalRutor[ram.serie] ?? 0) > 1);
// En fri tabell med meny: true står i menyn efter avsnittet den ligger efter på sidan, med rubrikens första led som namn
// (Ljudstarten, Dagens ljud och Ordbanken i Ljudlek i grupp, som läraren letar efter varje pass).
const menyEfter: Record<string, string | undefined> = {
  'efter-tidsschema': pass ? 'passrutin' : 'tidsschema', 'efter-steg': 'steg', 'efter-arbetsform': 'arbetsform',
  'efter-fastnar': 'fastnar', 'efter-urval': bank ? 'lektionsbank' : 'urval', 'efter-grund': 'grund',
};
// Saknar metoden avsnittet tabellen står efter (Texttyper i grupp har tabeller efter steg men ingen stegtabell), står
// posten efter det närmaste avsnittet före i sidans ordning som finns, eller överst, så att ingen tabell faller ur
// menyn (granskningen 2026-10-09: fyra av sju tabeller saknades).
const sidansOrdning = ['passrutin', 'tidsschema', 'steg', 'arbetsform', 'exempel', 'fastnar', 'roll', 'urval', 'lektionsbank', 'hem', 'progression', 'uppfoljning', 'mal', 'snabbmall', 'checklista', 'grund'];
const finns = new Set(avsnitt.map((a) => a.id));
const narmastFore = (id: string | undefined) => {
  if (!id || finns.has(id)) return id;
  for (let i = sidansOrdning.indexOf(id) - 1; i >= 0; i--) if (finns.has(sidansOrdning[i])) return sidansOrdning[i];
  return undefined;
};
const menyTabeller = d.tabeller.filter((t) => t.meny).map((t) => ({ efter: t.plats === 'efter-inledning' ? undefined : narmastFore(menyEfter[t.plats]), post: { id: tabellAnkare.get(t)!, namn: t.rubrik.split(':')[0].trim() } }));
const meny = [
  ...menyTabeller.filter((m) => !m.efter).map((m) => m.post),
  ...avsnitt.flatMap((a) => [a, ...menyTabeller.filter((m) => m.efter === a.id).map((m) => m.post), ...(a.id === 'ramar' ? menyLektioner : [])]),
];
---
<div class="metod-modell">
  {meny.length > 2 && (
    <nav class="metod-nav" aria-label="På den här sidan">
      {d.lathund && <a class="lathund-lank" href={`/stodundervisning/${id}/lathund`}>Öppna lathunden</a>}
      <span class="nav-etikett" aria-hidden="true">På den här sidan</span>
      <ul>{meny.map((a) => <li><a href={`#${a.id}`} data-avsnitt={a.id}>{a.namn}</a></li>)}</ul>
    </nav>
  )}
  <div class="metod-text">
  {d.inledning.map((s, i) => <><p>{s}</p><Filmruta filmer={vid({ stycke: i + 1 })} titel={d.titel} /></>)}

  {/* Rutornas rubriker är rubriker, så att en skärmläsare kan hoppa till dem (K-028). De står direkt under h1. */}
  {d.upplagg && <div class="m-ruta" id="upplagg"><h2 class="kicker">{d.upplagg.rubrik}</h2><p>{d.upplagg.text}</p></div>}
  {d.gruppen && <div class="m-ruta" id="gruppen"><h2 class="kicker">{d.gruppen.rubrik}</h2><p>{d.gruppen.text}</p></div>}
  {d.principer && <div class="m-ruta" id="principer"><h2 class="kicker">{d.principer.rubrik}</h2><p>{d.principer.text}</p></div>}

  {efterInledning.map((t) => (
    <section id={tabellAnkare.get(t)}>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} karta={t.karta ? kartLankar : undefined} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
      <Filmruta filmer={vid({ tabell: t.rubrik })} titel={d.titel} />
    </section>
  ))}

  {pass && d.passrutin && (
    <section id="passrutin" class="m-pass-avsnitt">
      {/* Rubriken och ingressen i ett block, som utskriften håller ihop (global.css, .m-pass-huvud). */}
      <div class="m-pass-huvud">
      <h2>{pass.rubrik}</h2>
      {d.passrutin.text && <p>{d.passrutin.text}</p>}
      {pass.text && <p>{pass.text}</p>}
      </div>
