              {ram.delar.map((del) => (<>
                <div class="m-listnot">
                  <p class="kicker">{del.rubrik}</p>
                  {del.falt.map((f) => <p><b>{f.rubrik}</b>{linjer(f.text).map((x, j) => <>{j > 0 && <br />}{repliker(x).map((r) => (r.replik ? <em>{r.text}</em> : r.text))}</>)}</p>)}
                </div>
                <Filmruta filmer={vid({ del: del.rubrik })} titel={d.titel} />
              </>))}
              {/* Räknebladen (rakneblad): här står uppgifterna, och bladet med rutnät att räkna i finns i Word. Hänvisningen står
                  före listorna, så att den inte blir ensam på en sida i utskriften (granskningen 2026-10-04). */}
              {(ram.listor ?? []).some((l) => l.rakneblad) && <p class="m-efter">{(ram.listor ?? []).filter((l) => l.rakneblad).length === 1 ? 'Bladet' : 'Bladen'}, med en ruta per uppgift och ett rutnät att räkna i, en siffra per ruta, finns i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a> (Word).</p>}
              {ram.listor.map((l, plats) => {
                // Listans plats i ramen som den står i filen: en ram kan ritas utan de listor som står vid veckorna, och
                // en lista vid en vecka ritas ensam (src/lib/veckomaterial.ts).
                const alla = ramarna[ri].listor ?? ram.listor!;
                const li = alla.includes(l) ? alla.indexOf(l) : plats;
                // Ljudlekens former går före de andra korten (src/lib/ljudkort.ts).
                const ljud = ljudform(d, l);
                if (ljud === 'bildkort') return <Vikkort rubrik={l.rubrik} rader={l.rader} />;
                if (ljud === 'bokstavskort') return <Bokstavskort rubrik={l.rubrik} rader={l.rader} />;
                if (ljud === 'golvbokstaver') return <Golvbokstaver rubrik={l.rubrik} rader={l.rader} id={id} titel={d.titel} />;
                if (ljud === 'bokstavskarta') return <Bokstavskarta rubrik={l.rubrik} rader={l.rader} />;
                if (arBildlista(l)) return <Bildlista rubrik={l.rubrik} rader={l.rader} />;
                const info = kortInfo(d, l);
                const forra = li > 0 ? kortInfo(d, alla[li - 1])?.grupp : undefined;
                // Ramens fält att fylla i (elevens namn på kartläggningens kopia) står överst i den första listan, så att
                // de följer med listan i utskriften.
                // En lästräningstext blir två läskort (K-063), och en ensam kort lista ett kort i stor stil (K-062).
                const stodKolumn = info ? undefined : laskortKolumn(l);
                if (stodKolumn !== undefined) return <Laskort lista={l} stodKolumn={stodKolumn} />;
                // En tärnings ord står på skärmen men inte i utskriften: tärningen att vika finns i planeringsmallarna.
                // Alla tärningar står i samma form, tre ord i bredd, också när ett ord är längre än tio tecken (en
                // astronaut): annars stod tärningarna i en ram i två storlekar (Texttyp: Berättande text, 2026-10-09).
                if (info && arTarning(d, l)) return <div class="m-ej-utskrift"><Kortlista rubrik={l.rubrik} info={{ ...info, korta: false, medel: true }} nyGrupp={info.grupp !== forra} brak={brak} /></div>;
                return info
                  ? <Kortlista rubrik={l.rubrik} info={info} nyGrupp={lage === 'material' || info.grupp !== forra} brak={brak} />
                  : <Elevlista {...(l.rakneblad ? listansNiva(d.nivaer, l.rubrik) : { rubrik: l.rubrik })} id={bladAnkare.get(`${ri}-${li}`)} kolumner={l.kolumner} rader={l.rader} brak={brak} huvud={plats === 0 ? ram.huvud : undefined} klass={arEttKort(alla, l) ? 'kort' : ''} elev={elevtypsnitt && !l.larare} />;
              })}
            </>
          ) : ramArTom(ram)
            ? (d.elevblad[ram.rubrik]
              ? (
                <>
                  {/* Elevens blad (Stapelrutan): fälten i sina höjder, så att läraren ser bladet där det beskrivs. I utskriften
                      får fälten sina riktiga mått i cm, och bladet börjar på en ny sida. */}
                  <div class="m-ramdelar m-elevblad">
                    {ram.huvud && (
                      <dl class="m-ramfalt m-ramhuvud">
                        {ram.huvud.map((f) => <div><dt>{f.rubrik}</dt><dd>{f.text}</dd></div>)}
                      </dl>
                    )}
                    {ram.delar.map((del) => (
                      <div class="m-ramdel">
                        <h4>{del.rubrik}{del.rubrik !== ram.rubrik && <span class="m-ramnamn"> · {ram.rubrik}</span>}</h4>
                        <dl class="m-ramfalt">
                          {del.falt.map((f) => <div style={`--hojd:${d.elevblad[ram.rubrik][f.rubrik] ?? 2}`}><dt>{f.rubrik}</dt><dd></dd></div>)}
                        </dl>
                      </div>
                    ))}
                  </div>
                  {/* Ett sagoblad har redan sin hänvisning till planeringsmallarna överst i ramen (granskningen 2026-10-09). */}
                  {!ram.sagoform && <p class="m-efter">Bladet finns i full storlek i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a>.</p>}
                </>
              )
              : <p class="m-efter">Ramen att fylla i, med {ram.delar.length === 1 ? 'en del' : `${ram.delar.length} delar`}, finns i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a>.</p>)
            : (
              <div class="m-ramdelar">
                {ram.lektioner && lage !== 'vecka' && (
                  <ol class="m-lektionskort m-veckokort" aria-label={(ram.rubrik.split(':')[1] ?? 'delarna').trim().replace(/^\p{Ll}/u, (c) => c.toLocaleUpperCase('sv'))}>
                    {ram.delar.map((del, di) => {
                      const [forsta, ...resten] = del.rubrik.split(' · ');
                      // Ett led utan tal (Start · pass 1, Boken · pass 14 och 15) får inget nummer (granskningen 2026-10-10).
                      const nr = forsta.match(/\d+/)?.[0] ?? (resten.length ? '' : String(di + 1));
                      return (
                        <li class="m-lektionskort-kort">
                          <p class="m-lektionskort-formaga">{nr && <span class="m-lektionskort-nr" aria-hidden="true">{nr}</span>}<span>{resten.length ? forsta : `Del ${di + 1}`}</span></p>
                          <h4><a href={`#${delAnkare[ri][di]}`}>{resten.length ? resten.join(' · ') : del.rubrik}</a></h4>
                          {del.falt[0] && <p>{del.falt[0].text}</p>}
                        </li>
                      );
                    })}
                  </ol>
                )}
                {ram.huvud && (
                  <dl class="m-ramfalt m-ramhuvud">
                    {ram.huvud.map((f) => <div><dt>{f.rubrik}</dt><dd>{f.text}</dd></div>)}
                  </dl>
                )}
                {ram.delar.map((del, di) => {
                  // Ramen med lektioner i delar (se punkterna ovan): huvudet utan veckor, och sedan en vecka i taget.
                  if (lage === 'huvud' || (lage === 'vecka' && di !== vecka)) return null;
                  const rutan = (
                  <div class="m-ramdel" id={ram.lektioner ? delAnkare[ri][di] : undefined}>
                    <h4>{del.rubrik}{del.rubrik !== ram.rubrik && <span class="m-ramnamn"> · {ram.rubrik}</span>}</h4>
                    <dl class="m-ramfalt">
                      {del.falt.map((f) => (
                        <div><dt>{f.rubrik}</dt><dd>{f.kursiv ? <em>{linjer(f.text).map((x, j) => <>{j > 0 && <br />}{x}</>)}</em> : linjer(f.text).map((x, j) => <>{j > 0 && <br />}{x}</>)}</dd></div>
                      ))}
                    </dl>
                  </div>
                  );
                  const bilder = vid({ del: del.rubrik });
                  if (!ram.lektioner) return <>{rutan}<Filmruta filmer={bilder} titel={d.titel} /></>;
                  // En vecka (en ram med lektioner): rutan, och sedan raden ur kartan och bilden På bordet som ett block. I
                  // utskriften är veckan en sida och bilden fyller det som är kvar av den (global.css, .m-vecka); räcker det
                  // inte till en bild som går att läsa (veckanRyms), står blocket i full storlek på nästa sida, så att talen
                  // och bladen står med bilden (Niclas 2026-10-04).
                  const kartrad = karta ? delensRad(karta, del.rubrik) : undefined;
                  const ryms = veckanRyms(del.falt, kartrad?.slice(1), bilder.map((b) => ('bild' in b ? b.bild.text : '')).join(' '));
                  return (
                    <div class={`m-vecka${ryms ? '' : ' tva-sidor'}`}>
                      {rutan}
                      <div class="m-vecka-bild">
                        {/* Veckans rad ur kartan står utan egen rubrik: nivåernas färger säger vad den är (Niclas
                            2026-10-04: "Rubriken Talen och bladen i veckan behövs nog inte"). */}
                        {kartrad && (
                          <div class="m-kartrad">
                            <MetodTabell kolumner={karta!.kolumner.slice(1)} rader={[kartrad.slice(1)]} klass="fri stapla" radrubrik={false} karta={radLankar} />
                          </div>
                        )}
                        <Filmruta filmer={bilder} titel={d.titel} />
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          {/* Elevens blad med bildserien och arket att klippa ut står efter ramens delar, som i Word, där bladet står på ett
              liggande A4 och arket på ett A4 med 1 cm marginal. Utskriften från sidan ger dem samma sidor (global.css). */}
          {ram.serie && antalRutor[ram.serie] > 1 && (<>
            <Serierutor rutor={serieBlad(ram)} titel={hel(ram.rubrik)} namn etikett={`${ram.rubrik}, elevens blad`} />
            <p class="m-efter m-serie-efter">Elevens blad finns också på ett liggande A4 i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a> (Word).</p>
          </>)}
          {ram.ark && (<>
            <h4 class="m-lista-rubrik m-ark-rubrik">{ram.rubrik}</h4>
            <p class="m-ark"><img src={arkAdress(id, ram.ark)} alt={`${ram.rubrik}: tankebubblor, pratbubblor och en bubbla för det någon ropar, att klippa ut`} width={svgMatt(seriefiler.get(arkAdress(id, ram.ark))!).bredd} height={svgMatt(seriefiler.get(arkAdress(id, ram.ark))!).hojd} loading="lazy" decoding="async" data-utskriftsbild /></p>
            <p class="m-efter m-serie-efter">Arket finns i rätt storlek, på ett A4 med 1 cm marginal, i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a> (Word).</p>
          </>)}
          {/* Länkarna mellan veckans kort och ramen de kommer ur (bara på skärmen): under veckans kort en länk till
              ramens ruta Till läraren, med rutans första fält som ord ("Så gör du: Ordkorten"), och i ramen en länk
              till varje veckas kort. */}
          {lage === 'material' && (ramarna[ri].text.length > 0 || ramarna[ri].delar.length > 0) && (
            <p class="m-efter m-veckolank">{ramarna[ri].delar[0]?.falt[0]?.rubrik ?? 'Till läraren'}:{' '}<a href={`#ram-${ri + 1}`}>{hel(ramarna[ri].rubrik)}</a></p>
          )}
          {!lage && vm?.listor.has(ri) && (
            <p class="m-efter m-veckolank">Korten står vid sin vecka:{' '}{[...vm.listor.get(ri)!].map(([li, di], i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={`#${listAnkare.get(`${ri}-${li}`)}`}>{hel(vm.veckor[di].led)}</a></>)}</p>
          )}
        </section>
        {par && <Textpar p={par} id={`ram-${ri + 1}-elev`} />}
        <Filmruta filmer={[...(lage ? [] : vid({ ram: ram.rubrik })), ...(efter ? vid({ ram: efter }) : [])]} titel={d.titel} />
      </>))}
      {d.ramar.efter && <p class="m-efter">{d.ramar.efter}</p>}
      <Filmruta filmer={vid({ avsnitt: 'ramar' })} titel={d.titel} />
    </section>
  )}

  {d.diplom && (
    <section id="diplom">
      <h2>{d.diplom.rubrik}</h2>
      <div class="m-diplom">
        {d.diplom.kicker && <p class="kicker">{d.diplom.kicker}</p>}
        <p class="m-diplom-rubrik">{d.diplom.rubrik}</p>
        {d.diplom.text.map((t) => (/^_{3,}$/.test(t) ? <p class="m-linje" aria-hidden="true"></p> : <p>{t}</p>))}
        {d.diplom.underskrifter.length > 0 && <p class="m-underskrifter">{d.diplom.underskrifter.map((u) => <span>{u} <span class="m-linje-kort" aria-hidden="true"></span></span>)}</p>}
      </div>
      <p class="m-efter">Diplomet finns som egen sida i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a>.</p>
    </section>
  )}

  {d.mallar.length > 0 && (
    <section id="mallar">
      <h2>Mallar att skriva ut</h2>
      {planketOchLinjen
        ? <p>Mallarna finns i rätt storlek på liggande A4 sist i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a>. Det hela är {helaCm} cm i bråkplanket och på tallinjen från 0 till 1, så att bitarna kan läggas mot linjen. Skrivs mallarna ut på A3 blir allt lika mycket större.{lathundBlad && ` ${lathundBlad} finns på lathundens tredje sida och står också sist i planeringsmallarna.`}</p>
        : <p>Mallarna finns i rätt storlek sist i <a href={`/stodundervisning/${id}-mallar.docx`} data-goatcounter-click={`fil:${id}-mallar.docx`} data-goatcounter-title={`${d.titel}: planeringsmallarna som Word`}>planeringsmallarna</a>.{lathundBlad && ` ${lathundBlad} finns på lathundens tredje sida och står också där.`}</p>}
      {d.mallar.some((m) => !arSerieMall(m)) && <p class="m-mall-svep">Bilderna är bredare än skärmen. Svep i sidled för att se hela mallen.</p>}
      {d.mallar.map((m) => (
        <figure class="m-mall">
          <figcaption>
            <h3>{m.rubrik}</h3>
            {m.text && <p>{m.text}</p>}
            {/* Underraden (Paret och Sagorna på Parets väg) står över mallen, som i Word, så att ett utskrivet blad går att
                knyta till ett par (granskningen 2026-10-02, P1). */}
            {m.underrad && <p class="m-mall-underrad">{m.underrad}</p>}
          </figcaption>
          {arSerieMall(m)
            ? <Serierutor rutor={mallBlad(m)} namn mall etikett={m.rubrik} />
            : <div class="m-mall-ram" tabindex="0" role="region" aria-label={`${m.rubrik}, bild`}><MallBild mall={m} /></div>}
          {/* Mattans regel står i foten, som på bladet i Word. */}
          {m.fot && <div class="m-ruta m-mall-fot"><p>{m.fot}</p></div>}
          {/* Arken per talsort ryms inte i rätt storlek i utskriften från sidan: där står en hänvisning i stället för bilden. */}
          {m.typ === 'matta' && m.enPerSida && <p class="m-mall-utskrift">Arken, ett stående A4 per talsort, finns i rätt storlek sist i planeringsmallarna.</p>}
        </figure>
      ))}
    </section>
  )}
  </div>
</div>

<script>
  import '../scripts/bockar';
  // Sidnavigationen markerar det avsnitt som är i bild, så att läsaren ser var på sidan hen är.
  const lankar = [...document.querySelectorAll<HTMLAnchorElement>('.metod-nav a[data-avsnitt]')];
  if (lankar.length > 0 && 'IntersectionObserver' in window) {
    const synliga = new Set<string>();
    const markera = () => {
      const forst = lankar.find((a) => synliga.has(a.dataset.avsnitt ?? ''));
      for (const a of lankar) {
        if (a === forst) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    const obs = new IntersectionObserver((poster) => {
      for (const p of poster) {
        if (p.isIntersecting) synliga.add(p.target.id);
        else synliga.delete(p.target.id);
      }
      markera();
    }, { rootMargin: '-10% 0px -60% 0px' });
    for (const a of lankar) {
      const del = document.getElementById(a.dataset.avsnitt ?? '');
      if (del) obs.observe(del);
    }
  }
</script>
