---
// Hela metoden i modellens ordning, med kompendiets designelement: rutor, tabeller med rubrikrad,
// band, gör/undvik och bockar. Samma element och ordning som i docx-filen (src/lib/metoddocx.ts).
import MetodTabell from './MetodTabell.astro';
import Tavla from './Tavla.astro';
import Elevlista from './Elevlista.astro';
import type { MetodData } from '../lib/metod';
import { ramArTom, passOversikt, stegTexter } from '../lib/metod';
interface Props { d: MetodData; id: string }
const { d, id } = Astro.props;
const efterInledning = d.tabeller.filter((t) => t.plats === 'efter-inledning');
const efterTidsschema = d.tabeller.filter((t) => t.plats === 'efter-tidsschema');
const efterSteg = d.tabeller.filter((t) => t.plats === 'efter-steg');
const efterArbetsform = d.tabeller.filter((t) => t.plats === 'efter-arbetsform');
const efterUrval = d.tabeller.filter((t) => t.plats === 'efter-urval');
const efterFastnar = d.tabeller.filter((t) => t.plats === 'efter-fastnar');
const efterGrund = d.tabeller.filter((t) => t.plats === 'efter-grund');
// En översikt med bara korta celler (en ordlista, en bokstavslista) får lika breda kolumner (klassen tat)
// och plats även på mobil; bara översikter med längre text och fler än tre kolumner staplas.
const kortaCeller = (rader: string[][]) => rader.every((r) => r.every((c) => c.length <= 12));
// Faserna en arbetsform spänner över, som en uppräkning: "Läs, Hitta draget, Vår text och Läraren skriver".
const radaUpp = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} och ${xs[xs.length - 1]}` : xs[0] ?? '');
// Exemplet berättas rakt; replikerna (”…”) sätts kursiva, som exempelfraserna i stegtabellen, så att en lärare hittar det som sägs.
const repliker = (s: string) => s.split(/(”[^”]*”)/).filter(Boolean).map((text) => ({ text, replik: text.startsWith('”') }));
// En fri tabell med tre kolumner och längre text staplas på mobil, som de med fler kolumner; tre korta kolumner får plats.
const friKlass = (t: { kolumner: string[]; rader: string[][] }) => (t.kolumner.length > 3 || (t.kolumner.length === 3 && t.rader.some((r) => r.some((c) => c.length > 40))) ? 'fri stapla' : 'fri');
// Passöversikten: rutin, tidsschema och arbetsform i en bild när stegen har faser.
const pass = passOversikt(d);
const tavla = d.exempel?.tavla ? d.lathund?.mall.block.find((b) => b.typ === 'tavla') : undefined;
const fraserRubrik = d.steg?.fraserRubrik ?? '';
// En radbrytning i ett ramfält blir en ny rad, som i tabellcellerna.
const linjer = (t: string) => t.split('\n');
// Sidnavigationen: de avsnitt som finns, i modellens ordning, med korta namn.
const avsnitt = [
  d.passrutin && { id: 'passrutin', namn: pass ? 'Passet' : 'Passrutin' },
  d.tidsschema && !pass && { id: 'tidsschema', namn: 'Tidsschema' },
  d.steg && { id: 'steg', namn: 'Stegen' },
  d.arbetsform && { id: 'arbetsform', namn: 'Arbetsform' },
  d.exempel && { id: 'exempel', namn: 'Exempel' },
  d.fastnar && { id: 'fastnar', namn: 'När det fastnar' },
  d.roll && { id: 'roll', namn: 'Lärarens roll' },
  d.urval && { id: 'urval', namn: 'Material' },
  d.hem && { id: 'hem', namn: 'Hem och skola' },
  d.progression && { id: 'progression', namn: 'Progression' },
  d.uppfoljning && { id: 'uppfoljning', namn: 'Uppföljning' },
  d.mal && { id: 'mal', namn: 'Mål' },
  d.snabbmall && { id: 'snabbmall', namn: 'Snabbmall' },
  d.checklista && { id: 'checklista', namn: 'Checklista' },
  d.grund && { id: 'grund', namn: 'Grunden' },
  d.ramar && { id: 'ramar', namn: d.ramar.rubrik },
  d.diplom && { id: 'diplom', namn: d.diplom.rubrik },
].filter((a): a is { id: string; namn: string } => Boolean(a));
---
<div class="metod-modell">
  {avsnitt.length > 2 && (
    <nav class="metod-nav" aria-label="På den här sidan">
      {d.lathund && <a class="lathund-lank" href={`/stodundervisning/${id}/lathund`}>Öppna lathunden</a>}
      <span class="nav-etikett" aria-hidden="true">På den här sidan</span>
      <ul>{avsnitt.map((a) => <li><a href={`#${a.id}`} data-avsnitt={a.id}>{a.namn}</a></li>)}</ul>
    </nav>
  )}
  <div class="metod-text">
  {d.inledning.map((s) => <p>{s}</p>)}

  {d.upplagg && <div class="m-ruta"><p><strong class="kicker">{d.upplagg.rubrik}</strong>{' '}{d.upplagg.text}</p></div>}
  {d.gruppen && <div class="m-ruta"><p><strong class="kicker">{d.gruppen.rubrik}</strong>{' '}{d.gruppen.text}</p></div>}
  {d.principer && <div class="m-ruta"><p><strong class="kicker">{d.principer.rubrik}</strong>{' '}{d.principer.text}</p></div>}

  {efterInledning.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {pass && d.passrutin && (
    <section id="passrutin" class="m-pass-avsnitt">
      <h2>{pass.rubrik}</h2>
      {d.passrutin.text && <p>{d.passrutin.text}</p>}
      {pass.text && <p>{pass.text}</p>}
      <div class="m-remsa" style={`--kolumner:${pass.faser.map((f) => `minmax(7rem, ${f.minuter}fr)`).join(' ')}`} role="img" aria-label={`Passets faser: ${pass.faser.map((f) => `${f.fas} ${f.tid}`).join(', ')}${pass.delar.length ? `. Arbetsform: ${pass.delar.map((x) => `${x.rubrik} ${x.tid}`).join(', ')}` : ''}`}>
        {pass.faser.map((f, i) => <div class="m-remsa-fas" style={`--n:${i}`}><strong>{f.fas}</strong><span>{f.tid}</span></div>)}
        {pass.delar.map((x) => <div class="m-remsa-del" style={`grid-column:${x.fran + 1} / span ${x.antal};--n:${x.fran}`}><strong>{x.rubrik}</strong>{x.tid && <>{' '}<span class="m-remsa-tid">{x.tid}</span></>}{x.antal > 1 && <span class="m-remsa-faser">{' '}under {radaUpp(pass.faser.slice(x.fran, x.fran + x.antal).map((f) => f.fas))}</span>}{' '}· {x.text}</div>)}
      </div>
      <table class="m-tabell m-pass stapla" id="tidsschema">
        <colgroup><col style="width:18%" /><col style="width:40%" /><col style="width:42%" /></colgroup>
        <thead><tr><th scope="col">Fas</th><th scope="col">Rutinen i {stegTexter(d).length} steg</th><th scope="col">Så leder du det</th></tr></thead>
        <tbody>
          {pass.fore && <tr class="m-pass-kant"><th scope="row" data-rubrik="Fas">Före passet</th><td colspan="2" data-rubrik="Förberedelse">{pass.fore}</td></tr>}
          {pass.faser.map((f) => (
            <tr>
              <th scope="row" data-rubrik="Fas"><span class="forsta">{f.fas}</span><span class="under">{f.tid}</span></th>
              {f.steg.length > 0 ? <td data-rubrik="Rutinen"><ol class="m-pass-steg" start={f.steg[0].nr}>{f.steg.map((s) => <li>{s.text}</li>)}</ol></td> : <td class="tom"></td>}
              <td data-rubrik="Så leder du det">{f.vad}</td>
            </tr>
          ))}
          {pass.efter && <tr class="m-pass-kant"><th scope="row" data-rubrik="Fas">Efter passet</th><td colspan="2" data-rubrik="Notering">{pass.efter}</td></tr>}
        </tbody>
      </table>
      {pass.efterTabell && <p class="m-efter">{pass.efterTabell}</p>}
    </section>
  )}

  {!pass && d.passrutin && (
    <section id="passrutin">
      <h2>{d.passrutin.rubrik}</h2>
      {d.passrutin.text && <p>{d.passrutin.text}</p>}
      <ol class="m-rutin">{stegTexter(d).map((s) => <li>{s}</li>)}</ol>
      {d.passrutin.efter && <p class="m-efter">{d.passrutin.efter}</p>}
    </section>
  )}

  {!pass && d.tidsschema && (
    <section id="tidsschema">
      <h2>{d.tidsschema.rubrik}</h2>
      {d.tidsschema.text && <p>{d.tidsschema.text}</p>}
      <MetodTabell kolumner={['Tid', 'Fas', 'Vad händer']} rader={d.tidsschema.rader.map((r) => [r.tid, r.fas, r.vad])} bredder={['18%', '22%', '60%']} klass="tidsschema" />
      {d.tidsschema.efter && <p class="m-efter">{d.tidsschema.efter}</p>}
    </section>
  )}

  {efterTidsschema.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {d.steg && (
    <section id="steg">
      <h2>{d.steg.rubrik}</h2>
      {d.steg.text && <p>{d.steg.text}</p>}
      <table class="m-tabell steg" role="table">
        <colgroup><col style="width:22%" /><col style="width:36%" /><col style="width:42%" /></colgroup>
        <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Steg</th><th scope="col" role="columnheader">Vad du gör</th><th scope="col" role="columnheader">{fraserRubrik}</th></tr></thead>
        <tbody role="rowgroup">
          {d.steg.rader.map((r, i) => (
            <tr role="row">
              <th scope="row" role="rowheader" data-rubrik="Steg"><span class="forsta stegnamn">{i + 1} {r.namn}</span>{r.fraga && <span class="under">{r.fraga}</span>}</th>
              <td role="cell" data-rubrik="Vad du gör">{r.gor}</td>
              <td role="cell" data-rubrik={fraserRubrik}>{r.fraser.length > 0 && <ul class="fraser">{r.fraser.map((f) => <li>”{f}”</li>)}</ul>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {efterSteg.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {d.arbetsform && (
    <section id="arbetsform">
      <h2>{d.arbetsform.rubrik}</h2>
      <p>{d.arbetsform.text}</p>
      {!(pass && pass.delar.length) && (
        <div class="m-band" style={`--delar:${d.arbetsform.delar.length}`}>
          {d.arbetsform.delar.map((x) => <div><strong>{x.rubrik}</strong><span>{x.text}</span></div>)}
        </div>
      )}
    </section>
  )}

  {efterArbetsform.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {d.exempel && (
    <section id="exempel" class="m-exempel">
      <h2>{d.exempel.rubrik}</h2>
      <div class="m-ruta"><p><strong class="kicker">{d.exempel.valt.rubrik}:</strong>{' '}{d.exempel.valt.text}</p></div>
      {d.exempel.text.map((s) => <p>{repliker(s).map((x) => (x.replik ? <em>{x.text}</em> : x.text))}</p>)}
      {tavla && (
        <div class="m-tavla">
          <p class="kicker">Tavlan under passet</p>
          <Tavla b={tavla} />
          {d.exempel.tavlaText && <p class="m-efter">{d.exempel.tavlaText}</p>}
        </div>
      )}
    </section>
  )}

  {d.fastnar && (
    <section id="fastnar">
      <h2>{d.fastnar.rubrik}</h2>
      <p>{d.fastnar.text}</p>
      <div class="m-ruta m-fraga">
        <p class="kicker">Fråga alltid först:</p>
        {d.fastnar.fragaForst.map((f) => <p class="stor">{f}</p>)}
      </div>
      <p>{d.fastnar.trappaText}</p>
      <ol class="m-trappa">{d.fastnar.trappa.map((t) => <li>{t}</li>)}</ol>
      {d.fastnar.efter && <p class="m-efter">{d.fastnar.efter}</p>}
      {d.fastnar.motto && <p class="m-motto">{d.fastnar.motto}</p>}
    </section>
  )}

  {efterFastnar.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {d.roll && (
    <section id="roll">
      <h2>{d.roll.rubrik}</h2>
      <p>{d.roll.text}</p>
      <div class="m-gor-undvik">
        <div class="gor"><h3>Gör så här</h3><ul>{d.roll.gor.map((x) => <li>{x}</li>)}</ul></div>
        <div class="undvik"><h3>Undvik</h3><ul>{d.roll.undvik.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>
  )}

  {d.urval && (
    <section id="urval">
      <h2>{d.urval.rubrik}</h2>
      {d.urval.text.map((s) => <p>{s}</p>)}
      {d.urval.kravText && <p>{d.urval.kravText}</p>}
      <div class="m-band" style={`--delar:${d.urval.krav.length}`}>
        {d.urval.krav.map((x) => <div><strong>{x.rubrik}</strong><span>{x.text}</span></div>)}
      </div>
      {d.ramar && <p class="m-efter"><a href="#ramar">{d.ramar.rubrik}</a> ligger sist på sidan, och som egna sidor att kopiera i <a href={`/stodundervisning/${id}-mallar.docx`}>planeringsmallarna</a> (Word).</p>}
    </section>
  )}

  {efterUrval.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {d.hem && (
    <section id="hem">
      <h2>{d.hem.rubrik}</h2>
      {d.hem.text.map((s) => <p>{s}</p>)}
      {d.hem.kontrakt && (
        <div class="m-kontrakt">
          <p class="kicker">{d.hem.kontrakt.rubrik}</p>
          <p><em>{d.hem.kontrakt.inledning}</em></p>
          {d.hem.kontrakt.ansvar.map((a) => <p><strong>{a.rubrik}.</strong>{' '}{a.text}</p>)}
          {d.hem.kontrakt.efter && <p class="m-efter">{d.hem.kontrakt.efter}</p>}
        </div>
      )}
      {d.hem.schema && <p class="m-efter">{d.hem.schema.rubrik}: {d.hem.schema.text}{d.hem.schema.text && ' '}Schemat med {d.hem.schema.rader} rader att fylla i finns i planeringsmallarna.</p>}
    </section>
  )}

  {d.progression && (
    <section id="progression">
      <h2>{d.progression.rubrik}</h2>
      {d.progression.text && <p>{d.progression.text}</p>}
      <MetodTabell kolumner={[d.progression.enhet, 'Fokus', 'Lärarens roll']} rader={d.progression.rader.map((r) => [r.led ? `${r.vecka}\n${r.led}` : r.vecka, r.fokus, r.roll])} bredder={['18%', '42%', '40%']} klass="stapla" />
    </section>
  )}

  {d.uppfoljning && (
    <section id="uppfoljning">
      <h2>{d.uppfoljning.rubrik}</h2>
      {d.uppfoljning.text && <p>{d.uppfoljning.text}</p>}
      <table class="m-tabell tva">
        <colgroup><col style="width:28%" /><col style="width:72%" /></colgroup>
        <tbody>{d.uppfoljning.rader.map((r) => <tr><th scope="row">{r.nar}</th><td>{r.vad}</td></tr>)}</tbody>
      </table>
    </section>
  )}

  {d.mal && (
    <section id="mal">
      <h2>{d.mal.rubrik}</h2>
      <p>{d.mal.text}</p>
      <ul class="m-bockar tva" data-bockar>{d.mal.punkter.map((p) => <li><label><input type="checkbox" /> {p}</label></li>)}</ul>
      <p class="bara-js m-rensa"><button type="button" class="lank" data-rensa-bockar>Rensa kryssen</button></p>
    </section>
  )}

  {d.snabbmall && (
    <section id="snabbmall">
      <h2>{d.snabbmall.rubrik}</h2>
      {d.snabbmall.text && <p>{d.snabbmall.text}</p>}
      <table class="m-snabbmall">
        <caption>SNABBMALL · {d.titel}</caption>
        <colgroup><col style="width:38%" /><col style="width:62%" /></colgroup>
        <tbody>
          <tr class="avsnitt"><th scope="col">Före passet</th><th scope="col"><span class="visually-hidden">Att fylla i</span></th></tr>
          {d.snabbmall.fore.map((f) => <tr><th scope="row">{f}</th><td></td></tr>)}
        </tbody>
        <tbody>
          <tr class="avsnitt"><th scope="col">Efter passet: kort notering</th><th scope="col"><span class="visually-hidden">Att fylla i</span></th></tr>
          {d.snabbmall.efter.map((f) => <tr><th scope="row">{f}</th><td></td></tr>)}
        </tbody>
      </table>
    </section>
  )}

  {d.checklista && (
    <section id="checklista">
      <h2>{d.checklista.rubrik}</h2>
      <ul class="m-bockar" data-bockar>{d.checklista.punkter.map((p) => <li><label><input type="checkbox" /> {p}</label></li>)}</ul>
      <p class="bara-js m-rensa"><button type="button" class="lank" data-rensa-bockar>Rensa kryssen</button></p>
    </section>
  )}

  {d.grund && (
    <section id="grund">
      <h2>{d.grund.rubrik}</h2>
      <div class="m-grund"><p>{d.grund.text}</p></div>
      {d.grund.kallor && <p class="m-kallor">{d.grund.kallor}</p>}
    </section>
  )}

  {efterGrund.map((t) => (
    <section>
      <h2>{t.rubrik}</h2>
      {t.text && <p>{t.text}</p>}
      <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friKlass(t)} radrubrik={false} />
      {t.not && <div class="m-ruta"><p>{t.not}</p></div>}
    </section>
  ))}

  {d.ramar && (
    <section id="ramar">
      <h2>{d.ramar.rubrik}</h2>
      {d.ramar.text.map((s) => <p>{s}</p>)}
      {d.ramar.ramar.map((ram) => (
        <section class="m-ram">
          <h3>{ram.rubrik}</h3>
          {ram.text.map((s) => <p>{s}</p>)}
          {ram.oversikt && <MetodTabell kolumner={ram.oversikt.kolumner} rader={ram.oversikt.rader} klass={kortaCeller(ram.oversikt.rader) ? 'fri tat' : friKlass(ram.oversikt)} radrubrik={false} />}
          {ram.listor ? (
            <>
              {ram.delar.map((del) => (
                <div class="m-listnot">
                  {del.falt.map((f) => <p><b>{f.rubrik}</b>{linjer(f.text).map((x, j) => <>{j > 0 && <br />}{x}</>)}</p>)}
                </div>
              ))}
              {ram.listor.map((l) => <Elevlista rubrik={l.rubrik} kolumner={l.kolumner} rader={l.rader} />)}
            </>
          ) : ramArTom(ram)
            ? <p class="m-efter">Ramen att fylla i, med {ram.delar.length} delar, finns i <a href={`/stodundervisning/${id}-mallar.docx`}>planeringsmallarna</a>.</p>
            : (
              <div class="m-ramdelar">
                {ram.huvud && (
                  <dl class="m-ramfalt m-ramhuvud">
                    {ram.huvud.map((f) => <div><dt>{f.rubrik}</dt><dd>{f.text}</dd></div>)}
                  </dl>
                )}
                {ram.delar.map((del) => (
                  <div class="m-ramdel">
                    <h4>{del.rubrik}<span class="m-ramnamn"> · {ram.rubrik}</span></h4>
                    <dl class="m-ramfalt">
                      {del.falt.map((f) => (
                        <div><dt>{f.rubrik}</dt><dd>{f.kursiv ? <em>{linjer(f.text).map((x, j) => <>{j > 0 && <br />}{x}</>)}</em> : linjer(f.text).map((x, j) => <>{j > 0 && <br />}{x}</>)}</dd></div>
                      ))}
                    </dl>
                  </div>
                ))}
              </div>
            )}
        </section>
      ))}
      {d.ramar.efter && <p class="m-efter">{d.ramar.efter}</p>}
    </section>
  )}

  {d.diplom && (
    <section id="diplom">
      <h2>{d.diplom.rubrik}</h2>
      <div class="m-diplom">
        {d.diplom.kicker && <p class="kicker">{d.diplom.kicker}</p>}
        <p class="m-diplom-rubrik">{d.diplom.rubrik}</p>
        {d.diplom.text.map((t) => (/^_{3,}$/.test(t) ? <p class="m-linje" aria-hidden="true"></p> : <p>{t}</p>))}
        {d.diplom.underskrifter.length > 0 && <p class="m-underskrifter">{d.diplom.underskrifter.map((u) => <span>{u} <span class="m-linje-kort" aria-hidden="true"></span></span>)}</p>}
      </div>
      <p class="m-efter">Diplomet finns som egen sida i <a href={`/stodundervisning/${id}-mallar.docx`}>planeringsmallarna</a>.</p>
    </section>
  )}
  </div>
</div>

<script>
  import '../scripts/bockar';
  // Sidnavigationen markerar det avsnitt som är i bild, så att läsaren ser var på sidan hen är.
  const lankar = [...document.querySelectorAll<HTMLAnchorElement>('.metod-nav a[data-avsnitt]')];
  if (lankar.length > 0 && 'IntersectionObserver' in window) {
    const synliga = new Set<string>();
    const markera = () => {
      const forst = lankar.find((a) => synliga.has(a.dataset.avsnitt ?? ''));
      for (const a of lankar) {
        if (a === forst) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    const obs = new IntersectionObserver((poster) => {
      for (const p of poster) {
        if (p.isIntersecting) synliga.add(p.target.id);
        else synliga.delete(p.target.id);
      }
      markera();
    }, { rootMargin: '-10% 0px -60% 0px' });
    for (const a of lankar) {
      const del = document.getElementById(a.dataset.avsnitt ?? '');
      if (del) obs.observe(del);
    }
  }
</script>
