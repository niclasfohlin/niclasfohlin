---
// Ett kort på /strukturer (K-650): bilden, namnet och syftet som en länk till strukturens sida, och bocken som lägger
// strukturen i listan Att skriva ut (Kortbock.astro, src/scripts/kortlistan.ts). I topplistan bär kortet sin plats.
import { strukturensAdress, bildensAdress, slagensStil, type Struktur } from '../lib/strukturer';
import Kortbock from './Kortbock.astro';

interface Props { s: Struktur; nr?: number }
const { s, nr } = Astro.props;
---

<li>
  <article class="st-kort" data-slag={s.data.slag} style={slagensStil(s.data.slag)}>
    <a href={strukturensAdress(s.id)}>
      <img src={bildensAdress(s.id)} alt="" width="900" height="560" loading="lazy" decoding="async" />
      <span class="st-kort-text">
        <span class="st-kort-namn">{s.data.namn}</span>
        <span class="st-kort-rad">{s.data.syfte}</span>
      </span>
    </a>
    {nr !== undefined && <span class="st-nr" aria-label={`Plats ${nr}`}>{nr}</span>}
    <Kortbock id={s.id} namn={s.data.namn} />
  </article>
</li>
