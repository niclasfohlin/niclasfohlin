---
// Metodkortet för en undervisningsmetod, ett utkast för formen (K-623). Formen är Raderna, som båda idéförslagen
// rekommenderade (underlag/prov/metoder/ide/): faktan som celler under huvudet, en rad per område med namnet överst och
// staplarna och nivåns ord under, så att ordet alltid ryms efter staplarna (Niclas 2026-10-29: "Kan du göra så att ordet
// alltid får plats efter staplarna"). Raden fälls ut till motiveringen. Lärande totalt är större och öppen, Primär evidens
// är sajtens områden med deras färger och märken, och Svårighet och Kostnad har neutrala staplar och ett ord. Nivå 1 och
// Negativ effekt har inga fyllda staplar, och Oklart och Inte studerat har en streckad ram (riggens utkast 4). Kortet står
// alltid i sajtens bläck (Niclas 2026-10-30), och Primär evidens är en rad med etikett och ämnets märke. Med bank är det
// kortet i banken: huvudet med titeln, faktan med de andra namnen under, raderna Lärande totalt, Svårighet och Kostnad,
// ingressen och länkarna till Lär dig metoden och lathunden, som korten i Stödundervisning (design-3 nr 17 och 22).
import Staplar from './Staplar.astro';
import { OMRADEN, primaraOmraden, type Utkast } from '../lib/metodprofil';
import { esc, effektensSkala, uppraknat, laget, motiveringensDelar, svarighetensNiva, kostnadensNiva, SVARIGHETENS_ORD, KOSTNADENS_ORD, NIVAORD, type Laget } from '../lib/standard/index.js';
import { medSaker, METODKORTET } from '../lib/undervisningsmetod';
import type { MetodSak } from '../lib/metodsaker';
interface Props { m: Utkast; bank?: boolean; kallor?: Set<string>; saker?: MetodSak[]; lankar?: { text: string; href: string; klass: string }[] }
const { m, bank = false, kallor, saker = [], lankar = [] } = Astro.props;
// På metodens sida leder hänvisningarna i motiveringen till sin post i referensbladet (granskningen 2026-10-30), och
// metodens saker, som referensbladet, är länkar (medSaker).
const skal = (t: string) => (kallor ? medSaker(t, saker, kallor) : esc(t));
const total = laget(m.evidens.larande);
const prim = primaraOmraden(m.evidens);
// Det primära områdets korta mening, när metoden har den (`kort`, som Lärande totalt): för vilka elever stödet gäller, så
// att villkoret står också på bankens kort (granskare-3 nr 11).
const primKort = prim.map((namn) => (m.evidens[OMRADEN.find((o) => o.namn === namn)?.id ?? 'larande'] as { kort?: string }).kort).filter((x): x is string => !!x);
const kallas = `Kallas också ${uppraknat(m.alternativaNamn)}`;
// Svårighet och Kostnad: namnet, nivån ur kriterierna, ordet och motiveringen, i samma rader som evidensen. Timmarna står
// efter motiveringen bara när den inte redan säger talet (granskare-3 nr 15).
const infor = [
  { namn: 'Svårighet att införa', kort: 'Svårighet', niva: svarighetensNiva(m.svarighet), ord: SVARIGHETENS_ORD, motivering: m.svarighet.motivering },
  { namn: 'Kostnad att införa', kort: 'Kostnad', niva: kostnadensNiva(m.kostnad), ord: KOSTNADENS_ORD, motivering: m.kostnad.motivering, timmar: m.kostnad.timmar },
];
const timmarna = (x: (typeof infor)[number]) => ('timmar' in x && x.timmar !== undefined && !new RegExp(`(^|\\D)${x.timmar}(\\D|$)`).test(x.motivering) ? ` Timmarna är lärarens första läsår, omkring ${x.timmar}.` : '');
// Hur ett läge ritas, en rot för raderna och förklaringen: staplar och ordet, eller en streckad ram med ordet.
const fylld = (l: Laget) => (l.slag === 'niva' && l.niva > 1 ? l.niva : 0);
---
{bank ? (
  <article class="kort metodkort mp-bank" data-del="metoder">
    <div class="kort-topp">
      <h3><a href={`/metoder/${m.id}`}>{m.titel}</a></h3>
    </div>
    <dl class="kort-fakta">
      {m.fakta.map(([rubrik, text]) => <div><dt>{rubrik}</dt><dd>{text}</dd></div>)}
    </dl>
    {m.alternativaNamn.length > 0 && <p class="mp-kallas-bank">{kallas}</p>}
    <div class="mp-bank-rader">
      <div class="mp-bank-total">
        <p class="mp-bank-en">
          <span class="mp-namn">Lärande totalt</span>
          {total.slag === 'niva'
            ? <span class="mp-stapelrad"><Staplar niva={fylld(total)} /><span class={`mp-varde${total.negativ ? ' mp-negativ' : ''}`}>{total.ord}<span class="visually-hidden">, {total.niva} av 5</span></span></span>
            : <span class="mp-inte">{total.ord}</span>}
        </p>
        {m.larandeKort && <p class="mp-kommentar">{m.larandeKort}</p>}
        {prim.length > 0 && <p class="mp-bank-primar"><span>Primär evidens</span><span class="mp-omraden">{prim.map((o) => <span class="amne" data-amne={o}>{o}</span>)}</span></p>}
        {primKort.map((t) => <p class="mp-bank-primar-kort">{t}</p>)}
      </div>
      <div class="mp-bank-par">
        {infor.map((x) => <p class="mp-bank-halv"><span class="mp-namn">{x.kort}</span><span class="mp-stapelrad"><Staplar niva={x.niva} neutral /><span class="mp-varde">{x.ord[x.niva]}<span class="visually-hidden">, {x.niva} av 5</span></span></span>{'timmar' in x && x.timmar !== undefined && <span class="mp-timmar">omkring {x.timmar} timmar</span>}</p>)}
      </div>
    </div>
    <p class="ingress">{m.ingress}</p>
    {lankar.length > 0 && <p class="kort-rad mp-bank-lankar">{lankar.map((l) => <a class={l.klass} href={l.href}>{l.text}<span class="visually-hidden">: {m.titel}</span></a>)}</p>}
    {m.platshallare && <p class="mp-platshallare"><span class="beta">Platshållare</span> Värdena är inget omdöme om metoden.</p>}
  </article>
) : (
  <div class="faktaruta metodprofil" id="metodkortet">
    <p class="faktaruta-etikett"><span>{METODKORTET}</span> {m.platshallare && <span class="beta">Platshållare</span>}</p>
    <dl class="kort-fakta">
      {m.fakta.map(([rubrik, text]) => <div><dt>{rubrik}</dt><dd>{text}</dd></div>)}
    </dl>
    {OMRADEN.map((o) => {
      const v = m.evidens[o.id];
      const l = laget(v);
      const radenTotal = o.id === 'larande';
      const { forst, resten } = motiveringensDelar(v.motivering);
      return (
        <>
          <details class={`mp-rad${radenTotal ? ' mp-total' : ''}`} open={radenTotal}>
            <summary>
              <span class="mp-namn">{o.namn}{o.under && <small>{o.under}</small>}</span>
              {l.slag === 'niva'
                ? <><Staplar niva={fylld(l)} /><span class={`mp-varde${l.negativ ? ' mp-negativ' : ''}`}>{l.ord}<span class="visually-hidden">, {l.niva} av 5</span></span></>
                : <span class="mp-inte">{l.ord}</span>}
            </summary>
            <p class="mp-skal">{forst && <strong>{forst}</strong>} <span set:html={skal(resten)} /></p>
          </details>
          {radenTotal && (
            <p class="mp-primar">
              <span>Primär evidens</span>
              {prim.length ? <span class="mp-omraden">{prim.map((o) => <span class="amne" data-amne={o}>{o}</span>)}</span> : <strong>Inget område med minst visst stöd</strong>}
            </p>
          )}
        </>
      );
    })}
    {infor.map((x) => (
      <details class="mp-rad">
        <summary><span class="mp-namn">{x.namn}</span><Staplar niva={x.niva} neutral /><span class="mp-varde">{x.ord[x.niva]}{'timmar' in x && x.timmar !== undefined && <span class="mp-timmar">, omkring {x.timmar} timmar</span>}<span class="visually-hidden">, {x.niva} av 5</span></span></summary>
        <p class="mp-skal" set:html={skal(`${x.motivering}${timmarna(x)}`)} />
      </details>
    ))}
    <details class="mp-rad mp-skalan">
      <summary><span class="mp-namn">Vad nivåerna betyder</span></summary>
      <div class="mp-skal">
        <p>Varje grön stapel svarar på en fråga: hur väl stöder forskningen att metoden förbättrar elevernas resultat i området? Nivån räknas ur hur tillförlitlig forskningen är och hur stor effekten är, och tillförlitligheten sätter taket. En stor effekt i få och små studier får därför högst 2.</p>
        <table class="mp-nivaer">
          <tbody>
            {[5, 4, 3, 2].map((n) => <tr><th scope="row"><Staplar niva={n} /></th><td>{NIVAORD[n]}</td></tr>)}
            <tr><th scope="row"><Staplar niva={0} /></th><td>Inget påvisat stöd: studier med jämförelsegrupp visar ingen effekt. Visar de en negativ effekt står Negativ effekt</td></tr>
            <tr><th scope="row"><span class="mp-inte">Oklart</span></th><td>Få och osäkra studier, utan effekt eller med en negativ</td></tr>
            <tr><th scope="row"><span class="mp-inte">Inte studerat</span></th><td>Ingen studie med jämförelsegrupp har mätt området. Vi vet inte, och det betyder inte att metoden saknar effekt</td></tr>
          </tbody>
        </table>
        <p set:html={skal(`${effektensSkala().text[1]} Ordet vid en nivå väger alla källor för området och hur säkra de är, så det kan skilja sig från en enskild källas ord i referensbladet.`)} />
        <p>Primär evidens är det eller de två av sajtens fyra områden, Läsning, Skrivning, Matematik och Socialt, där stödet är starkast, minst Visst stöd.</p>
        <p>De grå staplarna visar hur svårt och hur dyrt det är att införa metoden: Svårighet från Mycket lätt till Mycket svårt, Kostnad från Mycket låg till Mycket hög.</p>
        <p>Forskningen visar vad som ofta fungerar för många elever. Du avgör vad som fungerar i din klass.</p>
      </div>
    </details>
  </div>
)}
