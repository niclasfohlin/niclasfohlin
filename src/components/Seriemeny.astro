---
// Seriens meny överst på den generella metoden och på varje lektion (Ljudlek i grupp): översikten och lektionerna i
// bankens ordning, med numret på förmågan. På datorn en rad flikar, på telefonen en rad som fälls ut. Den sida läsaren
// är på är markerad; på telefonen står den i raden utan synlig etikett, så att raden ryms också i 320 punkter. Byggs ur
// lektionerna (src/lib/serie.ts), så att en ny lektion kommer med utan att något skrivs om.
import type { SerieKoppling } from '../lib/serie';
interface Props { koppling: SerieKoppling }
const { koppling } = Astro.props;
const { serie, lektion } = koppling;
const bas = '/stodundervisning';
const { ord } = serie;
const har = lektion ? (ord.numrerad ? `${lektion.formaga} · ${lektion.namn}` : lektion.namn) : ord.oversikt;
// Flikarna på datorn står i jämna rader, lika breda: omkring tre i bredd på en smalare skärm och fem på en bred. Antalet
// kolumner väljs så att raderna blir få och ingen flik står ensam på sista raden; en kolumn fler än målet får kosta lite
// (nio flikar blir tre gånger tre eller fem och fyra, sju blir fyra och tre, tio blir fyra, fyra och två; granskningen
// 2026-09-29).
const flikar = serie.lektioner.length + 1;
const kolumner = (mal: number) => {
  let bast = mal, poang = Infinity;
  for (let k = 2; k <= mal + 1; k++) {
    const rader = Math.ceil(flikar / k);
    const p = rader + (flikar % k === 1 && rader > 1 ? 10 : 0) + (k > mal ? 1.5 : 0);
    if (p < poang) { poang = p; bast = k; }
  }
  return bast;
};
---
<nav class="serie-meny" aria-label={`${serie.titel}: översikt och ${ord.flera}`}>
  <p class="serie-meny-namn">{serie.titel}</p>
  <ol class="serie-meny-flikar" style={`--kol-smal:${kolumner(3)};--kol-bred:${kolumner(5)}`}>
    <li><a href={`${bas}/${serie.id}`} aria-current={lektion ? undefined : 'page'}>Översikt</a></li>
    {serie.lektioner.map((l) => (
      <li><a href={`${bas}/${l.id}`} aria-current={lektion?.id === l.id ? 'page' : undefined}>{ord.numrerad && <span class="serie-nr" aria-hidden="true">{l.formaga}</span>}{l.namn}</a></li>
    ))}
  </ol>
  <details class="serie-meny-fall">
    <summary><span class="visually-hidden">{lektion ? ord.en.charAt(0).toLocaleUpperCase('sv') + ord.en.slice(1) : 'Du är på'}</span> {har}</summary>
    <ol>
      <li><a href={`${bas}/${serie.id}`} aria-current={lektion ? undefined : 'page'}>{ord.oversikt}</a></li>
      {serie.lektioner.map((l) => (
        <li><a href={`${bas}/${l.id}`} aria-current={lektion?.id === l.id ? 'page' : undefined}>{ord.numrerad && <span class="serie-nr" aria-hidden="true">{l.formaga}</span>}{l.namn}</a></li>
      ))}
    </ol>
  </details>
</nav>
