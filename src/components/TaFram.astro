---
// Ta fram ur en bank (src/lib/tafram.ts): sidan som väljer ur en metods bank efter nivå och tagg, som Ta fram ett
// matteproblem ([id]/problem.astro), Ta fram en lästext och Ta fram en faktatext ([id]/texter.astro). Gemensam för
// bankerna, så att de blir samma sida. Formen är den Niclas fick se 2026-10-18 (underlag/prov/verktyg/bilder/
// tafram-B-*.png), och en bank med teman, som faktatexterna, har dem mellan nivån och texterna (Niclas samma kväll:
// "Kanske nivå. Sedan tema. Sedan enskilda texterna"):
//
//   Valet      Nivåknapparna och, när taggarna delar nivån, taggarna (Niclas 2026-10-18: "en innehållstag likt brainbreaks
//              har"), var tagg i sin färg, skild från nivåernas (Niclas samma kväll: "Då syns de bättre på kortet och när
//              man ska välja"). Läraren bläddrar och väljer själv (Niclas samma kväll om knappen Ta fram ett, som tog fram
//              en post på måfå: "Man får bläddra bland dem och sortera sedan välja").
//   Temana     I en bank med teman står nivåns teman som rader i nivåns färg som fälls ut, som nivåerna i metodens bank,
//              ett öppet åt gången (Niclas 2026-10-18 natt: "Du ska kunna säg lägga in 3 nya teman och enkelt hitta ...
//              Mer struktur och mindre plottrigt helst. Och att nya teman enkelt kan läggas in"; formgivarnas förslag i
//              underlag/prov/verktyg/granskning/ide-*.md). Ett nytt tema i metodens fil blir en rad till. Temats rad har
//              temats texter som pdf och lärarhandledningen, och varje text sin struktur som tagg.
//   Raderna    Nivåns poster i ordning (metoden: "Börja med metodens tio problem på nivån, i ordning, ett per pass"), i
//              temana när banken har teman, var och en i TaFramRad.astro, och en liten bock som lägger posten i listan
//              att skriva ut, som på Ta fram en aktivitet. På sidorna med texter står bara texten (baraTexter).
//   Visa stort Posten och frågorna stort, utan klocka (Niclas: "Båda dessa ska ju inte ha klocka"), i problemets egen
//              form (Problemsida.astro), eller faktatexten i sin egen form (Faktatext.astro). Esc stänger. Knappen Lösningsförslag visar bladet (src/lib/losningsforslag.ts)
//              bredvid problemet på en bred skärm och under det i telefonen (Niclas 2026-10-18: "Synas brevid varandra
//              när man trycker på problemet i pc och under varandra i mobil?"), först när läraren trycker, eftersom
//              projektorn står inför eleverna. Utskriften är det som syns: problemet, eller problemet och lösningsförslaget.
//   Listan     Bredvid raderna på en bred skärm och i en rad längst ned i telefonen, som på Ta fram en aktivitet. Problemen
//              skrivs ut bara problemen eller med lösningsförslagen (Niclas samma dag: "problemets A4a och dess
//              lösningsförslag"), och texterna som texter. Sidan säger storleken innan.
//
// Utan JavaScript står alla nivåer under varandra med posternas sidor, nivåernas filer och temana utfällda. Bocken, som
// bara finns med JavaScript, ritas av skriptet i en kolumn som har sin bredd från början, så att sidan som Facebook
// hämtar okomprimerad är liten (scripts/cacheprov.mjs) och inget flyttar sig. Statistiken: utskrifterna som
// utskrift:<metod>/<led> och :med, Visa stort och Lösningsförslag som händelser (DRIFT.md under Besöksstatistik).
import Base from '../layouts/Base.astro';
import Delning from './Delning.astro';
import SkrivUtPdf from './SkrivUtPdf.astro';
import TaFramRad from './TaFramRad.astro';
import TillMetoden from './TillMetoden.astro';
import { UPPHOV, metodAdress } from '../lib/metod';
import { delningPa } from '../lib/delning';
import { kortdataAdress } from '../lib/kortdata';
import type { TaFram } from '../lib/tafram';
import { taFramDatafil } from '../lib/taframdata';
import { PABORDET_MATT } from '../lib/pabordet';
import { LOSNINGSSTEG } from '../lib/losningsforslag';
import { site } from '../data/site';
interface Props { t: TaFram }
const { t } = Astro.props;
const versal = (s: string) => s.charAt(0).toLocaleUpperCase('sv') + s.slice(1);
const mb = (byte: number) => `${(byte / 1048576).toLocaleString('sv-SE', { maximumFractionDigits: 1, minimumFractionDigits: 1 })} MB`;
const antal = t.poster.length;
const kortdata = kortdataAdress(t.adress, await taFramDatafil(t));
const adress = `${metodAdress(site.url, t.metod).replace(/^https?:\/\//, '')}/${t.led}`;
const kort = t.kort ? `${site.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}${t.kort}` : adress;
const BOCK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 12.5l3.7 3.7 7.3-8"/></svg>';
// Taggens färg ur designsystemet (klassen tagg-1 till tagg-7 i global.css).
const taggKlass = (id: string) => `tf-tagg tagg-${t.taggar.find((x) => x.id === id)?.farg ?? 1}`;
// Nivåns teman, eller nivåns poster: ett tema eller flera.
const teman = Math.max(0, ...t.nivaer.map((n) => n.teman?.length ?? 0));
// På sidorna med texter är ingressen kort, så att den första texten syns på telefonens första skärm (designgranskningen
// 2026-10-18 natt: ingressen var fem rader, och ingen text syntes): valet, taggen och bocken.
const borjan = t.baraTexter ? (teman ? 'Välj nivå och tema.' : 'Välj nivå.') : `Välj nivå, så ser du nivåns ${t.ord.flera} i ordning, eller Alla.`;
const bocken = t.baraTexter ? ` Bocken lägger ${t.ord.bestamd} i listan att skriva ut.` : ` Tryck på bocken på de ${t.ord.flera} du vill ha, så hamnar de i listan att skriva ut.`;
// Valet i sidans beskrivning: nivån och temat, nivån och taggen, eller bara nivån.
const valet = teman ? 'tema' : t.taggVal ? 'tagg' : '';
// Nivåns två filer: bara posterna och med följesidorna. På sidorna med texter står bara texterna.
const baraNamn = t.baraTexter ? t.ord.alla : `bara ${t.ord.alla}`;
const medNamn = `med ${t.folje}`;
// Ett problem, det; en text, den.
const den = t.ord.artikel === 'ett' ? 'det' : 'den';
// Temana per nivå, som skriptet före raderna läser.
const temaslugs = Object.fromEntries(t.nivaer.map((n) => [n.slug, (n.teman ?? []).map((x) => x.slug)]));
---

<Base title={`${t.namn}: ${t.titel}`} description={`Välj nivå${valet ? ` och ${valet}` : ''} bland ${antal} ${t.ord.flera} i ${t.titel}, se dem i ordning, visa ${t.ord.artikel} ${t.ord.en} stort och skriv ut dem du vill ha${t.baraTexter ? '' : `, med eller utan ${t.folje}`}.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class:list={['tafram', { 'tf-bara': t.baraTexter }]} data-metod={t.metod} data-titel={t.titel} data-led={t.led} data-kortdata={kortdata} data-en={t.ord.en} data-flera={t.ord.flera} data-alla={t.ord.alla} data-bestamd={t.ord.bestamd} data-folje={t.folje} data-folje-en={t.foljeEn} data-bara={t.baraTexter ? '' : undefined} data-taggval={t.taggVal ? '' : undefined}>
    <header class="sk-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${t.metod}`}>{t.titel}</a> · {t.namn}</p>
      <h1>{t.namn}</h1>
      <p class="ingress">{borjan}{t.taggar.length > 0 && t.taggText.ingress}{bocken}</p>
    </header>

    {/* Före raderna: nivån, taggen och temana ur adressen eller webbläsarens minne, så att sidan ritas med rätt nivå, rätt
        tema utfällt och med valet och listan från början, utan att något flyttar sig när sidans skript har laddats
        (Lighthouse: CLS). Temana står utfällda i sidan, för den som läser utan JavaScript, och de som ska stå stängda
        göms här med stil tills skriptet har stängt dem. Samma regler som i src/scripts/tafram.ts. */}
    <script is:inline define:vars={{ tfNyckel: `tafram:${t.metod}/${t.led}`, tfNivaer: t.nivaer.map((n) => n.slug), tfTaggar: t.taggVal ? t.taggar.map((x) => x.id) : [], tfTeman: temaslugs }}>
      (function () {
        var hash = location.hash.slice(1);
        try { hash = decodeURIComponent(hash); } catch (e) { /* en trasig adress */ }
        var delar = hash.split('/');
        var sparat = {};
        try { sparat = JSON.parse(localStorage.getItem(tfNyckel) || '{}') || {}; } catch (e) { /* utan lagring */ }
        var giltiga = ['alla'].concat(tfNivaer);
        var niva = giltiga.indexOf(delar[0]) >= 0 ? delar[0] : tfNivaer.filter(function (n) { return delar[0].indexOf(n + '-') === 0; })[0];
        // En post i adressen (#bas-3): dess nivå, och dess tema utfällt.
        var post = niva && delar[0] !== niva ? delar[0] : '';
        var andra = niva && delar[0] === niva ? delar[1] || '' : '';
        var tagg = niva ? andra : sparat.tagg || '';
        if (!niva) niva = giltiga.indexOf(sparat.niva) >= 0 ? sparat.niva : tfNivaer[0];
        if (tfTaggar.indexOf(tagg) < 0) tagg = '';
        var css = '.tf-val{display:flex!important}.tf-val>[data-js]{display:flex!important}.tf-valda{display:block!important}' + (niva === 'alla' ? '' : '.tf-niva:not([data-niva="' + niva + '"]){display:none}');
        if (tagg) css += '.tf-post:not([data-taggar~="' + tagg + '"]){display:none}.tf-tema:not(:has([data-taggar~="' + tagg + '"])){display:none}';
        // Temana: nivåns tema ur adressen, det läraren hade utfällt sist, eller nivåns enda tema; annars står alla stängda.
        var sparade = sparat.teman || {};
        for (var n in tfTeman) {
          var lista = tfTeman[n];
          if (!lista.length) continue;
          var vald = n === niva && lista.indexOf(andra) >= 0 ? andra : lista.length === 1 ? lista[0] : typeof sparade[n] === 'string' && (sparade[n] === '' || lista.indexOf(sparade[n]) >= 0) ? sparade[n] : '';
          // En post i adressen fäller ut sitt tema, när posten finns; annars gäller nivåns tema, som i sidans skript.
          var valt = vald ? ':not([data-tema="' + vald + '"])' : '';
          var stangda = post && n === niva
            ? ['.tf-niva[data-niva="' + n + '"]:has([id="' + post + '"]) .tf-tema:not(:has([id="' + post + '"]))', '.tf-niva[data-niva="' + n + '"]:not(:has([id="' + post + '"])) .tf-tema' + valt]
            : ['.tf-niva[data-niva="' + n + '"] .tf-tema' + valt];
          for (var i = 0; i < stangda.length; i++) css += stangda[i] + '>.tf-tema-innehall{display:none}' + stangda[i] + '>summary{border-bottom-color:transparent}' + stangda[i] + '>summary::after{transform:translateY(-0.15rem) rotate(45deg)}';
        }
        // Med Alla står nivåernas rubriker kvar, så att läraren ser var en nivå börjar.
        if (niva === 'alla') document.currentScript.parentElement.classList.add('tf-alla');
        var stil = document.createElement('style');
        stil.id = 'tf-tidig';
        stil.textContent = css;
        document.head.appendChild(stil);
        document.documentElement.classList.add('tf-js');
      })();
    </script>

    {/* Valet: nivåknapparna och taggarna, bara med JavaScript, och knappen Till metoden, som finns på alla verktygssidor
        och också utan JavaScript (TillMetoden.astro; Niclas 2026-10-19): på datorn till höger om nivåerna, i telefonen
        sist. På sidorna med texter står taggarna inte som val, och bredvid knappen till metoden står, när banken har en,
        en till lärarhandledningen (Niclas 2026-10-18 natt: "Knapp till metoden Textsamtal i grupp och knapp till
        Lärarhandledning"). Lärarens sidor och modellerna finns i metoden. Lärarhandledningen öppnar sin pdf, och temats rad likaså (Niclas 2026-10-19: "på
        verktygssidan ska det vara enkelt. Led till färdig pdf för dem"); sidorna där de står att läsa nås från metoden.
        Namnet i statistiken är detsamma som pdf-knappens på handledningens sida, så att trycken räknas ihop. */}
    <div class="sk-val tf-val">
      <div class="sk-valrad" role="group" aria-labelledby="tf-niva-etikett" data-js hidden>
        <span class="sk-etikett" id="tf-niva-etikett">Nivå</span>
        <div class="sk-nivaknappar">
          <button type="button" class="sk-niva tf-alla-knapp" data-niva="alla" aria-pressed="false">Alla</button>
          {t.nivaer.map((n) => <button type="button" class="sk-niva" data-niva={n.slug} style={`--niva:${n.farg}`} aria-pressed="false">{n.namn}</button>)}
        </div>
      </div>
      <TillMetoden metod={t.metod} titel={t.titel} verktyg={t.namn} handelse={`${t.led}:${t.metod}:metoden`}>
          {t.handledning && <a class="knapp sekundar" href={`/stodundervisning/${t.handledning}.pdf`} target="_blank" rel="noopener" data-goatcounter-click={`utskrift:${t.metod}/lararhandledning`} data-goatcounter-title={`${t.titel}: lärarhandledningen till ${t.ord.alla} som pdf`}>Lärarhandledning<span class="visually-hidden">, pdf</span></a>}
      </TillMetoden>
      {t.taggVal && (
        <div class="sk-valrad tf-taggrad" role="group" aria-labelledby="tf-tagg-etikett" data-js hidden>
          <span class="sk-etikett" id="tf-tagg-etikett">{t.taggText.etikett}</span>
          <div class="tf-taggar">
            <button type="button" class="tf-tagg tf-tagg-alla" data-tagg="" aria-pressed="true">Alla <span class="tf-tagg-antal" data-antal></span></button>
            {t.taggar.map((x) => <button type="button" class={taggKlass(x.id)} data-tagg={x.id} title={x.om} aria-pressed="false">{x.namn} <span class="tf-tagg-antal" data-antal></span></button>)}
          </div>
        </div>
      )}
    </div>

    <div class="tf-yta">
      <div class="tf-poster" id="tf-poster">
        {t.nivaer.map((n) => (
          <section class="tf-niva" data-niva={n.slug} data-nivanamn={n.namn} style={`--niva:${n.farg}`} aria-labelledby={`tf-niva-${n.slug}`}>
            <h2 class="tf-niva-rubrik" id={`tf-niva-${n.slug}`}>{n.namn}{!n.teman && <>{' '}<span class="tf-niva-antal">{n.poster.length} {t.ord.flera}</span></>}</h2>
            {n.teman ? (
              <div class="tf-teman">
                {n.teman.length > 1 && <p class="sk-etikett tf-teman-etikett">Teman på nivån {n.namn}</p>}
                {n.teman.map((tema) => (
                  <details class="tf-tema" data-tema={tema.slug} open>
                    <summary><h3 class="tf-tema-rubrik">{tema.namn}</h3> <span class="tf-tema-antal">{tema.poster.length} {t.ord.flera}</span></summary>
                    <div class="tf-tema-innehall">
                      <p class="tf-tema-knappar">
                        {tema.utskrift && <a class="knapp sekundar" href={tema.utskrift.adress} target="_blank" rel="noopener" data-skriv-ut-pdf data-sidor-hogst={String(6 * tema.poster.length)} data-goatcounter-click={`utskrift:${t.metod}/${t.led}/${tema.slug}`} data-goatcounter-title={`${t.titel}: ${tema.namn}, utskrift av temats ${t.ord.flera}`}><span data-direkt="Skriv ut temat">Temat som pdf</span><span class="visually-hidden">: {tema.namn}</span></a>}
                        {tema.handledning
                          ? <a class="knapp sekundar" href={`/stodundervisning/${tema.handledning}.pdf`} target="_blank" rel="noopener" data-goatcounter-click={`utskrift:${t.metod}/${tema.handledning.slice(t.metod.length + 1)}`} data-goatcounter-title={`${t.titel}: lärarhandledningen till ${tema.namn} som pdf`}>Lärarhandledning<span class="visually-hidden">: {tema.namn}, pdf</span></a>
                          : <a class="knapp sekundar" href={tema.adress}>Temats sida<span class="visually-hidden">: {tema.namn}</span></a>}
                      </p>
                      <ol class="tf-lista">{tema.poster.map((p) => <TaFramRad t={t} p={p} rubrik="h4" />)}</ol>
                    </div>
                  </details>
                ))}
              </div>
            ) : (
              <ol class="tf-lista">{n.poster.map((p) => <TaFramRad t={t} p={p} rubrik="h3" />)}</ol>
            )}
            {/* Hela nivån i en fil, som är billigare än nivåns poster var för sig (K-424). En nivå med ett tema har temats fil,
                som är samma sidor (designgranskningen 2026-10-18 natt: två knappar gjorde samma sak). */}
            {(n.teman?.length ?? 0) !== 1 && <p class="tf-nivafiler"><span class="tf-nivafiler-rubrik">Hela nivån {n.namn}:</span>{' '}
              <a href={n.filer.bara.adress} target="_blank" rel="noopener" data-goatcounter-click={`fil:${n.filer.bara.namn}.pdf`} data-goatcounter-title={`${t.titel}: ${n.namn}, ${baraNamn} som pdf`}>{baraNamn}{n.kartlaggning ? ' och kartläggningen' : ''}, pdf {mb(n.filer.bara.byte)}</a>
              {!t.baraTexter && n.filer.med && <>{' · '}<a href={n.filer.med.adress} target="_blank" rel="noopener" data-goatcounter-click={`fil:${n.filer.med.namn}.pdf`} data-goatcounter-title={`${t.titel}: ${n.namn}, ${t.ord.alla} med ${t.folje} som pdf`}>{medNamn}, pdf {mb(n.filer.med.byte)}</a></>}
            </p>}
          </section>
        ))}
        <p class="sk-tom tf-tom" id="tf-tom" hidden></p>
      </div>

      <aside class="ak-valda tf-valda" id="tf-valda" aria-labelledby="tf-valda-rubrik" data-oppen="false" data-js hidden>
        <button type="button" class="ak-valda-rad" id="tf-valda-rad" aria-expanded="false" aria-controls="tf-valda-innehall">
          <span>Att skriva ut</span> <span class="ak-valda-antal">0</span>
        </button>
        <div class="ak-valda-innehall" id="tf-valda-innehall">
          <h2 class="ak-valda-rubrik" id="tf-valda-rubrik" tabindex="-1">Att skriva ut <span class="ak-valda-antal">0</span></h2>
          <p class="ak-valda-tom" id="tf-valda-tom">Listan är tom. Tryck på bocken vid {t.ord.artikel} {t.ord.en}, så hamnar {den} här.</p>
          <ol class="ak-valda-lista" id="tf-valda-lista"></ol>
          <div class="sk-atgarder ak-valda-knappar">
            <a class="knapp" id="tf-skrivut" href="#" data-rakna={`utskrift:${t.metod}/${t.led}`} data-rakna-titel={`${t.titel}: utskrift av listans ${t.ord.flera}`}>Skriv ut {t.ord.alla}</a>
            {!t.baraTexter && <a class="knapp sekundar" id="tf-skrivut-med" href="#" data-rakna={`utskrift:${t.metod}/${t.led}:med`} data-rakna-titel={`${t.titel}: utskrift av listans ${t.ord.flera} med ${t.folje}`}>Skriv ut med {t.folje}</a>}
            <button type="button" class="knapp sekundar" id="tf-kopiera" hidden data-goatcounter-click={`${t.led}:${t.metod}:lank`} data-goatcounter-title={`${t.titel}: listans länk kopierad`}>Kopiera listans länk</button>
            <button type="button" class="knapp sekundar" id="tf-tomlista" hidden>Töm listan</button>
          </div>
          <p class="ak-valda-not tf-storlek" id="tf-storlek"></p>
          <p class="ak-valda-not" id="tf-valda-not" role="status"></p>
        </div>
      </aside>
    </div>

    {/* Visa stort: posten i problemets egen form (Problemsida.astro), ritad ur datafilen, och lösningsförslaget bredvid
        när läraren trycker på Lösningsförslag. */}
    <dialog class="tf-stort" id="tf-stort" aria-labelledby="tf-stort-titel">
      <div class="tf-stort-huvud">
        <p class="tf-stort-etikett" id="tf-stort-etikett"></p>
        {/* Bläddra bland posterna som syns, i radernas ordning, och i en bank med teman bland temats texter (K-434; Niclas
            2026-10-18 natt: "Man måste kunna se eller enkelt navigera så alla texter för temat syns"). */}
        <div class="tf-bladdra"><button type="button" id="tf-forra" aria-label={`Förra ${t.ord.en}`}>‹</button><button type="button" id="tf-nasta" aria-label={`Nästa ${t.ord.en}`}>›</button></div>
        <button type="button" class="tf-stang" id="tf-stang" aria-label="Stäng">×</button>
      </div>
      {/* Stegen på helskärm (src/lib/losningsforslag.ts, losningsstegHtml): problemet, A, B, A och B, och C. Pilarna och
          bläddrarens knappar byter steg. */}
      <nav class="tf-steg" id="tf-steg" aria-label="Visa" hidden>
        {LOSNINGSSTEG.map((namn, i) => <button type="button" data-steg={i} aria-current={i === 0 ? 'step' : undefined}>{namn}</button>)}
      </nav>
      <div class="tf-visning" id="tf-visning" hidden></div>
      <div class="tf-stort-sidor" id="tf-stort-sidor">
        <section class="boksida problemsida tf-stort-sida" id="tf-stort-sida">
          <div class="boksida-ram">
            <h2 class="boksida-titel" id="tf-stort-titel"></h2>
            <div class="problemsida-text" id="tf-stort-text"></div>
            <p class="problemsida-bild" id="tf-stort-bildrad"><img id="tf-stort-bild" alt="" width={PABORDET_MATT.bredd} height={PABORDET_MATT.hojd} /></p>
            <div class="problemsida-fraga" id="tf-stort-fraga"></div>
          </div>
        </section>
        {/* En faktatext i sin egen form, ritad i datafilen av Faktatext.astro (src/lib/taframdata.ts). */}
        <div class="tf-stort-fakta" id="tf-stort-fakta" hidden></div>
        <div class="tf-stort-lf" id="tf-stort-lf" tabindex="-1" hidden></div>
      </div>
      <div class="tf-stort-knappar">
        <button type="button" class="knapp sekundar tf-stort-bock" id="tf-stort-bock" aria-pressed="false"><span set:html={BOCK} /> <span id="tf-stort-bock-text">Lägg i listan</span></button>
        <button type="button" class="knapp sekundar" id="tf-stort-losning" aria-pressed="false" aria-controls="tf-stort-lf" hidden>Visa {t.foljeEn}</button>
        {/* Postens sida i metoden, och på sidorna med texter lärarens sida, den enda vägen dit från sidan. */}
        <a class="knapp sekundar" id="tf-stort-sidan" href="#">{t.baraTexter ? 'Lärarens sida' : `${versal(t.ord.bestamd)} i metoden`}</a>
        <a class="knapp sekundar" id="tf-stort-skrivut" href="#" target="_blank" rel="noopener" data-goatcounter-click={`utskrift:${t.metod}/${t.led}:ett`} data-goatcounter-title={`${t.titel}: utskrift av ${t.ord.artikel} ${t.ord.en}`}>Skriv ut {t.ord.bestamd}</a>
        {/* Ett problem utan lösningsförslag skrivs också ut med följesidan (designgranskningen 2026-10-18 natt). */}
        {!t.baraTexter && <a class="knapp sekundar" id="tf-stort-skrivut-med" href="#" target="_blank" rel="noopener" hidden data-goatcounter-click={`utskrift:${t.metod}/${t.led}:ett-med`} data-goatcounter-title={`${t.titel}: utskrift av ${t.ord.artikel} ${t.ord.en} med ${t.foljeEn}`}>Skriv ut med {t.foljeEn}</a>}
      </div>
    </dialog>

    <p class="upphov">{UPPHOV}. {versal(t.ord.alla)} i <a href={`/stodundervisning/${t.metod}`}>{t.titel}</a>: {antal} {t.ord.flera}, {t.nivaer.map((n) => `${n.poster.length} på nivån ${n.namn}`).join(', ')}.{t.taggar.length > 0 && t.taggText.kalla} Sidans korta adress är {kort}.</p>

    {delningPa && <Delning sida={t.adress} titel={`${t.namn}: ${t.titel}`} medKort />}
  </article>
</Base>

<SkrivUtPdf />

