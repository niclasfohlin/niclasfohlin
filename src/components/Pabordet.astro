---
// En bild På bordet (src/lib/pabordet.ts): rubriken, bilden i textens bredd och bildtexten, på skärmen och i
// utskriften. Efter en vecka (en del i en ram med lektioner) står bilden utan egen rubrik, och bildtexten börjar med
// På bordet, som i Word, där veckan och bilden står på samma sida. Bilden hämtas först när läsaren närmar sig den, och
// knappen Skriv ut väntar in den (data-utskriftsbild, Nedladdning.astro). Bilden har sina egna mått (b.matt), och den
// leder till svg-filen, så att den går att se stor i telefonen: en bild med en grupps post-it-lappar går inte att läsa i
// telefonbredd (riggens läsning 2026-10-13, och K-296).
// Ett blad (arBlad: rubriken börjar med "Blad: ", Faktatextsamtal i grupp 2026-10-13) står med sitt namn över bilden och
// leder till svg-filen, så att bladet går att se stort i telefonen. I utskriften är bladet en egen sida med bara bilden,
// liggande eller stående som i Word (arStaendeBlad), där bladets namn är ritat i bilden (global.css, .m-blad).
// Textalternativet är bildens rubrik och text, som i Word, och scripts/paritet.mjs prövar det.
import { arBlad, arIfylltBlad, arStaendeBlad, bildensAlt, bladNamn, iDel, type PaBordet } from '../lib/pabordet';
// utanRubrik: bladet står under sin egen rubrik på ramens sida ([id]/[enhet].astro), så namnet och ankaret står där.
interface Props { b: PaBordet; utanRubrik?: boolean }
const { b, utanRubrik = false } = Astro.props;
const vecka = iDel(b);
const blad = arBlad(b);
---
{blad ? (
  <figure class:list={['m-blad', { ifyllt: arIfylltBlad(b), staende: arStaendeBlad(b) }]} id={utanRubrik ? undefined : `blad-${b.bild.nr}`}>
    {!utanRubrik && <p class="m-blad-rubrik">{bladNamn(b)}</p>}
    <a href={b.adress} class="bild-lank" title="Öppna bladet i full storlek"><img src={b.adress} alt={bildensAlt(b)} width={b.matt.bredd} height={b.matt.hojd} loading="lazy" decoding="async" data-utskriftsbild /></a>
    <figcaption>{b.bild.text}</figcaption>
  </figure>
) : (
  <figure class={`m-pabordet${vecka ? ' i-del' : ''}`}>
    {!vecka && <p class="m-pabordet-rubrik">På bordet · {b.bild.rubrik}</p>}
    <a href={b.adress} class="bild-lank" title="Öppna bilden i full storlek"><img src={b.adress} alt={`På bordet: ${b.bild.rubrik}`} width={b.matt.bredd} height={b.matt.hojd} loading="lazy" decoding="async" data-utskriftsbild /></a>
    <figcaption>{vecka ? <><b>På bordet.</b>{' '}{b.bild.text}</> : b.bild.text}</figcaption>
  </figure>
)}
