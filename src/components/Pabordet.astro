---
// En bild På bordet (src/lib/pabordet.ts): rubriken, bilden i textens bredd och bildtexten, på skärmen och i
// utskriften. Efter en vecka (en del i en ram med lektioner) står bilden utan egen rubrik, och bildtexten börjar med
// På bordet, som i Word, där veckan och bilden står på samma sida. Bilden hämtas först när läsaren närmar sig den, och
// knappen Skriv ut väntar in den (data-utskriftsbild, Nedladdning.astro). Bilden har sina egna mått (b.matt), och den
// leder till svg-filen, så att den går att se stor i telefonen: en bild med en grupps post-it-lappar går inte att läsa i
// telefonbredd (riggens läsning 2026-10-13, och K-296).
// Ett blad (arBlad: rubriken börjar med "Blad: ", Faktatextsamtal i grupp 2026-10-13) står med sitt namn över bilden och
// leder till svg-filen, så att bladet går att se stort i telefonen. I utskriften är bladet en egen sida med bara bilden,
// liggande eller stående som i Word (arStaendeBlad), där bladets namn är ritat i bilden (global.css, .m-blad).
// Textalternativet är bildens rubrik och text, som i Word, och scripts/paritet.mjs prövar det.
// Ett blad med en egen fil (b.fil, egnaBlad i src/lib/bladmaterial.ts, K-476) har direkt under bilden en knapp som
// skriver ut bladets pdf, ur Word-filen med bara bladet, och filvalet med Word-filen, där bladets fält går att skriva i.
// Knappen står så nära bladet som möjligt, så att det syns vad den skriver ut (Niclas 2026-10-20), och bara på skärmen:
// Word-filerna och utskriften har den inte. Under det sista bladet i en ram med flera står en knapp till, som skriver
// ut alla ramens blad i en pdf (b.alla, bladgrupper), så att screeningens två sidor går att skriva ut dubbelsidigt; ett
// blad med två sidor har bara den knappen, under den sista sidan. Länken runt bilden har bladets namn som namn, så att en
// skärmläsare läser bladets text en gång, i bildtexten (granskningen i telefonbredd 2026-10-20). Knappen för Google
// Formulär står efter bildtexten (METODER.md under Bladet). En bild På bordet med eget textalternativ (alt, STIL.md under
// Bildtexter) har det som bildens alt, som i Word; utan alt står bildtexten under bilden, och alt är bara rubriken.
import { arBlad, arIfylltBlad, arStaendeBlad, bildensAlt, bildtextFel, bladNamn, iDel, type PaBordet } from '../lib/pabordet';
import Filval from './Filval.astro';
// utanRubrik: bladet står under sin egen rubrik på ramens sida ([id]/[enhet].astro), så namnet och ankaret står där.
interface Props { b: PaBordet; utanRubrik?: boolean }
const { b, utanRubrik = false } = Astro.props;
const vecka = iDel(b);
const blad = arBlad(b);
// Bildtexten står här, under bilden, och bygget stannar när den bryter mot regeln (bildtextFel, STIL.md under Bildtexter).
const bildtextensFel = bildtextFel(b);
if (bildtextensFel) throw new Error(bildtextensFel);
---
{blad ? (
  <figure class:list={['m-blad', { ifyllt: arIfylltBlad(b), staende: arStaendeBlad(b) }]} id={utanRubrik ? undefined : `blad-${b.bild.nr}`}>
    {!utanRubrik && <p class="m-blad-rubrik">{bladNamn(b)}</p>}
    <a href={b.adress} class="bild-lank" title="Öppna bladet i full storlek" aria-label={`Öppna bladet ${bladNamn(b)} i full storlek`}><img src={b.adress} alt={bildensAlt(b)} width={b.matt.bredd} height={b.matt.hojd} loading="lazy" decoding="async" data-utskriftsbild /></a>
    {b.fil && (
      <p class="m-blad-filer">
        <a class="knapp sekundar liten" href={`/stodundervisning/${b.fil.namn}.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande={arStaendeBlad(b) ? undefined : ''} data-sidor-hogst="1" data-goatcounter-click={`utskrift:${b.fil.namn}`} data-goatcounter-title={`${b.fil.statistik}, bladet`}><span data-direkt="Skriv ut bladet">Bladet som pdf</span><span class="visually-hidden">: {b.fil.titel}</span></a>
        <Filval fil={`/stodundervisning/${b.fil.namn}`} namn={b.fil.namn} rubrik={`Bladet ${b.fil.titel}`} statistik={b.fil.statistik} liten />
      </p>
    )}
    {b.alla && (
      <p class="m-blad-filer">
        <a class="knapp sekundar liten" href={`/stodundervisning/${b.alla.namn}.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande={b.alla.liggande ? '' : undefined} data-sidor-hogst={b.alla.antal} data-goatcounter-click={`utskrift:${b.alla.namn}`} data-goatcounter-title={`${b.alla.statistik}, ${b.alla.text.replace('Skriv ut ', '')}`}><span data-direkt={b.alla.text}>{b.alla.pdftext}</span><span class="visually-hidden">: {b.alla.titel}</span></a>
        <Filval fil={`/stodundervisning/${b.alla.namn}`} namn={b.alla.namn} rubrik={b.alla.titel} statistik={b.alla.statistik} liten />
      </p>
    )}
    <figcaption>{b.bild.text}</figcaption>
    {/* Vad formuläret är, före knappen (verifieringen 2026-10-26: ordet formuläret stod först på knappen). */}
    {b.bild.google && (
      <div class="m-blad-google">
        <p>Formuläret är bladet {bladNamn(b)} på skärmen, som eleverna fyller i på telefonen eller datorn. Knappen gör en kopia i din Google Drive, med ett kalkylark som sammanställer svaren, och svaren hamnar bara i din kopia.</p>
        <p><a class="knapp sekundar" href={b.bild.google} target="_blank" rel="noopener" data-goatcounter-click={`google:${b.bild.google.slice(1)}`} data-goatcounter-title={`${bladNamn(b)}: kopiera formuläret och sammanställningen i Google`}>Kopiera formuläret och sammanställningen</a></p>
      </div>
    )}
  </figure>
) : (
  <figure class={`m-pabordet${vecka ? ' i-del' : ''}`}>
    {!vecka && <p class="m-pabordet-rubrik">På bordet · {b.bild.rubrik}</p>}
    <a href={b.adress} class="bild-lank" title="Öppna bilden i full storlek"><img src={b.adress} alt={b.bild.alt ? bildensAlt(b) : `På bordet: ${b.bild.rubrik}`} width={b.matt.bredd} height={b.matt.hojd} loading="lazy" decoding="async" data-utskriftsbild /></a>
    <figcaption>{vecka ? <><b>På bordet.</b>{' '}{b.bild.text}</> : b.bild.text}</figcaption>
  </figure>
)}
