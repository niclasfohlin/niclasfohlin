---
// En post på en Ta fram-sida (TaFram.astro): nivåns färg, bilden när posten har en, numret, titeln, postens rad,
// taggarna i sina färger och Visa stort. Bocken ritas av skriptet (src/scripts/tafram.ts). Rubriken är h3 under nivån,
// och h4 när posten står i ett tema. Raden är så kort den kan vara, eftersom sidan växer med varje post och Facebook
// hämtar den okomprimerad (scripts/cacheprov.mjs): skriptet läser numret och titeln ur rubriken och taggarnas id ur
// data-taggar, i chipens ordning, och knapparnas namn står i aria-label.
//
// Ta fram ett matteproblem har lösningsförslaget och problemets sida i metoden vid posten (Niclas 2026-10-18: "utan att
// missa att de finns"). På sidorna med texter står bara texten (TaFram.baraTexter; Niclas 2026-10-18 natt: "Funderar på
// om denna sida med texter bara ska ha texterna"): titeln leder till textens sida, som skriptet öppnar i Visa stort, och
// lärarens sida nås därifrån (data-larare). En text i ett tema har sitt nummer i temat (temaNr).
import type { TaFram, TaFramPost } from '../lib/tafram';
import { PABORDET_MATT } from '../lib/pabordet';
// Ett blad i Metoder som är problemet i en metods form, som Fyrfältaren Borden i Tänkande klassrum (K-761; Niclas 2026-11-14:
// "Integrera den i verktyget problem på något smidigt sätt?"): en länk med bladets namn efter I metoden, till bladets sida,
// så kort som raden tillåter (scripts/cacheprov.mjs).
interface Props { t: TaFram; p: TaFramPost; rubrik: 'h3' | 'h4'; iMetoder?: Map<string, { adress: string; slag: string; metod: string }[]> }
const { t, p, rubrik: Rubrik, iMetoder } = Astro.props;
const bladen = iMetoder?.get(`${t.adress}#${p.id}`) ?? [];
// Taggens färg ur designsystemet (klassen tagg-1 till tagg-7 i global.css).
const taggKlass = (id: string) => `tf-radtagg tagg-${t.taggar.find((x) => x.id === id)?.farg ?? 1}`;
const taggNamn = (id: string) => t.taggar.find((x) => x.id === id)?.namn ?? id;
const bild = !t.baraTexter && p.bildFil;
---
<li class={bild ? 'tf-post' : 'tf-post utan-bild'} id={p.id} data-taggar={p.taggIds.join(' ')} data-tema={p.tema} data-lf={p.losningsforslag ? '' : undefined} data-fakta={p.fakta ? '' : undefined} data-larare={t.baraTexter ? p.losning : undefined}>
  {bild && <img class="tf-bild" src={p.bildFil} alt="" width={p.bildMatt?.bredd ?? PABORDET_MATT.bredd} height={p.bildMatt?.hojd ?? PABORDET_MATT.hojd} loading="lazy" decoding="async" />}
  <div class="tf-text">
    <Rubrik class="tf-titel"><span class="tf-nr">{p.temaNr ?? p.nr}</span> {t.baraTexter && p.sida ? <a class="tf-titellank" href={p.textAdress ?? p.sida}>{p.titel}</a> : p.titel}</Rubrik>
    <p class="tf-rad">{p.rad}</p>
    <p class="tf-lankar">
      <button type="button" class="tf-visa" aria-label={`Visa stort: ${p.titel}`}>Visa stort</button>
      {!t.baraTexter && p.losning && <a class="tf-losning" href={p.losning} aria-label={`${t.losningNamn}: ${p.titel}`} data-goatcounter-click={p.sida ? undefined : `${t.led}:${t.metod}:losningsforslag`} data-goatcounter-title={p.sida ? undefined : `${t.titel}: Lösningsförslag i Visa stort`}>{t.losningNamn}</a>}
      {!t.baraTexter && p.sida && <a class="tf-sidlank" href={p.sida} aria-label={`${p.titel} i metoden`}>I metoden</a>}
      {bladen.map((b) => <a class="tf-sidlank" href={b.adress} aria-label={`${b.slag} ${p.titel}`} data-goatcounter-click={`bankblad:${p.id}`}>{b.slag}</a>)}
      {p.taggIds.length > 0 && <span class="tf-radtaggar">{p.taggIds.map((id) => <span class={taggKlass(id)}>{taggNamn(id)}</span>)}</span>}
    </p>
  </div>
</li>
