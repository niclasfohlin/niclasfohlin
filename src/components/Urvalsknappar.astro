---
// Knapparna i rutan nederst för de valda metoderna, en rot för båda bankerna, Stödundervisning och Metoder (Niclas
// 2026-10-31: "Varför har inte Metoder skicka till drive som stödundervisning?"; 2026-10-10: samma knapp betyder samma sak på
// varje sida): Word, som laddar ner, och Drive, som sparar i läsarens Google Drive, i den ordningen och med filvalets ikoner,
// och Rensa. Drive finns bara när site.driveKlientId är satt (DRIFT.md), som i Filval.astro. Vad knapparna ger står i bankens
// sida: Stödundervisning bygger en Word-fil med de valda metoderna, och Metoder ger varje vald metods Word-fil med allt, en
// fil eller flera i en zip, och Drive sparar varje metod som eget dokument. Trycken, rutan och Drive står i src/scripts/
// urval.ts (urvalet och driveIUrvalet), och Metoders Word byter namn efter antalet (data-samla-namn).
import { site } from '../data/site';
interface Props {
  /** Bankens namn i besöksstatistiken: "Metodbanken" i Stödundervisning, "Metoder" i Metoder (DRIFT.md under Besöksstatistik). */
  bank: string;
  /** Filens namn i statistiken, utan ändelse: fil:<namn>.docx och fil:drive:<namn>.docx. */
  handelse: string;
  /** Word-knappens titel, som säger vad den ger. */
  wordTitel: string;
}
const { bank, handelse, wordTitel } = Astro.props;
const drive = Boolean(site.driveKlientId);
---
<span class="samla-knappar">
  <span class="filval" role="group" aria-label={`Valda metoder: ladda ner${drive ? ' eller spara' : ''}`}>
    <button type="submit" disabled title={wordTitel} data-goatcounter-click={`fil:${handelse}.docx`} data-goatcounter-title={`${bank}: valda metoder som Word`}>
      <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M5 2h7l4 4v12H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 2v4h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M6.5 9.5l1.4 6 1.6-4.5 1.6 4.5 1.4-6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-samla-namn>Word</span><span class="visually-hidden">: ladda ner de valda metoderna</span>
    </button>
    {drive && (
      <button type="button" class="drive-knapp" data-drive-valda disabled title="Spara de valda metoderna i din Google Drive" data-goatcounter-click={`fil:drive:${handelse}.docx`} data-goatcounter-title={`${bank}: valda metoder till Google Drive`}>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M7 3h6l5 9-3 5H5l-3-5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 3l4 9M13 3l-4 9h9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        Drive<span class="visually-hidden">: spara de valda metoderna i Google Drive</span>
      </button>
    )}
  </span>
  <button type="button" class="lank" data-rensa hidden>Rensa</button>
</span>

{/* Googles skript hämtas när läsaren pekar på Drive (src/scripts/drive.ts), också på en sida utan filval. */}
{drive && <script>import '../scripts/drive';</script>}
