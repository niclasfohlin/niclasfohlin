---
// En ifylld lektionsplanering i undervisningsmetodens planeringsmall (K-621; riggens standard, avsnitt 11): huvudet,
// Före lektionen med stegen och felet, lektionens delar, beslutet med utfallens gränser för klassens antal och, i
// huvudexemplet, Efter lektionen. Formen är mallens tre zoner, och etiketterna kommer ur metodens planeringsmall, så att
// bladet på sidan och det tomma bladet säger samma sak. Med `variant` har delarna variantens minuter, som första
// lektionens (granskningen 2026-10-30: förlagan till lektion 1 visade 40-minutersschemats tider). Riggens Word-fil ritar
// samma blad med blocket planeringsblad. Det läraren skrev går genom medSaker, så att metodens saker är länkar också här.
import { UTFALLEN } from '../lib/standard/index.js';
import { BLADETS_ORD as O, bladetsLista, bladetsRad, medSaker, planeringsbladet, utfalletsGrans, type Um } from '../lib/undervisningsmetod';
import type { MetodSak } from '../lib/metodsaker';
// eslint-disable-next-line @typescript-eslint/no-explicit-any
interface Props { d: Um; plan: Record<string, any>; amne?: string; gra?: boolean; variant?: string; saker?: MetodSak[] }
const { d, plan, amne, gra = false, variant, saker = [] } = Astro.props;
// Bladets regler (variantens minuter, utfallens texter, planens delar och Efter lektionens etiketter) står i
// planeringsbladet i src/lib/undervisningsmetod.ts, som lathundens PowerPoint-fil och pdf ritar samma blad ur.
const { mall, varianten, variantensNamn, delensTid, utfalletsText, delarna, planensDel, kryss, etikett, beslutetsFas, karnansNr } = planeringsbladet(d, plan, variant);
const lista = bladetsLista;
const bryt = bladetsRad;
// Det läraren skrev, med metodens saker som länkar.
const k = (t: unknown) => medSaker(String(t ?? ''), saker, new Set());
---
<div class={`um-blad${gra ? ' um-blad-gra' : ''}`}>
  <dl class="um-blad-huvud">
    <div><dt>{O.klass}</dt><dd>{plan.klass}</dd></div>
    {amne && <div><dt>{O.amne}</dt><dd>{amne}</dd></div>}
    <div><dt>{O.datum}</dt><dd>{plan.datum}</dd></div>
    <div><dt>{O.lektion}</dt><dd>{plan.lektion}</dd></div>
    <div class="bred"><dt>{O.mal}</dt><dd set:html={k(plan.mal)} /></div>
    <div class="bred"><dt>{O.belagg}</dt><dd set:html={k(plan.belagg)} /></div>
  </dl>
  <p class="um-blad-zon">{O.fore}</p>
  <div class="um-blad-fore">
    {(mall.fore ?? []).map((ruta: { etikett: string; rader?: string[]; falt?: string | string[]; fot?: string; fotFalt?: string }) => (
      <div class="um-blad-ruta">
        <p class="um-blad-etikett">{ruta.etikett}</p>
        {typeof ruta.falt === 'string'
          ? <ol>{lista(plan.fore?.[ruta.falt]).filter(Boolean).map((s) => <li set:html={k(s)} />)}</ol>
          : <dl class="um-blad-rader">{(ruta.rader ?? []).map((r, i) => <div><dt>{r.replace(/:$/, '')}</dt><dd set:html={k(plan.fore?.[(ruta.falt as string[] | undefined)?.[i] ?? ''] ?? '')} /></div>)}</dl>}
        {ruta.fot && <p class="um-blad-fot"><span>{ruta.fot}</span>{' '}<Fragment set:html={ruta.fotFalt ? k(plan.fore?.[ruta.fotFalt]) : ''} /></p>}
      </div>
    ))}
    <div class="um-blad-ruta">
      <p class="um-blad-etikett">{O.forberett}</p>
      <dl class="um-blad-rader"><div><dt>{O.blad}</dt><dd set:html={k(plan.blad)} /></div><div><dt>{O.stod}</dt><dd set:html={k(plan.forberett)} /></div></dl>
    </div>
  </div>
  <p class="um-blad-zon">{O.lektionen}{varianten && <span class="um-blad-zon-not">{` · ${O.minuterna} ${variantensNamn}`}</span>}</p>
  <table class="um-blad-lektion">
    <tbody>
      {delarna.map((del) => {
        const text = planensDel(del.fas);
        return (
          <>
            <tr>
              <th scope="row"><span class="um-blad-fas">{del.fas}</span><span class="um-blad-tid">{delensTid(del.fas)}{karnansNr(del.fas) && ` · ${karnansNr(del.fas)}`}</span></th>
              <td>{del.skriv && <span class="um-blad-skriv">{bryt(del.skriv)}</span>}{text && <span class="um-blad-text" set:html={k(text)} />}{!text && del.not && <span class="um-blad-skriv">{del.not}</span>}</td>
            </tr>
            {del.fas === beslutetsFas && plan.beslut && (
              <tr class="um-blad-beslut">
                <th scope="row"><span class="um-blad-fas">{O.beslutet}</span><span class="um-blad-tid">{`${O.elever} ${plan.beslut.elever}`}</span></th>
                <td>
                  <div class="um-utfall um-utfall-litet">
                    {UTFALLEN.map((u) => (
                      <div class={`um-utfall-ruta um-utfall-${u.id}`}>
                        <p class="um-utfall-namn">{u.namn}</p>
                        <p class="um-utfall-grans">{utfalletsGrans(u.id, plan.beslut.elever)} {utfalletsText(u.id)}</p>
                        {lista(mall.beslut?.[u.id]).map((etikett, j) => <p class="um-blad-skriv">{etikett} <span class="um-blad-text" set:html={k(lista(plan.beslut[u.id])[j] ?? '')} /></p>)}
                      </div>
                    ))}
                  </div>
                </td>
              </tr>
            )}
          </>
        );
      })}
    </tbody>
  </table>
  {plan.efter && (
    <>
      <p class="um-blad-zon">{O.efter}</p>
      <dl class="um-blad-efter">
        <div><dt>{etikett('kontrollen', 'Kontrollen')}</dt><dd set:html={k(plan.efter.kontrollen)} /></div>
        <div><dt>{etikett('hogar', 'Exit-lapparna', true)}</dt><dd set:html={k(plan.efter.hogar)} /></div>
        <div class="bred"><dt>{etikett('sag', 'Det jag såg')}</dt><dd set:html={k(plan.efter.sag)} /></div>
        <div class="bred um-blad-kryss"><dt>{O.karnanIlektionen}</dt><dd>{(d.karna?.komponenter ?? []).map((k: { kryss: string }, i: number) => <span class={kryss.has(i + 1) ? 'pa' : ''}><span aria-hidden="true">{kryss.has(i + 1) ? '☒' : '☐'}</span> {i + 1} {k.kryss.replace(/\.$/, '')}<span class="visually-hidden">{kryss.has(i + 1) ? ', kryssad' : ', inte kryssad'}</span></span>)}</dd></div>
        <div><dt>{etikett('nasta', 'Nästa lektion: två snabba')}</dt><dd set:html={k(plan.efter.nasta)} /></div>
        <div><dt>{etikett('forst', 'Jag går först till')}</dt><dd set:html={k(plan.efter.forst)} /></div>
      </dl>
    </>
  )}
  {lista(plan.lagg).map((s) => <p class="um-blad-lagg" set:html={k(s)} />)}
</div>
