---
// Filvalet vid en nedladdning: samma fil som Word, i Google Drive och, för lathunden, som pdf.
// En grupp små knappar med ikon och ord, så att valet syns utan att ta plats. Används överallt
// där en Word-fil erbjuds (metodsidan, lathunden, metodbankens kort), så att nya metoder får
// samma val automatiskt. Drive-knappen finns bara när site.driveKlientId är satt (DRIFT.md).
import { site } from '../data/site';
interface Props {
  /** Adressen utan filändelse, t.ex. /stodundervisning/problemlosning-i-grupp-lathund */
  fil: string;
  /** Filnamnet utan ändelse, t.ex. problemlosning-i-grupp-lathund */
  namn: string;
  /** Vad filen innehåller, för skärmläsare: "Lathunden", "Allt om metoden" */
  rubrik: string;
  /** Finns filen också som pdf (lathunden, liggande fyra sidor)? */
  pdf?: boolean;
  liten?: boolean;
}
const { fil, namn, rubrik, pdf = false, liten = false } = Astro.props;
const drive = Boolean(site.driveKlientId);
---
<span class:list={['filval', { liten }]} role="group" aria-label={`${rubrik}: ladda ner eller spara`}>
  <a href={`${fil}.docx`} download={`${namn}.docx`} title="Ladda ner som Word-fil">
    <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M5 2h7l4 4v12H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 2v4h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M6.5 9.5l1.4 6 1.6-4.5 1.6 4.5 1.4-6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Word<span class="visually-hidden">: {rubrik}</span>
  </a>
  {drive && (
    <button type="button" class="drive-knapp" data-drive-src={`${fil}.docx`} data-drive-namn={`${namn}.docx`} title="Spara i din Google Drive">
      <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M7 3h6l5 9-3 5H5l-3-5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 3l4 9M13 3l-4 9h9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      Drive<span class="visually-hidden">: spara {rubrik.toLowerCase()} i Google Drive</span>
    </button>
  )}
  {pdf && (
    <a href={`${fil}.pdf`} download={`${namn}.pdf`} title="Ladda ner som pdf, liggande">
      <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M5 2h7l4 4v12H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 2v4h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7.5 15v-5h1.6a1.5 1.5 0 0 1 0 3H7.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Pdf<span class="visually-hidden">: {rubrik}</span>
    </a>
  )}
</span>

{drive && <script>import '../scripts/drive';</script>}
