---
// Knappen som öppnar nedladdade planer, en form för planens sidor (PlanFilen.astro) och för bankerna och appens sida
// (PlanernasKnappar.astro): filfältet tar en zip, en fil eller flera filer, och i knappen, under dess namn, står filernas slag
// i liten svagare text (PLANFILERNAS_SLAG; Niclas 2026-10-31: "Tänk på en rot. Därför så viktigt för att inte få drift på
// modulen", och 2026-11-01: ".zip och .json kan väl vara i knappen så knapparna blir lika stora"). Sidans skript binder
// fältet med id eller med data-alla-oppna.
import { PLANFILERNAS_SLAG } from '../lib/standard/index.js';

interface Props {
  /** Knappens text, Öppna en nedladdad plan eller Öppna planer. */
  text: string;
  /** Filfältets id på planens sidor; utan id får fältet data-alla-oppna, som bankerna och appens sida. */
  id?: string;
  /** Statistikens namn och titel för trycket. */
  goat: string;
  goatTitel: string;
}
const { text, id, goat, goatTitel } = Astro.props;
---
<label class="knapp sekundar liten pl-filknapp" data-goatcounter-click={goat} data-goatcounter-title={goatTitel}><span>{text}</span><span class="pl-filslag">{PLANFILERNAS_SLAG}</span><input type="file" id={id} data-alla-oppna={id ? undefined : ''} accept=".json,.zip,application/json,application/zip" multiple class="visually-hidden" /></label>
