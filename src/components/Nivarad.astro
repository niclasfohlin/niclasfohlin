---
// En nivå i materialet (src/lib/nivamaterial.ts): en rad i nivåns färg som fälls ut, med nivåns ramar i, som nivån i en
// bank (Bank.astro, samma stilar, .bank-niva i global.css). I utskriften står nivån utfälld, utan raden.
// Har nivån fler än en ram står länkar till dem överst i den utfällda nivån (Om nivån · Böckerna): i telefonen ligger
// listan annars flera skärmar ned, efter sidan om nivån.
// Sist i nivån står nivåns filer, Pdf och Word (Nivafiler.astro), som i en bank.
import Nivafiler from './Nivafiler.astro';
import type { Nivamaterial, Nivarad } from '../lib/nivamaterial';
interface Props { rad: Nivarad; nm: Nivamaterial; id: string; titel: string }
const { rad, nm, id, titel } = Astro.props;
const enhet = nm.enhet;
---
<details class="bank-niva" id={`niva-${rad.slug}`} style={`--niva: #${rad.niva.farg}`} data-niva>
  <summary>
    <span class="bank-nivanamn">{rad.niva.namn}</span>
    {rad.antal > 0 && <span class="bank-antal">{rad.antal}{enhet ? ` ${enhet}` : ''}</span>}
  </summary>
  <div class="bank-innehall">
    {rad.lankar.length > 1 && <p class="bank-nivalankar">{rad.lankar.map((l, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={`#ram-${l.ri + 1}`}>{l.namn}<span class="visually-hidden">, {rad.niva.namn}</span></a></>)}</p>}
    <slot />
    <div class="bank-filer"><Nivafiler id={id} titel={titel} nm={nm} niva={rad} /></div>
  </div>
</details>

<script>
  // I utskriften står alla nivåer utfällda, som i Word-filen med allt, och efteråt som läsaren hade dem.
  const nivaer = [...document.querySelectorAll<HTMLDetailsElement>('details[data-niva]')];
  let oppna: boolean[] = [];
  window.addEventListener('beforeprint', () => { oppna = nivaer.map((x) => x.open); for (const x of nivaer) x.open = true; });
  window.addEventListener('afterprint', () => { nivaer.forEach((x, i) => { x.open = oppna[i] ?? x.open; }); });
  // En länk till nivån eller till något i den (#niva-bas, #ram-2) fäller ut nivån och visar målet.
  const visa = () => {
    const mal = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const x = mal?.closest('details[data-niva]');
    if (x instanceof HTMLDetailsElement && !x.open) { x.open = true; mal!.scrollIntoView(); }
  };
  visa();
  window.addEventListener('hashchange', visa);
  // Samma länk en gång till, efter att läsaren har stängt nivån, ändrar inte adressen: då prövas klicket (granskningen 2026-10-12).
  document.addEventListener('click', (e) => { if (e.target instanceof Element && e.target.closest('a[href^="#"]')) setTimeout(visa, 0); });
</script>
