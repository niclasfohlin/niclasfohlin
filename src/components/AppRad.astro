---
// Erbjudandet om appen Metodbanken på appens sida, /app (K-505, K-644; Niclas 2026-10-30: "Går man till /app utan appen
// installerad dyker den upp där som förslag om man inte tryckt på krysset (kommer upp igen efter 30 dagar)"). Raden är gömd
// tills src/scripts/appen.ts har sett att den passar: aldrig i appen själv. I Chrome och Android visar knappen webbläsarens egen
// fråga, på iPhone och iPad tre steg, eftersom Safari inte kan installera med en knapp, och i en apps egen webbläsare vägen ut
// till Safari eller webbläsaren. Texten under rubriken byts av skriptet.
import { appikonSvg } from '../lib/appikon';
import { APPEN } from '../lib/appen';
---

<section class="app-rad" id="lagg-till" data-app aria-label={`Appen ${APPEN.namn}`} hidden>
  <span class="app-ikon" aria-hidden="true" set:html={appikonSvg()} />
  <div class="app-text">
    <p class="app-rubrik">Lägg appen på hemskärmen</p>
    <p class="app-om" data-app-om>Stöd, Metoder och dina planer, ett tryck bort.</p>
  </div>
  <button type="button" class="knapp liten app-knapp" data-app-knapp data-goatcounter-click="app:installera" data-goatcounter-title={`Appen ${APPEN.namn}: knappen på /app`}>Installera</button>
  <a class="knapp liten app-knapp" data-app-ut hidden data-goatcounter-click="app:ut" data-goatcounter-title={`Appen ${APPEN.namn}: ut ur en apps webbläsare på /app`}></a>
  <button type="button" class="app-stang" data-app-stang aria-label="Stäng förslaget om appen">×</button>
  <div class="app-steg" data-app-steg hidden>
    <ol>
      <li>Tryck på Dela <svg class="app-dela" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M6 11H5v10h14V11h-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>, fyrkanten med en pil uppåt. I nyare iPhone ligger den under knappen med tre prickar.</li>
      <li>Välj Lägg till på hemskärmen. Syns det inte, rulla ned i listan.</li>
      <li>Tryck på Lägg till.</li>
    </ol>
    <p class="app-not" data-app-not hidden></p>
  </div>
</section>

<script>
  import '../scripts/appen';
</script>
