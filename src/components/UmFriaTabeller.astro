---
// Fria tabeller i en undervisningsmetod på sin plats (fältet plats): efter-inledning sist i del 1, efter Lärarens roll, som
// tanken bakom greppen i Formativ bedömning, och efter-progression efter veckorna där läraren planerar dem, som
// samarbetsfärdigheterna (riggens leverans 2026-11-01, K-671). Samma tabell och form som en fri tabell i stödundervisning
// (FriTabell.astro).
import MetodTabell from './MetodTabell.astro';
import { friTabellensKlass } from '../lib/metod';
type Tabell = { plats?: string; rubrik: string; text?: string; kolumner: string[]; rader: string[][]; not?: string };
interface Props { tabeller?: Tabell[]; plats: string; k: (t: string) => string }
const { tabeller = [], plats, k } = Astro.props;
---
{tabeller.filter((t) => t.plats === plats).map((t) => (
  <div class="um-fritabell">
    <h4>{t.rubrik}</h4>
    {t.text && <p set:html={k(t.text)} />}
    <MetodTabell kolumner={t.kolumner} rader={t.rader} klass={friTabellensKlass(t)} radrubrik={false} />
    {t.not && <p class="um-not" set:html={k(t.not)} />}
  </div>
))}
