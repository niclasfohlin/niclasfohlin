---
// Listan Att skriva ut i verktygen Strukturer (K-650) och Strategier (Niclas 2026-11-04: "Jag vill att strategier verktyget
// har samma funktion som strukturer. Att man kan skapa en lista och skriva ut dem"), på verktygets sida och på varje korts sida:
// på en bred skärm en spalt som följer med, i telefonen en rad längst ned som fäller ut listan, som på Ta fram en aktivitet
// (klasserna ak-valda i global.css). Skriptet src/scripts/kortlistan.ts fyller den och skriver ut korten två och två på A4.
// En komponent och ett skript för båda verktygen; verktyget säger var korten och orden kommer ifrån.
import { strukturerna, kortetsAdressMedVersion, SLAGEN, TVA_PA_A4 } from '../lib/strukturer';
import { strategierna, kortetsAdress as strategikortetsAdress, kortensVersion as strategikortensVersion, kortetFinns } from '../lib/strategier';
import { STRATEGIERNAS_FARG } from '../lib/standard/index.js';

interface Props { verktyg: 'strukturer' | 'strategier' }
const { verktyg } = Astro.props;
const farg = Object.fromEntries(SLAGEN.map((s) => [s.slag, s.farg]));
const data = verktyg === 'strukturer'
  ? Object.fromEntries((await strukturerna()).map((s) => [s.id, { namn: s.data.namn, farg: farg[s.data.slag], kort: kortetsAdressMedVersion(s.id) }]))
  : Object.fromEntries((await strategierna()).filter(kortetFinns).map((s) => [s.id, { namn: s.data.namn, farg: STRATEGIERNAS_FARG.farg, kort: strategikortensVersion(strategikortetsAdress(s.id)) }]));
// Orden som skiljer verktygen åt: kortets namn i utskriftens titel och statistiken, och vems kort bocken sitter på.
const ORD = {
  strukturer: { kort: 'Strukturkort', kortet: 'strukturkortet', vems: 'en strukturs', verktyget: 'Strukturer' },
  strategier: { kort: 'Strategikort', kortet: 'strategikortet', vems: 'en strategis', verktyget: 'Strategier' },
}[verktyg];
---

<aside class="ak-valda st-valda" id="st-valda" aria-labelledby="st-valda-rubrik" data-oppen="false" data-verktyg={verktyg} data-ord={JSON.stringify(ORD)} data-korten={JSON.stringify(data)}>
  <button type="button" class="ak-valda-rad" id="st-valda-rad" aria-expanded="false" aria-controls="st-valda-innehall">
    <span>Att skriva ut</span> <span class="ak-valda-antal st-valda-antal">0</span>
  </button>
  <div class="ak-valda-innehall" id="st-valda-innehall">
    <h2 class="ak-valda-rubrik" id="st-valda-rubrik" tabindex="-1">Att skriva ut <span class="ak-valda-antal st-valda-antal">0</span></h2>
    <p class="ak-valda-tom" id="st-valda-tom">Listan är tom. Tryck på bocken på {ORD.vems} kort eller på Lägg i Att skriva ut på dess sida, så hamnar den här.</p>
    <ol class="ak-valda-lista" id="st-valda-lista"></ol>
    <div class="sk-atgarder ak-valda-knappar">
      <a class="knapp" id="st-skrivut-valda" href="#" aria-disabled="true">Skriv ut listan</a>
      <button type="button" class="knapp sekundar" id="st-kopiera" data-goatcounter-click={`${verktyg}:lank`} data-goatcounter-title={`${ORD.verktyget}: listans länk kopierad`} hidden>Kopiera listans länk</button>
      <button type="button" class="knapp sekundar" id="st-tom" hidden>Töm listan</button>
    </div>
    <p class="st-utskriftsrad">{TVA_PA_A4}</p>
    <p class="ak-valda-not" id="st-valda-not" role="status"></p>
  </div>
</aside>

<script>
  import '../scripts/kortlistan';
</script>
