---
// Det sajten väver in på en plats i metoden (src/lib/vav.ts): kortraden med delarnas små kort och en rad till verktyget,
// eller rutan med verktygets text, korten och knappen. Bara på skärmen: metodens fil är densamma utan den, och Word-filen och
// pdf:en har en enkel rad på platsen när metoden har verktygets knapp i början (vavIWord i src/lib/vav.ts, vavBarn i metoddocx.ts).
import Centralknapp from './Centralknapp.astro';
import { vavensEtikett, type Vav } from '../lib/vav';
import { radenTillVerktyget } from '../lib/centrala';
// sist är den sista rutan på platsen. Raden till verktyget står där, och inte när verktygets knapp står i början av metoden
// (radenTillVerktyget i src/lib/centrala.ts, K-708).
interface Props { v: Vav; titel: string; sist?: boolean }
const { v, titel, sist = true } = Astro.props;
const c = v.vav;
const i = c.vav!.rad.lastIndexOf(c.namn);
const [fore, efter] = [c.vav!.rad.slice(0, i), c.vav!.rad.slice(i + c.namn.length)];
const etikett = vavensEtikett(v);
---
<aside class:list={['vav', `vav-${v.form}`]} aria-label={etikett}>
  <p class="vav-etikett">{etikett}</p>
  {v.form === 'ruta' && <p class="vav-text">{c.vav!.text}</p>}
  {v.delar.length > 0 && (
    <ul class="st-kort-lista vav-kort">
      {v.delar.map((x) => (
        <li>
          <a class="st-kort" href={x.adress} style={x.stil}>
            {x.bild && <img src={x.bild.src} alt="" width={x.bild.bredd} height={x.bild.hojd} loading="lazy" decoding="async" />}
            {x.bilder && <span class="sg-tre" aria-hidden="true">{x.bilder.map((b) => (b ? <img src={b} alt="" width="500" height="500" loading="lazy" decoding="async" /> : <span class="sg-bild-tom">Bild</span>))}</span>}
            <span class="st-kort-text"><span class="st-kort-namn">{x.namn}</span><span class="st-kort-rad">{x.rad}</span></span>
            {x.nr !== undefined && <span class="sg-nr"><span class="visually-hidden">Strategi </span>{x.nr}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
  {!v.knappenFinns && (v.form === 'ruta'
    ? <p class="m-central-knapp"><Centralknapp c={c} metod={v.metod} titel={titel} /></p>
    : radenTillVerktyget(v, { sidan: true, sist }) && <p class="vav-rad">{fore}<a href={c.adress}>{c.namn}</a>{efter}</p>)}
</aside>
