---
// Listan med lärarens planer (K-489, K-628, K-644): Dina insatser i Stödundervisning och Dina planer i Metoder, på bankerna och
// på appens sida, en form för båda samlingarna och alla tre sidorna (Niclas 2026-10-30: "på app sidan listas också alla ens
// insatser under Stödundervisning som är pågående och kommande samt avslutade likt på stödundervisning sida och samma listade
// under Metoder"). Planerna ritas ur webbläsaren av src/scripts/insatser.ts, med orden ur SAMLINGENS_ORD. Utan JavaScript och
// utan planer syns listan bara på appens sida, där raden tom säger var planerna görs, och på en bank som raden om planer i
// en fil med Öppna planer, utan listans rubrik. På en bank står knapparna Ladda
// ner planer och Öppna planer under listan, för bankens samling; på appens sida står de en gång under båda listorna, för
// planerna i båda samlingarna (knappar={false}, src/components/PlanernasKnappar.astro), som när en plan flyttas från Safari
// till appen i iPhone.
import { PLANERNA_I_EN_FIL, SAMLINGENS_ORD, type Samling } from '../scripts/insatser-lagring';
import PlanernasKnappar from './PlanernasKnappar.astro';

interface Props {
  samling: Samling;
  /** Bankens sida eller appens sida, i statistikens namn. */
  plats: 'bank' | 'app';
  id?: string;
  /** Knapparna Ladda ner planer och Öppna planer under listan; appens sida har dem en gång för båda listorna. */
  knappar?: boolean;
}
const { samling, plats, id = 'pl-insatser', knappar = true } = Astro.props;
const ord = SAMLINGENS_ORD[samling];
---

<section class="pl-insatser" id={id} data-samling={samling} data-plats={plats} aria-labelledby={`${id}-rubrik`} hidden>
  <h2 id={`${id}-rubrik`}>{ord.listan}</h2>
  {plats === 'app' && <p class="pl-tom" data-tom hidden>{ord.tom} <a href={ord.bank.adress}>{ord.bank.namn}</a>.</p>}
  {plats === 'bank' && <p class="pl-tom" data-tom-bank hidden>{PLANERNA_I_EN_FIL}</p>}
  <ul></ul>
  <div class="pl-avslutade" hidden></div>
  {/* Alla planer som en zip, och planer in ur en zip eller flera filer, med samma rot som i metoden (insatser-lagring.ts). */}
  {knappar && <PlanernasKnappar samling={samling} plats={plats} listan={ord.listan} />}
</section>
