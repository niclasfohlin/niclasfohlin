---
// Planera insatsen (K-489): sidan /stodundervisning/<id>/planera. Valen och planens ram står i sidan; planen, veckan och
// knapparnas verkan räknas och ritas av src/scripts/planera.ts med standardens planmotor (src/lib/standard/plan.js) ur
// metodens fält (src/lib/insatsplan.ts). Filernas knappar (snabbmallen, lektionskorten, lathunden) står gömda i sidan, så
// att bygget sätter filernas version på dem och utskriftsknapparnas skript binder dem; veckan flyttar in dem.
//
// Ordningen är telefonens (granskningarna av Codex och Opus 2026-10-24): veckan överst när planen är sparad, sedan planen
// med målet och knapparna, valen, veckorna, sammanställningen och planen på en annan dator. Ett förslag har planen överst,
// med Spara planen, och valen öppna under. På en bred skärm står planen i en spalt till höger om veckan.
import Base from '../layouts/Base.astro';
import SkrivUtPdf from './SkrivUtPdf.astro';
import Lektionskortknapp from './Lektionskortknapp.astro';
import { periodensLangd, PLANERA, tidensMatt, tolkaSteg } from '../lib/standard/index.js';
import { site } from '../data/site';
import type { PlanData } from '../lib/insatsplan';
import type { Lektionskort } from '../lib/lektionskort';

interface Props { data: PlanData; lektionskort: Lektionskort[]; antal: number; snabbmall?: { rubrik: string; period: string } }
const { data, lektionskort, antal, snabbmall } = Astro.props;
// Raden om modulen längst ned: namnet och versionen, att den är en beta, och mejlet till Niclas med metoden och versionen i
// ämnet (Niclas 2026-10-24: "skicka mail till mig om något inte funkar").
const mejl = `mailto:${site.epost}?subject=${encodeURIComponent(`${PLANERA.namn} ${PLANERA.version}: ${data.titel}`)}`;
const period = periodensLangd(data.period)!;
const matt = tidensMatt(data.tid ?? '');
// Längderna att välja: metodens spann (högst tio knappar), eller för en period utan slut den kortaste och två längre.
const langder = period.max
  ? Array.from({ length: Math.min(period.max, period.min + 9) - period.min + 1 }, (_, i) => period.min + i)
  : period.mer ? [period.min, period.min + 4, period.min + 8] : [period.min];
const minuter = matt.minst !== undefined && matt.minuter !== undefined && matt.minst !== matt.minuter ? [matt.minst, matt.minuter] : [];
const DAGAR = ['Mån', 'Tis', 'Ons', 'Tor', 'Fre'];
const DAGNAMN = ['måndag', 'tisdag', 'onsdag', 'torsdag', 'fredag'];
const liten = (s?: string) => (s ? s.charAt(0).toLocaleLowerCase('sv') + s.slice(1) : '');
const json = JSON.stringify(data).replace(/</g, '\\u003c');
// Nivåerna: bankens, eller metodens egna i en kurs i nivåer (De fyra räknesätten).
const nivaer = data.bank?.nivaer ?? data.nivaer ?? [];
// En stege, som läslistorna, kan börja högre upp: progressionens steg utom det som kommer efter insatsen.
const stegen = data.stege ? (data.progression?.rader ?? []).flatMap((r) => { const s = tolkaSteg(r.vecka); return s && !s.efter ? [{ fran: s.fran, namn: r.kort }] : []; }) : [];
---

<Base title={`Planera insatsen: ${data.titel}`} description={`Planera ${data.titel}: välj när ni träffas, så räknar planen fram passen, veckornas fokus och uppföljningen ur metoden.`}>
  <article class="plan" id="plan" data-metod={data.id}>
    <header class="pl-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={data.sida}>{data.titel}</a> · Planera</p>
      <h1>Planera insatsen{PLANERA.beta && <>{' '}<span class="beta">Beta</span></>}</h1>
      <p class="ingress">Välj när ni träffas. Planen räknar fram passen och uppföljningen ur metoden, och varje vecka visar vad ni gör och var materialet finns.</p>
      <noscript><p class="pl-utan-js">Planen räknas fram i webbläsaren och behöver JavaScript. Metoden står på <a href={data.sida}>metodens sida</a>.</p></noscript>
    </header>

    <nav class="pl-grupper" id="pl-grupper" aria-label="Dina planer för metoden" hidden></nav>
    <p class="pl-besked" id="pl-besked" role="status" hidden></p>

    <div class="pl-yta">
      <section class="pl-veckan" id="pl-veckan" aria-labelledby="pl-veckan-rubrik" hidden></section>

      <section class="pl-planen" id="pl-planen" aria-labelledby="pl-planen-rubrik">
        <div class="pl-summa" id="pl-summa">
          <h2 id="pl-planen-rubrik" tabindex="-1">Planen</h2>
          <div id="pl-summa-text"></div>
          <div class="pl-knappar">
            <button type="button" class="knapp" id="pl-spara" data-goatcounter-click={`planera:${data.id}:spara`} data-goatcounter-title={`${data.titel}: planen sparad`}>Spara planen</button>
            <button type="button" class="knapp sekundar" id="pl-kalender" data-goatcounter-click={`planera:${data.id}:kalender`} data-goatcounter-title={`${data.titel}: kalenderfilen hämtad`}>Lägg i kalendern</button>
          </div>
          <p class="pl-sparad" id="pl-sparad"></p>
        </div>

        {/* Texten till åtgärdsprogrammet, att kopiera när planen är klar (Niclas 2026-10-24: "textruta för text till ÅP"). Rutan
            är ungefär halva texten hög och rullar: den visar att texten finns, och knappen kopierar hela. */}
        <section class="pl-ap" id="pl-ap" aria-labelledby="pl-ap-rubrik" hidden>
          <h3 id="pl-ap-rubrik">Text till åtgärdsprogrammet</h3>
          <p class="pl-hjalp">Klistra in texten under Åtgärder, och skriv till det som gäller eleven.</p>
          <textarea class="pl-falt pl-textfalt pl-aptext" id="pl-aptext" readonly rows="8" aria-labelledby="pl-ap-rubrik"></textarea>
          <p class="pl-andra-knappar"><button type="button" class="knapp" id="pl-dokumentation" data-goatcounter-click={`planera:${data.id}:dokumentation`} data-goatcounter-title={`${data.titel}: texten till åtgärdsprogrammet kopierad`}>Kopiera texten</button></p>
        </section>


        <ol class="pl-veckor" id="pl-veckor"></ol>

        <details class="pl-andra" id="pl-andra" open>
          <summary>Ändra planen</summary>
          <form class="pl-val" id="pl-val" aria-labelledby="pl-val-rubrik">
            <h2 id="pl-val-rubrik">När ni träffas</h2>
            <p class="pl-hjalp pl-varning" id="pl-bockvarning" hidden>Du har bockat pass eller skattat. Ändras datumet eller dagarna står det kvar på sina datum, och det som hamnar utanför planen syns igen när du ändrar tillbaka. Du kan ångra direkt efteråt.</p>
            <div class="pl-rad">
              <label class="pl-etikett" for="pl-start">Från och med</label>
              <input class="pl-falt" type="date" id="pl-start" required />
              <p class="pl-hjalp" id="pl-forsta-pass"></p>
            </div>
            <fieldset class="pl-rad">
              <legend class="pl-etikett">Lov</legend>
              <div class="pl-lovveckor" id="pl-lovveckor"></div>
              <p class="pl-hjalp">Tryck på veckorna som är lov, så hoppar planen över dem.</p>
            </fieldset>
            <fieldset class="pl-rad">
              <legend class="pl-etikett">Dagar</legend>
              <div class="pl-dagar" id="pl-dagar">
                {DAGAR.map((d, i) => <button type="button" data-dag={i + 1} aria-pressed="false" aria-label={DAGNAMN[i]}>{d}</button>)}
              </div>
              {data.tid && <p class="pl-hjalp">Metoden: {liten(data.tid)}.</p>}
              <p class="pl-hjalp pl-varning" id="pl-dagar-varning" hidden></p>
            </fieldset>
            <fieldset class="pl-rad pl-tider" id="pl-tider">
              <legend class="pl-etikett">Tid, om du vill</legend>
              <div class="pl-tidrad" id="pl-tid-alla">
                <label class="pl-tidval"><span>Börjar</span><select class="pl-falt pl-tid" id="pl-tid-fran"></select></label>
                <label class="pl-tidval"><span>Slutar</span><select class="pl-falt pl-tid" id="pl-tid-till"></select></label>
              </div>
              <div class="pl-tiddagar" id="pl-tid-dagar" hidden></div>
              <p><button type="button" class="pl-textknapp" id="pl-tid-olika" aria-expanded="false" aria-controls="pl-tid-dagar">Olika tider olika dagar</button></p>
              <p class="pl-hjalp">Klockslagen går var femte minut. Med tid blir varje pass en egen händelse i kalendern.</p>
            </fieldset>
            {stegen.length > 1 && (
              <div class="pl-rad">
                <label class="pl-etikett" for="pl-borja">Börja på</label>
                <select class="pl-falt" id="pl-borja">
                  {stegen.map((s) => <option value={s.fran}>{s.namn}</option>)}
                </select>
                <p class="pl-hjalp">Börja där gruppen är, efter läsningen före. Planen tar sedan ett steg i veckan.</p>
                <p class="pl-hjalp pl-varning" id="pl-borja-not" hidden>Du har bockat pass eller skattat, så planen börjar där den började. Gör en ny plan för att börja på ett annat steg.</p>
              </div>
            )}
            <fieldset class="pl-rad">
              <legend class="pl-etikett">Antal {period.enhet === 'pass' ? 'pass' : 'veckor'}</legend>
              <div class="sk-segment pl-langd" id="pl-langd">
                {langder.map((n) => <button type="button" class="sk-antal" data-langd={n} aria-pressed="false">{n}</button>)}
              </div>
              {data.period && <p class="pl-hjalp">Metoden: {liten(data.period)}.{period.enhet === 'veckor' && ' Lovveckor hoppas över, och pass på röda dagar faller bort.'}</p>}
            </fieldset>
            {minuter.length > 0 && (
              <fieldset class="pl-rad">
                <legend class="pl-etikett">Passets längd</legend>
                <div class="sk-segment" id="pl-minuter">
                  {minuter.map((n) => <button type="button" class="sk-antal" data-minuter={n} aria-pressed="false">{n} min</button>)}
                </div>
              </fieldset>
            )}
            {nivaer.length > 0 && (
              <fieldset class="pl-rad">
                <legend class="pl-etikett">Nivå</legend>
                <div class="sk-nivaknappar pl-nivaer" id="pl-nivaer">
                  {nivaer.map((n) => <button type="button" class="sk-niva" data-niva={n.slug} style={`--niva:${n.farg}`} aria-pressed="false">{n.namn}</button>)}
                </div>
                <p class="pl-hjalp">{data.bank ? `Nivån styr vilka ${data.bank.flera} veckan visar.` : data.nivaTabell ? 'Nivån styr veckans tal och blad.' : 'Nivån står i planen.'} Tryck en gång till för att ta bort den.</p>
              </fieldset>
            )}
            <div class="pl-rad">
              <label class="pl-etikett" for="pl-namn">Gruppens namn, om du vill</label>
              <input class="pl-falt" type="text" id="pl-namn" maxlength="40" autocomplete="off" />
              <p class="pl-hjalp">Skriv inte elevernas namn här. Gruppens namn står i planen, i kalendern och i dina utskrifter, men aldrig i länken.</p>
            </div>
            <fieldset class="pl-rad pl-foljval">
              <legend class="pl-etikett">Följ insatsen</legend>
              <label class="pl-kryss"><input type="checkbox" id="pl-folj" data-goatcounter-click={`planera:${data.id}:folj`} data-goatcounter-title={`${data.titel}: Följ insatsen valt`} /> <span>Följ insatsen vecka för vecka</span></label>
              <p class="pl-hjalp">Bocka passen och skatta eleverna mot målet en gång i veckan. Inget måste fyllas i. Det du för in sparas bara i den här webbläsaren, och en kopia som fil tar det till en annan dator.</p>
              <div class="pl-elevruta" id="pl-elevruta" hidden>
                <label class="pl-etikett" for="pl-elever">Eleverna, en per rad, om du vill</label>
                <textarea class="pl-falt pl-textfalt" id="pl-elever" rows="4" maxlength="400" autocomplete="off" spellcheck="false"></textarea>
                <p class="pl-hjalp">Förnamn eller initialer, högst tolv elever. Namnen finns bara i den här webbläsaren och i kopian du sparar. Utan elevlista skattar du gruppen.</p>
                {data.gruppen && <p class="pl-hjalp">Metoden: {liten(data.grupp?.text ?? '')}{data.grupp ? '. ' : ''}<a href={data.gruppen.adress} data-goatcounter-click={`planera:${data.id}:gruppen`} data-goatcounter-title={`${data.titel}: gruppen från planen`}>{data.gruppen.rubrik}</a></p>}
                <p class="pl-hjalp pl-varning" id="pl-elever-not" role="status" hidden></p>
                <label class="pl-kryss pl-narvaroval"><input type="checkbox" id="pl-narvaro" /> <span>Notera närvaro i passen</span></label>
                <p><button type="button" class="pl-textknapp" id="pl-elever-bort" hidden>Ta bort elevernas namn och det som förts in om dem</button></p>
              </div>
            </fieldset>
          </form>
        </details>
      </section>

      <section class="pl-samman" id="pl-samman" aria-labelledby="pl-samman-rubrik" hidden></section>

      <section class="pl-kopia" id="pl-kopia" aria-labelledby="pl-kopia-rubrik">
        <h2 id="pl-kopia-rubrik">Planen på en annan dator eller telefon</h2>
        <p class="pl-hjalp" id="pl-kopia-text"></p>
        <p class="pl-andra-knappar">
          <button type="button" class="knapp sekundar liten" id="pl-lank" data-goatcounter-click={`planera:${data.id}:lank`} data-goatcounter-title={`${data.titel}: länken till planen kopierad`}>Kopiera länken</button>
          <button type="button" class="knapp sekundar liten" id="pl-kopia-spara" data-goatcounter-click={`planera:${data.id}:kopia`} data-goatcounter-title={`${data.titel}: en kopia av planen sparad`}>Spara en kopia</button>
          <label class="knapp sekundar liten pl-filknapp" data-goatcounter-click={`planera:${data.id}:oppna-kopia`} data-goatcounter-title={`${data.titel}: en kopia av planen öppnad`}>Öppna en kopia<input type="file" id="pl-kopia-fil" accept=".json,application/json" class="visually-hidden" /></label>
        </p>
        <p class="pl-ta-bort"><button type="button" class="pl-textknapp" id="pl-ta-bort" hidden>Ta bort planen</button></p>
      </section>
    </div>

    <footer class="pl-version">
      <p class="pl-version-namn">{PLANERA.beta && <span class="beta">Beta</span>}{' '}{PLANERA.namn} {PLANERA.version}</p>
      <p>{PLANERA.namn} är modulen som räknar fram planen ur metoden och följer insatsen. {PLANERA.beta ? `Den är ny och prövas på ${antal === 1 ? 'en metod' : `${antal} metoder`}, så allt är inte prövat i skolan än. ` : ''}Fungerar något inte, mejla mig, så rättar jag det: <a href={mejl} data-goatcounter-click={`planera:${data.id}:mejl`} data-goatcounter-title={`${data.titel}: mejl om Planera`}>{site.epost}</a>.</p>
    </footer>

    <div class="pl-filer" id="pl-filer" hidden>
      {snabbmall && <a class="knapp sekundar" data-fil="snabbmall" href={`/stodundervisning/${data.id}-snabbmall.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf data-sidor-hogst="1" data-goatcounter-click={`utskrift:${data.id}-snabbmall`} data-goatcounter-title={`${data.titel}: ${snabbmall.rubrik}, bladet`}><span data-direkt="Skriv ut snabbmallen">Snabbmallen som pdf</span></a>}
      {lektionskort.map((k, i) => <span class="pl-fil" data-fil={`lektionskort-${i + 1}`}><Lektionskortknapp k={k} titel={data.titel} klass="knapp sekundar" /></span>)}
      {data.harLathund && <a class="knapp sekundar" data-fil="lathund" href={`${data.sida}/lathund`}>Öppna lathunden</a>}
    </div>
    <div class="pl-toast" id="pl-toast" role="status" aria-live="polite" hidden></div>
    <script type="application/json" id="pl-data" is:inline set:html={json} />
  </article>
  <SkrivUtPdf />
</Base>

<script>
  import '../scripts/planera.ts';
</script>
