---
// Knapparna till en undervisningsmetods filer (K-621), i samma form som Stödundervisning, så att samma sak ser likadan ut
// överallt (Niclas 2026-10-30: knapparna "saknar symbolen från sajten för pdf och word"). Flera filer står som rader med
// namnet och filvalet med ikoner (Filval.astro: Drive, Pdf och Word), som nedladdningsrutan på en metodsida. En fil under
// sitt blad har knappen som skriver ut bladet, direkt under det (Niclas 2026-10-20: "Ha den så nära bladet du ska skriva
// ut som möjligt"), och Drive och Word bredvid. Knappen skriver ut pdf:en i Chromium på datorn och öppnar den annars
// (SkrivUtPdf.astro). Bara filer som finns får en knapp (src/lib/undervisningsmetodfiler.ts).
import Filval from './Filval.astro';
import SkrivUtPdf from './SkrivUtPdf.astro';
import type { UmFil, UmSlag } from '../lib/undervisningsmetodfiler';
interface Props { id: string; filer: Record<string, UmFil | undefined>; slag: UmSlag[]; stor?: boolean; titel?: string }
const { id, filer, slag, stor = false, titel = id } = Astro.props;
const valda = slag.map((s) => filer[s]).filter((f): f is UmFil => !!f);
const bas = (f: UmFil) => (f.pdf ?? f.docx ?? '').replace(/\.(pdf|docx)$/, '');
const namn = (f: UmFil) => bas(f).split('/').pop() ?? id;
const kort = (f: UmFil) => f.namn.split(',')[0];
const iMening = (f: UmFil) => kort(f).charAt(0).toLocaleLowerCase('sv') + kort(f).slice(1);
---
{valda.length > 1 ? (
  <ul class="filrader um-filrader">
    {valda.map((f) => <li><span class="filrubrik">{f.namn}</span> <Filval fil={bas(f)} namn={namn(f)} rubrik={f.namn} statistik={`${titel}: ${iMening(f)}`} pdf={!!f.pdf} pdfTitel="Ladda ner som pdf" /></li>)}
  </ul>
) : valda.length === 1 && (
  <p class="um-filknappar">
    {valda[0].pdf && <a class={stor ? 'knapp' : 'knapp sekundar liten'} href={valda[0].pdf} target="_blank" rel="noopener" data-skriv-ut-pdf data-direkt={`Skriv ut ${iMening(valda[0])}`} data-goatcounter-click={`utskrift:${namn(valda[0])}`} data-goatcounter-title={`${titel}: ${iMening(valda[0])}, utskrift`}>{kort(valda[0])} som pdf</a>}
    {valda[0].docx && <Filval fil={bas(valda[0])} namn={namn(valda[0])} rubrik={valda[0].namn} statistik={`${titel}: ${iMening(valda[0])}`} liten />}
  </p>
)}
<SkrivUtPdf />
