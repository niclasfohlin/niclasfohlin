---
// En undervisningsmetod på sin sida (K-621): de fyra delarna och de två bilagorna i lärarens väg, i samma ordning som
// Word-filen (riggens standard, avsnitt 4, och UNDERVISNINGSMETODENS_DELAR i standarden). Formen är idéförslagens form 2,
// Läsvägen öppen (underlag/prov/metoder/ide/): det läraren läser före första lektionen står öppet, och det som slås upp
// står som rader som fälls ut. Varje sak står en gång, i sitt hem, med en knapp under som skriver ut den, och varje text går
// genom medSaker, så att metodens saker är länkar där de nämns och hänvisningarna till källorna leder till sin post i
// referensbladet (STIL.md under Hänvisningar). Allt läses ur metodens fil, så att nästa metod får samma sida.
import Planeringsblad from './Planeringsblad.astro';
import Film from './Film.astro';
import Filmbilder from './Filmbilder.astro';
import { stor, UTFALLEN, MED_DIG_PA_VAGEN, forstaLektionensMinuter } from '../lib/standard/index.js';
import { metodensDelar, medSaker, KALLGRUPPER, OMRADESORD, SLAGORD, effektensDelar, kallansLank, karnanI, tidsschematsRad, exempletsAmne, bladetsAnkare, utfallensElever, utfallensTal, UTFALLENS_REGEL, UM_NAMN, METODKORTET, type Um } from '../lib/undervisningsmetod';
import type { MetodFilm } from '../lib/film';
import type { MetodSak } from '../lib/metodsaker';
import { metodensBlad, type UmBild, type UmFil } from '../lib/undervisningsmetodfiler';
import Umfilknappar from './Umfilknappar.astro';
interface Props { d: Um; id: string; extrafilmer: MetodFilm[]; filer: Record<string, UmFil | undefined>; bilder: Record<string, UmBild[]>; sidor?: { titel: string; href: string }[]; saker: MetodSak[] }
const { d, id, extrafilmer, filer, bilder, sidor = [], saker } = Astro.props;
const kallor = new Set<string>((d.kallor ?? []).map((k: { id: string }) => k.id));
// Varje text som HTML: metodens saker och källorna som länkar (medSaker), och en replik inom citattecken på egen rad.
const k = (t: string) => medSaker(t, saker, kallor, sidor);
const replik = (t: string, ar: (f: string) => boolean = () => true) => k(t).replace(/”([^”]+)”/g, (m: string, f: string) => (ar(f) ? `<q class="um-replik">${f}</q>` : m));
const ankareFor = (namn: string) => `nar-${namn.toLocaleLowerCase('sv').replace(/[åä]/g, 'a').replace(/ö/g, 'o').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
// Arbetslaget och besöken i tidsordning, i rutan Med dig på vägen: standardens lista, som lathunden också läser.
const MED_DIG = MED_DIG_PA_VAGEN;
// Delradens namn i telefonen, där den aktiva delen visar sitt namn.
const KORTA: Record<string, string> = { 'att-skriva-ut': 'Skriv ut', valet: 'Forskningen' };
// Kärnans fyra kort har rubriken som cellen i del 1 leder till (design-3 nr 18).
const KARNANS_FYRA = 'Kärnans fyra';
// Delarnas celler under bandet: avsnitten som länkar, i formspråket C. Bara avsnitt som metoden har.
const CELLER: Record<string, [string, string, unknown][]> = {
  metoden: [['det-har-ar', `Det här är ${d.titel.toLocaleLowerCase('sv')}`, true], ['i-korthet', KARNANS_FYRA, d.karna], ['lararens-roll', 'Lärarens roll', d.roll]],
  'kom-igang': [['fore-forsta', 'Före första lektionen', d.checklista], ['planera-lektionen', 'Planera lektionen', d.amnesexempel?.some((e: { plan?: unknown }) => e.plan)], ['forsta-lektionen', 'Första lektionen', d.forsta], ['de-forsta-veckorna', 'De första veckorna', d.progression], ['efter-de-forsta-veckorna', 'Efter de första veckorna', true], ['till-arbetslaget', 'Till arbetslaget', d.uppdrag]],
  'hall-i': [['karnan', 'Kärnan: fast och fritt', d.karna], ['lararens-fragor', 'Lärarens frågor', d.lararensFragor], ['nar-det-glider', 'När det glider', true]],
  'att-skriva-ut': [['materialet', UM_NAMN.lektionskort, true], ['materialet-for-klassen', d.ramar?.rubrik ?? UM_NAMN.materialet, d.ramar], ['planeringsmallen', UM_NAMN.planeringsmall, d.planeringsmall], ['observationsmallen', UM_NAMN.observation, d.observation]],
  valet: [],
};
const celler = (did: string) => (CELLER[did] ?? []).filter(([, , finns]) => !!finns);
const delar = metodensDelar(d);
const del = (did: string) => delar.find((x) => x.id === did)!;
const komp = (d.karna?.komponenter ?? []) as { namn: string; moment?: string[]; vad: string; syns: string; varfor: string; belagg: string; kvar: string; fritt: string; kryss: string }[];
const steg = (d.steg?.rader ?? []) as Record<string, any>[];
const rader = (d.tidsschema?.rader ?? []) as { tid: string; fas: string; form?: string; vad: string }[];
const foreRad = rader.find((r) => r.fas === 'Före lektionen');
const efterRad = rader.find((r) => r.fas === 'Efter lektionen');
const fallgropar = (d.fallgropar?.rader ?? []) as Record<string, any>[];
const manus = fallgropar.filter((f) => f.steg);
const tabellens = fallgropar.filter((f) => !f.steg);
const exempel = (d.amnesexempel ?? []) as Record<string, any>[];
const huvud = exempel.find((e) => e.huvud);
const ovriga = exempel.filter((e) => !e.huvud);
const uppf = (d.uppfoljning?.rader ?? []) as { id: string; nar: string; tid: string; vad: string }[];
const uppfRad = (rid: string) => uppf.find((r) => r.id === rid);
const varianter = (d.tidsschema?.varianter ?? []) as { nar: string; text?: string; delar: { fas: string; tid: string }[] }[];
const andraVarianter = varianter.filter((v) => v.nar !== 'första lektionen');
const forstaVarianten = varianter.find((v) => v.nar === 'första lektionen');
const rutinerFor = (vecka: string) => (d.rutiner?.rader ?? []).filter((r: { vecka: number }) => String(r.vecka) === String(vecka));
// Första lektionen, minut för minut: minuterna och det läraren säger ur standarden, samma rot som lathunden; vid den första
// delen står rutinens repliker (granskare-3 nr 22).
const minuterna = forstaLektionensMinuter(d);
const BELAGG: Record<string, string> = { provad: 'Prövad för sig', 'i-alla': 'Finns i nästan alla prövade versioner', teori: 'Bygger på teori och klassrumsstudier' };
const fallgropFor = (namn: string) => tabellens.filter((f) => f.komponent === namn);
const sorteradeKallor = (grupp: string) => (d.kallor ?? []).filter((x: { grupp: string }) => x.grupp === grupp);
const lasMerKalla = (x: { kalla?: string }) => (x.kalla ? (d.kallor ?? []).find((y: { id: string }) => y.id === x.kalla) : undefined);
const LASGRUPPER = [
  { namn: 'Att läsa', text: 'Texter på svenska, fria att läsa.', slag: ['text'] },
  { namn: 'Böcker och artiklar', text: 'För den som vill gå på djupet.', slag: ['bok', 'artikel', 'kalla'] },
  { namn: 'Att se', text: 'Filmer från klassrummen.', slag: ['film'] },
];
const lasGrupp = (slag: string[]) => (d.lasMer ?? []).filter((x: { slag?: string; kalla?: string }) => slag.includes(x.kalla ? 'kalla' : x.slag ?? ''));
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const urval = ((d.profil as Record<string, any>)?.urval ?? {}) as Record<string, any>;
const slutsats = (g: string) => urval.slutsatser?.[g] as string | undefined;
// Bladen i Materialet för klassen, med sina egna pdf:er när metoderfiler.mjs har klippt ut dem.
const bladen = metodensBlad(id, (d.ramar?.ramar ?? []).map((r: { rubrik: string }) => r.rubrik));
// Raden under Efter de första veckorna som har samma ord som rubriken står utan sin etikett (design-3 nr 18).
const EFTER = 'Efter de första veckorna';
const efterRaderna = uppf.filter((r) => !['lektionen', 'klassen', 'lararen', ...MED_DIG].includes(r.id));
---
{/* Delraden och delarna: på datorn står delraden som en spalt till vänster, som menyn i Stödundervisning (design-3 nr 15). */}
<div class="um-kropp">
<nav class="um-delrad" id="um-delrad" aria-label="Metodens delar">
  <ol>
    {delar.map((x) => <li><a href={`#del-${x.id}`} data-del={x.id}><span class="um-delrad-nr">{x.nr}</span><span class="um-delrad-namn">{KORTA[x.id] ?? x.namn}</span></a></li>)}
  </ol>
</nav>
<div class="um-delarna">

<section class="um-del" id="del-metoden" aria-labelledby="del-metoden-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">1</span><div><h2 id="del-metoden-rubrik"><span class="visually-hidden">Del 1: </span>{del('metoden').namn}</h2><p>{del('metoden').rad}</p></div></header>
  <nav class="um-celler" aria-label={`Avsnitten i ${del('metoden').namn}`}><ul>{celler('metoden').map(([cid, namn]) => <li><a href={`#${cid}`}>{namn}</a></li>)}</ul></nav>
  <h3 id="det-har-ar">Det här är {d.titel.toLocaleLowerCase('sv')}</h3>
  <p set:html={k(d.inledning?.[0] ?? '')} />
  <div class="um-korten" id="i-korthet">
    <h3>{KARNANS_FYRA}</h3>
    <ol class="um-kort-rad">
      {komp.map((x, i) => (
        <li class="um-kort">
          <span class="um-kort-nr" aria-hidden="true">{i + 1}</span>
          <p class="um-kort-namn">{x.namn}</p>
          <p class="um-kort-vad" set:html={k(x.vad)} />
          {x.moment && <p class="um-kort-moment">{x.moment.join(' och ')}</p>}
        </li>
      ))}
    </ol>
    {d.karna?.varv && <p class="um-varv">{d.karna.varv}</p>}
  </div>
  {d.karna?.grundregel && <p set:html={k(d.karna.grundregel)} />}
  {(d.inledning ?? []).slice(1).map((s: string) => <p set:html={k(s)} />)}
  {d.roll && (
    <section class="um-avsnitt" id="lararens-roll">
      <h3>{d.roll.rubrik}</h3>
      <p set:html={k(d.roll.text)} />
      {d.roll.fragor && (
        <div class="um-fragor">
          <p class="um-fragor-rubrik">Tre frågor att bära med dig</p>
          <ol>{d.roll.fragor.map((f: string) => <li set:html={k(f)} />)}</ol>
        </div>
      )}
      {d.roll.fragornaText && <p set:html={k(d.roll.fragornaText)} />}
    </section>
  )}
  {/* Lektionskortet efter Lärarens roll, där del 1 slutar, och inte mitt i texten (granskare-3 nr 20). */}
  <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['lektionskort']} stor />
  {del('metoden').text && <p class="um-overgang" set:html={k(del('metoden').text)} />}
</section>

<section class="um-del" id="del-lektionen" aria-labelledby="del-lektionen-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">2</span><div><h2 id="del-lektionen-rubrik"><span class="visually-hidden">Del 2: </span>{del('lektionen').namn}</h2><p>{del('lektionen').rad}</p></div></header>
  <nav class="um-remsa" aria-label="Lektionens delar">
    <ol>
      {steg.map((s) => { const r = tidsschematsRad(d, s.namn); return <li><a href={`#del-${s.namn.toLocaleLowerCase('sv').replace(/[^a-zåäö0-9]+/g, '-')}`}><span class="um-remsa-tid">{r?.tid}</span><span class="um-remsa-namn">{s.namn}</span></a></li>; })}
    </ol>
  </nav>
  <section class="um-avsnitt" id="lektionen">
    {/* Bandet säger redan rubriken, så den står bara för skärmläsaren (design-3 nr 18). */}
    <h3 class="visually-hidden">{d.tidsschema?.rubrik}</h3>
    {foreRad && <p class="um-fore-efter"><strong>Före lektionen.</strong> <span set:html={k(foreRad.vad)} /></p>}
    {steg.map((s) => {
      const r = tidsschematsRad(d, s.namn);
      const karna = karnanI(d, s.namn);
      const ankare = `del-${s.namn.toLocaleLowerCase('sv').replace(/[^a-zåäö0-9]+/g, '-')}`;
      const fraser = new Set<string>(s.fraser ?? []);
      const elever = s.redo ? utfallensElever(s.redo) : 0;
      return (
        <>
          <article class="um-lektionsdel" id={ankare}>
            <header class="um-ld-huvud">
              <h4>{s.namn}</h4>
              <p class="um-ld-fakta"><span>{r?.tid}</span>{(s.vem || r?.form) && <span>{s.vem ? stor(s.vem) : r!.form}</span>}</p>
            </header>
            {karna.length > 0 && <p class="um-ld-karna">Kärnan här: {karna.map((x: { nr: number; namn: string }, i: number) => <>{i > 0 && ', '}<a href={`#karnan-${x.nr}`}>{x.nr} {x.namn}</a></>)}</p>}
            {r?.vad && <p class="um-ld-vad" set:html={k(r.vad)} />}
            <dl class="um-tre">
              <div><dt>Alla elever visar</dt><dd set:html={k(s.alla)} /></div>
              <div><dt>Du tittar efter</dt><dd set:html={k(s.titta)} /></div>
              <div><dt>Beslutet</dt><dd set:html={k(s.beslut)} /></div>
            </dl>
            <ol class="um-gor">
              {(Array.isArray(s.gor) ? s.gor : [s.gor]).map((g: string) => <li set:html={replik(g, (f) => fraser.has(f) || f.length < 90)} />)}
            </ol>
            {manus.filter((f) => (f.moment ?? []).includes(s.namn)).map((f) => <p class="um-ld-manus"><a href={`#${ankareFor(f.fallgrop)}`}>Så gör du {f.fallgrop.charAt(0).toLocaleLowerCase('sv') + f.fallgrop.slice(1)}</a></p>)}
            {s.redo && (
              <div class="um-beslutskarta" data-utfall>
                <p class="um-beslutskarta-rubrik">Utfallet, i en klass på <span data-elever>{elever}</span></p>
                <div class="um-utfall">
                  {UTFALLEN.map((u) => <div class={`um-utfall-ruta um-utfall-${u.id}`}><p class="um-utfall-namn">{u.namn}</p><p set:html={utfallensTal(s.redo[u.id], elever)} /></div>)}
                </div>
                {s.redo.tiden && <p class="um-not" set:html={utfallensTal(s.redo.tiden, elever)} />}
                {/* Gränserna för en annan klass, ur standardens utfallensGranser, i sidans skript nedan (granskare-3 nr 2). */}
                <p class="um-not um-utfall-regel">I en annan klass: {UTFALLENS_REGEL}</p>
                <p class="um-utfall-antal"><label for={`${ankare}-elever`}>Elever i klassen</label> <input id={`${ankare}-elever`} type="number" inputmode="numeric" min="10" max="40" step="1" value={elever} /></p>
              </div>
            )}
          </article>
          {extrafilmer.filter((f) => f.vid && 'steg' in f.vid && steg[(f.vid as { steg: number }).steg - 1]?.namn === s.namn).map((f) => <div class="um-film"><Film f={f} titel={d.titel} /><Filmbilder f={f} /></div>)}
        </>
      );
    })}
    {efterRad && <p class="um-fore-efter"><strong>Efter lektionen.</strong> <span set:html={k(efterRad.vad)} /></p>}
    {d.tidsschema?.efter && <p class="um-not" set:html={k(d.tidsschema.efter)} />}
    {andraVarianter.map((v) => <p class="um-not"><strong>{v.nar.charAt(0).toLocaleUpperCase('sv') + v.nar.slice(1)}.</strong> <span set:html={k(`${v.text} ${v.delar.map((x) => `${x.fas} ${x.tid}`).join(', ')}.`)} /></p>)}
    {(d.lektionskort ?? []).map((x: { text: string }) => <p set:html={k(x.text)} />)}
  </section>
  {d.fastnar && (
    <section class="um-avsnitt" id="sa-rattar-du">
      <h3>{d.fastnar.rubrik}</h3>
      <p set:html={k(d.fastnar.text)} />
      <ol class="um-trappa">{d.fastnar.trappa.map((t: string) => <li set:html={replik(t)} />)}</ol>
      {d.fastnar.motto && <p class="um-motto" set:html={k(d.fastnar.motto)} />}
      {manus.map((f) => (
        <details class="um-rad" id={ankareFor(f.fallgrop)}>
          <summary><span>Så gör du {f.fallgrop.charAt(0).toLocaleLowerCase('sv') + f.fallgrop.slice(1)}</span></summary>
          <div class="um-rad-inne">
            <p set:html={k(f.hander)} />
            <ol>{f.steg.map((x: string) => <li set:html={k(x)} />)}</ol>
          </div>
        </details>
      ))}
    </section>
  )}
  <section class="um-avsnitt" id="exemplen">
    <h3>Så här kan det se ut i klassrummet</h3>
    {huvud && (
      <article class="um-exempel um-huvudexempel" id="huvudexemplet">
        <header class="um-ex-huvud"><h4>{exempletsAmne(huvud)}, {huvud.arskurs}</h4><p>{huvud.innehall}</p></header>
        <dl class="um-ex-overst">
          <div><dt>Stegen och orden</dt><dd set:html={k(huvud.overst?.egen)} /></div>
          <div><dt>Så visar alla</dt><dd set:html={k(huvud.overst?.visar)} /></div>
        </dl>
        {huvud.remsa && <ol class="um-ex-remsa">{huvud.remsa.map((x: string, i: number) => <li><span class="um-kort-nr" aria-hidden="true">{i + 1}</span><span class="visually-hidden">Kärnan {i + 1}, {komp[i]?.namn}: </span><span set:html={k(x)} /></li>)}</ol>}
        {(huvud.scen ?? []).map((x: string) => <p set:html={k(x)} />)}
        {huvud.notera && <p class="um-notera" set:html={k(huvud.notera)} />}
      </article>
    )}
    {ovriga.map((e) => (
      <details class="um-rad um-exempel-rad">
        <summary><span><strong>{exempletsAmne(e)}, {e.arskurs}.</strong> {e.innehall}</span></summary>
        <article class="um-rad-inne um-exempel">
          <dl class="um-ex-overst">
            <div><dt>Stegen och orden</dt><dd set:html={k(e.overst?.egen)} /></div>
            <div><dt>Så visar alla</dt><dd set:html={k(e.overst?.visar)} /></div>
          </dl>
          {(Array.isArray(e.scen) ? e.scen : [e.scen]).map((x: string) => <p set:html={k(x)} />)}
          {e.notera && <p class="um-notera" set:html={k(e.notera)} />}
        </article>
      </details>
    ))}
  </section>
  {d.stod && (
    <section class="um-avsnitt" id="mer-stod">
      <h3>{d.stod.rubrik}</h3>
      {d.stod.rader.map((r: { nar: string; metoden: string; du: string }) => (
        <details class="um-rad">
          <summary><span>{r.nar}</span></summary>
          <dl class="um-rad-inne um-fast-fritt"><div><dt>Det metoden ger</dt><dd set:html={k(r.metoden)} /></div><div><dt>Det du lägger till</dt><dd set:html={k(r.du)} /></div></dl>
        </details>
      ))}
    </section>
  )}
</section>

<section class="um-del" id="del-kom-igang" aria-labelledby="del-kom-igang-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">3</span><div><h2 id="del-kom-igang-rubrik"><span class="visually-hidden">Del 3: </span>{del('kom-igang').namn}</h2><p>{del('kom-igang').rad}</p></div></header>
  <nav class="um-celler" aria-label={`Avsnitten i ${del('kom-igang').namn}`}><ul>{celler('kom-igang').map(([cid, namn]) => <li><a href={`#${cid}`}>{namn}</a></li>)}</ul></nav>
  {del('kom-igang').text && <p class="um-overgang" set:html={k(del('kom-igang').text)} />}
  {MED_DIG.some((rid) => uppfRad(rid)) && (
    <div class="um-ruta">
      <p class="um-ruta-rubrik">Med dig på vägen</p>
      <dl class="um-uppf">{MED_DIG.map((rid) => uppfRad(rid)).filter(Boolean).map((r) => <div><dt>{r!.nar}</dt><dd set:html={k(r!.vad)} /></div>)}</dl>
    </div>
  )}
  {d.checklista && (
    <section class="um-avsnitt" id="fore-forsta">
      <h3>{d.checklista.rubrik}</h3>
      <ul class="um-checklista">{d.checklista.punkter.map((p: string) => <li set:html={k(p)} />)}</ul>
    </section>
  )}
  {d.klassen && <div class="um-ruta" id="klassen"><p class="um-ruta-rubrik">{d.klassen.rubrik}</p><p set:html={k(d.klassen.text)} /></div>}
  {huvud?.plan && (
    <section class="um-avsnitt" id="planera-lektionen">
      <h3>Planera lektionen</h3>
      {huvud.arbetsomradet && (
        <>
          <p class="um-ruta-rubrik">Arbetsområdet, lektion för lektion</p>
          <ol class="um-arbetsomrade">{huvud.arbetsomradet.map((x: string) => <li set:html={k(x)} />)}</ol>
        </>
      )}
      <p><Fragment set:html={k('Planera varje lektion på ett blad i planeringsmallen. Börja med målet och exit-lappen, sedan stegen och felet.')} /> Den tomma mallen står i <a href="#planeringsmallen">bilaga A</a>, och förlagan till din första lektion står under <a href="#forsta-lektionen">Första lektionen</a>.</p>
      <details class="um-rad">
        <summary><span>Lektion {String(huvud.plan.lektion ?? '').split(' ')[0]} i huvudexemplet, ifylld</span></summary>
        <div class="um-rad-inne"><Planeringsblad d={d} plan={huvud.plan} amne={exempletsAmne(huvud)} saker={saker} /></div>
      </details>
    </section>
  )}
  {d.forsta && (
    <section class="um-avsnitt" id="forsta-lektionen">
      <h3>{d.forsta.rubrik}</h3>
      {(d.forsta.text ?? []).map((s: string) => <p set:html={replik(s)} />)}
      {forstaVarianten?.text && <p set:html={k(forstaVarianten.text)} />}
      {minuterna.length > 0 && (
        <table class="m-tabell stapla um-tabell um-minuter">
          <caption>Första lektionen, minut för minut</caption>
          <thead><tr><th scope="col">Delen</th><th scope="col">Minuterna</th><th scope="col">Du säger</th></tr></thead>
          <tbody>{minuterna.map((x) => <tr><th scope="row" data-rubrik="Delen">{x.fas}</th><td data-rubrik="Minuterna">{x.tid}</td><td data-rubrik="Du säger">{x.fraser.map((f) => `”${f}”`).join(' ')}</td></tr>)}</tbody>
        </table>
      )}
      {rutinerFor('1').map((r: Record<string, any>) => (
        <div class="um-ruta" id="rutinen-vecka-1">
          <p class="um-ruta-rubrik">Rutinen: {r.namn}</p>
          <p set:html={k(r.vad)} />
          {r.steg && <ol>{r.steg.map((x: string) => <li set:html={replik(x)} />)}</ol>}
          {r.forsta && <p><strong>Första gången.</strong> <span set:html={k(r.forsta)} /></p>}
        </div>
      ))}
      {d.forsta.plan && (
        <>
          <p class="um-ruta-rubrik" set:html={k('Första lektionen ifylld i planeringsmallen, som exempel')} />
          <Planeringsblad d={d} plan={d.forsta.plan} amne={huvud ? exempletsAmne(huvud) : undefined} variant="första lektionen" saker={saker} />
        </>
      )}
    </section>
  )}
  {d.progression && (
    <section class="um-avsnitt" id="de-forsta-veckorna">
      <h3>{d.progression.rubrik ?? 'De första veckorna'}</h3>
      {d.uppfoljning?.text && <p set:html={k(d.uppfoljning.text)} />}
      {(uppfRad('lektionen') || uppfRad('klassen') || uppfRad('lararen')) && (
        <dl class="um-uppf">
          {['lektionen', 'klassen', 'lararen'].map((rid) => uppfRad(rid)).filter(Boolean).map((r) => <div><dt>{r!.nar}</dt><dd set:html={k(r!.vad)} /></div>)}
        </dl>
      )}
      {(d.plan?.skattningar ?? []).length > 0 && (
        <p>Varje fredag skattar du två frågor från 1 till 10 i <a href={`/metoder/${id}/lar-dig`}>Lär dig metoden</a>: {d.plan.skattningar.map((x: { namn: string }) => x.namn).join(' och ')} Linjerna visar hur du utvecklas, och planen säger vad du gör om en skattning står lågt två veckor i rad.</p>
      )}
      {d.larandet && (
        <details class="um-rad">
          <summary><span>{d.larandet.rubrik}</span></summary>
          <dl class="um-rad-inne um-larandet">{d.larandet.omraden.map((o: { omrade: string; syns: string }) => <div><dt>{({ amneskunskaper: 'Ämneskunskaperna', sprak: 'Språket', lasning: 'Läsningen', skrivning: 'Skrivandet', kommunikation: 'Kommunikationen', samarbete: 'Samarbetet' } as Record<string, string>)[o.omrade] ?? o.omrade}</dt><dd set:html={k(o.syns)} /></div>)}</dl>
        </details>
      )}
      {d.progression.rader.map((v: Record<string, string>) => (
        <article class="um-vecka" id={`vecka-${v.vecka}`}>
          <h4>Vecka {v.vecka}: {v.rubrik}</h4>
          <dl class="um-vecka-fakta">
            <div><dt>Klassen lär sig</dt><dd set:html={k(v.eleverna)} /></div>
            <div><dt>Du övar</dt><dd set:html={k(v.roll)} /></div>
            <div><dt>Gå vidare när</dt><dd set:html={k(stor(v.vidare))} /></div>
          </dl>
          {String(v.vecka) === '1' && rutinerFor('1').length > 0 && <p class="um-not">Rutinen {rutinerFor('1').map((r: { namn: string }) => r.namn.charAt(0).toLocaleLowerCase('sv') + r.namn.slice(1)).join(' och ')} står vid <a href="#rutinen-vecka-1">Första lektionen</a>.</p>}
          {rutinerFor(v.vecka).filter(() => String(v.vecka) !== '1').map((r: Record<string, any>) => (
            <details class="um-rad um-rutin">
              <summary><span>Rutinen: {r.namn}</span></summary>
              <div class="um-rad-inne">
                <p set:html={k(r.vad)} />
                {r.steg && <ol>{r.steg.map((x: string) => <li set:html={replik(x)} />)}</ol>}
                {r.forsta && <p><strong>Första gången.</strong> <span set:html={k(r.forsta)} /></p>}
              </div>
            </details>
          ))}
        </article>
      ))}
    </section>
  )}
  <section class="um-avsnitt" id="efter-de-forsta-veckorna">
    <h3>{EFTER}</h3>
    {efterRaderna.filter((r) => r.nar === EFTER).map((r) => <p set:html={k(r.vad)} />)}
    <dl class="um-uppf">
      {efterRaderna.filter((r) => r.nar !== EFTER).map((r) => <div><dt>{r.nar}</dt><dd set:html={k(r.vad)} /></div>)}
    </dl>
  </section>
  {d.uppdrag && (
    <section class="um-avsnitt" id="till-arbetslaget">
      <h3>{d.uppdrag.rubrik ?? 'Till arbetslaget'}</h3>
      {d.uppdrag.text && <p set:html={k(d.uppdrag.text)} />}
      {/* Planera och Genomför före mötena, så att de inte läses som Möte 1:s innehåll (design-3 nr 18). */}
      {d.uppdrag.planera && <p>{!/^planera/i.test(d.uppdrag.planera) && <><strong>Planera.</strong>{' '}</>}<Fragment set:html={k(d.uppdrag.planera)} /></p>}
      {d.uppdrag.genomfor && <p>{!/^(pröva|genomför)/i.test(d.uppdrag.genomfor) && <><strong>Genomför.</strong>{' '}</>}<Fragment set:html={k(d.uppdrag.genomfor)} /></p>}
      {d.uppdrag.forbered && (
        <details class="um-rad">
          <summary><span>Möte 1, före första lektionen</span></summary>
          <div class="um-rad-inne">
            <p set:html={k(d.uppdrag.forbered.text)} />
            <ol>{d.uppdrag.forbered.fragor.map((f: string) => <li set:html={k(f)} />)}</ol>
          </div>
        </details>
      )}
      {d.uppdrag.reflektera && (
        <details class="um-rad">
          <summary><span>Möte 2, i slutet av de första veckorna</span></summary>
          <ol class="um-rad-inne">{d.uppdrag.reflektera.map((f: string) => <li set:html={k(f)} />)}</ol>
        </details>
      )}
    </section>
  )}
</section>

<section class="um-del" id="del-hall-i" aria-labelledby="del-hall-i-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">4</span><div><h2 id="del-hall-i-rubrik"><span class="visually-hidden">Del 4: </span>{del('hall-i').namn}</h2><p>{del('hall-i').rad}</p></div></header>
  <nav class="um-celler" aria-label={`Avsnitten i ${del('hall-i').namn}`}><ul>{celler('hall-i').map(([cid, namn]) => <li><a href={`#${cid}`}>{namn}</a></li>)}</ul></nav>
