<section class="um-del" id="del-att-skriva-ut" aria-labelledby="del-att-skriva-ut-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">A</span><div><h2 id="del-att-skriva-ut-rubrik"><span class="visually-hidden">Bilaga A: </span>{del('att-skriva-ut').namn}</h2><p>{del('att-skriva-ut').rad}</p></div></header>
  <nav class="um-celler" aria-label={`Avsnitten i ${del('att-skriva-ut').namn}`}><ul>{celler('att-skriva-ut').map(([cid, namn]) => <li><a href={`#${cid}`}>{namn}</a></li>)}</ul></nav>
  <section class="um-avsnitt" id="materialet">
    <h3>{UM_NAMN.lektionskort}</h3>
    <p>Hela lektionen på ett A4 att ha i handen: kärnan, delarna med det du gör och säger, beslutet och rättningen.</p>
    {bilder.lektionskort?.length > 0 && <div class="um-sidor">{bilder.lektionskort.map((b) => <a href={filer.lektionskort?.pdf} data-goatcounter-click={`fil:${id}-lektionskort.pdf`} data-goatcounter-title={`Bilden av lektionskort, pdf, ${id}`} class="um-sida"><img src={b.src} alt="Lektionskortet: kärnan i fyra rutor, lektionens delar med det du gör och säger, beslutet och rättningen" loading="lazy" decoding="async" width={b.bredd} height={b.hojd} /></a>)}</div>}
