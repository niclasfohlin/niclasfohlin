<section class="um-del" id="del-valet" aria-labelledby="del-valet-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">B</span><div><h2 id="del-valet-rubrik"><span class="visually-hidden">Bilaga B: </span>{del('valet').namn}</h2><p>{del('valet').rad}</p></div></header>
  {d.passar && (
