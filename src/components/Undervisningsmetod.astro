        <tbody>{d.passar.rader.map((r: { fraga: string; metoden: string; annat: string }) => <tr><th scope="row" data-rubrik="Frågan">{r.fraga}</th><td data-rubrik={d.titel} set:html={k(r.metoden)} /><td data-rubrik="En annan metod passar bättre" set:html={k(r.annat)} /></tr>)}</tbody>
      </table>
      {d.passar.tumregel && <p set:html={k(d.passar.tumregel)} />}
      </div>
    </details>
  )}
  {d.invandningar && (
    <details class="um-rad um-rad-stor" id="invandningar">
      <summary><h3>{d.invandningar.rubrik}</h3></summary>
      <div class="um-rad-inne">
        {d.invandningar.fragor.map((f: { fraga: string; svar: string }) => <><p class="um-fraga">{f.fraga}</p><p set:html={k(f.svar)} /></>)}
      </div>
    </details>
  )}
  {d.grund && (
    <details class="um-rad um-rad-stor" id="forskningen">
      <summary><h3>{d.grund.rubrik}</h3></summary>
      <div class="um-rad-inne">
      {d.grund.text.map((s: string) => <p set:html={k(s)} />)}
      <p set:html={k(`${METODKORTET} säger hur väl forskningen stöder metoden i varje område, och varje rad där fälls ut till skälet.`)} />
      {urval.text && <div class="um-ruta"><p class="um-ruta-rubrik">Så valdes källorna</p><p set:html={k(urval.text)} />{urval.regel && <p class="um-not">Regeln: <span set:html={k(urval.regel)} /></p>}</div>}
      </div>
    </details>
  )}
  <details class="um-rad um-rad-stor um-referensblad" id="referensbladet">
    <summary><h3>Forskningen bakom {d.titel.toLocaleLowerCase('sv')}</h3></summary>
    <div class="um-rad-inne">
    <p class="um-not" set:html={k(`${(d.kallor ?? []).length} källor, valda ${urval.datum ? new Date(urval.datum).toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' }) : ''} efter metodens regel. Talet till vänster är källans effektstorlek, och ordet under säger hur stor den är, för den källan, eller Inte säker när källan säger att skillnaden inte är säker. Nivån i metodkortet väger alla källorna för området och hur säkra de är, så den kan ha ett annat ord. Märkena säger vilka rader i metodkortet källan bär.`)} />
    {KALLGRUPPER.map((g) => sorteradeKallor(g.id).length > 0 && (
      <div class="um-kallgrupp">
        <p class="um-kallgrupp-namn">{g.namn} <span set:html={k(g.text)} /></p>
        {slutsats(g.id) && <p class="um-slutsats"><strong>Slutsatsen.</strong> <span set:html={k(slutsats(g.id)!)} /></p>}
        <ol class="um-kallor">
          {sorteradeKallor(g.id).map((x: Record<string, any>) => {
            const e = x.effekt ? effektensDelar(x.effekt) : null;
            const l = kallansLank(x);
            return (
              <li class="um-kallpost" id={`kalla-${x.id}`}>
                <p class="um-kall-tal">{e && /\d/.test(e.tal) && <span class="um-kall-siffra">{e.tal}</span>}<span class={`um-kall-ord${e && !/\d/.test(e.tal) ? ' ensam' : ''}`}>{e ? e.ord : SLAGORD[x.slag] ?? x.slag}</span></p>
                <div>
                  <p>{x.adress ? <>{String(x.text).split(x.titel)[0]}<a href={x.adress}>{x.titel}</a>{String(x.text).split(x.titel).slice(1).join(x.titel)}</> : x.text}</p>
                  <p class="um-kall-rad">{e ? e.resten : x.bidrag}{l && <>{' · '}<a href={l.href}>{l.text}</a></>}</p>
                  {(x.omraden ?? []).length > 0 && <p class="um-markena">{x.omraden.map((o: string) => OMRADESORD[o] ?? o).join(', ')}</p>}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
    {urval.uteslutna?.length > 0 && (
      <div class="um-bortvalda">
        <p class="um-ruta-rubrik">Valdes bort</p>
        <ul>{urval.uteslutna.map((u: { namn: string; skal: string }) => <li><strong>{u.namn}.</strong> <span set:html={k(`${u.skal}${/[.!?]$/.test(u.skal) ? '' : '.'}`)} /></li>)}</ul>
      </div>
    )}
    <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['referensblad']} />
    </div>
  </details>
  {d.lasMer && (
    <details class="um-rad um-rad-stor" id="las-mer">
      <summary><h3>Läs mer</h3></summary>
      <div class="um-rad-inne">
      {LASGRUPPER.map((g) => lasGrupp(g.slag).length > 0 && (
        <div class="um-lasgrupp">
          <p class="um-ruta-rubrik">{g.namn} <span class="um-not">{g.text}</span></p>
          <ul class="um-lasmer">
            {lasGrupp(g.slag).map((x: Record<string, any>) => {
              const kk = lasMerKalla(x);
              const titel = kk ? kk.titel : x.titel;
              const adress = kk ? (kallansLank(kk)?.href ?? kk.adress) : x.adress;
              const upphov = kk ? kk.text.split(' (')[0] : x.upphov;
              const ar = kk ? kk.text.match(/\((\d{4})\)/)?.[1] : x.ar;
              return <li><a href={adress}>{titel}</a><p set:html={k(x.text)} /><p class="um-not">{upphov}{ar ? ` · ${ar}` : ''}</p></li>;
            })}
          </ul>
        </div>
      ))}
      </div>
    </details>
  )}
</section>
</div>
</div>

<script>
  import { utfallensGranser } from '../lib/standard/index.js';
  // Delraden visar delen läraren är i: den del vars band senast passerade toppen. Länken från lathunden, planen eller en
  // hänvisning öppnar raden den leder till, om raden är stängd.
  const lankar = [...document.querySelectorAll<HTMLAnchorElement>('#um-delrad a[data-del]')];
  const delarna = lankar.map((a) => document.getElementById(`del-${a.dataset.del}`)).filter((x): x is HTMLElement => !!x);
  const markera = () => {
    const y = 90;
    let aktiv = 0;
    delarna.forEach((s, i) => { if (s.getBoundingClientRect().top <= y) aktiv = i; });
    lankar.forEach((a, i) => (i === aktiv ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
  };
  addEventListener('scroll', markera, { passive: true });
  markera();
  const oppna = () => {
    const mal = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const rad = mal?.closest('details') ?? (mal instanceof HTMLDetailsElement ? mal : null);
    if (rad && !rad.open) { rad.open = true; mal!.scrollIntoView(); }
  };
  addEventListener('hashchange', oppna);
  oppna();
  // Utfallen för klassens antal (granskare-3 nr 2): läraren skriver antalet elever, och gränserna räknas om med standardens
  // utfallensGranser, samma rot som metodens text och planeringsbladet.
  for (const ruta of document.querySelectorAll<HTMLElement>('[data-utfall]')) {
    const falt = ruta.querySelector<HTMLInputElement>('input[type="number"]');
    falt?.addEventListener('input', () => {
      const n = Math.round(Number(falt.value));
      if (!(n >= 10 && n <= 40)) return;
      const g = utfallensGranser(n);
      const tal: Record<string, number> = { nastanAlla: g.nastanAlla, deFlesta0: g.deFlesta[0], deFlesta1: g.deFlesta[1], halften: g.halften };
      for (const e of ruta.querySelectorAll<HTMLElement>('[data-grans]')) e.textContent = String(tal[e.dataset.grans ?? ''] ?? e.textContent);
      for (const e of ruta.querySelectorAll<HTMLElement>('[data-elever]')) e.textContent = String(n);
    });
  }
</script>
