---
// En undervisningsmetod på sin sida (K-621): de fyra delarna och de två bilagorna i lärarens väg, i samma ordning som
// Word-filen (riggens standard, avsnitt 4, och UNDERVISNINGSMETODENS_DELAR i standarden). Formen är idéförslagens form 2,
// Läsvägen öppen (underlag/prov/metoder/ide/): det läraren läser före första lektionen står öppet, och det som slås upp
// står som rader som fälls ut. Varje sak står en gång, i sitt hem, med en knapp under som skriver ut den, och varje text går
// genom medSaker, så att metodens saker är länkar där de nämns och hänvisningarna till källorna leder till sin post i
// referensbladet (STIL.md under Hänvisningar). Allt läses ur metodens fil, så att nästa metod får samma sida.
import Planeringsblad from './Planeringsblad.astro';
import Film from './Film.astro';
import Filmbilder from './Filmbilder.astro';
import { friTabellensPlats, planerasNamn, planerasRad, slagensOrd, slugAv, stor, liten, litenForsta, talText, uppraknat, UTFALLEN, MED_DIG_PA_VAGEN, effektensSkala, forstaLektionensMinuter, forstaLektionensForm, veckansRubrik, EXEMPLETS_ETIKETTER, variantensAnkare, LARANDETS_OMRADEN, arbetslagetsMoten } from '../lib/standard/index.js';
import { metodensDelar, medSaker, KALLGRUPPER, OMRADESORD, SLAGORD, effektensDelar, kallansLank, karnanI, tidsschematsRad, exempletsAmne, planensAmne, bladetsAnkare, stegetsAnkare, utfalletsAnkare, utfallensElever, utfalletsText, utfallensRegel, UM_NAMN, METODKORTET, STRUKTURKORTEN, kortensKolumner, type Um } from '../lib/undervisningsmetod';
import type { MetodFilm } from '../lib/film';
import type { MetodSak } from '../lib/metodsaker';
import { metodensBlad, type UmBild, type UmFil } from '../lib/undervisningsmetodfiler';
import Umfilknappar from './Umfilknappar.astro';
import UmFriaTabeller from './UmFriaTabeller.astro';
import { metodensKortAdress, provaMetodensKort, slagensStil, bildensAdress, strukturensAdress, TVA_PA_A4, type ImporteradStruktur } from '../lib/strukturer';
import { metodensStrategiblad, rutinensRubrik, utfallsord } from '../lib/standard/index.js';
import Vavruta from './Vavruta.astro';
import { vavtIMetoder } from '../lib/vav';
import { strategiernaAv, strategikortetI, provaMetodensStrategikort, metodensKortAdress as metodensStrategikortAdress, strategiensAdress, strategiernasStil, STRATEGIERNAS_ADRESS } from '../lib/strategier';
interface Props { d: Um; id: string; extrafilmer: MetodFilm[]; filer: Record<string, UmFil | undefined>; tabellfiler?: UmFil[]; bilder: Record<string, UmBild[]>; sidor?: { titel: string; href: string }[]; saker: MetodSak[]; strukturer?: ImporteradStruktur[] }
const { d, id, extrafilmer, filer, tabellfiler = [], bilder, sidor = [], saker, strukturer = [] } = Astro.props;
if (strukturer.length) provaMetodensKort(id, strukturer.map((x) => x.id));
// Strategierna som metoden visar ur verktyget Strategier, som strukturkorten: metodens fält strategikort eller sajtens
// sådd (K-699, K-702).
const STRATEGIERNA = 'Strategier för lärande';
const strategikortet = strategikortetI(id, d);
const strategierna = strategikortet ? strategiernaAv(strategikortet.strategier, `${d.titel}: strategikort`) : [];
if (strategierna.length) provaMetodensStrategikort(id, strategierna.map((x) => x.id));
// Strategiernas små kort på platserna i texten (K-702), i sidans egen form: steg N, karna: <komponent>, tabell: <rubrik> och
// arbetsomradet (vavtIMetoder i src/lib/vav.ts). En plats som sidan inte har stoppar bygget. Raden till verktyget står med
// samma regel som i Stödundervisning (radenTillVerktyget i src/lib/centrala.ts).
const vavt = vavtIMetoder(id, d);
const vavtVidPlats = (efter: string) => vavt.filter((v) => v.efter === efter);
const kallor = new Set<string>((d.kallor ?? []).map((k: { id: string }) => k.id));
// Varje text som HTML: metodens saker och källorna som länkar (medSaker), och en replik inom citattecken på egen rad. En replik
// som meningen fortsätter efter, med komma eller liten bokstav, står kvar i meningen (um-replik-i), så att "Säg ”Pennan ner”,
// också om några inte är klara." inte delas i tre rader (andra ögat på Testbaserat lärande 2026-11-02).
const k = (t: string) => medSaker(t, saker, kallor, sidor);
const replik = (t: string, ar: (f: string) => boolean = () => true) => k(t).replace(/”([^”]+)”(?=([,;:]|\s+\p{Ll})?)/gu, (m: string, f: string, fortsatter?: string) => (ar(f) ? `<q class="um-replik${fortsatter ? ' um-replik-i' : ''}">${f}</q>` : m));
const ankareFor = (namn: string) => `nar-${namn.toLocaleLowerCase('sv').replace(/[åä]/g, 'a').replace(/ö/g, 'o').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
// Arbetslaget och besöken i tidsordning, i rutan Med dig på vägen: standardens lista, som lathunden också läser.
const MED_DIG = MED_DIG_PA_VAGEN;
// Delradens namn i telefonen, där den aktiva delen visar sitt namn.
const KORTA: Record<string, string> = { 'att-skriva-ut': 'Skriv ut', valet: 'Forskningen' };
// Kärnans kort har rubriken som cellen i del 1 leder till (design-3 nr 18), med antalet ur metodens komponenter: Kärnans fyra
// i explicit undervisning och Kärnans fem i kooperativt lärande.
const KARNANS_KORT = `Kärnans ${talText((d.karna?.komponenter ?? []).length)}`;
// Lektionen som minuterna och den grå planen gäller och avsnittets rubrik, Första lektionen eller Första veckan, ur
// metodens fält och slaget (forstaLektionensForm i standarden), samma rot som lathunden.
const forstaL = forstaLektionensForm(d);
const FORSTA = d.forsta?.rubrik ?? forstaL.namn;
// Delarnas celler under bandet: avsnitten som länkar, i formspråket C. Bara avsnitt som metoden har.
const slagetsOrd = slagensOrd(d);
// En fri tabell med meny: true har en rad i menyn där den står (UmFriaTabeller.astro), och likaså en tabell med egen fil, som
// Grovplaneringen i bilaga A (andra ögat på Testbaserat lärande 2026-11-02: den saknades i bilagans rad).
const tabellCeller = (plats: string) => ((d.tabeller ?? []) as { rubrik: string; plats?: string; meny?: boolean }[]).filter((t) => (t.meny || tabellfiler.some((f) => f.namn === t.rubrik)) && friTabellensPlats(t, d) === plats).map((t): [string, string, unknown] => [slugAv(t.rubrik), t.rubrik, true]);
const CELLER: Record<string, [string, string, unknown][]> = {
  metoden: [['det-har-ar', `Det här är ${d.titel.toLocaleLowerCase('sv')}`, true], ['i-korthet', KARNANS_KORT, d.karna], ['lararens-roll', 'Lärarens roll', d.roll], ...tabellCeller('efter-inledning')],
  'kom-igang': [['fore-forsta', 'Före första lektionen', d.checklista], ['planera-lektionen', planerasNamn(d), d.amnesexempel?.some((e: { plan?: unknown }) => e.plan)], ['forsta-lektionen', FORSTA, d.forsta], ['de-forsta-veckorna', 'De första veckorna', d.progression], ...tabellCeller('efter-progression'), ['efter-de-forsta-veckorna', 'Efter de första veckorna', true], ['till-arbetslaget', 'Till arbetslaget', d.uppdrag]],
  'hall-i': [['karnan', 'Kärnan: fast och fritt', d.karna], ['lararens-fragor', 'Lärarens frågor', d.lararensFragor], ['nar-det-glider', 'När det glider', true]],
  'att-skriva-ut': [['materialet', UM_NAMN.lektionskort, filer.lektionskort], ['strukturkorten', STRUKTURKORTEN, strukturer.length], ['strategierna', STRATEGIERNA, strategierna.length], ['materialet-for-klassen', d.ramar?.rubrik ?? UM_NAMN.materialet, d.ramar], ['planeringsmallen', UM_NAMN.planeringsmall, d.planeringsmall], ['observationsmallen', UM_NAMN.observation, d.observation], ...tabellCeller('bilaga-a')],
  valet: [],
};
const celler = (did: string) => (CELLER[did] ?? []).filter(([, , finns]) => !!finns);
const delar = metodensDelar(d);
const del = (did: string) => delar.find((x) => x.id === did)!;
const komp = (d.karna?.komponenter ?? []) as { namn: string; moment?: string[]; vad: string; syns: string; varfor: string; belagg: string; kvar: string; fritt: string; kryss: string }[];
const steg = (d.steg?.rader ?? []) as Record<string, any>[];
const rader = (d.tidsschema?.rader ?? []) as { tid: string; fas: string; form?: string; vad: string }[];
const foreRad = rader.find((r) => r.fas === 'Före lektionen');
const efterRad = rader.find((r) => r.fas === 'Efter lektionen');
const fallgropar = (d.fallgropar?.rader ?? []) as Record<string, any>[];
const manus = fallgropar.filter((f) => f.steg);
const tabellens = fallgropar.filter((f) => !f.steg);
const exempel = (d.amnesexempel ?? []) as Record<string, any>[];
const huvud = exempel.find((e) => e.huvud);
const ovriga = exempel.filter((e) => !e.huvud);
const uppf = (d.uppfoljning?.rader ?? []) as { id: string; nar: string; tid: string; vad: string }[];
const uppfRad = (rid: string) => uppf.find((r) => r.id === rid);
const varianter = (d.tidsschema?.varianter ?? []) as { nar: string; text?: string; delar: { fas: string; tid: string }[] }[];
const andraVarianter = varianter.filter((v) => v.nar !== 'första lektionen');
const forstaVarianten = varianter.find((v) => v.nar === 'första lektionen');
const rutinerFor = (vecka: string) => (d.rutiner?.rader ?? []).filter((r: { vecka: number }) => String(r.vecka) === String(vecka));
// Första lektionen, minut för minut: minuterna och det läraren säger ur standarden, samma rot som lathunden; vid den första
// delen står rutinens repliker (granskare-3 nr 22).
const minuterna = forstaLektionensMinuter(d);
const BELAGG: Record<string, string> = { provad: 'Prövad', 'i-alla': 'Finns i nästan alla prövade versioner', teori: 'Bygger på teori och klassrumsstudier' };
const fallgropFor = (namn: string) => tabellens.filter((f) => f.komponent === namn);
const sorteradeKallor = (grupp: string) => (d.kallor ?? []).filter((x: { grupp: string }) => x.grupp === grupp);
const lasMerKalla = (x: { kalla?: string }) => (x.kalla ? (d.kallor ?? []).find((y: { id: string }) => y.id === x.kalla) : undefined);
const LASGRUPPER = [
  { namn: 'Att läsa', text: 'Texter på svenska, fria att läsa.', slag: ['text'] },
  { namn: 'Böcker och artiklar', text: 'För den som vill gå på djupet.', slag: ['bok', 'artikel', 'kalla'] },
  { namn: 'Att se', text: 'Filmer från klassrummen.', slag: ['film'] },
];
const lasGrupp = (slag: string[]) => (d.lasMer ?? []).filter((x: { slag?: string; kalla?: string }) => slag.includes(x.kalla ? 'kalla' : x.slag ?? ''));
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const urval = ((d.profil as Record<string, any>)?.urval ?? {}) as Record<string, any>;
const slutsats = (g: string) => urval.slutsatser?.[g] as string | undefined;
// Bladen i Materialet för klassen, med sina egna pdf:er när metoderfiler.mjs har klippt ut dem.
const bladen = metodensBlad(id, (d.ramar?.ramar ?? []).map((r: { rubrik: string }) => r.rubrik));
// Bilderna av ett blads sidor: en bild per blad, och alla bilder när metoden har ett enda blad, som kan ha flera sidor, som
// Strategikorten i Reciprok undervisning (scripts/metoderfiler.mjs).
// Replikerna i stegets fraser som inte står i stegets text. Riggens dokument har alla i raden Det du säger, och sidan visar de
// som texten inte redan har, så att sidan och dokumentet säger samma sak (scripts/metoderparitet.mjs).
const fraserUtanforTexten = (s: Record<string, any>): string[] => {
  const ren = (t: string) => t.replace(/[⁠”“"]/g, '').replace(/[ \s]+/g, ' ').trim();
  const gor = ren((Array.isArray(s.gor) ? s.gor : [s.gor]).join(' '));
  return ((s.fraser ?? []) as string[]).filter((f) => !gor.includes(ren(f)));
};
// Ett enda blad med flera sidor är hela materialet: en rad knappar under bladet, eftersom två knappar annars gör samma sak.
const ettBladMedSidor = (d.ramar?.ramar ?? []).length === 1 && (bilder.materialet?.length ?? 0) > 1 && !!bladen[0]?.pdf;
const bladetsSidor = (i: number) => ((d.ramar?.ramar ?? []).length === 1 ? bilder.materialet ?? [] : bilder.materialet?.[i] ? [bilder.materialet[i]] : []);
// Ett blad i Materialet för klassen: rubriken och texten, och i ett blad som strukturkorten listorna och delarna.
type Ram = { rubrik: string; text: string[]; listor?: { rubrik?: string; rader: string[][] }[]; delar?: { rubrik: string; falt: { rubrik: string; text: string }[] }[] };
// Raden under Efter de första veckorna som har samma ord som rubriken står utan sin etikett (design-3 nr 18).
const EFTER = 'Efter de första veckorna';
const efterRaderna = uppf.filter((r) => !['lektionen', 'klassen', 'lararen', ...MED_DIG].includes(r.id));
// Till arbetslaget med riggens fasta text om mötena (G11).
const moten = arbetslagetsMoten(d);
---
{/* Delraden och delarna: på datorn står delraden som en spalt till vänster, som menyn i Stödundervisning (design-3 nr 15). */}
<div class="um-kropp">
<nav class="um-delrad" id="um-delrad" aria-label="Metodens delar">
  <ol>
    {delar.map((x) => <li><a href={`#del-${x.id}`} data-del={x.id}><span class="um-delrad-nr">{x.nr}</span><span class="um-delrad-namn">{KORTA[x.id] ?? x.namn}</span></a></li>)}
  </ol>
</nav>
<div class="um-delarna">

<section class="um-del" id="del-metoden" aria-labelledby="del-metoden-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">1</span><div><h2 id="del-metoden-rubrik"><span class="visually-hidden">Del 1: </span>{del('metoden').namn}</h2><p>{del('metoden').rad}</p></div></header>
  <nav class="um-celler" aria-label={`Avsnitten i ${del('metoden').namn}`}><ul>{celler('metoden').map(([cid, namn]) => <li><a href={`#${cid}`}>{namn}</a></li>)}</ul></nav>
  <h3 id="det-har-ar">Det här är {d.titel.toLocaleLowerCase('sv')}</h3>
  <p set:html={k(d.inledning?.[0] ?? '')} />
  <div class="um-korten" id="i-korthet">
    <h3>{KARNANS_KORT}</h3>
    <ol class="um-kort-rad" style={`--kolumner: ${kortensKolumner(komp.length)}`}>
      {komp.map((x, i) => (
        <li class="um-kort">
          <span class="um-kort-nr" aria-hidden="true">{i + 1}</span>
          <p class="um-kort-namn">{x.namn}</p>
          <p class="um-kort-vad" set:html={k(x.vad)} />
          {x.moment && <p class="um-kort-moment">{uppraknat(x.moment)}</p>}
        </li>
      ))}
    </ol>
    {d.karna?.varv && <p class="um-varv">{d.karna.varv}</p>}
  </div>
  {d.karna?.grundregel && <p set:html={k(d.karna.grundregel)} />}
  {(d.inledning ?? []).slice(1).map((s: string) => <p set:html={k(s)} />)}
  {d.roll && (
    <section class="um-avsnitt" id="lararens-roll">
      <h3>{d.roll.rubrik}</h3>
      <p set:html={k(d.roll.text)} />
      {d.roll.fragor && (
        <div class="um-fragor">
          <p class="um-fragor-rubrik">Tre frågor att bära med dig</p>
          <ol>{d.roll.fragor.map((f: string) => <li set:html={k(f)} />)}</ol>
        </div>
      )}
      {d.roll.fragornaText && <p set:html={k(d.roll.fragornaText)} />}
    </section>
  )}
  <UmFriaTabeller d={d} id={id} plats="efter-inledning" k={k} saker={saker} filer={tabellfiler} vavt={vavt} />
  {/* Lektionskortet efter Lärarens roll, där del 1 slutar, och inte mitt i texten (granskare-3 nr 20). */}
  <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['lektionskort']} stor />
  {del('metoden').text && <p class="um-overgang" set:html={k(del('metoden').text)} />}
</section>

<section class="um-del" id="del-lektionen" aria-labelledby="del-lektionen-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">2</span><div><h2 id="del-lektionen-rubrik"><span class="visually-hidden">Del 2: </span>{del('lektionen').namn}</h2><p>{del('lektionen').rad}</p></div></header>
  <nav class="um-remsa" aria-label={slagetsOrd.delarna}>
    <ol style={`--antal: ${steg.length}`}>
      {steg.map((s) => { const r = tidsschematsRad(d, s.namn); return <li><a href={`#${stegetsAnkare(s.namn)}`}><span class="um-remsa-tid">{r?.tid}</span><span class="um-remsa-namn">{s.namn}</span></a></li>; })}
    </ol>
  </nav>
  <section class="um-avsnitt" id="lektionen">
    {/* Bandet säger redan rubriken, så den står bara för skärmläsaren (design-3 nr 18). */}
    <h3 class="visually-hidden">{d.tidsschema?.rubrik}</h3>
    {foreRad && <p class="um-fore-efter"><strong>Före lektionen.</strong> <span set:html={k(foreRad.vad)} /></p>}
    {steg.map((s) => {
      const r = tidsschematsRad(d, s.namn);
      const karna = karnanI(d, s.namn);
      const ankare = stegetsAnkare(s.namn);
      const fraser = new Set<string>(s.fraser ?? []);
      const elever = s.redo ? utfallensElever(s.redo) : 0;
      return (
        <>
          <article class="um-lektionsdel" id={ankare}>
            <header class="um-ld-huvud">
              <h4>{s.namn}</h4>
              <p class="um-ld-fakta"><span>{r?.tid}</span>{(s.vem || r?.form) && <span>{s.vem ? stor(s.vem) : r!.form}</span>}</p>
            </header>
            {karna.length > 0 && <p class="um-ld-karna">Kärnan här: {karna.map((x: { nr: number; namn: string }, i: number) => <>{i > 0 && ', '}<a href={`#karnan-${x.nr}`}>{x.nr} {x.namn}</a></>)}</p>}
            {r?.vad && <p class="um-ld-vad" set:html={k(r.vad)} />}
            <dl class="um-tre">
              <div><dt>{slagetsOrd.alla}</dt><dd set:html={k(s.alla)} /></div>
              <div><dt>Du tittar efter</dt><dd set:html={k(s.titta)} /></div>
              <div><dt>{slagetsOrd.beslut}</dt><dd set:html={k(s.beslut)} /></div>
            </dl>
            <ol class="um-gor">
              {(Array.isArray(s.gor) ? s.gor : [s.gor]).map((g: string) => <li set:html={replik(g, (f) => { const ren = f.replace(/<[^>]+>/g, ""); return fraser.has(ren) || ren.length < 90; })} />)}
            </ol>
            {fraserUtanforTexten(s).length > 0 && <p class="um-not" set:html={k(`Du säger också: ${fraserUtanforTexten(s).map((f) => `”${f}”`).join(' ')}`)} />}
            {manus.filter((f) => (f.moment ?? []).includes(s.namn)).map((f) => <p class="um-ld-manus"><a href={`#${ankareFor(f.fallgrop)}`}>Så gör du {f.fallgrop.charAt(0).toLocaleLowerCase('sv') + f.fallgrop.slice(1)}</a></p>)}
            {s.redo && (
              <div class="um-beslutskarta" id={utfalletsAnkare(s.namn)} data-utfall>
                <p class="um-beslutskarta-rubrik">Utfallet, i en klass på <span data-elever>{elever}</span></p>
                <div class="um-utfall">
                  {UTFALLEN.map((u) => <div class={`um-utfall-ruta um-utfall-${u.id}`}><p class="um-utfall-namn">{u.namn}</p><p set:html={utfalletsText(s.redo[u.id], elever, saker)} /></div>)}
                </div>
                {s.redo.tiden && <p class="um-not" set:html={utfalletsText(s.redo.tiden, elever, saker)} />}
                {/* Gränserna för en annan klass, ur standardens utfallensGranser, i sidans skript nedan (granskare-3 nr 2). */}
                <p class="um-not um-utfall-regel">I en annan klass: {utfallensRegel(utfallsord(s.redo))}</p>
                <p class="um-utfall-antal"><label for={`${ankare}-elever`}>Elever i klassen</label> <input id={`${ankare}-elever`} type="number" inputmode="numeric" min="10" max="40" step="1" value={elever} /></p>
              </div>
            )}
          </article>
          {extrafilmer.filter((f) => f.vid && 'steg' in f.vid && steg[(f.vid as { steg: number }).steg - 1]?.namn === s.namn).map((f) => <div class="um-film"><Film f={f} titel={d.titel} /><Filmbilder f={f} /></div>)}
          {vavtVidPlats(`steg ${steg.indexOf(s) + 1}`).map((v, i, a) => <Vavruta v={v} titel={d.titel} sist={!a.slice(i + 1).some((w) => w.vav.id === v.vav.id)} />)}
        </>
      );
    })}
    {efterRad && <p class="um-fore-efter"><strong>Efter lektionen.</strong> <span set:html={k(efterRad.vad)} /></p>}
    {d.tidsschema?.efter && <p class="um-not" set:html={k(d.tidsschema.efter)} />}
    {/* Varje variant har ett ankare, som rutan Vill du börja på måndag? leder till (variantensAnkare, G1). */}
    {andraVarianter.map((v) => <p class="um-not" id={variantensAnkare(v.nar)}><strong>{v.nar.charAt(0).toLocaleUpperCase('sv') + v.nar.slice(1)}.</strong> <span set:html={k(`${v.text} ${v.delar.map((x) => `${x.fas} ${x.tid}`).join(', ')}.`)} /></p>)}
    {(d.lektionskort ?? []).map((x: { text: string }) => <p set:html={k(x.text)} />)}
  </section>
  {d.fastnar && (
    <section class="um-avsnitt" id="sa-rattar-du">
      <h3>{d.fastnar.rubrik}</h3>
      <p set:html={k(d.fastnar.text)} />
      <ol class="um-trappa">{d.fastnar.trappa.map((t: string) => <li set:html={replik(t)} />)}</ol>
