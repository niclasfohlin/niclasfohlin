          inte läses till texten ovanför i telefonen (design-3 nr 6). Word är hela materialet. */}
      {(d.ramar.ramar ?? []).map((r: { rubrik: string; text: string[] }, i: number) => (
        <div class="um-blad-post" id={bladetsAnkare(r.rubrik)}>
