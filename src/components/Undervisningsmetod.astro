    </section>
  )}
  {d.hallFast && (
    <section class="um-avsnitt um-under" id="hall-fast">
      <h4>{d.hallFast.rubrik}</h4>
      <ol class="um-hallfast">{d.hallFast.rader.map((r: { sak: string; text: string }) => <li><strong>{r.sak}.</strong> <span set:html={k(r.text)} /></li>)}</ol>
