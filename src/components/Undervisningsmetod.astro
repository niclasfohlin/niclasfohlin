      </ol>
      <p class="um-strukturknappar">
        <a class="knapp" href={metodensStrategikortAdress(id)} target="_blank" rel="noopener" data-skriv-ut-pdf data-goatcounter-click={`utskrift:${id}/strategikort`} data-goatcounter-title={`${d.titel}: strategikorten`}>{strategierna.length === 1 ? <span data-direkt="Skriv ut kortet">Kortet som pdf</span> : <span data-direkt={`Skriv ut de ${talText(strategierna.length)} korten`}>De {talText(strategierna.length)} korten som pdf</span>}</a>
        {d.strategikort?.blad && <a class="knapp sekundar" href={`/strategier/kort/${metodensStrategiblad(id).fil}`} target="_blank" rel="noopener" data-goatcounter-click={`fil:${metodensStrategiblad(id).fil}`} data-goatcounter-title={`${d.titel}: ${d.strategikort.blad}`}>{d.strategikort.blad}</a>}
        <a class="knapp sekundar" href={STRATEGIERNAS_ADRESS}>Alla strategier</a>
      </p>
      <p class="st-utskriftsrad">{TVA_PA_A4}</p>
    </section>
  )}
  {d.ramar && (
    <section class="um-avsnitt" id="materialet-for-klassen">
      <h3>{d.ramar.rubrik}</h3>
      {(d.ramar.text ?? []).map((s: string) => <p set:html={k(s)} />)}
      {/* Varje blad med rubriken och texten först, sedan bilden och knappen som skriver ut just det bladet, så att bilden
          inte läses till texten ovanför i telefonen (design-3 nr 6). Rubriken och texten står i en spalt, som på datorn står
          samlad uppifrån bredvid bilden (lagningen inför lanseringen, D6). Under bladet står bara bladets pdf, och hela
          materialet har sina knappar en gång, efter bladen (A3). */}
      {(d.ramar.ramar ?? []).map((r: Ram, i: number) => (
        <div class={`um-blad-post${bladetsSidor(i).length > 1 ? ' um-blad-sidor' : ''}`} id={bladetsAnkare(r.rubrik)}>
          <div class="um-blad-kropp">
          <h4>{r.rubrik}</h4>
          {r.text.map((s) => <p set:html={k(s)} />)}
          {/* Ett blad med listor och delar, som strukturkorten i kooperativt lärande (riggens standard, avsnitt 7): stegen, vad
              strukturen tränar och Till läraren står under en rad som fälls ut, med rubrikerna ur bladet, så att sidan säger
              det bladet säger och listan med blad inte blir lång i telefonen. */}
          {((r.listor ?? []).length > 0 || (r.delar ?? []).length > 0) && (
            <details class="um-rad um-bladets-inne">
              <summary><span>{uppraknat([...(r.listor ?? []).map((l) => l.rubrik ?? ''), ...(r.delar ?? []).map((x) => x.rubrik)].filter(Boolean))}</span></summary>
              <div class="um-rad-inne">
                {(r.listor ?? []).map((l) => (
                  <>
                    {l.rubrik && <p class="um-ruta-rubrik">{l.rubrik}</p>}
                    {l.rader.length > 1 ? <ol>{l.rader.map((c) => <li set:html={k(c.join(' '))} />)}</ol> : <p set:html={k((l.rader[0] ?? []).join(' '))} />}
                  </>
                ))}
                {(r.delar ?? []).map((x) => (
                  <>
                    <p class="um-ruta-rubrik">{x.rubrik}</p>
                    <dl class="um-uppf">{x.falt.map((f) => <div><dt>{f.rubrik}</dt><dd set:html={k(f.text)} /></div>)}</dl>
                  </>
                ))}
              </div>
            </details>
          )}
          </div>
          {(() => {
            const sidor = bladetsSidor(i);
            const bilderna = sidor.map((b: { src: string; bredd: number; hojd: number }, n: number) => <a href={bladen[i]?.pdf ?? filer.materialet?.pdf} data-goatcounter-click={`fil:${bladen[i]?.pdf ? String(bladen[i].pdf).replace(/^.*\//, '').replace(/\?.*$/, '') : `${id}-materialet.pdf`}`} data-goatcounter-title={`Bilden av ${r.rubrik}, pdf, ${id}`} class={`um-sida${b.bredd > b.hojd ? ' um-sida-liggande' : ''}`}><img src={b.src} alt={sidor.length > 1 ? `${r.rubrik}, sidan ${n + 1} av ${sidor.length}` : r.rubrik} loading="lazy" decoding="async" width={b.bredd} height={b.hojd} /></a>);
            return sidor.length > 1 ? <div class="um-sidor">{bilderna}</div> : bilderna;
          })()}
          {bladen[i]?.pdf && <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['materialet']} blad={{ namn: r.rubrik, pdf: bladen[i].pdf! }} medFilval={ettBladMedSidor} />}
        </div>
      ))}
      {!ettBladMedSidor && <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['materialet']} />}
    </section>
  )}
  {d.planeringsmall && (
    <section class="um-avsnitt" id="planeringsmallen">
      <h3>{UM_NAMN.planeringsmall}</h3>
      <p set:html={k(d.planeringsmall.text)} />
      {bilder.planeringsmall?.length > 0 && <div class="um-sidor">{bilder.planeringsmall.map((b, i) => <a href={filer.planeringsmall?.pdf} data-goatcounter-click={`fil:${id}-planeringsmall.pdf`} data-goatcounter-title={`Bilden av planeringsmall, pdf, ${id}`} class="um-sida"><img src={b.src} alt={`Planeringsmallen, sidan ${i + 1}: Före lektionen med rutorna ${(d.planeringsmall.fore ?? []).map((x: { etikett: string }) => x.etikett).join(' och ')}, ${liten(slagetsOrd.delarna)} med ${liten(slagetsOrd.bladetsBeslut)}, och Efter lektionen`} loading="lazy" decoding="async" width={b.bredd} height={b.hojd} /></a>)}</div>}
      <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['planeringsmall']} />
    </section>
  )}
  {d.observation && (
    <section class="um-avsnitt" id="observationsmallen">
      <h3>{UM_NAMN.observation}</h3>
      <p><strong>Frågan:</strong> {d.observation.fraga}</p>
      <p set:html={k(d.observation.text)} />
      {bilder.observation?.length > 0 && <div class="um-sidor">{bilder.observation.map((b, i) => <a href={filer.observation?.pdf} data-goatcounter-click={`fil:${id}-observation.pdf`} data-goatcounter-title={`Bilden av observation, pdf, ${id}`} class="um-sida"><img src={b.src} alt={i === 0 ? `Observationsmallen, sidan 1: loggen under lektionen, från ${d.observation.delar?.[0]?.fas ?? 'början'} till ${d.observation.delar?.at(-1)?.fas ?? 'slutet'}` : `Observationsmallen, sidan ${i + 1}: efter lektionen, kärnan rad för rad och samtalet`} loading="lazy" decoding="async" width={b.bredd} height={b.hojd} /></a>)}</div>}
      <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['observation']} />
    </section>
  )}
  <UmFriaTabeller d={d} id={id} plats="bilaga-a" k={k} saker={saker} filer={tabellfiler} vavt={vavt} />
</section>

<section class="um-del" id="del-valet" aria-labelledby="del-valet-rubrik">
  <header class="um-band"><span class="um-band-nr" aria-hidden="true">B</span><div><h2 id="del-valet-rubrik"><span class="visually-hidden">Bilaga B: </span>{del('valet').namn}</h2><p>{del('valet').rad}</p></div></header>
  {d.passar && (
    <details class="um-rad um-rad-stor" id="nar-passar">
      <summary><h3>{d.passar.rubrik}</h3></summary>
      <div class="um-rad-inne">
      <table class="m-tabell stapla um-tabell">
        <thead><tr><th scope="col">Frågan</th><th scope="col">{d.titel}</th><th scope="col">En annan metod passar bättre</th></tr></thead>
        <tbody>{d.passar.rader.map((r: { fraga: string; metoden: string; annat: string }) => <tr><th scope="row" data-rubrik="Frågan">{r.fraga}</th><td data-rubrik={d.titel} set:html={k(r.metoden)} /><td data-rubrik="En annan metod passar bättre" set:html={k(r.annat)} /></tr>)}</tbody>
      </table>
      {d.passar.tumregel && <p set:html={k(d.passar.tumregel)} />}
      </div>
    </details>
  )}
  {d.invandningar && (
    <details class="um-rad um-rad-stor" id="invandningar">
      <summary><h3>{d.invandningar.rubrik}</h3></summary>
      <div class="um-rad-inne">
        {d.invandningar.fragor.map((f: { fraga: string; svar: string }) => <><p class="um-fraga">{f.fraga}</p><p set:html={k(f.svar)} /></>)}
      </div>
    </details>
  )}
  {d.grund && (
    <details class="um-rad um-rad-stor" id="forskningen">
      <summary><h3>{d.grund.rubrik}</h3></summary>
      <div class="um-rad-inne">
      {d.grund.text.map((s: string) => <p set:html={k(s)} />)}
      <p set:html={k(`${METODKORTET} säger hur väl forskningen stöder metoden i varje område, och varje rad där fälls ut till skälet.`)} />
      {urval.text && <div class="um-ruta"><p class="um-ruta-rubrik">Så valdes källorna</p><p set:html={k(urval.text)} />{urval.regel && <p class="um-not">Regeln: <span set:html={k(urval.regel)} /></p>}</div>}
      <div class="um-ruta" id="sa-lases-effekten"><p class="um-ruta-rubrik">{effektensSkala().rubrik}</p>{effektensSkala().text.map((s) => <p set:html={k(s)} />)}<p class="um-not">Skalans källor: {effektensSkala().kallor.map((x, i) => <>{i > 0 && ' '}<a href={`https://doi.org/${x.doi}`}>{x.text}</a></>)}</p></div>
      </div>
    </details>
  )}
  <details class="um-rad um-rad-stor um-referensblad" id="referensbladet">
    <summary><h3>Forskningen bakom {d.titel.toLocaleLowerCase('sv')}</h3></summary>
    <div class="um-rad-inne">
    <p class="um-not" set:html={k(`${(d.kallor ?? []).length} källor, valda ${urval.datum ? new Date(urval.datum).toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' }) : ''} efter metodens regel. Talet till vänster är källans effektstorlek, och ordet under säger hur stor den är, för den källan, eller Inte säker när källan säger att skillnaden inte är säker. Nivån i metodkortet väger alla källorna för området och hur säkra de är, så den kan ha ett annat ord. Märkena säger vilka rader i metodkortet källan bär.`)} />
    {KALLGRUPPER.map((g) => sorteradeKallor(g.id).length > 0 && (
      <div class="um-kallgrupp">
        <p class="um-kallgrupp-namn">{g.namn} <span set:html={k(g.text)} /></p>
        {slutsats(g.id) && <p class="um-slutsats"><strong>Slutsatsen.</strong> <span set:html={k(slutsats(g.id)!)} /></p>}
        <ol class="um-kallor">
          {sorteradeKallor(g.id).map((x: Record<string, any>) => {
            const e = x.effekt ? effektensDelar(x.effekt) : null;
            const l = kallansLank(x);
            return (
              <li class="um-kallpost" id={`kalla-${x.id}`}>
                <p class="um-kall-tal">{e && /\d/.test(e.tal) && <span class="um-kall-siffra">{e.tal}</span>}<span class={`um-kall-ord${e && !/\d/.test(e.tal) ? ' ensam' : ''}`}>{e ? e.ord : SLAGORD[x.slag] ?? x.slag}</span></p>
                <div>
                  <p>{x.adress ? <>{String(x.text).split(x.titel)[0]}<a href={x.adress}>{x.titel}</a>{String(x.text).split(x.titel).slice(1).join(x.titel)}</> : x.text}</p>
                  {/* Källans bidrag som metodens andra texter, så att en sak eller en strategi som den nämner, som Ord och bild, är en länk. */}
                  <p class="um-kall-rad"><Fragment set:html={k(e ? e.resten : x.bidrag)} />{l && <>{' · '}<a href={l.href}>{l.text}</a></>}</p>
                  {(x.omraden ?? []).length > 0 && <p class="um-markena">{x.omraden.map((o: string) => OMRADESORD[o] ?? o).join(', ')}</p>}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
    {urval.uteslutna?.length > 0 && (
      <div class="um-bortvalda">
        <p class="um-ruta-rubrik">Valdes bort</p>
        <ul>{urval.uteslutna.map((u: { namn: string; skal: string }) => <li><strong>{u.namn}.</strong> <span set:html={k(`${u.skal}${/[.!?]$/.test(u.skal) ? '' : '.'}`)} /></li>)}</ul>
      </div>
    )}
    <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['referensblad']} />
    </div>
  </details>
  {d.lasMer && (
    <details class="um-rad um-rad-stor" id="las-mer">
      <summary><h3>Läs mer</h3></summary>
      <div class="um-rad-inne">
      {LASGRUPPER.map((g) => lasGrupp(g.slag).length > 0 && (
        <div class="um-lasgrupp">
          <p class="um-ruta-rubrik">{g.namn} <span class="um-not">{g.text}</span></p>
          <ul class="um-lasmer">
            {lasGrupp(g.slag).map((x: Record<string, any>) => {
              const kk = lasMerKalla(x);
              const titel = kk ? kk.titel : x.titel;
              const adress = kk ? (kallansLank(kk)?.href ?? kk.adress) : x.adress;
              const upphov = kk ? kk.text.split(' (')[0] : x.upphov;
              const ar = kk ? kk.text.match(/\((\d{4})\)/)?.[1] : x.ar;
              return <li><a href={adress}>{titel}</a><p set:html={k(x.text)} /><p class="um-not">{upphov}{ar ? ` · ${ar}` : ''}</p></li>;
            })}
          </ul>
        </div>
      ))}
      </div>
    </details>
  )}
</section>
</div>
</div>

<script>
  import { talText, utfallensGranser, utfallensPar } from '../lib/standard/index.js';
  // Delraden visar delen läraren är i: den del vars band senast passerade toppen. Länken från lathunden, planen eller en
  // hänvisning öppnar raden den leder till, om raden är stängd.
  const lankar = [...document.querySelectorAll<HTMLAnchorElement>('#um-delrad a[data-del]')];
  const delarna = lankar.map((a) => document.getElementById(`del-${a.dataset.del}`)).filter((x): x is HTMLElement => !!x);
  const markera = () => {
    const y = 90;
    let aktiv = 0;
    delarna.forEach((s, i) => { if (s.getBoundingClientRect().top <= y) aktiv = i; });
    lankar.forEach((a, i) => (i === aktiv ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
  };
  addEventListener('scroll', markera, { passive: true });
  markera();
  const oppna = () => {
    const mal = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const rad = mal?.closest('details') ?? (mal instanceof HTMLDetailsElement ? mal : null);
    if (rad && !rad.open) { rad.open = true; mal!.scrollIntoView(); }
  };
  addEventListener('hashchange', oppna);
  oppna();
  // Utfallen för klassens antal (granskare-3 nr 2): läraren skriver antalet elever, och gränserna räknas om med standardens
  // utfallensGranser, samma rot som metodens text och planeringsbladet.
  for (const ruta of document.querySelectorAll<HTMLElement>('[data-utfall]')) {
    const falt = ruta.querySelector<HTMLInputElement>('input[type="number"]');
    falt?.addEventListener('input', () => {
      const n = Math.round(Number(falt.value));
      if (!(n >= 10 && n <= 40)) return;
      const g = utfallensGranser(n);
      const tal: Record<string, number> = { nastanAlla: g.nastanAlla, deFlesta0: g.deFlesta[0], deFlesta1: g.deFlesta[1], halften: g.halften };
      for (const e of ruta.querySelectorAll<HTMLElement>('[data-grans]')) e.textContent = String(tal[e.dataset.grans ?? ''] ?? e.textContent);
      for (const e of ruta.querySelectorAll<HTMLElement>('[data-elever]')) e.textContent = String(n);
      // Paren, i en metod som också säger dem, med ord som i metodens mening: "alltså högst två par".
      const p = utfallensPar(n);
      const par: Record<string, number> = { nastanAlla: p.nastanAlla, deFlesta0: p.deFlesta[0], deFlesta1: p.deFlesta[1], halften: p.halften };
      for (const e of ruta.querySelectorAll<HTMLElement>('[data-par]')) e.textContent = talText(par[e.dataset.par ?? ''] ?? 0);
    });
  }
</script>
