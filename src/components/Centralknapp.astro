---
// Knappen till en central sak (src/lib/centrala.ts), med sakens namn: under ingressen, överst i menyn, i texten och på
// metodens kort. En pdf öppnas i en ny flik och har ett namn i statistiken. medTitel säger metodens namn till en
// skärmläsare, där flera metoder står bredvid varandra, som i metodbanken.
// Knappen ritas av centralKnappHtml, som länkningen i texten också använder (src/lib/boklankar.ts).
import { centralKnappHtml, type Central } from '../lib/centrala';
interface Props { c: Central; metod: string; titel: string; klass?: string; medTitel?: boolean }
const { c, metod, titel, klass = 'knapp', medTitel = false } = Astro.props;
---
<Fragment set:html={centralKnappHtml(c, metod, titel, klass, medTitel)} />
