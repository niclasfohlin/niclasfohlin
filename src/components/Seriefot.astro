---
// Sist på en lektions sida: föregående och nästa lektion i bankens ordning. Alla lektioner finns i seriens meny överst
// (Seriemeny.astro). Den första lektionen leder tillbaka till den generella metoden, och den sista till banken.
import type { SerieKoppling } from '../lib/serie';
interface Props { koppling: SerieKoppling }
const { koppling } = Astro.props;
const { serie, lektion, forra, nasta } = koppling;
const bas = '/stodundervisning';
---
{lektion && (
  <nav class="serie-fot" aria-label={`Lektionerna i ${serie.titel}`}>
    <p class="serie-bladdra">
      {forra
        ? <a class="forra" href={`${bas}/${forra.id}`}><span class="serie-bladdra-etikett">Förra lektionen</span>{forra.namn}</a>
        : <a class="forra" href={`${bas}/${serie.id}`}><span class="serie-bladdra-etikett">Tillbaka till</span>{serie.titel}</a>}
      {nasta
        ? <a class="nasta" href={`${bas}/${nasta.id}`}><span class="serie-bladdra-etikett">Nästa lektion</span>{nasta.namn}</a>
        : <a class="nasta" href={`${bas}/${serie.id}#lektionsbank`}><span class="serie-bladdra-etikett">Alla lektioner</span>{serie.titel}</a>}
    </p>
  </nav>
)}
