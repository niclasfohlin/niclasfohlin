---
// En lästext som en sida i en gammal bok (K-148; Niclas 2026-10-01: "se ut som en gamla bok", ett till ett med
// metodriggen), som i Word (boksida() i src/lib/metoddocx.ts): en dubbel ram, titeln i Cinzel med en röd dubbel linje
// under, ett anfang i Cinzel Decorative, texten i elevens typsnitt med en rad per rad, frågorna numrerade under en tunn
// linje, och raden Till läraren och nivåns knapp under ramen. Ramens text står inte här, eftersom bladet är elevens. I
// utskriften står boksidan på en egen sida (global.css). Rubriken säger nivån och texten för skärmläsare, som ramens
// rubrik gör; på sidan syns bara titeln, som i boken.
import type { Lastext } from '../lib/ramform';
import { BOKRAD, boksidansMatt } from '../lib/boksida';
interface Props {
  l: Lastext;
  /** Ramens ankare (ram-1 …) och rubrikens, som länkarna till ramarna pekar på. */
  id: string;
  ankare: string;
  /** Nivåns färg, i den ordning nivåerna först kommer (grön, ockra, plommon). */
  farg: string;
}
const { l, id, ankare, farg } = Astro.props;
const rader = (t: string) => t.split('\n');
// Fet och kursiv stil i en rad, som bokRuns i Word: **ord** och *ord* (förlagornas mellanrubriker i Ordverkstad i grupp).
type Del = { text: string; fet?: boolean; kursiv?: boolean };
const delar = (r: string): Del[] => {
  const ut: Del[] = [];
  let sist = 0;
  for (const m of r.matchAll(/\*\*[^*]+\*\*|\*[^*]+\*/g)) {
    if (m.index! > sist) ut.push({ text: r.slice(sist, m.index) });
    ut.push(m[0].startsWith('**') ? { text: m[0].slice(2, -2), fet: true } : { text: m[0].slice(1, -1), kursiv: true });
    sist = m.index! + m[0].length;
  }
  if (sist < r.length) ut.push({ text: r.slice(sist) });
  return ut;
};
// Måtten är Word-sidans, ur samma uträkning (src/lib/boksida.ts): textens storlek och radavstånd, anfangets storlek,
// dess kolumn och rad, och vad som står bredvid bokstaven (två rader, som Niclas valde i riggen) och under den. Bredden
// och höjden står i em av textens storlek, så att utskriften (texten i Words punkter) blir som Word och skärmen samma
// form i sin storlek. Lättläst har en mening per rad i större text, löpande text står mindre, som i Word.
const matt = boksidansMatt(l);
const em = (twips: number) => `${(twips / 20 / matt.pt).toFixed(3)}em`;
const stil = [
  `--bok-niva: ${farg}`,
  `--bok-pt: ${matt.pt}pt`,
  `--bok-rad: ${(BOKRAD.Andika * matt.line / 240).toFixed(3)}`,
  `--bok-kol: ${em(matt.kolW)}`,
  `--bok-anfang-h: ${em(matt.anfangH)}`,
  `--bok-anfang: ${(matt.storPt / matt.pt).toFixed(3)}em`,
].join('; ');
const ovriga = l.stycken.slice(1);
const fraga = (f: string) => f.match(/^(\d+)\.\s*([\s\S]*)$/);
---
<section class:list={['m-ram', 'boksida', { korta: matt.kortaRader }]} id={id} style={stil}>
  <div class="boksida-ram">
    <h3 id={ankare} class="boksida-titel"><span class="visually-hidden">{l.niva}, {l.vad}: </span>{l.titel}</h3>
    <div class="boksida-text">
      {/* Anfanget som i Word: bokstaven i en egen kolumn och de två första raderna bredvid, resten i full bredd under.
          Bokstaven är dold för skärmläsare och står kvar i ordet, så att ordet läses helt. */}
      <div class="boksida-anfang">
        <span class="boksida-kol" aria-hidden="true"><span class="boksida-bokstav">{matt.bokstav}</span></span>
        <p><span class="visually-hidden">{matt.bokstav}</span>{rader(matt.delat.inne).map((r, j) => <>{j > 0 && <br />}{delar(r).map((x) => (x.fet ? <strong>{x.text}</strong> : x.kursiv ? <em>{x.text}</em> : x.text))}</>)}</p>
      </div>
      {matt.delat.rest && <p>{rader(matt.delat.rest).map((r, j) => <>{j > 0 && <br />}{delar(r).map((x) => (x.fet ? <strong>{x.text}</strong> : x.kursiv ? <em>{x.text}</em> : x.text))}</>)}</p>}
      {ovriga.map((s) => <p>{rader(s).map((r, j) => <>{j > 0 && <br />}{delar(r).map((x) => (x.fet ? <strong>{x.text}</strong> : x.kursiv ? <em>{x.text}</em> : x.text))}</>)}</p>)}
    </div>
    {/* Numret är text, som i Word, där det står före frågan med en tabb, så att en fråga på flera rader står under sin början. */}
    <ol class="boksida-fragor">
      {l.fragor.map((f) => {
        const n = fraga(f);
        return <li><span class="boksida-nr">{n ? `${n[1]}.` : ''}</span><span>{rader(n ? n[2] : f).map((r, j) => <>{j > 0 && <br />}{delar(r).map((x) => (x.fet ? <strong>{x.text}</strong> : x.kursiv ? <em>{x.text}</em> : x.text))}</>)}</span></li>;
      })}
    </ol>
  </div>
  <p class="boksida-fot"><span>{l.not}</span> <span class="boksida-knapp">{l.niva.toUpperCase()}{!/^kartläggning/i.test(l.vad) && <>{' · '}{l.vad}</>}</span></p>
</section>
