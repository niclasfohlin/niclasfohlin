---
// En elevlista i en ram: orden stora och lätta att peka i, kolumnrubrikerna små och dämpade och
// bara när de betyder något, ingen fet första kolumn. Bokstäver centreras; en enda kolumn (meningar,
// en text) sätts något mindre. Samma lista finns i Word (elevlista i src/lib/metoddocx.ts). Bråken står
// staplade, som i elevens läromedel (Brak.astro).
import Brak from './Brak.astro';
import { harFragor, textlangd } from '../lib/ramform';
import { skyltText, type Niva } from '../lib/nivaer';
// brak: bråken staplas (metoder i matematik); annars står texten som den är.
// huvud: ramens fält att fylla i före listan (elevens namn på kartläggningens kopia), i samma block som listan.
// elev: metoden har kort i elevens typsnitt (src/lib/ljudkort.ts), så bladet eleven läser står i det också; lärarens
// protokoll behåller husets typsnitt.
// niva: listans nivå (src/lib/nivaer.ts), som en skylt i nivåns färg före rubriken, där nivåns led inte står kvar.
// id: ett ankare på listan (räknebladen, som kartan leder till, src/lib/karta.ts).
interface Props { rubrik?: string; kolumner?: string[]; rader: string[][]; klass?: string; brak?: boolean; huvud?: { rubrik: string; text: string }[]; elev?: boolean; niva?: Niva; id?: string }
const { rubrik, kolumner, rader, klass = '', brak = false, huvud, elev = false, niva, id } = Astro.props;
// En kolumn där alla rader är tomma, bredvid kolumner med text, är en skrivkolumn (kartläggningens Före och Efter):
// smal, och räknas inte när listan avgör om den är en enda kolumn text. Är alla kolumner tomma (ett schema att fylla
// i) är ingen smal. Samma regel som i Word (elevlista i src/lib/metoddocx.ts).
const n = Math.max(...rader.map((r) => r.length), kolumner?.length ?? 1);
const tomma = Array.from({ length: n }, (_, i) => rader.every((r) => !(r[i] ?? '').trim()));
const skriv = tomma.every(Boolean) ? tomma.map(() => false) : tomma;
const bokstaver = rader.every((r) => r.every((c) => c.trim().length <= 2));
const enKolumn = skriv.filter((s) => !s).length === 1;
// Många skrivkolumner (gruppens översikt i Ljudlek i grupp har nio) delar på bredden i stället för att vara 4,5 rem var,
// så att protokollet ryms på telefonen och i utskriften.
const manga = skriv.filter(Boolean).length > 4;
// Ett tomt schema med många kolumner (Sagokollen i Skrivkurs: sagoboken, sju kolumner) rullar i sidled på telefonen, så
// att kolumnrubrikerna inte skrivs in i varandra (granskningen i telefonen 2026-10-10).
const schema = tomma.every(Boolean) && n >= 5;
const protokoll = skriv.some(Boolean);
// En pil står kvar med orden på båda sidor ("sss-ooo-lll → sol" på strategikortet), också när raden bryts på mobilen.
const pil = (c: string) => c.replace(/ → /g, ' → ');
// En text med frågor (screeningens nivå 6–8, src/lib/ramform.ts): texten som eleven läser och frågorna som läraren läser
// upp står för sig, bredvid varandra på datorn och efter varandra på telefonen. Samma form i Word (fragelista).
const fragor = harFragor({ kolumner, rader }) ? rader.map((r) => (r[1] ?? '').trim()).filter(Boolean) : undefined;
---
<div id={id} class={`m-lista ${bokstaver ? 'bokstaver' : ''} ${enKolumn ? 'en-kolumn' : ''} ${protokoll ? 'protokoll' : ''} ${manga ? 'manga' : ''} ${schema ? 'schema' : ''} ${elev && !protokoll ? 'elev' : ''} ${fragor ? `fragor text-${textlangd({ rader })}` : ''} ${klass}`.replace(/\s+/g, ' ').trim()}>
  {huvud && (
    <dl class="m-ramfalt m-ramhuvud">
      {huvud.map((f) => <div><dt>{f.rubrik}</dt><dd>{f.text}</dd></div>)}
    </dl>
  )}
  {rubrik && <h4 class="m-lista-rubrik">{niva && <><span class="m-niva" style={`--niva:#${niva.farg};--niva-text:#${skyltText(niva.farg)}`}>{niva.namn}</span>{' '}</>}{rubrik}</h4>}
  {fragor ? (
    <div class="m-fragetext">
      <div class="m-texten">{rader.map((r) => <p>{r[0]}</p>)}</div>
      <div class="m-fragorna"><p class="visually-hidden">Frågorna, som läraren läser upp:</p>{fragor.map((f) => <p>{f}</p>)}</div>
    </div>
  ) : (
    <table>
      {kolumner && <thead><tr>{kolumner.map((k, i) => <th scope="col" class={skriv[i] ? 'skriv' : undefined}>{k}</th>)}</tr></thead>}
      <tbody>
        {rader.map((r) => <tr>{r.map((c, i) => <td class={skriv[i] ? 'skriv' : undefined}><Brak text={pil(c)} stapla={brak} /></td>)}</tr>)}
      </tbody>
    </table>
  )}
</div>
