---
// Materialets innehåll (K-152): ramarna som en ordnad lista, byggd ur rubrikerna och lästexterna (src/lib/ramindex.ts).
// En lästext och dess lärarsida står på en rad under sin nivå, med textens nummer först. Det som listar många saker på en
// gång fälls ut (Niclas 2026-10-01 valde förslag A, "för saker som listas många saker i samtidigt", som lektionerna i
// Ljudlek i grupp): en nivå alltid, och en grupp med samma led före kolon ("Åk 1") när den har FALL_UT rader eller fler.
// Listan finns bara på skärmen; utskriften gömmer den (global.css, .m-ramlankar).
import { ramindex, type Indexrad } from '../lib/ramindex';
import { ejBryt } from '../lib/metod';
interface Props {
  ramar: Parameters<typeof ramindex>[0];
  rubrik: string;
  /** Nivåernas färger, i den ordning nivåerna först kommer, som boksidornas knapp. */
  farger: string[];
}
const { ramar, rubrik, farger } = Astro.props;
const FALL_UT = 6;
// Ett led som är längre än ledets spalt (omkring nio tecken, "Åk 4–5" ryms och "Kartläggning" inte) står på en egen rad
// över sina ramar (granskningen 2026-10-01, K-156).
const LANGT_LED = 9;
const poster = ramindex(ramar);
// "Åk 4–5" hålls ihop, som i ramarnas rubriker, och ett tal sist står kvar med ordet före ("Lördag klockan 14").
const hel = (s: string) => ejBryt(s.replace(/(Åk|åk) (?=\d)/g, '$1 ')).replace(/ (\d{1,4})$/, ' $1');
// Nivåns antal är dess numrerade texter, som metodens text räknar dem ("femton texter"), och alla rader om ingen är numrerad.
const antal = (rader: Indexrad[]) => { const n = rader.filter((r) => /^\d+$/.test(r.etikett ?? '')).length || rader.length; return n === 1 ? 'en text' : `${n} texter`; };
const arNummer = (s?: string) => !!s && /^\d+$/.test(s);
---
<nav class="m-ramlankar ri" aria-label={`Hoppa till: ${rubrik}`}>
  <ul class="ri-lista">
    {poster.map((p) => {
      if (p.typ === 'rad') return <li class="ri-post"><a class="ri-lank" href={`#ram-${p.rad.lank.nr}`}>{hel(p.rad.lank.namn)}</a></li>;
      if (p.typ === 'led') {
        // Länken bär ledet för den som läser länkarna för sig ("Läxa 1–5, Åk 1"), som Lärarens sida bär sin titel.
        const lankar = <ul>{p.rader.map((r) => <li><a class="ri-lank" href={`#ram-${r.lank.nr}`}>{hel(r.lank.namn)}<span class="visually-hidden">, {p.namn}</span></a></li>)}</ul>;
        if (p.rader.length >= FALL_UT) return <li class="ri-post ri-led-fall"><details><summary><span class="ri-nivanamn">{hel(p.namn)}</span></summary>{lankar}</details></li>;
        return <li class={`ri-post ri-led${p.namn.length > LANGT_LED ? ' ri-led-lang' : ''}`}><span class="ri-ledrubrik">{hel(p.namn)}</span>{lankar}</li>;
      }
      return (
        <li class="ri-post ri-niva" style={`--niva: ${farger[p.nivaNr] ?? 'var(--farg-accent)'}`}>
          <details>
            <summary><span class="ri-nivanamn ri-prick">{p.namn}</span><span class="ri-antal">{antal(p.rader)}</span></summary>
            <ol class="ri-texter">
              {p.oversikt && <li class="ri-rad"><span class="ri-nr" aria-hidden="true"></span><a class="ri-titel" href={`#ram-${p.oversikt.nr}`}>Översikt<span class="visually-hidden">: {p.oversikt.namn}</span></a></li>}
              {p.rader.map((r: Indexrad) => (
                <li class="ri-rad">
                  {/* Numret står för sig; kartläggningens namn står i länken, över titeln, så att länken säger vad den är och fyller raden. */}
                  {arNummer(r.etikett)
                    ? <><span class="ri-nr">{r.etikett}</span><a class="ri-titel" href={`#ram-${r.lank.nr}`}>{hel(r.lank.namn)}</a></>
                    : <><span class="ri-nr" aria-hidden="true"></span><a class="ri-titel" href={`#ram-${r.lank.nr}`}><span class="ri-forled">{r.etikett}</span>{' '}{hel(r.lank.namn)}</a></>}
                  {r.extra && <a class="ri-extra" href={`#ram-${r.extra.nr}`} aria-label={`${r.extra.etikett}, ${r.extra.namn}`}>{r.extra.etikett}</a>}
                </li>
              ))}
            </ol>
          </details>
        </li>
      );
    })}
  </ul>
</nav>
