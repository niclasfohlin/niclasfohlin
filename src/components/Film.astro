---
// En film ur metodriggen (src/lib/film.ts) på metodens sida: huvudfilmen efter faktarutan eller en extrafilm vid sitt
// moment, alltid genom Filmruta.astro, som också ritar utskriftens stillbilder på samma plats. Filmen loopar och har inget
// ljud.
//
// Filmen står i en <object>, inte en <img> (Niclas 2026-09-30: på datorn stod filmen still utan knapp, och Pausa började
// om filmen i stället för att frysa den). Som <object> är svg-filen ett eget dokument, så dess globala CSS (g, korta id
// och @keyframes) stannar i filmen, men sidan når in i den: Pausa sätter --spel: paused och fryser filmen där den är,
// Spela fortsätter därifrån (WCAG 2.2.2), och skriptet tar bort filmens regel för minskad rörelse, så att filmen spelar
// också på en dator där Windows animeringar är avstängda ("Den måste ju spela alldeles oavsett"). Netlify skickar
// X-Frame-Options: SAMEORIGIN, så att sidan får bädda in sin egen fil (netlify.toml). Går filmen inte att bädda in
// byter skriptet till en <img> med samma fil. En extrafilm hämtas först när läsaren närmar sig den.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { FILM_MATT, filmAdress, filmNamn, stillbilder, type MetodFilm } from '../lib/film';
interface Props { f: MetodFilm; titel: string }
const { f, titel } = Astro.props;
// En film vars filer saknas stoppar bygget, så att en sida aldrig visar en trasig bild.
for (const fil of [filmAdress(f), ...stillbilder(f)]) {
  if (!existsSync(join(process.cwd(), 'public', fil))) throw new Error(`${titel}: filmens fil ${fil} saknas i public/. Filerna kommer i metodriggens filmpaket (out/filmpaket/).`);
}
const sekunder = Math.round(f.film.sekunder);
const alt = `${filmNamn(f)}, filmen: ${f.film.beskrivning}`;
---
<figure class="film" data-film={filmAdress(f)} data-namn={filmNamn(f)}>
  <object class="film-bild" type="image/svg+xml" data={f.huvud ? filmAdress(f) : undefined} role="img" aria-label={alt} width={FILM_MATT.bredd} height={FILM_MATT.hojd}>
    <img src={stillbilder(f)[0]} alt={alt} width={FILM_MATT.bredd} height={FILM_MATT.hojd} loading="lazy" decoding="async" />
  </object>
  <figcaption>
    <button type="button" class="film-knapp" hidden>Pausa</button>
    <span><strong>{filmNamn(f)}</strong> · {sekunder} sekunder, som börjar om</span>
  </figcaption>
</figure>

<script>
  // Filmen i <object>: skriptet tar bort filmens regel för minskad rörelse, så att den spelar, och ger knappen Pausa och
  // Spela, som fryser och fortsätter filmen genom CSS-variabeln --spel i svg-filen.
  const figurer = [...document.querySelectorAll<HTMLElement>('figure.film[data-film]')];
  const somBild = (figur: HTMLElement, obj: HTMLObjectElement) => {
    // Skyddsnätet: går filmen inte att bädda in visas den som bild, som förut.
    const bild = document.createElement('img');
    bild.src = figur.dataset.film!;
    bild.alt = obj.getAttribute('aria-label') ?? '';
    bild.width = 960;
    bild.height = 540;
    bild.className = 'film-bild';
    obj.replaceWith(bild);
  };
  const starta = (figur: HTMLElement, obj: HTMLObjectElement) => {
    const svg = obj.contentDocument?.documentElement;
    if (!svg || svg.nodeName.toLowerCase() !== 'svg') return false;
    // Filmen spelar också med minskad rörelse: regeln som stänger av den tas bort ur filmens egna stilar.
    for (const blad of [...(obj.contentDocument?.styleSheets ?? [])]) {
      const regler = blad.cssRules;
      for (let i = regler.length - 1; i >= 0; i--) {
        const r = regler[i] as CSSMediaRule;
        if (r.media && r.media.mediaText.includes('prefers-reduced-motion')) blad.deleteRule(i);
      }
    }
    const knapp = figur.querySelector<HTMLButtonElement>('.film-knapp');
    if (!knapp) return true;
    const namn = figur.dataset.namn ?? '';
    const satt = (spelar: boolean) => {
      svg.style.setProperty('--spel', spelar ? 'running' : 'paused');
      knapp.textContent = spelar ? 'Pausa' : 'Spela';
      knapp.setAttribute('aria-label', `${spelar ? 'Pausa' : 'Spela'} filmen ${namn}`.trim());
    };
    knapp.hidden = false;
    knapp.onclick = () => satt(knapp.textContent !== 'Pausa');
    satt(true);
    return true;
  };
  const ladda = (figur: HTMLElement) => {
    const obj = figur.querySelector<HTMLObjectElement>('object.film-bild');
    if (!obj) return;
    let klar = false;
    const forsok = () => { if (!klar && starta(figur, obj)) klar = true; };
    // Vid varje laddning, inte bara den första: en webbläsare som gör om filmens dokument när filmen har varit gömd
    // och visas igen (spelaren på lathundssidan, Filmspelare.astro) ska få regeln för minskad rörelse borttagen och
    // Pausa kopplad till det nya dokumentet. Chrome behåller dokumentet; Safari är oprövad (granskningen 2026-10-07).
    obj.addEventListener('load', () => { klar = false; forsok(); if (!klar) somBild(figur, obj); });
    if (!obj.getAttribute('data')) obj.setAttribute('data', figur.dataset.film!);
    forsok();
    // Laddar filmen inte alls inom tio sekunder visas den som bild.
    setTimeout(() => { forsok(); if (!klar && obj.isConnected) somBild(figur, obj); }, 10000);
  };
  // Huvudfilmen laddas direkt, en extrafilm när läsaren närmar sig den.
  const nara = 'IntersectionObserver' in window
    ? new IntersectionObserver((poster, iakttagare) => { for (const p of poster) if (p.isIntersecting) { iakttagare.unobserve(p.target); ladda(p.target as HTMLElement); } }, { rootMargin: '600px 0px' })
    : undefined;
  for (const figur of figurer) {
    const obj = figur.querySelector('object.film-bild');
    if (obj?.getAttribute('data') || !nara) ladda(figur);
    else nara.observe(figur);
  }
</script>
