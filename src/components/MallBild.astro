---
// En mall som bild på sidan: bråkplanket, tallinjerna, en matta, ett rutnät eller ett flöde, ritade som SVG i millimeter ur samma geometri som
// Word-filen (src/lib/brak.ts). På skärmen fyller bilden bredden, och på en smal skärm går den att svepa i sidled.
// I utskriften får den sitt riktiga mått på en liggande sida (global.css, .m-mall). Planeringsmallarna i Word är
// förlagan att skriva ut.
import { delnamn, lage, STANDARD_NAMNARE, TWIP_MM, type Mall } from '../lib/brak';
import TECKENBREDD from '../data/teckenbredd.json';
interface Props { mall: Mall }
// Ett bandnamn i rader som ryms i bredden (mm), mätt med Andikas egna bredder (src/data/teckenbredd.json, samma som
// Word-filen mäter med) och 2 procent för den feta stilen. Bandets text står i elevens typsnitt (global.css).
const BAND_FS = 5.6;
const BAND_RAD = BAND_FS * 1.25;
const TECKEN = new Map([...TECKENBREDD.tecken].map((c, i) => [c, i]));
const ANDIKA = (TECKENBREDD.bredd as Record<string, (number | null)[]>).Andika;
const textBredd = (s: string, fs: number) => [...s].reduce((a, c) => a + (ANDIKA[TECKEN.get(c) ?? -1] ?? 600) / 1000, 0) * fs * 1.02;
function radbryt(text: string, bredd: number, fs: number): string[] {
  const ut: string[] = [];
  let rad = '';
  for (const ord of text.split(/\s+/).filter(Boolean)) {
    const prov = rad ? `${rad} ${ord}` : ord;
    if (rad && textBredd(prov, fs) > bredd) { ut.push(rad); rad = ord; } else rad = prov;
  }
  return rad || !ut.length ? [...ut, rad] : ut;
}
const m = Astro.props.mall;
const r2 = (v: number) => Math.round(v * 100) / 100;
const L = (m.langdCm ?? 26) * 10;
const rutor: { x: number; y: number; w: number; h: number; band?: boolean }[] = [];
const streck: { x1: number; y1: number; x2: number; y2: number; w: number }[] = [];
const texter: { x: number; y: number; t: string; fs: number }[] = [];
const namn: { x: number; y: number; t: string }[] = [];
// Kolumnnamnen i en mattas band: feta, till vänster eller i mitten.
const etiketter: { x: number; y: number; t: string; fs: number; mitt: boolean; komma?: boolean }[] = [];
let bredd = L + 1;
let hojd = 0;
// Ett ark per talsort visas som arken bredvid varandra: i utskriften får bilden sidans bredd, inte arkens mått.
const oversikt = m.typ === 'matta' && !!m.enPerSida;
if (m.typ === 'flode') {
  // Ett flöde, som i Word: rutor i följd med namnet i ett ljust band och en pil mitt för rutorna mellan dem.
  const kolumner = m.kolumner ?? [];
  const B = 15398 * TWIP_MM;
  const pil = 700 * TWIP_MM;
  const w = (B - pil * (kolumner.length - 1)) / kolumner.length;
  // Rutornas höjd som i Word: 8 000 twips utan fot, 7 000 med (metoddocx.ts, ELEVBLAD_HOJD).
  const h = (m.fot ? 7000 : 8000) * TWIP_MM;
  const band = 12;
  kolumner.forEach((k, i) => {
    const x = 0.5 + i * (w + pil);
    rutor.push({ x, y: 0.5, w, h: band, band: true }, { x, y: 0.5 + band, w, h });
    etiketter.push({ x: x + 2.5, y: 0.5 + band * 0.66, t: k, fs: 5.6, mitt: false });
    if (i < kolumner.length - 1) texter.push({ x: x + w + pil / 2, y: 0.5 + band + h / 2 + 4, t: '→', fs: 11 });
  });
  bredd = B + 1;
  hojd = band + h + 1;
} else if (m.typ === 'matta' || m.typ === 'rutnat') {
  // En matta (decimalmattan), som i Word: kolumner med namnet i ett ljust band och höga rutor som fyller den liggande
  // sidan, och ett decimalkomma i en smal kolumn utan ram. Med enPerSida ett stående ark per kolumn, bredvid varandra.
  // Ett rutnät är samma blad med rader, som delar höjden.
  const kolumner = m.kolumner ?? [];
  if (m.enPerSida) {
    const w = 9638 * TWIP_MM;
    const h = 11900 * TWIP_MM;
    const band = 18;
    kolumner.forEach((k, i) => {
      const x = 0.5 + i * (w + 10);
      rutor.push({ x, y: 0.5, w, h: band, band: true }, { x, y: 0.5 + band, w, h });
      etiketter.push({ x: x + w / 2, y: 0.5 + band * 0.7, t: k, fs: 13, mitt: true });
    });
    bredd = kolumner.length * (w + 10) - 10 + 1;
    hojd = band + h + 1;
  } else {
    const B = 15398 * TWIP_MM;
    const kb = m.komma ? 1000 * TWIP_MM : 0;
    const w = (B - kb) / kolumner.length;
    // Bandet rymmer en rad. Ett långt kolumnnamn bryts i kolumnens bredd, bandet växer och rutorna under krymper lika
    // mycket, som i Word (mattaTabell i src/lib/metoddocx.ts): Parets väg skrev annars namnen över varandra.
    const etikettRader = kolumner.map((k) => radbryt(k, w - 5, BAND_FS));
    const extra = (Math.max(1, ...etikettRader.map((r) => r.length)) - 1) * BAND_RAD;
    const band = 12 + extra;
    const h = (m.typ === 'rutnat' && !m.fot ? 8000 : 7000) * TWIP_MM - extra;
    const rader = m.rader ?? 1;
    let x = 0.5;
    kolumner.forEach((k, i) => {
      rutor.push({ x, y: 0.5, w, h: band, band: true });
      for (let r = 0; r < rader; r++) rutor.push({ x, y: 0.5 + band + (r * h) / rader, w, h: h / rader });
      etikettRader[i].forEach((t, j) => etiketter.push({ x: x + 2.5, y: 0.5 + 12 * 0.66 + j * BAND_RAD, t, fs: BAND_FS, mitt: false }));
      x += w;
      if (m.komma === i + 1) {
        etiketter.push({ x: x + kb / 2, y: 0.5 + band + h - 12, t: ',', fs: 40, mitt: true, komma: true });
        x += kb;
      }
    });
    bredd = B + 1;
    hojd = band + h + 1;
  }
} else if (m.typ === 'brakplank') {
  // En rad per nämnare, varje rad lika lång som det hela och delad i lika stora delar, med bråket staplat i varje bit.
  const h = (m.radhojd ?? 800) * TWIP_MM;
  const namnare = m.namnare ?? STANDARD_NAMNARE;
  namnare.forEach((n, rad) => {
    const y = 0.5 + rad * h;
    for (let k = 0; k < n; k++) {
      const x0 = 0.5 + lage(L, k, n, false);
      const x1 = 0.5 + lage(L, k + 1, n, false);
      rutor.push({ x: x0, y, w: x1 - x0, h });
      if (m.etiketter === false) continue;
      const fs = h >= 21 ? (n >= 10 ? 4.5 : 5.6) : n >= 10 ? 3.6 : 4.2;
      const cx = (x0 + x1) / 2;
      const cy = y + h / 2;
      if (n === 1) texter.push({ x: cx, y: cy + fs * 0.36, t: '1', fs });
      else {
        const b = fs * (String(n).length * 0.62 + 0.35);
        texter.push({ x: cx, y: cy - fs * 0.22, t: '1', fs });
        streck.push({ x1: cx - b / 2, y1: cy, x2: cx + b / 2, y2: cy, w: fs * 0.07 });
        texter.push({ x: cx, y: cy + fs * 0.94, t: String(n), fs });
      }
    }
  });
  hojd = namnare.length * h + 1;
} else {
  // Varje linje från 0 till `till`, med ett streck vid varje del och talen vid hela tal. Strecken vid hela tal är
  // tjockare, och linjen fortsätter en bit efter sista strecket, eftersom talen fortsätter. Linjerna är centrerade.
  const marg = 283 * TWIP_MM;
  const halv = 150 * TWIP_MM;
  const etikett = 380 * TWIP_MM;
  const langst = Math.max(...(m.linjer ?? []).map((ln) => (ln.langdCm ? ln.langdCm * 10 : L)));
  bredd = langst + 2 * marg;
  let y = 0;
  (m.linjer ?? []).forEach((ln, i) => {
    y += (i ? m.mellanrum ?? 420 : 300) * TWIP_MM;
    const Ln = ln.langdCm ? ln.langdCm * 10 : L;
    const N = ln.delar * ln.till;
    const ox = (bredd - Ln) / 2;
    // En delad linje bär delarnas namn till vänster ovanför linjen (src/lib/brak.ts, delnamn).
    if (delnamn(ln.delar)) namn.push({ x: ox, y: y - 1.2, t: delnamn(ln.delar) });
    streck.push({ x1: ox, y1: y + halv, x2: ox + Ln + marg, y2: y + halv, w: 0.44 });
    for (let k = 0; k <= N; k++) {
      const x = ox + lage(Ln, k, N, false);
      const hel = k % ln.delar === 0;
      streck.push({ x1: x, y1: y, x2: x, y2: y + 2 * halv, w: hel ? 0.62 : 0.35 });
      if (hel) texter.push({ x, y: y + 2 * halv + 4.1, t: String(k / ln.delar), fs: 3.9 });
    }
    y += 2 * halv + etikett;
  });
  hojd = y + 1;
}
---
<svg class={`m-mall-bild${oversikt ? ' oversikt' : ''}`} xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${r2(bredd)} ${r2(hojd)}`} style={`--bredd:${r2(bredd)}`} role="img" aria-label={m.rubrik}>
  {rutor.map((r) => <rect class={r.band ? 'band' : undefined} x={r2(r.x)} y={r2(r.y)} width={r2(r.w)} height={r2(r.h)}></rect>)}
  {etiketter.map((t) => <text class={`band${t.mitt ? ' mitt' : ''}${t.komma ? ' komma' : ''}`} x={r2(t.x)} y={r2(t.y)} font-size={t.fs}>{t.t}</text>)}
  {streck.map((s) => <line x1={r2(s.x1)} y1={r2(s.y1)} x2={r2(s.x2)} y2={r2(s.y2)} stroke-width={r2(s.w)}></line>)}
  {texter.map((t) => <text x={r2(t.x)} y={r2(t.y)} font-size={t.fs}>{t.t}</text>)}
  {namn.map((t) => <text class="namn" x={r2(t.x)} y={r2(t.y)} font-size="3.8">{t.t}</text>)}
</svg>
