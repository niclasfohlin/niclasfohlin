---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Sätt till 'article' för artiklar och metoder. */
  typ?: 'website' | 'article';
  /** Absolut eller rotrelativ sökväg till delningsbild. Utan egen bild används porträttet. */
  bild?: string;
  /** Sidfot på varje utskriven sida (upphov och adress). Sätts som --tryck-text på html och
   *  läses av @page @bottom-center i global.css; sidan lägger också en .tryck-fot för webbläsare utan marginalrutor. */
  tryckText?: string;
}

const { title, description = site.beskrivning, typ = 'website', bild = site.delningsbild, tryckText } = Astro.props;
const htmlStil = tryckText ? `--tryck-text: '${tryckText.replace(/['\\]/g, '')}'` : undefined;
const fullTitel = title ? `${title} · ${site.namn}` : `${site.namn}: ${site.rad.toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const bildUrl = new URL(bild, Astro.site).href;
const nuvarande = Astro.url.pathname;
function aktiv(href: string) {
  return nuvarande === href || nuvarande.startsWith(href + '/') ? 'page' : undefined;
}
---

<!doctype html>
<html lang={site.sprak} style={htmlStil}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Chromium (Chrome, Edge) ritar utskriftens sidfot som marginalruta; andra får .tryck-fot.
      if (navigator.userAgentData) document.documentElement.classList.add('marginalrutor');
    </script>
    <title>{fullTitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.namn}: allt nytt`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.namn}: artiklar`} href="/artiklar/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.namn}: stödundervisning`} href="/stodundervisning/rss.xml" />
    <meta property="og:type" content={typ} />
    <meta property="og:title" content={title ?? site.namn} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.namn} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:image" content={bildUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="hopp-lank" href="#innehall">Hoppa till innehållet</a>
    <header class="sidhuvud">
      <a class="namn" href="/">{site.namn}</a>
      <nav aria-label="Huvudmeny">
        {site.navigation.map((post) => (
          <a href={post.href} aria-current={aktiv(post.href)}>{post.text}</a>
        ))}
      </nav>
    </header>
    <main id="innehall" class="innehall">
      <slot />
    </main>
    <footer class="sidfot">
      <p class="sidfot-rad"><strong>{site.namn}</strong>, {site.rad.toLowerCase()}. <a href={`mailto:${site.epost}`}>{site.epost}</a></p>
      <ul class="lankrad-lista sidfot-rad">
        <li><a href="/prenumerera">Få mejl när något nytt publiceras</a></li>
        <li><a href="/rss.xml">Följ med RSS</a></li>
        <li><a href="/taggar">Ämnen</a></li>
        <li><a href="/om">Om Niclas</a></li>
      </ul>
      <p class="sidfot-rad">© {new Date().getFullYear()} {site.namn}. Texterna är publicerade i Vi Lärare och andra tidningar först; varje text länkar till originalet.</p>
    </footer>
  </body>
</html>
