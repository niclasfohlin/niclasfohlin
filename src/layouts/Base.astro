---
import '../styles/global.css';
import { site } from '../data/site';
import { kortFor } from '../lib/delningskort';
import { appikonAdress } from '../lib/appikon';

interface Props {
  title?: string;
  description?: string;
  /** Sätt till 'article' för artiklar och metoder. */
  typ?: 'website' | 'article';
  /** Absolut eller rotrelativ sökväg till en egen delningsbild. Utan den används sidans delningskort
   *  (src/lib/delningskort.ts), som är 1200 × 630 och bär sidans titel. */
  bild?: string;
  /** Sidfot på varje utskriven sida (upphov och adress). Sätts som --tryck-text på html och
   *  läses av @page @bottom-center i global.css; sidan lägger också en .tryck-fot för webbläsare utan marginalrutor. */
  tryckText?: string;
  /** En sida bara för Niclas (statistiken): noindex, och besöket räknas inte. Länkas inte från menyn. */
  dold?: boolean;
}

const { title, description = site.beskrivning, typ = 'website', bild, tryckText, dold = false } = Astro.props;
const htmlStil = tryckText ? `--tryck-text: '${tryckText.replace(/['\\]/g, '')}'` : undefined;
const fullTitel = title ? `${title} · ${site.namn}` : `${site.namn}: ${site.rad.toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const kort = await kortFor(Astro.url.pathname);
const bildUrl = new URL(bild ?? kort.fil, Astro.site).href;
const bildAlt = kort.undertitel ? `${kort.titel}. ${kort.undertitel}` : kort.titel;
const nuvarande = Astro.url.pathname;
// Sidorna under /stodundervisning hör till appen Stöd (K-505, DRIFT.md under Appen Stöd): manifestet, appens ikon för
// iPhones hemskärm och namnet under ikonen. Resten av sajten har sajtens ikon.
const iAppen = nuvarande === '/stodundervisning' || nuvarande.startsWith('/stodundervisning/');
function aktiv(href: string) {
  return nuvarande === href || nuvarande.startsWith(href + '/') ? 'page' : undefined;
}
---

<!doctype html>
<html lang={site.sprak} style={htmlStil} data-drive-klient={site.driveKlientId || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14202b" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Chromium (Chrome, Edge) ritar utskriftens sidfot som marginalruta; andra får .tryck-fot.
      if (navigator.userAgentData) document.documentElement.classList.add('marginalrutor');
    </script>
    {/* Besöksstatistiken (site.statistik, DRIFT.md under Besöksstatistik): skriptet laddas bara på sajtens egen adress,
        så att samma bygge kan visas lokalt, på datorns adress i telefonen och som utkast hos Netlify utan att räknas.
        Klick på element med data-goatcounter-click räknas som händelser. */}
    {site.statistik && !dold && (
      <script is:inline define:vars={{ statistik: site.statistik }}>
        if (/^(www\.)?niclasfohlin\.se$/.test(location.hostname)) {
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://gc.zgo.at/count.js';
          s.dataset.goatcounter = statistik;
          document.head.appendChild(s);
          // count.js binder knapparna med data-goatcounter-click en gång, när det körs: står en knapp längre ned än sidan
          // hunnit läsas då, eller ritar sidan den senare, räknas den här i stället. Det som count.js har bundit
          // (data-goatcounter-bound) hoppas över, så att inget räknas två gånger (granskningen av statistiken 2026-10-19).
          const rakna = (e) => {
            const el = e.target instanceof Element ? e.target.closest('[data-goatcounter-click]') : null;
            if (!el || el.dataset.goatcounterBound) return;
            window.goatcounter?.count?.({ event: true, path: el.dataset.goatcounterClick, title: el.dataset.goatcounterTitle || el.title || '' });
          };
          document.addEventListener('click', rakna);
          document.addEventListener('auxclick', rakna);
        }
      </script>
    )}
    {dold && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={iAppen ? appikonAdress('ikon-180') : '/apple-touch-icon.png'} />
    {iAppen && <link rel="manifest" href="/stodundervisning/manifest.webmanifest" />}
    {iAppen && <meta name="apple-mobile-web-app-title" content="Stöd" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.namn}: allt nytt`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.namn}: artiklar`} href="/artiklar/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.namn}: stödundervisning`} href="/stodundervisning/rss.xml" />
    <meta property="og:type" content={typ} />
    <meta property="og:title" content={title ?? site.namn} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={site.namn} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:image" content={bildUrl} />
    {!bild && <meta property="og:image:type" content={kort.fil.endsWith('.png') ? 'image/png' : 'image/jpeg'} />}
    {!bild && <meta property="og:image:width" content="1200" />}
    {!bild && <meta property="og:image:height" content="630" />}
    {!bild && <meta property="og:image:alt" content={bildAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {!bild && <meta name="twitter:image:alt" content={bildAlt} />}
  </head>
  <body>
    <a class="hopp-lank" href="#innehall">Hoppa till innehållet</a>
    <header class="sidhuvud">
      <a class="namn" href="/">{site.namn}</a>
      <nav aria-label="Huvudmeny">
        {site.navigation.map((post) => (
          <a href={post.href} aria-current={aktiv(post.href)}>{post.text}</a>
        ))}
      </nav>
    </header>
    <main id="innehall" class="innehall">
      <slot />
    </main>
    {/* Sidfoten i tre korta rader (K-620; Niclas 2026-10-29: "Tightare. Mindre info. Ta bort om Goatcounter. (c) ska ju vara kvar"). */}
    <footer class="sidfot">
      <p class="sidfot-rad sidfot-namn"><strong>{site.namn}</strong> <a href={`mailto:${site.epost}`}>{site.epost}</a></p>
      <ul class="lankrad-lista sidfot-rad">
        <li><a href="/prenumerera"><svg class="ikon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 7 8.5-7" /></svg>Prenumerera</a></li>
        <li><a href="/rss.xml"><svg class="ikon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="18" r="1.7" fill="currentColor" stroke="none" /><path d="M4.5 11.5a8 8 0 0 1 8 8M4.5 4.5a15 15 0 0 1 15 15" /></svg>RSS</a></li>
        <li><a href="/taggar">Ämnen</a></li>
        <li><a href="/om">Om Niclas</a></li>
      </ul>
      <p class="sidfot-rad">© {new Date().getFullYear()} {site.namn}</p>
    </footer>
  </body>
</html>
