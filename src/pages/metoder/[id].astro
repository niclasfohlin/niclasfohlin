---
// En undervisningsmetods sida (K-621), byggd ur metodens fil i samlingen undervisningsmetoder: omslaget med huvudet,
// knapparna, metodkortet, faktan, huvudfilmen, läsvägen till måndag och filerna, och sedan metodens delar i lärarens väg
// (src/components/Undervisningsmetod.astro; riggens standard, avsnitt 4).
import Base from '../../layouts/Base.astro';
import Metodprofil from '../../components/Metodprofil.astro';
import Undervisningsmetod from '../../components/Undervisningsmetod.astro';
import Film from '../../components/Film.astro';
import Filmbilder from '../../components/Filmbilder.astro';
import Umfilknappar from '../../components/Umfilknappar.astro';
import { publicerade, formateraDatum } from '../../lib/innehall';
import { kortetUrFil } from '../../lib/metodprofil';
import { metodensFiler, metodensBilder } from '../../lib/undervisningsmetodfiler';
import { tolkaEfter, type MetodFilm } from '../../lib/film';
import { UPPHOV, SAJT } from '../../lib/metod';
import { uppraknat } from '../../lib/standard/index.js';
import { medKallor, type Um } from '../../lib/undervisningsmetod';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const metoder = await publicerade('undervisningsmetoder');
  return metoder.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data as Um;
const id = post.id;
const m = kortetUrFil(id, post.data);
const adress = `niclasfohlin.se/metoder/${id}`;
const filer = metodensFiler(id);
const bilder = metodensBilder(id);
// Huvudfilmen efter faktan, och extrafilmerna vid sin del (riggens filmer, i public/metoder/ som <id>-film och <id>-filmN).
const huvudfilm: MetodFilm | undefined = d.film ? { film: d.film, bas: `/metoder/${id}-film`, huvud: true, nr: 1 } : undefined;
const extrafilmer: MetodFilm[] = (d.filmer ?? []).map((f: { nr: number; efter: string }) => ({ film: f, bas: `/metoder/${id}-film${f.nr}`, vid: tolkaEfter(f.efter), huvud: false, nr: f.nr }));
const harLarDig = !!d.plan?.skattningar?.length;
// Läsvägens tid: orden i del 1–3 och Det svåraste, med omkring 180 ord i minuten, avrundat till fem minuter.
const ordI = (v: unknown): number => (typeof v === 'string' ? v.split(/\s+/).filter(Boolean).length : Array.isArray(v) ? v.reduce((n, x) => n + ordI(x), 0) : v && typeof v === 'object' ? Object.values(v).reduce((n: number, x) => n + ordI(x), 0) : 0);
const huvudexemplet = (d.amnesexempel ?? []).find((e: { huvud?: boolean }) => e.huvud);
const lastid = Math.max(5, Math.round(ordI([d.inledning, d.roll, d.karna?.komponenter?.map((k: { namn: string; vad: string }) => [k.namn, k.vad]), d.tidsschema, d.steg, d.fastnar, huvudexemplet, d.stod, d.checklista, d.klassen, d.forsta?.text, d.progression, d.rutiner, d.uppfoljning, d.uppdrag, d.hinder]) / 180 / 5) * 5);
const kallor = new Set<string>((d.kallor ?? []).map((x: { id: string }) => x.id));
// Metoderna i Stödundervisning som metoden hör ihop med: deras titlar blir länkar i texten, och de står i Hör ihop med.
const stod = await getCollection('stodundervisning');
const relaterade = (d.relaterade ?? []).map((rid: string) => stod.find((x) => x.id === rid)).filter((x: unknown): x is (typeof stod)[number] => !!x);
const sidor = relaterade.map((x: (typeof stod)[number]) => ({ titel: x.data.titel, href: `/stodundervisning/${x.id}` }));
---

<Base title={d.titel} description={d.ingress} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="metod um-sidan" data-del="metoder">
    <div class="metod-topp">
      <header class="metod-huvud">
        <p class="meta brodsmula"><a href="/metoder">Metoder</a> · {m.arskursText}</p>
        <h1>{d.titel}</h1>
        {m.alternativaNamn.length > 0 && <p class="mp-kallas">Kallas också {uppraknat(m.alternativaNamn)}</p>}
        {d.undertitel && <p class="undertitel">{d.undertitel}</p>}
        <p class="ingress">{d.ingress}</p>
        <p class="metod-centrala um-toppknappar">
          {harLarDig && <a class="knapp" href={`/metoder/${id}/lar-dig`}>Lär dig metoden</a>}
          {filer.lathund?.pdf && <a class="knapp sekundar" href={filer.lathund.pdf} data-goatcounter-click={`fil:${id}-lathund.pdf`} data-goatcounter-title={`Lathunden, pdf, ${id}`}>Lathunden</a>}
          {filer.lektionskort?.pdf && <a class="knapp sekundar" href={filer.lektionskort.pdf} data-goatcounter-click={`fil:${id}-lektionskort.pdf`} data-goatcounter-title={`Lektionskortet, pdf, ${id}`}>Lektionskortet</a>}
        </p>
        {/* Din plan: lärarens plan ur Lär dig metoden, om den finns i webbläsaren (src/scripts/insatser.ts, K-628). */}
        {harLarDig && <div class="pl-din" id="pl-din" data-metod={id} data-titel={d.titel} data-samling="metoder" hidden></div>}
      </header>
      <div class="um-sidospalt">
      <Metodprofil m={m} kallor={kallor} />
      <div class="faktaruta um-fakta">
        <p class="faktaruta-etikett">Fakta</p>
        <dl>
          {d.passar?.kort && <><dt class="bred">Passar när</dt><dd class="bred">{d.passar.kort}</dd></>}
          {d.hurOftaSkal && <><dt class="bred">Varför så ofta</dt><dd class="bred" set:html={medKallor(d.hurOftaSkal, kallor)} /></>}
          <dt class="bred">Material</dt><dd class="bred">{d.material.join(', ')}</dd>
          <dt>Uppdaterad</dt><dd>{formateraDatum(d.uppdaterad)}</dd>
        </dl>
      </div>
      </div>
      <div class="um-under-toppen">
      <div class="um-lasvag" id="lasvagen">
        <p class="um-lasvag-rubrik">Vill du börja på måndag?</p>
        <p>Läs del 1–3 och Det svåraste i del 4, omkring {lastid} minuter, och fyll i planeringsmallen för din första lektion. Resten slår du upp när du behöver det.</p>
        <ol>
          <li><a href="#del-metoden">1 Metoden</a></li>
          <li><a href="#del-lektionen">2 Lektionen</a></li>
          <li><a href="#del-kom-igang">3 Kom igång</a></li>
          <li><a href="#forsta-lektionen">Första lektionen</a></li>
          <li><a href="#det-svaraste">Det svåraste med metoden</a></li>
          <li><a href="#planeringsmallen">Planeringsmallen</a></li>
        </ol>
      </div>
      {huvudfilm && <div class="um-film" id="filmen"><Film f={huvudfilm} titel={d.titel} /><Filmbilder f={huvudfilm} /></div>}
      {(filer.allt || filer.metoden) && (
        <div class="um-nedladdning" id="filerna">
          <p class="um-ruta-rubrik">Skriv ut eller ladda ner</p>
          <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['allt', 'metoden', 'lektionskort', 'planeringsmall', 'lathund']} />
        </div>
      )}
      </div>
    </div>

    <Undervisningsmetod d={d} id={id} extrafilmer={extrafilmer} filer={filer} bilder={bilder} sidor={sidor} />

    <footer class="metod-fot">
      {relaterade.length > 0 && (
        <section class="relaterade">
          <h2>Hör ihop med</h2>
          <ul>{relaterade.map((r: (typeof stod)[number]) => <li><a href={`/stodundervisning/${r.id}`}>{r.data.titel}</a>{' '}<span class="meta">Stödundervisning · {r.data.omrade}</span></li>)}</ul>
        </section>
      )}
      <p class="upphov">{UPPHOV}. Metoden får användas i undervisning. Ange {SAJT} som källa när den sprids vidare. {adress}</p>
    </footer>
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<script>
  import '../../scripts/insatser.ts';
</script>
