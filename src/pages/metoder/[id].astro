---
// En undervisningsmetods sida (K-621), byggd ur metodens fil i samlingen undervisningsmetoder: omslaget med huvudet,
// knapparna, metodkortet, läsvägen till måndag, huvudfilmen, delningen, filerna och faktan, och sedan metodens delar i
// lärarens väg (src/components/Undervisningsmetod.astro; riggens standard, avsnitt 4). I telefonen står faktan efter filerna,
// så att filmen och del 1 kommer tidigare (design-3 nr 4); på datorn står metodkortet och faktan i spalten till höger.
// Metodens saker, som Planeringsmallen och bladet Stegen, är länkar där de nämns (undervisningsmetodensSaker), och böckerna
// och verktygen länkas av Boklankar.astro, som i Stödundervisning (STIL.md under Hänvisningar).
import HorIhopMed from '../../components/HorIhopMed.astro';
import Base from '../../layouts/Base.astro';
import Metodprofil from '../../components/Metodprofil.astro';
import Undervisningsmetod from '../../components/Undervisningsmetod.astro';
import Film from '../../components/Film.astro';
import Filmbilder from '../../components/Filmbilder.astro';
import Umfilknappar from '../../components/Umfilknappar.astro';
import Boklankar from '../../components/Boklankar.astro';
import Delning from '../../components/Delning.astro';
import { delningPa } from '../../lib/delning';
import { relateradeMetoder, publicerade, formateraDatum } from '../../lib/innehall';
import { kortetUrFil } from '../../lib/metodprofil';
import { metodensFiler, metodensBilder } from '../../lib/undervisningsmetodfiler';
import { huvudfilm as huvudfilmen, metodensFilmer } from '../../lib/film';
import { UPPHOV, SAJT } from '../../lib/metod';
import { uppraknat, liten, esc, lasvagen as lasvagenFor, forstaLektionensForm, vagenTillMandag } from '../../lib/standard/index.js';
import { medKallor, medSaker, undervisningsmetodensSaker, type Um } from '../../lib/undervisningsmetod';
import { harLarDig as metodenHarLarDig } from '../../lib/lardig';
import { metodensStrukturer } from '../../lib/strukturer';

export async function getStaticPaths() {
  const metoder = await publicerade('undervisningsmetoder');
  return metoder.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data as Um;
const id = post.id;
const m = kortetUrFil(id, post.data);
const adress = `niclasfohlin.se/metoder/${id}`;
const filer = metodensFiler(id);
const bilder = metodensBilder(id);
const strukturer = metodensStrukturer(d, d.titel);
const saker = undervisningsmetodensSaker(d, id, { lektionskort: !!filer.lektionskort, strukturer });
// Huvudfilmen efter läsvägen, och extrafilmerna vid sin del (riggens filmer, i public/metoder/ som <id>-film och <id>-filmN),
// med samma rot som Stödundervisning och lathunden (metodensFilmer i src/lib/film.ts).
const filmer = metodensFilmer({ film: d.film, filmer: d.filmer }, id, 'metoder');
const huvudfilm = huvudfilmen(filmer);
const extrafilmer = filmer.filter((f) => !f.huvud);
// Lär dig metoden finns när sidan finns (harLarDig i src/lib/lardig.ts, som sidan, bankens kort och mejlet läser).
const harLarDig = metodenHarLarDig(d);
// Läsvägens tid: orden i del 1–3 och Det svåraste, med omkring 180 ord i minuten, avrundat till fem minuter.
const huvudexemplet = (d.amnesexempel ?? []).find((e: { huvud?: boolean }) => e.huvud);
// Läsvägen före första lektionen, delarna och tiden, ur standarden (lasvagen), som Lär dig metoden visar under Läs in dig.
const lv = lasvagenFor(d);
const lastid = lv.minuter;
const kallor = new Set<string>((d.kallor ?? []).map((x: { id: string }) => x.id));
// Metoderna som metoden hör ihop med, i Stödundervisning eller Metoder: deras titlar blir länkar i texten, och de står i Hör ihop med. Bara
// de publicerade, så att ett utkast aldrig blir en länk; ett okänt id stoppar bygget (provaHanvisade i src/lib/innehall.ts).
const relaterade = await relateradeMetoder(d);
// Metoderna under Metoder som valkartan pekar på (passar.metoder), som Explicit undervisning i Kooperativt lärandes När
// passar metoden?, är också länkar där deras namn står (STIL.md under Hänvisningar).
const metoderna = await publicerade('undervisningsmetoder');
const sidor = [...relaterade, ...((d.passar?.metoder ?? []) as string[]).map((mid) => metoderna.find((x) => x.id === mid)).filter((x): x is (typeof metoderna)[number] => !!x).map((x) => ({ titel: x.data.titel, href: `/metoder/${x.id}` }))];
const s = (t: string) => medSaker(t, saker, kallor, sidor);
// Läsvägen som en mening med länkarna i (design-3 nr 5): delarna och första lektionen leder till sina avsnitt, och
// planeringsmallen och lathunden är metodens saker. Lathunden har samma väg till måndag på fyra sidor (granskare-3 nr 4).
// Kommer den första hela lektionen efter vecka 1, som i strukturerna, säger rutan vecka 1 med metodens egen mening, leder till
// minuterna för den korta formen och säger när planeringsmallen fylls i för den hela lektionen, ur samma rot som lathundens
// sida 2 (vagenTillMandag i standarden; granskningen inför lanseringen, G1). Ett lektionsförlopp har rutan som förut. Metodens
// fält skyddas där de sätts in som text (Codex 2026-10-31).
const vagen = vagenTillMandag(d);
const lathundsrad = d.lathund ? ` ${s('Allt du behöver till måndag står också på fyra sidor i lathunden Att komma igång.')}` : '';
const lasvagen = vagen
  ? `Läs <a href="#${lv.delar[0].ankare}">del 1–3</a> och <a href="#${lv.delar[3].ankare}">Det svåraste</a> i del 4, omkring ${lastid} minuter. ${s(vagen.vecka1)}${vagen.kort ? ` Minuterna för <a href="#${esc(vagen.kort.ankare)}">${esc(vagen.kort.nar)}</a> står i del 2.` : ''} Fyll i ${s('planeringsmallen')} för <a href="#forsta-lektionen">${esc(liten(vagen.hel.namn))}</a>, ${esc(vagen.hel.nar)}. Resten slår du upp när du behöver det.${lathundsrad}`
  : `Läs <a href="#${lv.delar[0].ankare}">del 1–3</a> och <a href="#${lv.delar[3].ankare}">Det svåraste</a> i del 4, omkring ${lastid} minuter, och fyll i ${s('planeringsmallen')} för <a href="#forsta-lektionen">${forstaLektionensForm(d).din}</a>. Resten slår du upp när du behöver det.${lathundsrad}`;
---

<Base title={d.titel} description={d.ingress} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="metod um-sidan" data-del="metoder">
    <Boklankar metod={id} titel={d.titel}>
    <div class="metod-topp">
      <header class="metod-huvud">
        <p class="meta brodsmula"><a href="/metoder">Metoder</a> · {m.arskursText}</p>
        <h1>{d.titel}</h1>
        {d.undertitel && <p class="undertitel">{d.undertitel}</p>}
        {m.alternativaNamn.length > 0 && <p class="mp-kallas">Kallas också {uppraknat(m.alternativaNamn)}</p>}
        <p class="ingress">{d.ingress}</p>
        <p class="metod-centrala um-toppknappar">
          {/* När läraren har en plan bär rutan Din plan länken till Lär dig metoden ensam, och knappen går undan, så att två
              länkar med samma namn inte står efter varandra (data-din-ersatter, src/scripts/insatser.ts; lagningen inför
              lanseringen, A9). */}
          {harLarDig && <a class="knapp" href={`/metoder/${id}/lar-dig`} data-din-ersatter>Lär dig metoden</a>}
          {d.lathund && <a class="knapp sekundar" href={`/metoder/${id}/lathund`}>Öppna lathunden</a>}
          {/* Verktyget Strukturer, för en metod som importerar strukturkort (K-661; Niclas 2026-11-01: "Samt verktyg inuti
              kooperativt lärande"). */}
          {strukturer.length > 0 && <a class="knapp sekundar" href="/strukturer">Strukturer</a>}
          <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['lektionskort']} bara />
        </p>
        {/* Din plan: lärarens plan ur Lär dig metoden, om den finns i webbläsaren (src/scripts/insatser.ts, K-628). */}
        {harLarDig && <div class="pl-din" id="pl-din" data-metod={id} data-titel={d.titel} data-samling="metoder" hidden></div>}
      </header>
      <div class="um-sidospalt">
      <Metodprofil m={m} kallor={kallor} saker={saker} />
      <div class="faktaruta um-fakta">
        <p class="faktaruta-etikett">Fakta</p>
        <dl>
          {d.passar?.kort && <><dt class="bred">Passar när</dt><dd class="bred" set:html={medKallor(d.passar.kort, kallor, sidor)} /></>}
          {d.hurOftaSkal && <><dt class="bred">Varför så ofta</dt><dd class="bred" set:html={medKallor(d.hurOftaSkal, kallor)} /></>}
          <dt class="bred">Material</dt><dd class="bred" set:html={s(d.material.join(', '))} />
          <dt>Uppdaterad</dt><dd>{formateraDatum(d.uppdaterad)}</dd>
        </dl>
      </div>
      </div>
      <div class="um-under-toppen">
      <div class="um-lasvag" id="lasvagen">
        <p class="um-lasvag-rubrik">Vill du börja på måndag?</p>
        <p set:html={lasvagen} />
      </div>
      {huvudfilm && <div class="um-film" id="filmen"><Film f={huvudfilm} titel={d.titel} /><Filmbilder f={huvudfilm} /></div>}
      {delningPa && <Delning sida={`/metoder/${id}`} titel={d.titel} plats="topp" />}
      {(filer.allt || filer.metoden) && (
        <aside class="nedladdning um-nedladdning" id="filerna" aria-labelledby="filerna-rubrik">
          <h2 id="filerna-rubrik">Ladda ner och skriv ut</h2>
          <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['allt', 'metoden', 'lathund', 'lektionskort', 'planeringsmall', 'materialet', 'observation']} filmer={filmer.length} />
        </aside>
      )}
      </div>
    </div>

    <Undervisningsmetod d={d} id={id} extrafilmer={extrafilmer} filer={filer} bilder={bilder} sidor={sidor} saker={saker} strukturer={strukturer} />

    <footer class="metod-fot">
      <HorIhopMed relaterade={relaterade} />
      <p class="upphov">{UPPHOV}. Metoden får användas i undervisning. Ange {SAJT} som källa när den sprids vidare. {adress}</p>
    </footer>
    </Boklankar>
    {/* Metodens saker med sina adresser, som scripts/metoderprov.mjs prövar sidans länkar och knappar mot. */}
    <script type="application/json" id="um-saker" is:inline set:html={JSON.stringify(saker).replace(/</g, '\\u003c')} />
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<script>
  import '../../scripts/insatser.ts';
</script>
