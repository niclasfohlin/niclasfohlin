---
// /metoder/<id>/lathund (K-632, K-637): lathunden Att komma igång för en undervisningsmetod, fyra sidor att ha bredvid sig
// när läraren börjar, med metodens filmer i en spelare överst. Sidorna är standardens (lathundensSidor), samma som sajten
// ritar i lathundens PowerPoint-fil och pdf (src/lib/metodpptx.ts, scripts/lathund-pdf.mjs), och sidfoten i dem leder hit.
// Formen är Stödundervisnings lathundssida (src/pages/stodundervisning/[id]/lathund.astro), med samma knappar
// (Lathundsknappar.astro), samma spelare (Filmspelare.astro) och samma utskrift i A4 liggande (Lathundsutskrift.astro):
// huvudet med brödsmulan, knapparna, navigeringen, filmerna och sidorna, och upphovet sist. Filmerna hör till skärmen och
// står varken i utskriften eller i pdf:en. Word-lathunden är riggens; sidan skriver aldrig ut sig själv.
import Base from '../../../layouts/Base.astro';
import Boklankar from '../../../components/Boklankar.astro';
import Filmspelare from '../../../components/Filmspelare.astro';
import Lathundsknappar from '../../../components/Lathundsknappar.astro';
import Lathundsutskrift from '../../../components/Lathundsutskrift.astro';
import Umfilknappar from '../../../components/Umfilknappar.astro';
import Umlathund from '../../../components/Umlathund.astro';
import { relateradeMetoder, publicerade } from '../../../lib/innehall';
import { FILM_UPPHOV, metodensFilmer } from '../../../lib/film';
import { datumText, UPPHOV } from '../../../lib/metod';
import { lathundensSidor, slagensOrd } from '../../../lib/standard/index.js';
import { metodensAdress, umStam, undervisningsmetodensSaker, type Um } from '../../../lib/undervisningsmetod';
import { metodensStrukturer } from '../../../lib/strukturer';
import { metodensFiler } from '../../../lib/undervisningsmetodfiler';

export async function getStaticPaths() {
  const metoder = await publicerade('undervisningsmetoder');
  return metoder.filter((m) => m.data.lathund).map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props;
const d = m.data as Um;
const id = m.id;
const sida = metodensAdress(id);
const adress = `niclasfohlin.se${sida}/lathund`;
const sidor = lathundensSidor(d);
const filer = metodensFiler(id);
const filmer = metodensFilmer({ film: d.film, filmer: d.filmer }, id, 'metoder');
// Metodens saker, som leder till metodens sida, utom lathunden själv.
const saker = undervisningsmetodensSaker(d, id, { lektionskort: !!filer.lektionskort, strukturer: metodensStrukturer(d, d.titel) }).filter((x) => x.adress !== `${sida}/lathund`);
// De publicerade metoderna, så att ett utkast aldrig blir en länk; ett okänt id stoppar bygget (provaHanvisade i src/lib/innehall.ts).
const relaterade = await relateradeMetoder(d);
---

<Base title={`Lathund: ${d.titel}`} description={`Lathunden Att komma igång till ${d.titel}: metoden, vägen till måndag, ${slagensOrd(d).lathunden} och de första veckorna. Skriv ut i liggande A4 eller ladda ner som PowerPoint, pdf eller Word.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="lathund">
    <header class="lathund-huvud">
      <p class="meta brodsmula"><a href="/metoder">Metoder</a> · <a href={sida}>{d.titel}</a> · Lathund</p>
      <h1>Lathund: {d.titel}</h1>
      <p class="ingress">Fyra sidor att ha bredvid sig när du börjar: metoden, vägen till måndag, {slagensOrd(d).lathunden} och de första veckorna. Skriv ut i liggande A4 eller ladda ner som PowerPoint, pdf eller Word.</p>
      <p class="lathund-knappar">
        <Lathundsknappar fil={`/metoder/${umStam(id, 'lathund')}`} titel={d.titel} />
        {' '}<Umfilknappar id={id} titel={d.titel} filer={filer} slag={['lektionskort']} bara />
      </p>
      <nav class="metod-nav lathund-nav" aria-label="Lathundens sidor">
        <span class="nav-etikett" aria-hidden="true">Lathundens sidor</span>
        <ul>
          {filmer.length > 0 && <li><a href="#lathund-film">{filmer.length === 1 ? 'Filmen' : 'Filmerna'}</a></li>}
          {sidor.map((s) => <li><a href={`#lathund-${s.id}`}>{s.nr} {s.namn}</a></li>)}
        </ul>
      </nav>
    </header>
    {filmer.length > 0 && <Filmspelare filmer={filmer} id={id} titel={d.titel} samling="metoder" />}
    <Boklankar metod={id} titel={d.titel} knappar={false}><Umlathund d={d} id={id} sidor={sidor} filer={filer} saker={saker} relaterade={relaterade} /></Boklankar>
    <p class="upphov">{UPPHOV}. Lathund till {d.titel}{d.uppdaterad && `, uppdaterad ${datumText(d.uppdaterad)}`}. {adress}{filmer.length > 0 && `. ${FILM_UPPHOV}`}</p>
    {/* Metodens saker med sina adresser, som scripts/metoderprov.mjs prövar sidans länkar mot. */}
    <script type="application/json" id="um-saker" is:inline set:html={JSON.stringify(saker).replace(/</g, '\\u003c')} />
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<Lathundsutskrift />
