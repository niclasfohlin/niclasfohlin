---
// /metoder/<id>/<nivå>-<titel>: ett blad i en bank, som Fyrfältaren Borden på Medel i Tänkande klassrum (K-761; Niclas
// 2026-11-14: "Behöver ju enkelt kunna läsa och trycka på problemen. Ha dem som små bildkort att trycka på?", och efter
// skisserna: "Det blir bra. Kör så!"). Korten på metodens sida leder hit (Bankbladkort.astro), och problemet i verktyget
// leder hit med märket (TaFram.astro). Sidan har det läraren behöver före lektionen och vid tavlorna, i bankens form från
// Stödundervisning ([id]/[enhet].astro): bladet stort med knappen som skriver ut det, metodens egen mening om hur bladet
// skrivs ut, lärarens text om bladet ur Materialet för klassen, vägen till fler problem i verktyget på samma nivå och del,
// och förra och nästa blad på nivån. Allt ur metodens fil och verktygets problem (metodensBankblad i
// src/lib/undervisningsmetodfiler.ts), så att metodens sida och den här säger samma sak.
import Base from '../../../layouts/Base.astro';
import Boklankar from '../../../components/Boklankar.astro';
import Umfilknappar from '../../../components/Umfilknappar.astro';
import SkrivUtPdf from '../../../components/SkrivUtPdf.astro';
import { publicerade } from '../../../lib/innehall';
import { bladensTextalternativ, metodensBankblad, metodensBilder, metodensBlad, metodensFiler, sakernasFiler, tabellensBankblad, type Bankblad } from '../../../lib/undervisningsmetodfiler';
import { medSaker, undervisningsmetodensSaker, type Um } from '../../../lib/undervisningsmetod';
import { metodensStrukturer } from '../../../lib/strukturer';
import { liten, meningarna, slugAv } from '../../../lib/standard/index.js';
import { UPPHOV } from '../../../lib/metod';
import materialetsSidor from '../../../data/materialets-sidor.json';

export async function getStaticPaths() {
  const metoder = await publicerade('undervisningsmetoder');
  return metoder.flatMap((m) => metodensBankblad(m.id, m.data as Um).map((b) => ({ params: { id: m.id, blad: b.slug }, props: { m, b } })));
}
const { m, b } = Astro.props as { m: Awaited<ReturnType<typeof publicerade<'undervisningsmetoder'>>>[number]; b: Bankblad };
const d = m.data as Um;
const id = m.id;
const ram = (d.ramar!.ramar as { rubrik: string; text: string[] }[])[b.i];
const banken = metodensBankblad(id, d);
const kallor = new Set<string>((d.kallor ?? []).map((x: { id: string }) => x.id));
const saker = undervisningsmetodensSaker(d, id, { ...sakernasFiler(id, d), strukturer: metodensStrukturer(d, d.titel) });
// Hänvisningarna till källorna leder till referensbladet på metodens sida, som den här sidan inte har (Codex 2026-11-14).
const k = (t: string) => medSaker(t, saker, kallor).replace(/href="#kalla-/g, `href="/metoder/${id}#kalla-`);
// Bladets sidbild, som på metodens sida: den första av bladets sidor (src/data/materialets-sidor.json), annars bladets nummer.
const delarna = (materialetsSidor as unknown as Record<string, { blad: string; bilder: number[] }[] | undefined>)[id];
const bilden = metodensBilder(id).materialet?.[(delarna?.[b.i]?.bilder[0] ?? b.i + 1) - 1];
const pdf = metodensBlad(id, [b.rubrik])[0]?.pdf;
// Bladets textalternativ ur riggens Word-fil, med det som står på bladet, som på metodens sida.
// Ett blad med två sidor, som en fyrfältare med Baksidan, har sidornas namn "<rubrik> 1" och "<rubrik> 2".
const bildensAlt = ((t) => t.get(b.rubrik) ?? t.get(`${b.rubrik} 1`) ?? b.rubrik)(await bladensTextalternativ(id));
const filer = metodensFiler(id);
// Metodens egen mening om hur bladet skrivs ut, ur Materialet för klassens text: den som börjar med Skriv ut och nämner
// bladet, som "Skriv ut fyrfältaren du väljer, ett blad per grupp med Baksidan på andra sidan …".
const slaget = b.slag.toLocaleLowerCase('sv');
// Meningen efter, som säger vad som görs med bladet, hör till samma anvisning: "Vik bladet så att ruta 4 är dold, och fäst det
// vid tavlan." (riggens leverans 2026-11-14 kväll).
const utskriften = ((d.ramar?.text ?? []) as string[]).map((t) => meningarna(t) as string[]).flatMap((m) => {
  const i = m.findIndex((s) => s.startsWith('Skriv ut') && s.toLocaleLowerCase('sv').includes(slaget));
  return i < 0 ? [] : [[m[i], ...(m[i + 1] && /\bbladet\b/.test(m[i + 1]) ? [m[i + 1]] : [])].join(' ')];
})[0];
// Förra och nästa blad på nivån, i Materialets ordning.
const nivans = banken.filter((x) => x.niva === b.niva);
const plats = nivans.findIndex((x) => x.slug === b.slug);
const forra = nivans[plats - 1];
const nasta = nivans[plats + 1];
// Vägen tillbaka: tabellen på metodens sida vars rader är bankens blad, som korten Fyrfältarna, annars Materialet för klassen.
const tabellen = ((d.tabeller ?? []) as { rubrik: string; rader: string[][] }[]).find((t) => tabellensBankblad(t.rader, banken));
const tillbaka = tabellen ? { adress: `/metoder/${id}#${slugAv(tabellen.rubrik)}`, namn: tabellen.rubrik } : { adress: `/metoder/${id}#materialet-for-klassen`, namn: d.ramar?.rubrik ?? 'Materialet för klassen' };
const adress = `niclasfohlin.se${b.adress}`;
const del = b.problem.tagg ? `, ${b.problem.tagg}` : '';
---

<Base title={`${b.slag} ${b.titel} · ${d.titel}`} description={`${b.slag} ${b.titel}, ${b.niva}${del}: bladet att skriva ut och det du behöver vid tavlorna i ${d.titel}.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="metod enhet um-bankblad" style={`--niva: #${b.farg}`}>
    <Boklankar metod={id} titel={d.titel}>
    <header class="enhet-huvud">
      <p class="meta brodsmula"><a href="/metoder">Metoder</a> · <a href={`/metoder/${id}`}>{d.titel}</a> · <a href={tillbaka.adress}>{tillbaka.namn}</a></p>
      <p class="enhet-kicker"><span class="enhet-niva">{b.niva}</span> {b.slag}{b.problem.tagg && <> · {b.problem.tagg}</>}</p>
      <h1>{b.titel}</h1>
    </header>
    {bilden && (
      <a href={pdf ?? filer.materialet?.pdf} class="um-sida um-sida-liggande um-bankblad-bild" data-goatcounter-click={`fil:${(pdf ?? '').replace(/^.*\//, '')}`} data-goatcounter-title={`Bilden av ${b.rubrik}, pdf, ${id}`}>
        <img src={bilden.src} alt={bildensAlt} width={bilden.bredd} height={bilden.hojd} decoding="async" />
      </a>
    )}
    {pdf && <Umfilknappar id={id} titel={d.titel} filer={filer} slag={['materialet']} blad={{ namn: b.rubrik, pdf }} />}
    {utskriften && <p class="um-bankblad-utskrift" set:html={k(utskriften)} />}
    <div class="um-bankblad-text">
      {ram.text.map((s) => <p set:html={k(s)} />)}
    </div>
    <p class="um-bankblad-fler"><a href={b.problem.fler}>Fler problem{b.problem.tagg ? ` i ${b.problem.tagg}` : ''} på {b.niva} i {b.verktyget.namn}</a></p>
    <nav class="enhet-fot" aria-label={`${b.slag} på ${b.niva}`}>
      {forra ? <a class="enhet-forra" href={forra.adress}><span class="enhet-fot-etikett">Förra</span>{forra.titel}</a> : <span></span>}
      <a class="enhet-alla" href={tillbaka.adress}>Alla {liten(tillbaka.namn)}</a>
      {nasta ? <a class="enhet-nasta" href={nasta.adress}><span class="enhet-fot-etikett">Nästa</span>{nasta.titel}</a> : <span></span>}
    </nav>
    <p class="upphov">{UPPHOV}. Ur {d.titel}. Får användas i undervisning. {adress}</p>
    </Boklankar>
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<SkrivUtPdf />
