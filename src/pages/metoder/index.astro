---
// Metoder: undervisningsmetoderna för helklass (K-621, K-623), ett kort per metod ur samlingen undervisningsmetoder, i
// bokstavsordning och aldrig efter staplarna (riggens standard, avsnitt 19), också inom varje val i filtret. Utan metoder visar banken
// utkastets kort med platshållare, som K-623 visade formen med. Kortet har länkarna till Lär dig metoden och lathunden, som
// korten i Stödundervisning har sina (design-3 nr 22), raden med Drive och Word för metodens fil med allt, och kryssrutan
// Välj i hörnet, som laddar ner metodens Word-fil med allt, en fil eller flera i en zip (Niclas 2026-10-30: "Det ska finnas
// en checkruta också likt stödundervisning för [att] ladda ner hela metoden i hörnet"). Urvalet och rutan nederst, med Word
// och Drive, är Stödundervisnings (src/scripts/urval.ts, Urvalsknappar.astro; Niclas 2026-10-31: "Varför har inte Metoder
// skicka till drive som stödundervisning?"), och scripts/metoderprov.mjs stannar när de glider isär.
// Filtret är Stödundervisnings (K-642; Niclas 2026-10-30: "Se stödundervisning som förlaga", och "Man vill kunna hitta
// metoder bättre för just läsning i evidens"): rutorna Du vill, Används i, Område, Forskningsstöd och Svårighet med valen och deras
// förklaringar ur standardens rötter, och Visar. Varje kort bär det banken filtrerar på (bankensVal), en ruta visas bara
// när den skiljer metoderna åt (bankensRutor), och antalen räknas med bankensValPassar, som filtret i webbläsaren
// (src/scripts/bankfilter.ts). Valen är ord, utan staplarnas antal (Niclas samma dag: "I listan ska det vara ord").
// Rutan Verktyg och Stödmaterial är Stödundervisnings, med samma saker, och följer inte filtret här (Verktygsruta.astro;
// Niclas 2026-10-31: "Alla verktyg ska också finnas på metoder").
import Base from '../../layouts/Base.astro';
import Metodprofil from '../../components/Metodprofil.astro';
import Verktygsruta from '../../components/Verktygsruta.astro';
import AppLank from '../../components/AppLank.astro';
import Insatslista from '../../components/Insatslista.astro';
import Urvalsknappar from '../../components/Urvalsknappar.astro';
import { site } from '../../data/site';
import { publicerade } from '../../lib/innehall';
import { PILOTEN, kortetUrFil } from '../../lib/metodprofil';
import { UM_NAMN, type Um } from '../../lib/undervisningsmetod';
import { bankensVal, bankensRutor, bankensValPassar, laget, SYFTEN, ANVANDS_I, BANKENS_OMRADEN, BANKENS_LAGEN, STODETS_GRUPPER, SVARIGHETENS_GRUPPER } from '../../lib/standard/index.js';
import { metodensFiler } from '../../lib/undervisningsmetodfiler';
import { metodensSidor } from '../../lib/lardig';

const metoder = (await publicerade('undervisningsmetoder'))
  .sort((a, b) => a.data.titel.localeCompare(b.data.titel, 'sv'))
  .map((post) => {
    const val = bankensVal(post.data);
    // Länkarna till Lär dig metoden och lathunden, ur samma rot som mejlet om en ny metod (metodensSidor i src/lib/lardig.ts).
    return { m: kortetUrFil(post.id, post.data), val, fil: metodensFiler(post.id).allt?.docx, lankar: metodensSidor(post.id, post.data as Um),
    // Kortets ord i varje område där metoden inte har något steg på Forskningsstödets skala, som Oklart, som raden under
    // skalan säger (A5).
    utanSteg: Object.fromEntries(BANKENS_OMRADEN.filter((o) => !val.stod[o.id]).map((o) => [o.id, laget(((post.data as Um).profil?.evidens as Record<string, Parameters<typeof laget>[0]> | undefined)?.[o.id]).ord])) };
  });
const korten = metoder.length ? metoder : [{ m: PILOTEN, val: undefined, fil: undefined, lankar: [] }];
const valbara = metoder.some((x) => x.fil);

// Filtrets rutor i ordning, med valen ur standarden. Ett tomt värde är Alla, och i Område Lärande totalt, som Stöd gäller
// när inget område är valt. Bara rutorna som skiljer metoderna åt visas, och utan någon visas inget filter. Används i, Stöd
// och Svårighet har en ordning och är reglage med två grepp, Från och Till, med lägena i standardens ordning (BANKENS_LAGEN;
// Niclas 2026-10-30: "Tre av dem kan göras i en slider istället för enskilda kort" och "Från-Till"). Greppen står i varsin
// ände från början, Alla, och lägenas ord under banan är tryckytor för den som pekar (src/scripts/bankfilter.ts).
const valen = metoder.map((x) => x.val);
const visas = bankensRutor(valen);
const RUTORNA = ([
  { falt: 'syfte', namn: 'Du vill', alla: 'Alla', reglage: false, val: SYFTEN.map((x) => ({ varde: x.id, text: x.namn, forklaring: x.text })) },
  { falt: 'anvands', namn: 'Används i', alla: 'Alla', reglage: true, val: Object.entries(ANVANDS_I).map(([varde, text]) => ({ varde, text, forklaring: undefined })) },
  { falt: 'omrade', namn: 'Område', alla: BANKENS_OMRADEN[0].namn, reglage: false, val: BANKENS_OMRADEN.slice(1).map((o) => ({ varde: o.id, text: o.namn, forklaring: undefined })) },
  { falt: 'stod', namn: 'Forskningsstöd', alla: 'Alla', reglage: true, val: STODETS_GRUPPER.map((g) => ({ varde: g.id, text: g.namn, forklaring: g.text })) },
  { falt: 'svarighet', namn: 'Svårighet', alla: 'Alla', reglage: true, val: SVARIGHETENS_GRUPPER.map((g) => ({ varde: g.id, text: g.namn, forklaring: undefined })) },
] as const).filter((r) => visas[r.falt]);
// Antalet med ett val, och i ett reglage antalet i just det läget.
const antalMed = (falt: string, varde: string, reglage = false) => valen.filter((v) => bankensValPassar(v, { [falt]: reglage ? { fran: varde, till: varde } : varde })).length;
const metoderText = (n: number) => (n === 1 ? '1 metod' : `${n} metoder`);
---

<Base title={site.sidor.metoder.titel} description={site.sidor.metoder.beskrivning} tryckText="© Niclas Fohlin · niclasfohlin.se/metoder">
  <h1>Metoder</h1>
  <p class="text metodbank-ingress">Undervisningsmetoder för hela klassen, i ämnets vanliga lektioner. Varje metod visar vad forskningen säger, vad som måste stå kvar och hur en lektion går till, med mallar att planera med.</p>
  {!metoder.length && <p class="mp-utkast">Ett utkast till bankens form. Kortet visar den första metoden med platshållare i stället för värden.</p>}
  <AppLank plats="metoder" titel="Metoder" />
  {/* Dina planer: lärarens planer ur Lär dig metoden, ur webbläsaren, som Dina insatser i Stödundervisning (src/scripts/insatser.ts, K-628). */}
  <Insatslista samling="metoder" plats="bank" />
  {RUTORNA.length > 0 && (
    <form class="mbf mp-filter" id="filter" aria-label="Filtrera metoder">
      <div class="mbf-rutor" style={`--rutor: ${RUTORNA.length + 1}`}>
        {RUTORNA.map((r) => (
          <button type="button" class="mbf-ruta" data-ruta={r.falt} aria-expanded="false" aria-controls={`mbf-${r.falt}`}><span class="mbf-namn">{r.namn}</span><span class="mbf-varde"><span data-varde={r.falt}>{r.alla}</span>{" "}<span class="mbf-pil" aria-hidden="true"></span></span></button>
        ))}
        <p class="mbf-ruta mbf-antal"><span class="mbf-namn">Visar</span><span class="mbf-varde"><span aria-live="polite" data-antal>{metoderText(metoder.length)}</span><span data-rensa-rad hidden> · <button type="button" class="mbf-rensa" data-rensa-filter>Rensa</button></span></span></p>
      </div>
      {RUTORNA.map((r) => (
        <fieldset class="mbf-panel" id={`mbf-${r.falt}`} data-panel={r.falt} hidden>
          <legend class="visually-hidden">{r.namn}</legend>
          {r.reglage ? (
            <div class="mbf-reglage" data-spann={r.falt} data-lagen={BANKENS_LAGEN[r.falt as keyof typeof BANKENS_LAGEN].join(' ')} data-alla={r.alla} style={`--lagen: ${r.val.length}; --fran: 0; --till: ${r.val.length - 1}`}>
              <input type="text" name={r.falt} value="" hidden />
              <div class="mbf-bana">
                <span class="mbf-fyllt" aria-hidden="true"></span>
                <input type="range" min="0" max={r.val.length - 1} step="1" value="0" data-grepp="fran" aria-label={`${r.namn}, från`} aria-valuetext={`${r.val[0].text}, ${metoderText(metoder.length)}`} />
                <input type="range" min="0" max={r.val.length - 1} step="1" value={r.val.length - 1} data-grepp="till" aria-label={`${r.namn}, till`} aria-valuetext={`${r.val[r.val.length - 1].text}, ${metoderText(metoder.length)}`} />
              </div>
              <ol class="mbf-lagen" aria-hidden="true">
                {r.val.map((x, i) => (
                  <li><button type="button" class="mbf-lage" data-lage={i} data-forklaring={x.forklaring} tabindex="-1"><span data-text>{x.text}</span> <small data-n>{antalMed(r.falt, x.varde, true)}</small></button></li>
                ))}
              </ol>
              {/* Metoderna utan läge på skalan, som Oklart i området, med antalet (src/scripts/bankfilter.ts, A5). */}
              <p class="mbf-utanfor" data-utanfor role="status" hidden></p>
            </div>
          ) : (
            <>
              <label class="mbf-knapp"><input type="radio" name={r.falt} value="" checked /><span data-text>{r.alla}</span> <small data-n>{antalMed(r.falt, '')}</small></label>
              {r.val.map((x) => <label class="mbf-knapp" data-forklaring={x.forklaring}><input type="radio" name={r.falt} value={x.varde} disabled={antalMed(r.falt, x.varde) === 0} /><span data-text>{x.text}</span> <small data-n>{antalMed(r.falt, x.varde)}</small></label>)}
            </>
          )}
          {r.val.some((x) => x.forklaring) && (
            <dl class="mbf-forklaringar">
              {r.val.map((x) => <div><dt>{x.text}</dt><dd>{x.forklaring}</dd></div>)}
            </dl>
          )}
        </fieldset>
      ))}
      <p class="mbf-upplagg" data-forklaring-not hidden></p>
      <p class="mbf-tom" data-tom hidden>Ingen metod matchar dina val. <button type="button" data-rensa-filter>Visa alla metoder</button></p>
    </form>
  )}
  {/* Rutan Verktyg och Stödmaterial står som i Stödundervisning: först, så att den kommer under filtret på en smal skärm,
      och på en bred i en egen spalt bredvid korten (global.css, Rutan Verktyg och Stödmaterial). */}
  <div class="mb-yta">
  <Verktygsruta samling="undervisningsmetoder" />
  <div class="mb-metoder">
  <div class="rutnat mp-rutnat">
    {korten.map((x) => <Metodprofil m={x.m} lankar={x.lankar} fil={x.fil} val={x.val} omraden={visas.omrade} bank />)}
  </div>
  </div>
  </div>
  {/* Kortens ord i områdena utan steg på Forskningsstödets skala, i kortens ordning, för raden under skalan (A5). */}
  <script type="application/json" id="mbf-utan-steg" is:inline set:html={JSON.stringify(metoder.map((x) => x.utanSteg)).replace(/</g, '\\u003c')} />

  {/* Rutan nederst, i Stödundervisnings form och med samma ord, utan valet Med mallar: Metoder har en Word-fil per metod.
      Word och Drive är Stödundervisnings knappar ur samma rot (Urvalsknappar.astro). */}
  {valbara && (
    <form class="samla mp-samla" id="samla" aria-label="Ladda ner valda metoder">
      <p class="samla-antal" aria-live="polite" data-valda>Inga metoder valda</p>
      <Urvalsknappar bank="Metoder" handelse="metoder-valda" wordTitel="Ladda ner de valda metodernas Word-filer" />
      <p class="meta" data-status role="status" aria-live="polite"></p>
      {/* Förklaringen står också i telefonen, eftersom knappen ger en zip-fil när flera är valda och Stöds knapp ger en Word-fil
          med alla (lagningen inför lanseringen, A4), och Drive sparar varje metod för sig, eftersom Drive inte öppnar en zip-fil
          som dokument. */}
      <p class="meta samla-hjalp">{site.driveKlientId ? `${UM_NAMN.allt} för varje vald metod: Word ger flera i en zip-fil, Drive ett dokument per metod.` : `${UM_NAMN.allt} som Word-fil för varje vald metod, och flera i en zip-fil.`}</p>
    </form>
  )}
</Base>

<script>
  import '../../scripts/insatser.ts';
</script>

<script>
  // Filtret, Stödundervisnings (src/scripts/bankfilter.ts): ett kort passar valen enligt standarden (bankensValPassar), med
  // det kortet bär ur bankensVal. Med ett område valt står det områdets rad på korten i stället för Lärande totalt.
  import { bankfiltret } from '../../scripts/bankfilter';
  import { bankensValPassar, bankensValUr, BANKENS_OMRADEN, type bankensVal } from '../../lib/standard/index.js';
  const form = document.getElementById('filter') as HTMLFormElement | null;
  if (form) {
    const kort = Array.from(document.querySelectorAll<HTMLElement>('.mp-bank[data-val]'));
    const valen = new Map(kort.map((k) => [k, JSON.parse(k.dataset.val ?? '{}') as ReturnType<typeof bankensVal>]));
    const rader = Array.from(document.querySelectorAll<HTMLElement>('[data-omrade-rad]'));
    const utanSteg = JSON.parse(document.getElementById('mbf-utan-steg')?.textContent ?? '[]') as Record<string, string>[];
    bankfiltret({
      form,
      kort,
      namn: Array.from(form.querySelectorAll<HTMLElement>('[data-ruta]')).map((r) => r.dataset.ruta ?? ''),
      passar: (k, val) => bankensValPassar(valen.get(k)!, bankensValUr(val)),
      statistik: { adress: 'filter:metoder:', titel: 'Metoder' },
      efter: (val) => { const omrade = val.omrade || BANKENS_OMRADEN[0].id; for (const r of rader) r.hidden = r.dataset.omradeRad !== omrade; },
      // Raden under Forskningsstödets skala: metoderna utan steg i området, med kortets ord, som Oklart, så att stegens antal
      // går ihop med Visar (lagningen inför lanseringen, A5).
      utanfor: (namn, utan, val) => {
        if (namn !== 'stod') return undefined;
        const omrade = BANKENS_OMRADEN.find((o) => o.id === val.omrade) ?? BANKENS_OMRADEN[0];
        const orden = [...new Set(utan.map((k) => utanSteg[kort.indexOf(k)]?.[omrade.id]).filter(Boolean))];
        return `${utan.length === 1 ? '1 metod' : `${utan.length} metoder`} har ${orden.join(' eller ')} i ${omrade.namn} och syns bara med hela skalan.`;
      },
    });
  }
</script>

<script>
  // De valda metodernas Word-filer med allt (src/lib/undervisningsmetodfiler.ts): en metod laddas ner som sin fil, och
  // flera som en zip med varje metods fil, gjord i webbläsaren med JSZip, som hämtas först när läraren laddar ner. Word-
  // filerna är redan packade, så zip-filen lagrar dem utan att packa om. Drive sparar varje metods fil som eget dokument,
  // eftersom Drive inte öppnar en zip-fil som dokument, med Stödundervisnings Drive (driveIUrvalet). Urvalet, rutan och
  // Drive står i src/scripts/urval.ts.
  import { urvalet, driveIUrvalet, kortetsNamn } from '../../scripts/urval';
  import { laddaNer } from '../../scripts/skattning';
  import { idagLokalt } from '../../scripts/insatser-lagring';
  const DOCX = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
  const samla = document.getElementById('samla') as HTMLFormElement | null;
  if (samla) {
    // Knappen heter efter vad den ger: Word för en metod och Word-filerna i en zip för flera (A4: samma knapp i Stöd ger en
    // Word-fil med alla valda).
    const knappnamn = samla.querySelector<HTMLElement>('[data-samla-namn]');
    const u = urvalet(samla, 'metodurval-metoder', (n) => { if (knappnamn) knappnamn.textContent = n > 1 ? 'Word-filerna i en zip' : 'Word'; });
    const { visaStatus, arbeta } = u;
    // Felet ligger kvar tills läsaren rensar urvalet eller lyckas.
    const visaFel = (fel: unknown) => {
      visaStatus('Det gick inte att hämta filerna. Ladda om sidan och försök igen, eller ladda ner Word-filen på varje metods sida.');
      console.error(fel);
    };
    samla.addEventListener('submit', (h) => {
      h.preventDefault();
      void arbeta(async (valda) => {
        try {
          const filerna = await hamtaFilerna(valda);
          if (filerna.length === 1) {
            laddaNer(new Blob([filerna[0].data], { type: DOCX }), filerna[0].namn);
            visaStatus('Filen är nedladdad.', true);
          } else {
            const { default: JSZip } = await import('jszip');
            const zip = new JSZip();
            for (const f of filerna) zip.file(f.namn, f.data);
            laddaNer(await zip.generateAsync({ type: 'blob', compression: 'STORE' }), `metoder-valda-${idagLokalt()}.zip`);
            visaStatus(`Zip-filen med ${filerna.length} metoder är nedladdad.`, true);
          }
        } catch (fel) {
          visaFel(fel);
        }
      });
    });
    driveIUrvalet(samla, u, (valda) => async () => (await hamtaFilerna(valda)).map((f) => ({ blob: new Blob([f.data], { type: DOCX }), namn: f.namn, titel: f.titel })), visaFel);

    /** Hämtar de valdas Word-filer med allt, med filens namn och metodens; kastar ett fel när en fil inte gick att hämta. */
    async function hamtaFilerna(valda: HTMLInputElement[]) {
      visaStatus(valda.length === 1 ? 'Hämtar filen.' : 'Hämtar filerna.');
      // cache: 'no-cache' frågar alltid servern om filen har ändrats, så att läraren aldrig får en äldre fil än sidan.
      return Promise.all(valda.map(async (b) => {
        const adress = b.dataset.fil ?? '';
        const svar = await fetch(adress, { cache: 'no-cache' });
        if (!svar.ok) throw new Error(`${adress} svarade ${svar.status}`);
        return { namn: adress.split('/').pop() ?? `${b.value}.docx`, titel: kortetsNamn(b) ?? b.value, data: await svar.arrayBuffer() };
      }));
    }
  }
</script>
