---
// Metoder: undervisningsmetoderna för helklass (K-621, K-623), ett kort per metod ur samlingen undervisningsmetoder,
// sorterade efter slaget och namnet och aldrig efter staplarna (riggens standard, avsnitt 19). Utan metoder visar banken
// utkastets kort med platshållare, som K-623 visade formen med.
import Base from '../../layouts/Base.astro';
import Metodprofil from '../../components/Metodprofil.astro';
import { site } from '../../data/site';
import { publicerade } from '../../lib/innehall';
import { PILOTEN, kortetUrFil } from '../../lib/metodprofil';

const SLAGEN = ['lektionsforlopp', 'strukturer', 'strategier'];
const metoder = (await publicerade('undervisningsmetoder'))
  .sort((a, b) => SLAGEN.indexOf(a.data.slag) - SLAGEN.indexOf(b.data.slag) || a.data.titel.localeCompare(b.data.titel, 'sv'))
  .map((post) => kortetUrFil(post.id, post.data));
const korten = metoder.length ? metoder : [PILOTEN];
---

<Base title={site.sidor.metoder.titel} description={site.sidor.metoder.beskrivning} tryckText="© Niclas Fohlin · niclasfohlin.se/metoder">
  <h1>Metoder</h1>
  <p class="text metodbank-ingress">Undervisningsmetoder för hela klassen, i ämnets vanliga lektioner. Varje metod visar vad forskningen säger, vad som bär effekten och hur en lektion går till, med mallar att planera med.</p>
  {!metoder.length && <p class="mp-utkast">Ett utkast till bankens form. Kortet visar den första metoden med platshållare i stället för värden.</p>}
  <div class="rutnat mp-rutnat">
    {korten.map((m) => <Metodprofil m={m} bank />)}
  </div>
</Base>
