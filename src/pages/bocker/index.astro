---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import BokKort from '../../components/BokKort.astro';
import { bockerSorterade } from '../../lib/innehall';
import { bokKategorier } from '../../content.config';
const bocker = await bockerSorterade();
// En rubrik per kategori, i registrets ordning; tomma kategorier visas inte.
const grupper = bokKategorier.map((k) => ({ kategori: k, lista: bocker.filter((b) => b.data.kategori === k) })).filter((g) => g.lista.length > 0);
---

<Base title={site.sidor.bocker.titel} description={site.sidor.bocker.beskrivning}>
  <h1>Böcker</h1>
  <p class="text">Böckerna är skrivna för lärare som vill ha något att använda i klassrummet, de flesta tillsammans med Jennie Wilson. Varje bok länkar till förlaget.</p>
  {bocker.length === 0 && <p>Inga böcker ännu.</p>}
  {grupper.map((g) => (
    <section class="bokgrupp">
      <h2>{g.kategori}</h2>
      <div class="rutnat">
        {g.lista.map((b) => (
          <BokKort b={b} beskrivning etikett={false} />
        ))}
      </div>
    </section>
  ))}
</Base>
