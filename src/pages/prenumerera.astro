---
import Base from '../layouts/Base.astro';
---

<Base title="Prenumerera" description="Få ett mejl när det kommer nya artiklar eller metoder.">
  <article class="text">
    <h1>Prenumerera</h1>
    <p>Ett mejl när det kommer något nytt. Inget annat. Du bekräftar prenumerationen via en länk i det första mejlet och kan avsluta när som helst.</p>

    <form class="prenumerera" method="post" action="/.netlify/functions/prenumerera" id="form">
      <label for="epost">E-postadress</label>
      <input id="epost" name="epost" type="email" required autocomplete="email" inputmode="email" />
      <label class="honung" for="webbplats" aria-hidden="true">Lämna tomt</label>
      <input class="honung" id="webbplats" name="webbplats" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit">Prenumerera</button>
      <p class="meta" id="svar" role="status" aria-live="polite"></p>
    </form>

    <p class="meta">Föredrar du RSS? Alla nyheter finns i <a href="/rss.xml">/rss.xml</a>, bara artiklar i <a href="/artiklar/rss.xml">/artiklar/rss.xml</a> och bara metoder i <a href="/stodundervisning/rss.xml">/stodundervisning/rss.xml</a>.</p>
  </article>

  <script>
    const form = document.getElementById('form') as HTMLFormElement;
    const svar = document.getElementById('svar') as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      svar.textContent = 'Skickar…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        svar.textContent = data.meddelande ?? (res.ok ? 'Klart. Kolla din inkorg.' : 'Något gick fel. Försök igen.');
        if (res.ok) form.reset();
      } catch {
        svar.textContent = 'Kunde inte nå servern. Försök igen senare.';
      }
    });
  </script>
</Base>
