---
import Base from '../../layouts/Base.astro';
import Taggar from '../../components/Taggar.astro';
import { site } from '../../data/site';
import { metoderSorterade, taggLabel } from '../../lib/innehall';
import { arskursSpann, harLathund, harMallar } from '../../lib/metod';
const metoder = await metoderSorterade();
// Bara taggar som någon metod använder, i bokstavsordning efter etiketten läsaren ser.
const taggarIBruk = [...new Set(metoder.flatMap((m) => m.data.taggar))].sort((a, b) => taggLabel(a).localeCompare(taggLabel(b), 'sv'));
// Bara årskursnivåer som någon metod har, så att filtret inte erbjuder tomma val.
const arskurserIBruk = site.arskurser.filter((a) => metoder.some((m) => m.data.arskurs.includes(a)));
const antalPerOmrade = Object.fromEntries(site.omraden.map((o) => [o, metoder.filter((m) => m.data.omrade === o).length]));
---

<Base title="Stödundervisning" description="Metodbank för stödundervisning i matematik, läsning och skrivning. Varje metod har körschema, exempelfraser och mallar, och går att skriva ut och ladda ner som Word-fil.">
  <h1>Stödundervisning</h1>
  <p class="text">Konkreta metoder att använda i morgon. Varje metod har ett körschema, exempelfraser, snabbmall och checklista, en lathund på fyra sidor, och går att ladda ner som Word-fil eller skriva ut. Markera flera metoder för att få dem i en fil.</p>

  {metoder.length > 0 && (
    <form class="filter" id="filter" aria-label="Filtrera metoder">
      <fieldset>
        <legend>Område</legend>
        <div class="val">
          <label><input type="radio" name="omrade" value="" checked /> Alla</label>
          {site.omraden.map((o) => <label class={antalPerOmrade[o] === 0 ? 'tomt' : undefined}><input type="radio" name="omrade" value={o} disabled={antalPerOmrade[o] === 0} /> {o} <span class="meta">{antalPerOmrade[o] === 0 ? '(kommer)' : `(${antalPerOmrade[o]})`}</span></label>)}
        </div>
      </fieldset>
      <fieldset>
        <legend>Årskurs</legend>
        <div class="val">
          <label><input type="radio" name="arskurs" value="" checked /> Alla</label>
          {arskurserIBruk.map((a) => <label><input type="radio" name="arskurs" value={a} /> {a}</label>)}
        </div>
      </fieldset>
      <div class="tagg-val">
        <label for="filter-tagg">Tränar</label>
        <select id="filter-tagg" name="tagg">
          <option value="">Allt</option>
          {taggarIBruk.map((t) => <option value={t}>{taggLabel(t)}</option>)}
        </select>
      </div>
      <p class="meta" aria-live="polite" data-antal>{metoder.length === 1 ? '1 metod' : `${metoder.length} metoder`}</p>
      <p class="meta tom" data-tom hidden>Ingen metod matchar dina val. <button type="button" data-rensa-filter>Visa alla metoder</button></p>
    </form>
  )}

  {site.omraden.map((omrade) => {
    const lista = metoder.filter((m) => m.data.omrade === omrade);
    return (
      <section data-omrade-sektion={omrade}>
        <h2>{omrade}</h2>
        {lista.length === 0 && <p class="meta">Inga metoder ännu. Området fylls på.</p>}
        <div class="rutnat">
          {lista.map((m) => (
            <article class="kort metodkort" data-metod data-omrade={m.data.omrade} data-arskurs={m.data.arskurs.join(' ')} data-taggar={m.data.taggar.join(' ')}>
              <p class="meta">{arskursSpann(m.data.arskurs)}{m.data.tid && ` · ${m.data.tid}`}{m.data.grupp && ` · ${m.data.grupp.toLowerCase()}`}</p>
              <h3><a href={`/stodundervisning/${m.id}`}>{m.data.titel}</a></h3>
              {m.data.undertitel && <p class="undertitel">{m.data.undertitel}</p>}
              <p>{m.data.ingress}</p>
              <Taggar taggar={m.data.taggar} nivaer={m.data.arskurs} />
              <p class="kort-rad">
                {harLathund(m.data) && <><a class="lathund-lank" href={`/stodundervisning/${m.id}/lathund`}>Lathund<span class="visually-hidden">: {m.data.titel}</span></a>{' · '}</>}
                <a href={`/stodundervisning/${m.id}.docx`} download={`${m.id}.docx`}>Allt som Word-fil<span class="visually-hidden">: {m.data.titel}</span></a>
                <label class="valj"><input type="checkbox" name="valda" value={m.id} /> Välj<span class="visually-hidden"> {m.data.titel}</span></label>
              </p>
            </article>
          ))}
        </div>
      </section>
    );
  })}

  {metoder.length > 0 && (
    <form class="samla" id="samla" aria-label="Ladda ner valda metoder" data-bas={site.url}>
      <p class="samla-antal" aria-live="polite" data-valda>Inga metoder valda</p>
      <label class="samla-mallar"><input type="checkbox" name="mallar" checked /> Med mallar och lathundar</label>
      <span class="samla-knappar">
        <button type="submit" class="knapp" disabled>Ladda ner valda (docx)</button>
        <button type="button" class="knapp sekundar" data-rensa hidden>Rensa</button>
      </span>
      <p class="meta" data-status role="status" aria-live="polite"></p>
      <p class="meta samla-hjalp">Markera metoder i listan med Välj, så får du dem i en Word-fil. Utan kryss i rutan får du bara metodbeskrivningarna.</p>
    </form>
  )}
  <div class="tryck-fot" aria-hidden="true">© Niclas Fohlin · niclasfohlin.se/stodundervisning</div>
  {metoder.length > 0 && (
    <p class="meta samla-alla"><a href="/stodundervisning/alla-metoder.docx" download="alla-metoder.docx">Ladda ner allt om alla metoder i en Word-fil</a></p>
  )}
</Base>

<script>
  // Filtrering utan ramverk. Utan JavaScript visas alla metoder; formuläret, urvalsrutorna och
  // raden för samlad nedladdning visas bara när html har klassen js (sätts i Base.astro före
  // första målningen, så att inget hoppar när sidan laddas).
  // Valet speglas i adressen (?omrade=Läsning&arskurs=F-3&tagg=lasflyt) så att en filtrerad vy går att länka.
  const form = document.getElementById('filter') as HTMLFormElement | null;
  if (form) {
    const kort = Array.from(document.querySelectorAll<HTMLElement>('[data-metod]'));
    const sektioner = Array.from(document.querySelectorAll<HTMLElement>('[data-omrade-sektion]'));
    const antal = form.querySelector('[data-antal]') as HTMLElement;
    const namn = ['omrade', 'arskurs', 'tagg'] as const;

    const parametrar = new URLSearchParams(location.search);
    for (const n of namn) {
      const v = parametrar.get(n);
      const falt = form.elements.namedItem(n) as RadioNodeList | HTMLSelectElement | null;
      if (v && falt) falt.value = v;
    }

    function filtrera() {
      const data = new FormData(form!);
      const val = Object.fromEntries(namn.map((n) => [n, String(data.get(n) ?? '')]));
      const aktiv = namn.some((n) => val[n]);
      let synliga = 0;
      for (const k of kort) {
        const passar =
          (!val.omrade || k.dataset.omrade === val.omrade) &&
          (!val.arskurs || (k.dataset.arskurs ?? '').split(' ').includes(val.arskurs)) &&
          (!val.tagg || (k.dataset.taggar ?? '').split(' ').includes(val.tagg));
        k.hidden = !passar;
        if (passar) synliga++;
      }
      for (const s of sektioner) {
        s.hidden = aktiv && !Array.from(s.querySelectorAll<HTMLElement>('[data-metod]')).some((k) => !k.hidden);
      }
      antal.textContent = synliga === 1 ? '1 metod' : `${synliga} metoder`;
      tom.hidden = synliga > 0;
      const q = new URLSearchParams();
      for (const n of namn) if (val[n]) q.set(n, val[n]);
      const frageDel = q.toString();
      history.replaceState(null, '', frageDel ? `?${frageDel}` : location.pathname);
      try { sessionStorage.setItem('metodfilter', frageDel ? `?${frageDel}` : ''); } catch { /* utan lagring */ }
    }

    const tom = form.querySelector('[data-tom]') as HTMLElement;
    form.querySelector('[data-rensa-filter]')?.addEventListener('click', () => { form!.reset(); filtrera(); });
    form.addEventListener('change', filtrera);
    filtrera();
  }

  // Flera metoder i en Word-fil. Data hämtas från metoder.json och filen byggs i webbläsaren
  // med samma generator som bygget använder (src/lib/metoddocx.ts), så innehållet är identiskt.
  const samla = document.getElementById('samla') as HTMLFormElement | null;
  if (samla) {
    const boxar = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="valda"]'));
    const knapp = samla.querySelector('button') as HTMLButtonElement;
    const valda = samla.querySelector('[data-valda]') as HTMLElement;
    const status = samla.querySelector('[data-status]') as HTMLElement;
    const rensa = samla.querySelector('[data-rensa]') as HTMLButtonElement;
    const medMallar = samla.elements.namedItem('mallar') as HTMLInputElement;
    const bas = samla.dataset.bas ?? location.origin;
    let bygger = false;
    // Ett lyckat-meddelande försvinner efter en stund; timern stoppas om något nytt händer, så att den inte raderar ett senare fel.
    let statusTimer: number | undefined;
    const visaStatus = (html: string, tillfalligt = false) => {
      window.clearTimeout(statusTimer);
      status.innerHTML = html;
      if (tillfalligt) statusTimer = window.setTimeout(() => { status.textContent = ''; }, 8000);
    };

    function uppdatera() {
      const markerade = boxar.filter((b) => b.checked);
      const n = markerade.length;
      knapp.disabled = bygger || n === 0;
      rensa.hidden = n === 0;
      const namn = markerade.map((b) => b.closest('[data-metod]')?.querySelector('h3')?.textContent?.trim()).filter(Boolean);
      valda.textContent = n === 0 ? 'Inga metoder valda' : `${n === 1 ? '1 metod vald' : `${n} metoder valda`}: ${namn.join(', ')}`;
      for (const b of boxar) b.closest('[data-metod]')?.classList.toggle('vald', b.checked);
    }
    // Urvalet minns under besöket, så att läraren kan läsa en metod och komma tillbaka.
    const spara = () => { try { sessionStorage.setItem('metodurval', JSON.stringify(boxar.filter((b) => b.checked).map((b) => b.value))); } catch { /* utan lagring */ } };
    try {
      const sparade = JSON.parse(sessionStorage.getItem('metodurval') ?? '[]') as string[];
      for (const b of boxar) if (sparade.includes(b.value)) b.checked = true;
    } catch { /* utan lagring */ }
    for (const b of boxar) b.addEventListener('change', () => { uppdatera(); spara(); });
    rensa.addEventListener('click', () => { for (const b of boxar) b.checked = false; visaStatus(''); uppdatera(); spara(); });
    uppdatera();

    samla.addEventListener('submit', async (h) => {
      h.preventDefault();
      const ids = boxar.filter((b) => b.checked).map((b) => b.value);
      const medMallarVal = medMallar.checked;
      if (ids.length === 0 || bygger) return;
      bygger = true;
      knapp.disabled = true;
      visaStatus('Bygger filen.');
      try {
        const svar = await fetch('/stodundervisning/metoder.json');
        if (!svar.ok) throw new Error(`metoder.json svarade ${svar.status}`);
        const { metoder } = (await svar.json()) as { metoder: { id: string; data: unknown }[] };
        const poster = ids.map((id) => metoder.find((m) => m.id === id)).filter((m): m is { id: string; data: unknown } => Boolean(m));
        if (poster.length !== ids.length) throw new Error('En vald metod saknas i metoder.json. Sidan och datan kommer från olika byggen.');
        const [{ metodDokument }, { Packer }] = await Promise.all([import('../../lib/metoddocx'), import('docx')]);
        const dokument = metodDokument(poster as Parameters<typeof metodDokument>[0], { bas, medMallar: medMallarVal });
        const blob = await Packer.toBlob(dokument);
        const lank = document.createElement('a');
        lank.href = URL.createObjectURL(blob);
        lank.download = poster.length === 1 ? `${poster[0].id}${medMallarVal ? '' : '-beskrivning'}.docx` : `metoder-niclasfohlin-se${medMallarVal ? '' : '-beskrivningar'}.docx`;
        document.body.appendChild(lank);
        lank.click();
        lank.remove();
        setTimeout(() => URL.revokeObjectURL(lank.href), 60000);
        visaStatus(poster.length === 1 ? 'Filen är nedladdad.' : `Filen med ${poster.length} metoder är nedladdad.`, true);
      } catch (fel) {
        // Felet ligger kvar tills läsaren rensar urvalet eller lyckas.
        visaStatus(`Det gick inte att bygga filen. Ladda om sidan och försök igen, eller ladda ner <a href="/stodundervisning/alla-metoder.docx" download="alla-metoder.docx">alla metoder som en fil</a>.`);
        console.error(fel);
      } finally {
        bygger = false;
        uppdatera();
      }
    });
  }
</script>
