---
import Base from '../../layouts/Base.astro';
import Taggar from '../../components/Taggar.astro';
import Filval from '../../components/Filval.astro';
import Metodkort from '../../components/Metodkort.astro';
import Tackning from '../../components/Tackning.astro';
import Verktygsruta from '../../components/Verktygsruta.astro';
import { site } from '../../data/site';
import { metoderSorterade, taggLabel } from '../../lib/innehall';
import { harMallar } from '../../lib/metod';
import { byggSerier, arLektion, serieTaggar } from '../../lib/serie';
import { kanGorasIKlass, taggensSlag } from '../../lib/upplagg';
import taggarData from '../../data/taggar.json';
// En lektion står i sin serie och inte som eget kort (src/lib/serie.ts): seriens kort visar lektionerna och filtreras
// på allt serien tränar.
const allaMetoder = await metoderSorterade();
const serier = byggSerier(allaMetoder);
const metoder = allaMetoder.filter((m) => !arLektion(m.data));

// Bara taggar som någon metod använder, i bokstavsordning efter etiketten läsaren ser. Tränar har förmågorna, det eleven
// tränar, och Upplägg hur insatsen går till, Intensivträning eller Lektionsupplägg; Klass eller grupp läser fältet format
// (K-463, src/lib/upplagg.ts).
const taggarIBruk = [...new Set(allaMetoder.flatMap((m) => m.data.taggar))].sort((a, b) => taggLabel(a).localeCompare(taggLabel(b), 'sv'));
const formagorIBruk = taggarIBruk.filter((t) => taggensSlag(t) === 'förmåga');
const upplaggIBruk = taggarIBruk.filter((t) => taggensSlag(t) === 'upplägg');
// Bara årskursnivåer som någon metod har, så att filtret inte erbjuder tomma val.
const arskurserIBruk = site.arskurser.filter((a) => metoder.some((m) => m.data.arskurs.includes(a)));

// Formuläret (Niclas valde A 2026-10-19, ur skisserna i underlag/prov/taggar/design/): fem rutor som visar vad som är
// valt, Område, Årskurs, Tränar, Upplägg och Klass eller grupp, och en sjätte med antalet. Ett tryck på en ruta fäller ut
// dess val som knappar med antalet metoder, ett val i taget, och ett val fäller ihop dem igen. Under knapparna ligger
// formulärets radioknappar, så att adressen (?omrade=Läsning&tagg=lasflyt) och filtreringen fungerar som förut. Tränar
// står i grupper efter förmågans område, och Upplägg säger vad varje upplägg är, också i en rad under rutorna när ett
// är valt. Antalen räknas här för sidan utan val och i skriptet nedan när valen ändras, ur korten.
const beskrivning = Object.fromEntries(taggarData.taggar.map((t) => [t.id, t.beskrivning]));
const omradeAv = Object.fromEntries(taggarData.taggar.map((t) => [t.id, t.omrade]));
const korten = metoder.map((m) => { const serie = serier.get(m.id); return { omrade: m.data.omrade, arskurs: m.data.arskurs as string[], taggar: serie ? serieTaggar(serie, allaMetoder) : m.data.taggar, klass: kanGorasIKlass(m.data) ? 'klass' : 'grupp' }; });
const antalMed = (falt: 'omrade' | 'arskurs' | 'tagg' | 'upplagg' | 'klass', varde: string) => korten.filter((k) => !varde || (falt === 'omrade' ? k.omrade === varde : falt === 'arskurs' ? k.arskurs.includes(varde) : falt === 'klass' ? k.klass === varde : k.taggar.includes(varde))).length;
const formagegrupper = [...site.omraden, 'Allmänt'].map((o) => ({ o, taggar: formagorIBruk.filter((t) => (omradeAv[t] ?? 'Allmänt') === o) })).filter((g) => g.taggar.length);
const metoderText = (n: number) => (n === 1 ? '1 metod' : `${n} metoder`);
---

<Base title={site.sidor.stodundervisning.titel} description={site.sidor.stodundervisning.beskrivning} tryckText="© Niclas Fohlin · niclasfohlin.se/stodundervisning">
  <h1>Stödundervisning</h1>
  <p class="text">Konkreta metoder att använda i morgon. Varje metod har ett körschema, exempelfraser, snabbmall och checklista, en lathund på fyra sidor, och går att ladda ner som Word-fil eller skriva ut. Markera flera metoder för att få dem i en fil.</p>

  {metoder.length > 0 && (
    <form class="mbf" id="filter" aria-label="Filtrera metoder">
      <div class="mbf-rutor">
        {([['omrade', 'Område', 'Alla'], ['arskurs', 'Årskurs', 'Alla'], ['tagg', 'Tränar', 'Allt'], ['upplagg', 'Upplägg', 'Alla'], ['klass', 'Klass eller grupp', 'Alla']] as const).map(([falt, namn, alla]) => (
          <button type="button" class="mbf-ruta" data-ruta={falt} aria-expanded="false" aria-controls={`mbf-${falt}`}><span class="mbf-namn">{namn}</span><span class="mbf-varde"><span data-varde={falt}>{alla}</span>{" "}<span class="mbf-pil" aria-hidden="true"></span></span></button>
        ))}
        <p class="mbf-ruta mbf-antal"><span class="mbf-namn">Visar</span><span class="mbf-varde"><span aria-live="polite" data-antal>{metoderText(metoder.length)}</span><span data-rensa-rad hidden> · <button type="button" class="mbf-rensa" data-rensa-filter>Rensa</button></span></span></p>
      </div>
      <fieldset class="mbf-panel" id="mbf-omrade" data-panel="omrade" hidden>
        <legend class="visually-hidden">Område</legend>
        <label class="mbf-knapp"><input type="radio" name="omrade" value="" checked /><span data-text>Alla</span> <small data-n>{antalMed('omrade', '')}</small></label>
        {site.omraden.map((o) => <label class="mbf-knapp" data-amne={o}><input type="radio" name="omrade" value={o} disabled={antalMed('omrade', o) === 0} /><span data-text>{o}</span> <small data-n>{antalMed('omrade', o)}</small></label>)}
      </fieldset>
      <fieldset class="mbf-panel" id="mbf-arskurs" data-panel="arskurs" hidden>
        <legend class="visually-hidden">Årskurs</legend>
        <label class="mbf-knapp"><input type="radio" name="arskurs" value="" checked /><span data-text>Alla</span> <small data-n>{antalMed('arskurs', '')}</small></label>
        {arskurserIBruk.map((a) => <label class="mbf-knapp"><input type="radio" name="arskurs" value={a} /><span data-text>{a}</span> <small data-n>{antalMed('arskurs', a)}</small></label>)}
      </fieldset>
      <fieldset class="mbf-panel" id="mbf-tagg" data-panel="tagg" hidden>
        <legend class="visually-hidden">Tränar</legend>
        <label class="mbf-knapp"><input type="radio" name="tagg" value="" checked /><span data-text>Allt</span> <small data-n>{antalMed('tagg', '')}</small></label>
        {formagegrupper.map((g) => (
          <div class="mbf-grupp" data-grupp>
            <p class="mbf-gruppnamn" data-amne={g.o}>{g.o}</p>
            {g.taggar.map((t) => <label class="mbf-knapp"><input type="radio" name="tagg" value={t} /><span data-text>{taggLabel(t)}</span> <small data-n>{antalMed('tagg', t)}</small></label>)}
          </div>
        ))}
      </fieldset>
      <fieldset class="mbf-panel" id="mbf-upplagg" data-panel="upplagg" hidden>
        <legend class="visually-hidden">Upplägg</legend>
        <label class="mbf-knapp"><input type="radio" name="upplagg" value="" checked /><span data-text>Alla</span> <small data-n>{antalMed('upplagg', '')}</small></label>
        {upplaggIBruk.map((t) => <label class="mbf-knapp" data-forklaring={beskrivning[t]}><input type="radio" name="upplagg" value={t} /><span data-text>{taggLabel(t)}</span> <small data-n>{antalMed('upplagg', t)}</small></label>)}
        <dl class="mbf-forklaringar">
          {upplaggIBruk.map((t) => <div><dt>{taggLabel(t)}</dt><dd>{beskrivning[t]}</dd></div>)}
        </dl>
      </fieldset>
      <fieldset class="mbf-panel" id="mbf-klass" data-panel="klass" hidden>
        <legend class="visually-hidden">Klass eller grupp</legend>
        <label class="mbf-knapp"><input type="radio" name="klass" value="" checked /><span data-text>Alla</span> <small data-n>{antalMed('klass', '')}</small></label>
        <label class="mbf-knapp"><input type="radio" name="klass" value="klass" /><span data-text>Kan göras i klass</span> <small data-n>{antalMed('klass', 'klass')}</small></label>
        <label class="mbf-knapp"><input type="radio" name="klass" value="grupp" /><span data-text>Bara i grupp</span> <small data-n>{antalMed('klass', 'grupp')}</small></label>
      </fieldset>
      <p class="mbf-upplagg" data-upplagg-not hidden></p>
      <p class="mbf-tom" data-tom hidden>Ingen metod matchar dina val. <button type="button" data-rensa-filter>Visa alla metoder</button></p>
    </form>
  )}

  {/* Rutan Verktyg och Stödmaterial står först, så att den kommer under sorteringen på en smal skärm; på en bred står
      den i en egen spalt bredvid metoderna (global.css, Rutan Verktyg och Stödmaterial). */}
  <div class="mb-yta">
  <Verktygsruta metoder={allaMetoder} />
  <div class="mb-metoder">
  {metoder.length > 0 && <Tackning metoder={metoder} taggar={(m) => { const serie = serier.get(m.id); return serie ? serieTaggar(serie, allaMetoder) : m.data.taggar; }} />}

  {site.omraden.map((omrade) => {
    const lista = metoder.filter((m) => m.data.omrade === omrade);
    return (
      <section data-omrade-sektion={omrade}>
        <h2>{omrade}</h2>
        {lista.length === 0 && <p class="meta">Inga metoder ännu. Området fylls på.</p>}
        <div class="rutnat">
          {lista.map((m) => { const serie = serier.get(m.id); return <Metodkort m={m} valj serie={serie} taggar={serie && serieTaggar(serie, allaMetoder)} />; })}
        </div>
      </section>
    );
  })}
  </div>
  </div>

  {metoder.length > 0 && (
    <form class="samla" id="samla" aria-label="Ladda ner valda metoder" data-bas={site.url}>
      <p class="samla-antal" aria-live="polite" data-valda>Inga metoder valda</p>
      <label class="samla-mallar"><input type="checkbox" name="mallar" checked /> <span class="samla-lang">Med mallar och lathundar</span><span class="samla-kort" aria-hidden="true">Med mallar</span></label>
      <span class="samla-knappar">
        <span class="filval" role="group" aria-label="Valda metoder: ladda ner eller spara">
          <button type="submit" disabled title="Ladda ner de valda metoderna som Word-fil" data-goatcounter-click="fil:valda-metoder.docx" data-goatcounter-title="Metodbanken: valda metoder som Word">
            <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M5 2h7l4 4v12H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 2v4h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M6.5 9.5l1.4 6 1.6-4.5 1.6 4.5 1.4-6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Word<span class="visually-hidden">: ladda ner de valda metoderna</span>
          </button>
          {site.driveKlientId && (
            <button type="button" class="drive-knapp" data-drive-valda disabled title="Spara de valda metoderna i din Google Drive" data-goatcounter-click="fil:drive:valda-metoder.docx" data-goatcounter-title="Metodbanken: valda metoder till Google Drive">
              <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M7 3h6l5 9-3 5H5l-3-5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 3l4 9M13 3l-4 9h9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              Drive<span class="visually-hidden">: spara de valda metoderna i Google Drive</span>
            </button>
          )}
        </span>
        <button type="button" class="lank" data-rensa hidden>Rensa</button>
      </span>
      <p class="meta" data-status role="status" aria-live="polite"></p>
      <p class="meta samla-hjalp">Markera metoder i listan med Välj, så får du dem i en Word-fil. Utan kryss i rutan får du bara metodbeskrivningarna.</p>
    </form>
  )}
  <div class="tryck-fot" aria-hidden="true">© Niclas Fohlin · niclasfohlin.se/stodundervisning</div>
  {metoder.length > 0 && (
    <p class="meta samla-alla">Allt om alla metoder i en fil: <Filval fil="/stodundervisning/alla-metoder" namn="alla-metoder" rubrik="Alla metoder" statistik="Metodbanken: alla metoder" liten /></p>
  )}
</Base>

<script>
  // Filtrering utan ramverk. Utan JavaScript visas alla metoder; formuläret, urvalsrutorna och
  // raden för samlad nedladdning visas bara när html har klassen js (sätts i Base.astro före
  // första målningen, så att inget hoppar när sidan laddas).
  // Valet speglas i adressen (?omrade=Läsning&arskurs=F-3&tagg=lasflyt&upplagg=intensivtraning&klass=klass) så att en
  // filtrerad vy går att länka.
  const form = document.getElementById('filter') as HTMLFormElement | null;
  if (form) {
    const kort = Array.from(document.querySelectorAll<HTMLElement>('[data-metod]'));
    // Täckningskartans rader och banor (Tackning.astro) följer samma val som korten.
    const kartrader = Array.from(document.querySelectorAll<HTMLElement>('[data-karta]'));
    const banor = Array.from(document.querySelectorAll<HTMLElement>('[data-tk-grupp]'));
    const karta = document.querySelector<HTMLElement>('[data-tackning]');
    const sektioner = Array.from(document.querySelectorAll<HTMLElement>('[data-omrade-sektion]'));
    const antal = form.querySelector('[data-antal]') as HTMLElement;
    const namn = ['omrade', 'arskurs', 'klass', 'tagg', 'upplagg'] as const;
    const rutor = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-ruta]'));
    const paneler = Array.from(form.querySelectorAll<HTMLElement>('[data-panel]'));
    const radioknappar = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    const upplaggNot = form.querySelector('[data-upplagg-not]') as HTMLElement;
    const rensaRad = form.querySelector('[data-rensa-rad]') as HTMLElement;
    // En ruta fäller ut sina val och fäller ihop de andra; samma ruta igen, Escape eller ett val fäller ihop.
    function oppna(falt: string | null) {
      for (const r of rutor) r.setAttribute('aria-expanded', String(r.dataset.ruta === falt));
      for (const p of paneler) p.hidden = p.dataset.panel !== falt;
    }
    // Öppnas en ruta med tangentbordet (klicket har detail 0) går fokus till det valda i panelen, som står efter alla
    // rutorna i formuläret.
    for (const r of rutor) r.addEventListener('click', (h) => {
      const falt = r.getAttribute('aria-expanded') === 'true' ? null : r.dataset.ruta ?? null;
      oppna(falt);
      if (falt && h.detail === 0) form!.querySelector<HTMLInputElement>(`input[name="${falt}"]:checked`)?.focus();
    });
    form.addEventListener('keydown', (h) => {
      if (h.key !== 'Escape') return;
      const oppen = rutor.find((r) => r.getAttribute('aria-expanded') === 'true');
      if (oppen) { oppna(null); oppen.focus(); }
    });
    // Ett tryck eller klick på en knapp väljer och fäller ihop. Med tangentbordet byter piltangenterna val utan att
    // fälla ihop (deras klick har detail 0), och Enter fäller ihop.
    for (const p of paneler) {
      p.addEventListener('click', (h) => {
        const knapp = (h.target as HTMLElement).closest('label');
        if (h.detail === 0 || !knapp || knapp.querySelector('input')?.disabled) return;
        window.setTimeout(() => stang(p), 0);
      });
      p.addEventListener('keydown', (h) => { if (h.key === 'Enter' && (h.target as HTMLElement).matches('input')) { h.preventDefault(); stang(p); } });
    }
    function stang(p: HTMLElement) {
      oppna(null);
      rutor.find((r) => r.dataset.ruta === p.dataset.panel)?.focus();
    }
    const egenskaper = (k: HTMLElement) => ({ omrade: k.dataset.omrade ?? '', arskurs: (k.dataset.arskurs ?? '').split(' '), taggar: (k.dataset.taggar ?? '').split(' '), klass: k.dataset.klass ?? '' });
    const kortensData = () => Array.from(document.querySelectorAll<HTMLElement>('[data-metod]')).map(egenskaper);
    const passarVal = (k: ReturnType<typeof egenskaper>, val: Record<string, string>) =>
      (!val.omrade || k.omrade === val.omrade) && (!val.arskurs || k.arskurs.includes(val.arskurs)) && (!val.tagg || k.taggar.includes(val.tagg)) &&
      (!val.upplagg || k.taggar.includes(val.upplagg)) && (!val.klass || k.klass === val.klass);
    // Rutornas värden, knapparnas antal och raden om upplägget, efter valen. Ett val som inte ger någon metod går inte
    // att göra; i Tränar döljs förmågor utan metoder när ett område är valt, så att listan blir områdets.
    function visaVal(val: Record<string, string>) {
      const data = kortensData();
      for (const r of radioknappar) {
        const n = data.filter((k) => passarVal(k, { ...val, [r.name]: r.value })).length;
        const knapp = r.closest('label') as HTMLElement;
        (knapp.querySelector('[data-n]') as HTMLElement).textContent = String(n);
        const tomt = n === 0 && !r.checked;
        r.disabled = tomt;
        knapp.classList.toggle('noll', tomt);
        if (r.name === 'tagg' && r.value) knapp.hidden = tomt && Boolean(val.omrade);
      }
      for (const g of form!.querySelectorAll<HTMLElement>('[data-grupp]')) g.hidden = !g.querySelector('label:not([hidden])');
      for (const r of rutor) {
        const vald = radioknappar.find((x) => x.name === r.dataset.ruta && x.checked);
        const text = vald?.closest('label')?.querySelector('[data-text]')?.textContent ?? '';
        (r.querySelector('[data-varde]') as HTMLElement).textContent = text;
        r.classList.toggle('valt', Boolean(vald?.value));
      }
      const upplagg = radioknappar.find((x) => x.name === 'upplagg' && x.checked && x.value);
      const forklaring = upplagg?.closest('label')?.getAttribute('data-forklaring');
      upplaggNot.hidden = !forklaring;
      upplaggNot.textContent = forklaring ? `${upplagg?.closest('label')?.querySelector('[data-text]')?.textContent}: ${forklaring}` : '';
      rensaRad.hidden = !namn.some((n) => val[n]);
    }

    const parametrar = new URLSearchParams(location.search);
    for (const n of namn) {
      const v = parametrar.get(n);
      const falt = form.elements.namedItem(n) as RadioNodeList | null;
      // Ett värde som inte finns längre (en gammal länk) lämnar Alla valt. Intensivträning stod under Tränar till
      // 2026-10-19, så en gammal länk ?tagg=intensivtraning väljer upplägget.
      const upplagg = form.elements.namedItem('upplagg') as RadioNodeList | null;
      if (n === 'tagg' && v && upplagg && radioknappar.some((r) => r.name === 'upplagg' && r.value === v)) upplagg.value = v;
      else if (v && falt && radioknappar.some((r) => r.name === n && r.value === v)) falt.value = v;
    }

    function filtrera() {
      const data = new FormData(form!);
      const val = Object.fromEntries(namn.map((n) => [n, String(data.get(n) ?? '')]));
      const aktiv = namn.some((n) => val[n]);
      const passar = (k: HTMLElement) =>
        (!val.omrade || k.dataset.omrade === val.omrade) &&
        (!val.arskurs || (k.dataset.arskurs ?? '').split(' ').includes(val.arskurs)) &&
        (!val.tagg || (k.dataset.taggar ?? '').split(' ').includes(val.tagg)) &&
        (!val.upplagg || (k.dataset.taggar ?? '').split(' ').includes(val.upplagg)) &&
        (!val.klass || k.dataset.klass === val.klass);
      let synliga = 0;
      for (const k of kort) {
        k.hidden = !passar(k);
        if (!k.hidden) synliga++;
      }
      let synligaRader = 0;
      for (const r of kartrader) { r.hidden = !passar(r); if (!r.hidden) synligaRader++; }
      for (const b of banor) b.hidden = !kartrader.some((r) => !r.hidden && b.contains(r));
      // Utan träffar göms hela kartan: väljaren säger redan att ingen metod matchar.
      if (karta) karta.hidden = synligaRader === 0;
      for (const s of sektioner) {
        s.hidden = aktiv && !Array.from(s.querySelectorAll<HTMLElement>('[data-metod]')).some((k) => !k.hidden);
      }
      antal.textContent = synliga === 1 ? '1 metod' : `${synliga} metoder`;
      tom.hidden = synliga > 0;
      visaVal(val);
      const q = new URLSearchParams();
      for (const n of namn) if (val[n]) q.set(n, val[n]);
      const frageDel = q.toString();
      history.replaceState(null, '', frageDel ? `?${frageDel}` : location.pathname);
      try { sessionStorage.setItem('metodfilter', frageDel ? `?${frageDel}` : ''); } catch { /* utan lagring */ }
      // Rutan Verktyg och Stödmaterial (Verktygsruta.astro) visar det som hör till metoderna som syns.
      document.dispatchEvent(new Event('metodbank:filtrerat'));
    }

    const tom = form.querySelector('[data-tom]') as HTMLElement;
    // Rensa döljer sig själv, så fokus går till den första rutan.
    for (const b of form.querySelectorAll('[data-rensa-filter]')) b.addEventListener('click', () => { form!.reset(); oppna(null); filtrera(); rutor[0]?.focus(); });
    form.addEventListener('change', filtrera);
    // Statistiken: ett val räknas en gång, här, och inte på etiketten, där klicket och webbläsarens klick på
    // radioknappen räknades var för sig (granskningen 2026-10-19). Statistiksidan har en egen rad för valen.
    form.addEventListener('change', (h) => {
      const r = h.target as HTMLInputElement;
      if (r.type !== 'radio') return;
      const fraga = rutor.find((x) => x.dataset.ruta === r.name)?.querySelector('.mbf-namn')?.textContent ?? r.name;
      const text = r.closest('label')?.querySelector('[data-text]')?.textContent ?? r.value;
      (window as unknown as { goatcounter?: { count?: (o: object) => void } }).goatcounter?.count?.({ event: true, path: `filter:${r.name}:${r.value || 'alla'}`, title: `Metodbanken: ${fraga} ${text}` });
    });
    filtrera();
  }


  // Flera metoder i en Word-fil. Data hämtas från metoder.json och filen byggs i webbläsaren
  // med samma generator som bygget använder (src/lib/metoddocx.ts), så innehållet är identiskt.
  const samla = document.getElementById('samla') as HTMLFormElement | null;
  if (samla) {
    const boxar = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="valda"]'));
    const knapp = samla.querySelector('button') as HTMLButtonElement;
    const valda = samla.querySelector('[data-valda]') as HTMLElement;
    const status = samla.querySelector('[data-status]') as HTMLElement;
    const rensa = samla.querySelector('[data-rensa]') as HTMLButtonElement;
    const medMallar = samla.elements.namedItem('mallar') as HTMLInputElement;
    const bas = samla.dataset.bas ?? location.origin;
    let bygger = false;
    // Ett lyckat-meddelande försvinner efter en stund; timern stoppas om något nytt händer, så att den inte raderar ett senare fel.
    let statusTimer: number | undefined;
    const visaStatus = (html: string, tillfalligt = false) => {
      window.clearTimeout(statusTimer);
      status.innerHTML = html;
      if (tillfalligt) statusTimer = window.setTimeout(() => { status.textContent = ''; }, 8000);
    };

    function uppdatera() {
      const markerade = boxar.filter((b) => b.checked);
      const n = markerade.length;
      knapp.disabled = bygger || n === 0;
      // Rutan ligger fast nederst bara när en metod är vald, så att den inte står över korten i onödan (K-463).
      samla!.classList.toggle('har-valda', n > 0 || bygger || Boolean(status.textContent));
      rensa.hidden = n === 0;
      const namn = markerade.map((b) => b.closest('[data-metod]')?.querySelector('h3')?.textContent?.trim()).filter(Boolean);
      valda.textContent = n === 0 ? 'Inga metoder valda' : `${n === 1 ? '1 metod vald' : `${n} metoder valda`}: ${namn.join(', ')}`;
      for (const b of boxar) b.closest('[data-metod]')?.classList.toggle('vald', b.checked);
    }
    // Urvalet minns under besöket, så att läraren kan läsa en metod och komma tillbaka.
    const spara = () => { try { sessionStorage.setItem('metodurval', JSON.stringify(boxar.filter((b) => b.checked).map((b) => b.value))); } catch { /* utan lagring */ } };
    try {
      const sparade = JSON.parse(sessionStorage.getItem('metodurval') ?? '[]') as string[];
      for (const b of boxar) if (sparade.includes(b.value)) b.checked = true;
    } catch { /* utan lagring */ }
    for (const b of boxar) b.addEventListener('change', () => { uppdatera(); spara(); });
    rensa.addEventListener('click', () => { for (const b of boxar) b.checked = false; visaStatus(''); uppdatera(); spara(); });
    uppdatera();

    // Samma fil kan laddas ner eller sparas i läsarens Google Drive (knappen finns bara med klient-id).
    const driveKnapp = samla.querySelector<HTMLButtonElement>('[data-drive-valda]');
    const uppdateraDrive = () => { if (driveKnapp) driveKnapp.disabled = knapp.disabled; };
    samla.addEventListener('submit', (h) => { h.preventDefault(); void bygg('ladda'); });
    driveKnapp?.addEventListener('click', () => void bygg('drive'));
    boxar.forEach((b) => b.addEventListener('change', uppdateraDrive));
    rensa.addEventListener('click', uppdateraDrive);
    uppdateraDrive();

    async function bygg(mal: 'ladda' | 'drive') {
      const ids = boxar.filter((b) => b.checked).map((b) => b.value);
      const medMallarVal = medMallar.checked;
      if (ids.length === 0 || bygger) return;
      bygger = true;
      knapp.disabled = true;
      uppdateraDrive();
      // Drive: be om behörighet direkt på trycket, innan filen byggs, annars kan inloggningsrutan blockeras.
      let drive: typeof import('../../scripts/drive') | undefined;
      if (mal === 'drive') {
        try {
          drive = await import('../../scripts/drive');
          await drive.forberedDrive();
        } catch (fel) {
          visaStatus(`Det gick inte: ${(fel as Error).message}`);
          bygger = false;
          uppdatera();
          uppdateraDrive();
          return;
        }
      }
      visaStatus('Bygger filen.');
      try {
        const svar = await fetch('/stodundervisning/metoder.json', { cache: 'no-cache' });
        if (!svar.ok) throw new Error(`metoder.json svarade ${svar.status}`);
        const { metoder } = (await svar.json()) as { metoder: { id: string; data: unknown; bildserier?: Record<string, number>; lektionskort?: Record<string, unknown> }[] };
        const poster = ids.map((id) => metoder.find((m) => m.id === id)).filter((m): m is { id: string; data: unknown; bildserier?: Record<string, number>; lektionskort?: Record<string, unknown> } => Boolean(m));
        if (poster.length !== ids.length) throw new Error('En vald metod saknas i metoder.json. Sidan och datan kommer från olika byggen.');
        const [{ metodDokument }, { packaWord }, ljud, reserv, ramform, saga, bildserier] = await Promise.all([import('../../lib/metoddocx'), import('../../lib/wordpaket'), import('../../lib/ljudkort'), import('../../lib/reservbild'), import('../../lib/ramform'), import('../../lib/sagoblad'), import('../../lib/bildserier')]);
        // Ljudlekens kort har bilder och elevens typsnitt (src/lib/ljudkort.ts): de hämtas innan filen byggs, som bygget
        // läser dem från disken.
        const valda = poster as Parameters<typeof metodDokument>[0];
        // cache: 'no-cache' frågar alltid servern om filen har ändrats, så att den samlade filen aldrig byggs av en äldre bild.
        const hamta = async (adress: string) => { const svar = await fetch(adress, { cache: 'no-cache' }); if (!svar.ok) throw new Error(`${adress} svarade ${svar.status}`); return new Uint8Array(await svar.arrayBuffer()); };
        // Bildseriernas rutor (src/lib/bildserier.ts) hämtas som bygget ritade dem, med antalet rutor ur metoder.json.
        const bildvagar = [...new Set(valda.flatMap((p, i) => [...ljud.metodensBilder(p.data, p.id), ...saga.sagoBilder(p.data), ...bildserier.serieBilder(p.data, p.id, poster[i].bildserier)]))];
        const bilder = new Map(await Promise.all(bildvagar.map(async (b) => [b, await hamta(b)] as const)));
        const elevtypsnitt = valda.some((p) => ljud.harElevtypsnitt(p.data)) ? await hamta(ljud.ELEVTYPSNITT_TTF) : undefined;
        // Boksidornas och sagobladens typsnitt (src/lib/ramform.ts, src/lib/sagoblad.ts), när någon vald metod har dem.
        const boktypsnitt = valda.some((p) => saga.harBoktypsnitt(p.data)) ? { cinzel: await hamta(ramform.BOKTYPSNITT_TTF.cinzel), dekor: await hamta(ramform.BOKTYPSNITT_TTF.dekor) } : undefined;
        // Faktatexternas typsnitt Anton (src/lib/ramform.ts), när någon vald metod har faktatexter.
        const faktatypsnitt = valda.some((p) => ramform.harFaktatexter(p.data)) ? await hamta(ramform.FAKTATYPSNITT_TTF) : undefined;
        // Reservbilderna (src/lib/reservbild.ts): filen byggs först en gång för att se vilka bilder den har, och varje
        // bilds reservbild hämtas som bygget ritade den ur samma SVG, som när filerna byggs vid bygget.
        // Lektionskortens innehåll (src/lib/lektionskortdata.ts) följer med i metoder.json, efter stam.
        const lektionskort = new Map(poster.flatMap((p) => Object.entries(p.lektionskort ?? {}))) as NonNullable<Parameters<typeof metodDokument>[1]['resurser']>['lektionskort'];
        const behovet = reserv.samlaReservbilder();
        metodDokument(valda, { bas, medMallar: medMallarVal, resurser: { bilder, elevtypsnitt, boktypsnitt, faktatypsnitt, lektionskort, png: behovet.png } });
        const png = new Map(await Promise.all([...behovet.behov.keys()].map(async (n) => [n, await hamta(reserv.reservAdress(n))] as const)));
        const dokument = metodDokument(valda, { bas, medMallar: medMallarVal, resurser: { bilder, elevtypsnitt, boktypsnitt, faktatypsnitt, lektionskort, png: (svg, bredd, hojd) => png.get(reserv.reservNyckel(svg, bredd, hojd)) } });
        // Packad som vid bygget, med likadana sidhuvuden och sidfötter delade (src/lib/wordpaket.ts, K-151).
        const blob = await packaWord(dokument, 'blob');
        const filnamn = poster.length === 1 ? `${poster[0].id}${medMallarVal ? '' : '-beskrivning'}.docx` : `metoder-niclasfohlin-se${medMallarVal ? '' : '-beskrivningar'}.docx`;
        if (mal === 'drive' && drive) {
          window.clearTimeout(statusTimer);
          await drive.sparaIDrive(blob, filnamn, status);
        } else {
          const lank = document.createElement('a');
          lank.href = URL.createObjectURL(blob);
          lank.download = filnamn;
          document.body.appendChild(lank);
          lank.click();
          lank.remove();
          setTimeout(() => URL.revokeObjectURL(lank.href), 60000);
          visaStatus(poster.length === 1 ? 'Filen är nedladdad.' : `Filen med ${poster.length} metoder är nedladdad.`, true);
        }
      } catch (fel) {
        // Felet ligger kvar tills läsaren rensar urvalet eller lyckas.
        visaStatus(`Det gick inte att bygga filen. Ladda om sidan och försök igen, eller ladda ner <a href="/stodundervisning/alla-metoder.docx" download="alla-metoder.docx">alla metoder som en fil</a>.`);
        console.error(fel);
      } finally {
        bygger = false;
        uppdatera();
        uppdateraDrive();
      }
    }
  }
</script>
