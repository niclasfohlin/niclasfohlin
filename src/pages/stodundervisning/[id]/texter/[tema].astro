---
// /stodundervisning/<id>/texter/<tema>: ett temas sida på Ta fram en faktatext (K-434; Niclas 2026-10-18 natt: "Temat får
// sin lärarhandledning. Man måste kunna se eller enkelt navigera så alla texter för temat syns i dess sida"). Det är
// lärarens sida för temat: Ta fram en faktatext har bara texterna, och metoden leder hit (temats rad på Ta fram öppnar
// lärarhandledningens pdf, Niclas 2026-10-19). Överst knappen som skriver
// ut temats texter (temanasUtskrifter i src/lib/utskrift.ts), och temats texter i ordning, var och en med texten, lärarens
// sida, modellen ifylld och tom, knapparna som skriver ut dem och en länk till textens del i lärarhandledningen. Sedan
// temats lärarhandledning, när metoden har den (ramen "Lärarhandledning: <nivå>, <tema>", src/lib/handledning.ts), med
// knappen som skriver ut dess två sidor och Word-filen, före och efter den. Delningskortet är temats eget, med tre av
// temats texter (src/lib/delningskort.ts).
import Boklankar from '../../../../components/Boklankar.astro';
import Base from '../../../../layouts/Base.astro';
import Lararhandledning from '../../../../components/Lararhandledning.astro';
import Filval from '../../../../components/Filval.astro';
import SkrivUtPdf from '../../../../components/SkrivUtPdf.astro';
import { handledningenTill, handledningensFil, type Lararhandledning as Handledning } from '../../../../lib/handledning';
import { UPPHOV, metodAdress } from '../../../../lib/metod';
import { publicerade } from '../../../../lib/innehall';
import { harTaFram, taFramAv, type TaFram, type TaFramTema } from '../../../../lib/tafram';
import { medDatabasen } from '../../../../lib/faktateman';
import { slugAv } from '../../../../lib/standard/index.js';
import { site } from '../../../../data/site';

export async function getStaticPaths() {
  const ut = [];
  for (const m of (await publicerade('stodundervisning')).filter((x) => harTaFram(x, 'texter'))) {
    const t = await taFramAv(m);
    // Handledningen ur metoden med databasens teman (src/lib/faktateman.ts), som Ta fram läser.
    const ramar = (await medDatabasen(m)).data.ramar?.ramar ?? [];
    for (const n of t.nivaer) for (const tema of n.teman ?? []) ut.push({ params: { id: m.id, tema: tema.slug }, props: { t, niva: n.namn, farg: n.farg, tema, h: handledningenTill(ramar, tema.namn) } });
  }
  return ut;
}

const { t, niva, farg, tema, h } = Astro.props as { t: TaFram; niva: string; farg: string; tema: TaFramTema; h?: Handledning };
const hlFil = h ? handledningensFil(t.metod, h) : undefined;
const versal = (s: string) => s.charAt(0).toLocaleUpperCase('sv') + s.slice(1);
const TAL = ['', 'en', 'två', 'tre', 'fyra', 'fem', 'sex', 'sju', 'åtta', 'nio', 'tio'];
const antal = tema.poster.length;
const byggnad = tema.poster.map((p) => (p.taggar ?? [])[0]?.toLowerCase()).filter((x): x is string => !!x);
// Meningen om att texterna är byggda på var sitt sätt står bara när de är det (designgranskningen 2026-10-18 natt: ett nytt
// tema med två jämförelser skulle göra den fel).
const varSitt = byggnad.length === antal && new Set(byggnad).size === antal;
// En uppräkning av strukturerna. Två av namnen har själva "och", så det sista ledet binds med samt (designgranskningen
// 2026-10-18 natt: "orsak och verkan och problem och lösning" gick inte att läsa).
const lista = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} ${xs.some((x) => / och /.test(x)) ? 'samt' : 'och'} ${xs.at(-1)}` : xs[0] ?? '');
const adress = `${metodAdress(site.url, t.metod).replace(/^https?:\/\//, '')}/${t.led}/${tema.slug}`;
// Alla temats texter i listan att skriva ut på Ta fram en faktatext (src/scripts/tafram.ts läser #lista=).
const listan = `${t.adress}#lista=${tema.poster.map((p) => p.id).join(',')}`;
// Ta fram en faktatext med temat utfällt (#<nivå>/<tema>, src/scripts/tafram.ts).
const nivaSlug = t.nivaer.find((n) => n.namn === niva)?.slug ?? '';
const tillTaFram = `${t.adress}#${nivaSlug}/${tema.slug}`;
// Textens del i lärarhandledningen, när handledningen har en del med textens titel.
const delen = (titel: string) => (h?.texter.some((x) => x.titel === titel) ? `#hl-${slugAv(titel)}` : undefined);
---

<Base title={`${tema.namn}: ${t.namn}`} description={`Temat ${tema.namn} i ${t.titel}: ${TAL[antal] ?? antal} faktatexter på nivån ${niva}, var och en med sin modell${byggnad.length ? ` (${lista([...new Set(byggnad)])})` : ''}, att läsa, visa och skriva ut.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="tema-sida" style={`--niva:${farg}`}>
    <header class="sk-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${t.metod}`}>{t.titel}</a> · <a href={tillTaFram}>{t.namn}</a> · {tema.namn}</p>
      <p class="tema-kicker"><span class="tema-niva">{niva}</span> Tema med {TAL[antal] ?? antal} {t.ord.flera}</p>
      <h1>{tema.namn}</h1>
      <p class="ingress">{varSitt && `Temats ${TAL[antal] ?? antal} ${t.ord.flera} är byggda på var sitt sätt: ${lista(byggnad)}. `}Varje text har sin modell{tema.poster.some((p) => p.modell?.ifylld) ? ', ifylld och tom' : ''}, och lärarens sida säger hur en liten grupp läser den.{h && ' Lärarhandledningen efter texterna säger hur hela klassen läser temat.'}</p>
      <p class="tema-atgarder">{tema.utskrift
        ? <a class="knapp" href={tema.utskrift.adress} target="_blank" rel="noopener" data-skriv-ut-pdf data-sidor-hogst={String(6 * antal)} data-goatcounter-click={`utskrift:${t.metod}/${t.led}/${tema.slug}`} data-goatcounter-title={`${t.titel}: ${tema.namn}, utskrift av temats ${t.ord.flera}`}><span data-direkt={`Skriv ut temats ${t.ord.flera}`}>Temats {t.ord.flera} som pdf</span></a>
        : <a class="knapp" href={listan}>Temats {t.ord.flera} i listan</a>}{h && <>{' '}<a class="knapp sekundar" href="#lararhandledning">Lärarhandledning</a></>}{' '}<a class="knapp sekundar" href={tillTaFram}>{t.namn}</a></p>
    </header>

    <ol class="tema-texter" id="tema-texter">
      {tema.poster.map((p) => (
        <li class="tema-text">
          {/* Modellen, den ifyllda när den finns, så att temats texter syns med sina modeller (designgranskningen 2026-10-18
              natt); annars textens första bild. */}
          {(() => { const b = p.modell?.ifylld ?? p.modell; return b ? <a class="tema-bildlank" href={p.modell?.ifylld?.sida ?? (p.sida ? `${p.sida}#enhetens-blad` : p.modell!.sida)} tabindex="-1" aria-hidden="true"><img class="tema-bild" src={b.bild.adress} alt="" width={b.bildMatt.bredd} height={b.bildMatt.hojd} loading="lazy" decoding="async" /></a> : p.bildFil && <img class="tema-bild" src={p.bildFil} alt="" width={p.bildMatt?.bredd} height={p.bildMatt?.hojd} loading="lazy" decoding="async" />; })()}
          <div class="tema-text-text">
            <h2 class="tema-titel"><span class="tf-nr">{p.temaNr ?? p.nr}</span> <a href={p.textAdress ?? p.sida}>{p.titel}</a></h2>
            <p class="tema-byggnad">{(p.taggar ?? []).join(' · ')}{p.modell && ` · ${p.modell.namn}, ${p.modell.blad.charAt(0).toLowerCase()}${p.modell.blad.slice(1)}`}</p>
            <p class="tf-rad">{p.rad}</p>
            {/* Det som visas: lärarens sida, modellen och textens del i handledningen. Titeln leder till texten. */}
            <p class="tema-lankar">
              {p.losning && <a href={p.losning}>{t.losningNamn}<span class="visually-hidden">: {p.titel}</span></a>}
              {p.modell && <a href={p.modell.ifylld?.sida ?? (p.sida ? `${p.sida}#enhetens-blad` : p.modell.sida)}>Modellen<span class="visually-hidden">: {p.titel}</span></a>}
              {delen(p.titel) && <a href={delen(p.titel)}>Handledningen<span class="visually-hidden">: {p.titel}</span></a>}
            </p>
            {/* Utskrifterna på en egen rad, så att det som visas och det som skrivs ut står var för sig, med en etikett som
                säger Pdf, eller Skriv ut där knapparna ger utskriftsrutan (SkrivUtPdf.astro), och korta namn, så att raden ryms
                i telefonen (designgranskningen 2026-10-18 natt: sex länkar i fyra rader). */}
            <p class="tema-lankar tema-utskrifter" role="group" aria-labelledby={`pdf-${p.id}`}>
              <span class="tema-etikett" id={`pdf-${p.id}`} data-direkt="Skriv ut:">Pdf:</span>
              <a href={p.utskrift.post.adress} target="_blank" rel="noopener" data-skriv-ut-pdf data-sidor-hogst="6" data-goatcounter-click={`utskrift:${t.metod}/${t.led}:tema`} data-goatcounter-title={`${t.titel}: utskrift av en text på temats sida`}><span>Texten</span><span class="visually-hidden">: {p.titel}</span></a>
              {p.modell?.ifylld && <a href={p.modell.ifylld.utskrift.adress} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande data-sidor-hogst="1" data-goatcounter-click={`utskrift:${t.metod}/${t.led}:ifylld-modell`} data-goatcounter-title={`${t.titel}: utskrift av en ifylld modell`}><span>Ifylld modell</span><span class="visually-hidden">: {p.titel}</span></a>}
              {p.modell && <a href={p.modell.utskrift.adress} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande data-sidor-hogst="1" data-goatcounter-click={`utskrift:${t.metod}/${t.led}:modell`} data-goatcounter-title={`${t.titel}: utskrift av en tom modell`}><span>{p.modell.ifylld ? 'Tom modell' : 'Modellen'}</span><span class="visually-hidden">: {p.titel}</span></a>}
            </p>
          </div>
        </li>
      ))}
    </ol>

    {h && hlFil && (
      <section class="tema-handledning" id="lararhandledning" aria-labelledby="tema-hl-rubrik">
        <h2 id="tema-hl-rubrik">Lärarhandledning</h2>
        <p>Två sidor för den som läser temats {t.ord.flera} med hela klassen: hur klassen arbetar med en text i två lektioner, och vad varje text behöver.</p>
        <p class="tema-atgarder"><a class="knapp" href={`/stodundervisning/${hlFil}.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf data-sidor-hogst="2" data-direkt="Skriv ut lärarhandledningen" data-goatcounter-click={`utskrift:${t.metod}/${hlFil.slice(t.metod.length + 1)}`} data-goatcounter-title={`${t.titel}: lärarhandledningen till ${tema.namn} som pdf`}>Lärarhandledningen som pdf</a>{' '}<Filval fil={`/stodundervisning/${hlFil}`} namn={hlFil} rubrik={`Lärarhandledning: ${tema.namn}`} statistik={`${t.titel}: lärarhandledningen till ${tema.namn}`} utanDrive liten /></p>
        <Boklankar metod={t.metod} titel={t.titel} knappar={false}><Lararhandledning h={h} farg={farg} rubrik="h3" ankare="hl" /></Boklankar>
        {/* Efter handledningen: utskriften igen, och vägen tillbaka till texterna (designgranskningen 2026-10-18 natt: i
            telefonen är handledningen nio skärmar, och knappen stod bara före den). */}
        <p class="tema-atgarder tema-efter-hl"><a class="knapp" href={`/stodundervisning/${hlFil}.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf data-sidor-hogst="2" data-direkt="Skriv ut lärarhandledningen" data-goatcounter-click={`utskrift:${t.metod}/${hlFil.slice(t.metod.length + 1)}`} data-goatcounter-title={`${t.titel}: lärarhandledningen till ${tema.namn} som pdf`}>Lärarhandledningen som pdf</a>{' '}<a class="knapp sekundar" href="#tema-texter">Till temats {t.ord.flera}</a></p>
      </section>
    )}

    <p class="upphov">{UPPHOV}. {versal(t.ord.alla)} i <a href={`/stodundervisning/${t.metod}`}>{t.titel}</a>.</p>
  </article>
</Base>

<SkrivUtPdf />
