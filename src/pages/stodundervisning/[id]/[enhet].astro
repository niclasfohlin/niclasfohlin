---
import Base from '../../../layouts/Base.astro';
import Metod from '../../../components/Metod.astro';
import EjBryt from '../../../components/EjBryt.astro';
import Bladfiler from '../../../components/Bladfiler.astro';
import Pabordet from '../../../components/Pabordet.astro';
import SkrivUtPdf from '../../../components/SkrivUtPdf.astro';
import { publicerade } from '../../../lib/innehall';
import { bankAv, enhetAdress, grannar, nivaFarger, type Bankenhet } from '../../../lib/bank';
import { bladKort, bladpar, bladsidaAdress, gruppId, harExempel, ledFlera, ledSida, metodensBladmaterial, type Bladrad } from '../../../lib/bladmaterial';
import { arIfylltBlad, arStaendeBlad, metodensPaBordet, type PaBordet } from '../../../lib/pabordet';
import { metodAdress, UPPHOV } from '../../../lib/metod';
import { enhetensUtskrifter, radensUtskrifter, utskriftAdress, vidEnheterna, type VidEnheten } from '../../../lib/utskrift';
import { site } from '../../../data/site';

// /stodundervisning/<id>/<nivå>-<nummer>: en enhet i metodens bank (src/lib/bank.ts; Niclas 2026-10-10 om Problemlösning i
// grupp: problemen ska inte ligga "scrollandes på mobilen i evigheter", och det ska gå "att bara skriva ut problem utan allt
// annat och bara problem samt med tillhörande lärarens sida och kontrastpar"). Sidan har enhetens blad i den ordning de
// står i bankens filer: lärarens sida, problemet och Två lösningar, var och en med en knapp som skriver ut bara bladet,
// och en knapp överst som skriver ut alla. Sist leder sidan till förra och nästa enhet på nivån och tillbaka till nivån
// på metodens sida. Bladen ritas av Metod.astro, som på metodens sida, så att formerna är desamma.
//
// /stodundervisning/<id>/<namn>: en ram med blad (src/lib/bladmaterial.ts), som en modell i Faktatextsamtal i grupp
// (Niclas 2026-10-13: modellerna på "egen sida med förklaring, exempel och mallarna likt texterna"). Sidan har ramen,
// Modellens sida, och sedan varje blad för sig, exemplet och de tomma bladen, med en knapp som skriver ut bara det
// bladet: veckans blad på A3 med ett tryck. Sist står ramens filer, och sidan leder till förra och nästa ram och
// tillbaka till raden på metodens sida.
export async function getStaticPaths() {
  const metoder = await publicerade('stodundervisning');
  return metoder.flatMap((m) => {
    const bank = bankAv(m.data);
    const bm = metodensBladmaterial(m.data, m.id);
    return [
      ...(bank ? bank.enheter.map((e) => ({ params: { id: m.id, enhet: e.slug }, props: { m, e } })) : []),
      ...(bm ? bm.rader.map((rad) => ({ params: { id: m.id, enhet: rad.slug }, props: { m, rad } })) : []),
    ];
  });
}

const { m, e: given, rad: givenRad } = Astro.props as { m: Awaited<ReturnType<typeof publicerade<'stodundervisning'>>>[number]; e?: Bankenhet; rad?: Bladrad };
const d = m.data;
const versal = (s: string) => s.charAt(0).toLocaleUpperCase('sv') + s.slice(1);
const metodensAdress = metodAdress(site.url, m.id).replace(/^https?:\/\//, '');
const ramarna = d.ramar!.ramar;
const kortad = (s: string) => { const t = s.replace(/\s+/g, ' '); return t.length > 120 ? `${t.slice(0, t.lastIndexOf(' ', 118))} …` : t; };
type Lank = { adress: string; namn: string };
// Det sidan visar, för en enhet i banken eller för en ram med blad.
interface Vy {
  slug: string; farg: string; titel: string; sidtitel: string; beskrivning: string;
  /** Vägen tillbaka i brödsmulan och sist på sidan: nivån eller ramarnas rad. */
  tillbaka: Lank; allaText: string;
  skylt: string; kicker: string;
  /** Sidans blad: ankaret och namnet i raden överst. */
  nav: { id: string; namn: string }[];
  /** Det knappen överst skriver ut, pdf:en den öppnar (src/lib/utskrift.ts) och raden i statistiken. */
  allaBlad: string; allaPdf: string; statistik: string;
  forra?: Lank; nasta?: Lank; fotEtikett: string; upphov: string;
  /** Det som hör ihop med sidan: modellens texter, eller textens modell när sidan inte kan visa bladet (bladpar i
   * src/lib/bladmaterial.ts). */
  hor?: { etikett: string; lankar: Lank[] };
  /** Enhetens blad ur en ram med blad: veckans blad på textens sida, under ramarnas led som rubrik (Modellen). */
  blad?: { rad: Bladrad; b: PaBordet; nr: string; led: string; sida: string; exempel: boolean; pdf: string };
  /** Ramarna som hör till varje enhet (ramar.vidEnheterna, src/lib/utskrift.ts), som bladet Kärnorna till varje text. */
  vid: VidEnheten[];
}
let vy: Vy;
let enhet: Bankenhet | undefined;
let bladenhet: Bladrad | undefined;
// Ramarna med blad: på ramens egen sida, och på en enhets sida för vägen till ramen som hör till enheten.
const bm = metodensBladmaterial(d, m.id);
const par = bm ? bladpar(d, bm) : [];
if (givenRad && bm) {
  // Ramen ur sidans eget bladmaterial, så att raderna och grannarna är samma föremål.
  const rad = bm.rader.find((x) => x.slug === givenRad.slug)!;
  bladenhet = rad;
  const i = bm.rader.indexOf(rad);
  const ifyllda = rad.blad.filter(arIfylltBlad).length;
  const delar = ['sidan', ...(ifyllda ? [ifyllda === 1 ? 'exemplet' : 'exemplen'] : []), ...(rad.tomma ? [rad.tomma === 1 ? 'bladet' : 'bladen'] : [])];
  const lank = (x: Bladrad): Lank => ({ adress: bladsidaAdress(m.id, x), namn: `${bm.rader.indexOf(x) + 1}. ${x.namn}` });
  vy = {
    slug: rad.slug, farg: 'var(--farg-accent)', titel: rad.namn, sidtitel: `${rad.namn} · ${bm.led} · ${d.titel}`,
    beskrivning: `${bm.led} ${rad.namn} i ${d.titel}: ${kortad(ramarna[rad.ri].delar[0]?.falt[0]?.text ?? ramarna[rad.ri].text[0] ?? '')}`,
    tillbaka: { adress: `/stodundervisning/${m.id}#${gruppId(bm)}`, namn: ledFlera(bm) }, allaText: `Alla ${ledFlera(bm).toLowerCase()}`,
    skylt: bm.led, kicker: `${i + 1} av ${bm.rader.length}`,
    nav: [{ id: `blad-${rad.ri + 1}`, namn: 'Sidan' }, ...rad.blad.map((b) => ({ id: `bild-${b.bild.nr}`, namn: bladKort(rad, b) }))],
    allaBlad: delar.length > 1 ? `${delar.slice(0, -1).join(', ')} och ${delar[delar.length - 1]}` : delar[0],
    allaPdf: utskriftAdress(radensUtskrifter(d, m.id, bm, rad).alla),
    statistik: `${d.titel}: ${rad.namn}`,
    forra: bm.rader[i - 1] && lank(bm.rader[i - 1]), nasta: bm.rader[i + 1] && lank(bm.rader[i + 1]),
    fotEtikett: `De andra ${ledFlera(bm).toLowerCase()}`, upphov: `${bm.led.toLowerCase()} ${rad.namn}`, vid: [],
  };
  const bank = bankAv(d);
  const enheterna = par.filter((p) => p.rad === rad).map((p) => bank!.enheter.find((x) => x.ri === p.enhet)!);
  if (bank && enheterna.length) vy.hor = { etikett: versal(bank.ord.alla), lankar: enheterna.map((x) => ({ adress: enhetAdress(m.id, x), namn: `${x.l.titel} (${x.l.niva})` })) };
} else {
  const bank = bankAv(d)!;
  // Enheten ur sidans egen bank, så att nivåerna och grannarna är samma föremål.
  const e = bank.enheter.find((x) => x.slug === given!.slug)!;
  enhet = e;
  const { forra, nasta, niva } = grannar(bank, e);
  const bladen = [...e.fore, e.ri, ...e.efter];
  const bladNamn = (ri: number) => (ri === e.ri ? versal(bank.ord.bestamd) : ramarna[ri].rubrik.split(':')[0]);
  // En faktatext är flera sidor, och lärarens sida till den två: där säger knappen vad som skrivs ut (lärarens sida och
  // texten), eftersom "båda sidorna" skulle läsas som två papper.
  const iMening = (ri: number) => (ri === e.ri || /^Lärarens sida$/i.test(bladNamn(ri)) ? bladNamn(ri).toLowerCase() : bladNamn(ri));
  const allaBlad = e.l.faktatext && bladen.length > 1
    ? `${bladen.slice(0, -1).map(iMening).join(', ')} och ${iMening(bladen[bladen.length - 1])}`
    : bladen.length === 1 ? 'sidan' : bladen.length === 2 ? 'båda sidorna' : `alla ${['', 'en', 'två', 'tre', 'fyra', 'fem'][bladen.length] ?? bladen.length} sidorna`;
  const numrerade = niva.enheter.filter((x) => x.nr !== undefined).length;
  // Beskrivningen: enhetens första stycke, kortat vid ett ord. En faktatext börjar med ingressen.
  const forsta = e.l.lastext?.stycken[0] ?? e.l.faktatext?.ingress[0] ?? '';
  const lank = (x: Bankenhet): Lank => ({ adress: enhetAdress(m.id, x), namn: x.nr !== undefined ? `${x.nr}. ${x.l.titel}` : `${versal(x.l.vad)}: ${x.l.titel}` });
  vy = {
    slug: e.slug, farg: nivaFarger(d, bank)[niva.namn], titel: e.l.titel, sidtitel: `${e.l.titel} · ${niva.namn}, ${e.l.vad} · ${d.titel}`,
    beskrivning: `${niva.namn}, ${e.l.vad} i ${d.titel}: ${kortad(forsta)}`,
    tillbaka: { adress: `/stodundervisning/${m.id}#${niva.oversikt !== undefined ? `ram-${niva.oversikt + 1}` : `niva-${niva.slug}`}`, namn: niva.namn }, allaText: `Alla ${bank.ord.alla} på nivån ${niva.namn}`,
    skylt: niva.namn, kicker: e.nr !== undefined ? `${versal(bank.ord.en)} ${e.nr} av ${numrerade}` : versal(e.l.vad),
    nav: bladen.map((ri) => ({ id: `blad-${ri + 1}`, namn: bladNamn(ri) })),
    allaBlad, allaPdf: utskriftAdress(enhetensUtskrifter(d, m.id, bank, e).alla), statistik: `${d.titel}: ${niva.namn}, ${e.l.vad}`,
    forra: forra && lank(forra), nasta: nasta && lank(nasta),
    fotEtikett: `Fler ${bank.ord.flera} på nivån ${niva.namn}`, upphov: `${niva.namn}, ${e.l.vad}`, vid: vidEnheterna(d, m.id),
  };
  for (const v of vy.vid) vy.nav.push({ id: `vid-${v.ri + 1}`, namn: v.rubrik });
  const raderna = par.filter((p) => p.enhet === e.ri).map((p) => p.rad);
  // Följesidan säger vilket av ramens blad som hör till enheten ("modellen är Tankekartan, blad 1"). Då står bladet på
  // enhetens sida, under ramarnas led som rubrik, Modellen, med en knapp som skriver ut bara bladet och en rad som leder
  // till ramens sida (Niclas 2026-10-13: "Visst bör en sida hänvisa till sin modell?", och "Eller ha modellen för under
  // sin sida också under rubriken Modellen?"). Det är samma regel som att veckans material står vid veckan. Säger
  // följesidan inget blad, eller hör flera ramar till enheten, blir det en rad med länkar till ramarnas sidor.
  const foljetext = [...e.fore, ...e.efter].flatMap((ri) => ramarna[ri].text ?? []).join(' ');
  const bladet = (x: Bladrad) => {
    const nr = foljetext.match(new RegExp(`${x.namn.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}, blad (\\d+)`))?.[1];
    const b = nr ? x.blad.find((y) => bladKort(x, y) === `Blad ${nr}`) : undefined;
    return b && nr ? { rad: x, b, nr } : undefined;
  };
  const funnet = raderna.length === 1 ? bladet(raderna[0]) : undefined;
  if (bm && funnet) {
    vy.blad = { ...funnet, led: bm.led, sida: ledSida(bm), exempel: harExempel(bm), pdf: utskriftAdress(radensUtskrifter(d, m.id, bm, funnet.rad).blad.get(funnet.b.bild.nr)!) };
    vy.nav.push({ id: 'enhetens-blad', namn: bm.led });
  } else if (bm && raderna.length) vy.hor = { etikett: bm.led, lankar: raderna.map((x) => ({ adress: bladsidaAdress(m.id, x), namn: x.namn })) };
}
const adress = `${metodensAdress}/${vy.slug}`;
// Figurerna i sidans bilder (pabordet[].fluent): upphovet står under sidan, som i Word-filens sidhuvud och på metodens
// sida (granskningen 2026-10-13: raden stod i Word i tolv av femton texter men inte på texternas egna sidor).
const sidansRamar = new Set((enhet ? [...enhet.fore, enhet.ri, ...enhet.efter] : bladenhet ? [bladenhet.ri] : []).map((ri) => ramarna[ri].rubrik));
const figurer = metodensPaBordet(d, m.id).some((b) => b.bild.fluent?.length && sidansRamar.has((b.bild.efter ?? '').replace(/^ram: /, '')));
---

<Base title={vy.sidtitel} description={vy.beskrivning} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="metod enhet" style={`--niva: ${vy.farg}`}>
    <EjBryt>
    <header class="enhet-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${m.id}`}>{d.titel}</a> · <a href={vy.tillbaka.adress}>{vy.tillbaka.namn}</a></p>
      <p class="enhet-kicker"><span class="enhet-niva">{vy.skylt}</span> {vy.kicker}</p>
      <h1>{vy.titel}</h1>
      <nav class="enhet-blad-nav" aria-label="Sidorna">
        <ul>{vy.nav.map((x) => <li><a href={`#${x.id}`}>{x.namn}</a></li>)}</ul>
      </nav>
      {vy.hor && <p class="enhet-hor"><span class="enhet-hor-etikett">{vy.hor.etikett}:</span>{' '}{vy.hor.lankar.map((x, i) => <>{i > 0 && ' · '}<a href={x.adress}>{x.namn}</a></>)}</p>}
      <p class="enhet-knappar"><a class="knapp" href={vy.allaPdf} target="_blank" rel="noopener" data-skriv-ut-pdf data-direkt={`Skriv ut ${vy.allaBlad}`} data-goatcounter-click={`utskrift:${m.id}/${vy.slug}`} data-goatcounter-title={`${vy.statistik}, ${vy.allaBlad}`}>{versal(vy.allaBlad)} som pdf</a></p>
    </header>
    {/* Enhetens blad ur en ram med blad, som veckans blad på textens sida, bland enhetens andra blad (platsen efter-bladen i
        Metod.astro). Knappen överst skriver ut enhetens egna sidor, och bladet har sin egen knapp (data-egen), eftersom
        det skrivs ut för sig, liggande och gärna på A3. */}
    <Metod d={d} id={m.id} enhet={enhet} bladenhet={bladenhet}>
    {/* Ramarna som hör till varje enhet (ramar.vidEnheterna), som bladet Kärnorna till varje text: bladet med en egen
        knapp, och en rad som leder till ramen på metodens sida, där det står hur bladet används. */}
    {vy.vid.map((v) => (
      <div slot="efter-bladen" class="enhet-blad" id={`vid-${v.ri + 1}`}>
        <div class="enhet-bladhuvud">
          <h2>{v.rubrik}</h2>
          <a class="knapp sekundar liten" href={utskriftAdress(v.utskrift)} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande={v.blad.length && !v.blad.some(arStaendeBlad) ? '' : undefined} data-sidor-hogst={Math.max(1, v.blad.length) * (v.blad.length ? 1 : 3)} data-goatcounter-click={`utskrift:${m.id}/${vy.slug}`} data-goatcounter-title={`${vy.statistik}, ${v.rubrik.toLowerCase()}`}><span data-direkt={v.blad.length === 1 ? 'Skriv ut bladet' : v.blad.length ? 'Skriv ut bladen' : 'Skriv ut sidan'}>{v.blad.length === 1 ? 'Bladet' : v.blad.length ? 'Bladen' : 'Sidan'} som pdf</span><span class="visually-hidden">: {v.rubrik}</span></a>
        </div>
        <p class="enhet-bladtext">Hur {v.blad.length === 1 ? 'bladet' : v.blad.length ? 'bladen' : 'det'} används står under <a href={`/stodundervisning/${m.id}#ram-${v.ri + 1}`}>{v.rubrik}</a> på metodens sida.</p>
        {v.blad.map((b) => <Pabordet b={b} utanRubrik />)}
      </div>
    ))}
    {vy.blad && (
      <div slot="efter-bladen" class="enhet-blad" id="enhetens-blad">
        <div class="enhet-bladhuvud">
          <h2>{vy.blad.led}</h2>
          <a class="knapp sekundar liten" href={vy.blad.pdf} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande={arStaendeBlad(vy.blad.b) ? undefined : ''} data-sidor-hogst="1" data-goatcounter-click={`utskrift:${m.id}/${vy.slug}`} data-goatcounter-title={`${vy.statistik}, bladet`}><span data-direkt="Skriv ut bladet">Bladet som pdf</span><span class="visually-hidden">: {vy.blad.rad.namn}, blad {vy.blad.nr}</span></a>
        </div>
        <p class="enhet-bladtext">{vy.blad.rad.namn}, blad {vy.blad.nr}. {vy.blad.sida}{vy.blad.exempel ? ', exemplet' : ''} och de andra bladen står på sidan <a href={bladsidaAdress(m.id, vy.blad.rad)}>{vy.blad.rad.namn}</a>.</p>
        <Pabordet b={vy.blad.b} utanRubrik />
      </div>
    )}
    </Metod>
    {/* Ramens egna filer, bladen och sidan med exemplet, sist på ramens sida, som nivåns filer står sist i nivån. */}
    {bladenhet && bm && (
      <div class="bank-filer enhet-filer">
        <p class="bank-filer-rubrik">{bladenhet.namn} att skriva ut</p>
        <Bladfiler id={m.id} titel={d.titel} bm={bm} rad={bladenhet} />
        {/* Bladen är liggande A4 (granskningen 2026-10-13: metoden säger A3 på tolv ställen, och ingen rad sa hur). */}
        {bladenhet.tomma > 0 && <p class="m-efter">Bladen är liggande A4. Vill du ha ett blad på A3 väljer du A3 som papper och låter utskriften anpassas till sidan, eller förstorar bladet till 141 procent i kopiatorn.</p>}
      </div>
    )}
    <nav class="enhet-fot" aria-label={vy.fotEtikett}>
      {vy.forra ? <a class="enhet-forra" href={vy.forra.adress}><span class="enhet-fot-etikett">Förra</span>{vy.forra.namn}</a> : <span></span>}
      <a class="enhet-alla" href={vy.tillbaka.adress}>{vy.allaText}</a>
      {vy.nasta ? <a class="enhet-nasta" href={vy.nasta.adress}><span class="enhet-fot-etikett">Nästa</span>{vy.nasta.namn}</a> : <span></span>}
    </nav>
    <p class="upphov">{UPPHOV}. Ur {d.titel}, {vy.upphov}. Får användas i undervisning. {adress}{figurer && ' Figurerna i bilderna: Fluent Emoji, © Microsoft Corporation, MIT-licens.'}</p>
    </EjBryt>
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<SkrivUtPdf />

<script>
  // Den som skriver ut sidan med webbläsarens egen meny får bilderna hämtade när utskriften börjar. Knapparna skriver
  // inte ut sidan: de öppnar pdf:er ur Word-filerna (SkrivUtPdf.astro).
  window.addEventListener('beforeprint', () => {
    for (const b of document.querySelectorAll<HTMLImageElement>('img[data-utskriftsbild]')) b.loading = 'eager';
  });
</script>
