---
import Base from '../../../layouts/Base.astro';
import Lathund from '../../../components/Lathund.astro';
import SkrivUtPdf from '../../../components/SkrivUtPdf.astro';
import Filval from '../../../components/Filval.astro';
import Filmspelare from '../../../components/Filmspelare.astro';
import Lektionskortknapp from '../../../components/Lektionskortknapp.astro';
import { metodensLektionskort } from '../../../lib/lektionskort';
import { FILM_UPPHOV, metodensFilmer } from '../../../lib/film';
import { publicerade } from '../../../lib/innehall';
import { datumText, metodAdress, passOrd, UPPHOV } from '../../../lib/metod';
import { site } from '../../../data/site';

// /stodundervisning/<id>/lathund: snabbguiden på fyra sidor, för skärm och liggande A4. Överst står metodens filmer i en
// spelare (Filmspelare.astro, Niclas 2026-10-07); de hör till skärmen och står varken i utskriften eller i pdf:en.
export async function getStaticPaths() {
  const metoder = await publicerade('stodundervisning');
  return metoder.filter((m) => m.data.lathund).map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props;
const d = m.data;
const adress = `${metodAdress(site.url, m.id).replace(/^https?:\/\//, '')}/lathund`;
const forSteg = passOrd(d).forSteg;
const filmer = metodensFilmer(d, m.id);
// Lektionskorten (src/lib/lektionskort.ts) bredvid lathundens knappar, eftersom lathunden hänvisar till dem (granskningen
// 2026-10-17: mallsidan har de första meningarna, och kortet har resten).
const lektionskort = metodensLektionskort(d, m.id);
---

<Base title={`Lathund: ${d.titel}`} description={`Snabbguide till ${d.titel}: metoden i korthet, ett pass ${forSteg}, mallen och vad du behöver. Skriv ut i liggande A4 eller ladda ner som PowerPoint, pdf eller Word.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="lathund">
    <header class="lathund-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${m.id}`}>{d.titel}</a> · Lathund</p>
      <h1>Lathund: {d.titel}</h1>
      <p class="ingress">Fyra sidor att ha bredvid sig: metoden i korthet, ett pass {forSteg}, mallen och vad du behöver. Skriv ut i liggande A4 eller ladda ner som PowerPoint, pdf eller Word.</p>
      <p class="lathund-knappar">
        {/* Utskriften är alltid pdf:en, lathunden i A4 liggande ur PowerPoint-koden: fyra sidor kant till kant. Knappen öppnar
            den; där webbläsaren kan skriva ut den direkt heter knappen Skriv ut och öppnar utskriftsrutan (skriptet nedan). */}
        <a class="knapp" href={`/stodundervisning/${m.id}-lathund.pdf`} target="_blank" rel="noopener" data-skriv-ut-pdf data-liggande data-sidor-hogst="4" data-direkt="Skriv ut lathunden (fyra sidor)" data-goatcounter-click={`utskrift:${m.id}-lathund`} data-goatcounter-title={`${d.titel}: utskrift av lathunden`}>Öppna pdf:en för utskrift (fyra sidor)</a>
        {' '}<Filval fil={`/stodundervisning/${m.id}-lathund`} namn={`${m.id}-lathund`} rubrik="Lathunden" statistik={`${d.titel}: lathunden`} pdf pptx />
        {lektionskort.map((k) => <>{' '}<Lektionskortknapp k={k} titel={d.titel} /></>)}
      </p>
      <nav class="metod-nav lathund-nav" aria-label="Lathundens sidor">
        <span class="nav-etikett" aria-hidden="true">Lathundens sidor</span>
        <ul>
          {filmer.length > 0 && <li><a href="#lathund-film">{filmer.length === 1 ? 'Filmen' : 'Filmerna'}</a></li>}
          <li><a href="#lathund-metoden">1 Metoden</a></li>
          <li><a href="#lathund-pass">2 Ett pass</a></li>
          <li><a href="#lathund-mall">3 Mallen</a></li>
          <li><a href="#lathund-material">4 Material</a></li>
        </ul>
      </nav>
    </header>
    {filmer.length > 0 && <Filmspelare filmer={filmer} id={m.id} titel={d.titel} />}
    <Lathund d={d} id={m.id} />
    <p class="upphov">{UPPHOV}. Lathund till {d.titel}{d.uppdaterad && `, uppdaterad ${datumText(d.uppdaterad)}`}. {adress}{filmer.length > 0 && `. ${FILM_UPPHOV}`}</p>
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<style is:global>
  @media print {
    @page {
      size: A4 landscape;
      margin: 9mm 11mm 13mm;
      @bottom-center { content: var(--tryck-text, ''); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 8pt; color: #555; }
    }
    @page staende {
      size: A4 portrait;
      margin: 20mm 22mm 22mm;
      @bottom-center { content: var(--tryck-text, ''); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 8pt; color: #555; }
    }
  }
</style>

<SkrivUtPdf />

<script>
  // Tillbaka till metodbanken med samma filter som läsaren hade (sparas av listan i sessionStorage).
  try {
    const filter = sessionStorage.getItem('metodfilter');
    if (filter) for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href="/stodundervisning"]')) a.href = `/stodundervisning${filter}`;
  } catch { /* utan lagring */ }
</script>
