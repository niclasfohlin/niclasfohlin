---
import Base from '../../../layouts/Base.astro';
import Lathund from '../../../components/Lathund.astro';
import Filval from '../../../components/Filval.astro';
import { publicerade } from '../../../lib/innehall';
import { datumText, metodAdress, UPPHOV } from '../../../lib/metod';
import { site } from '../../../data/site';

// /stodundervisning/<id>/lathund: snabbguiden på fyra sidor, för skärm och liggande A4.
export async function getStaticPaths() {
  const metoder = await publicerade('stodundervisning');
  return metoder.filter((m) => m.data.lathund).map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props;
const d = m.data;
const adress = `${metodAdress(site.url, m.id).replace(/^https?:\/\//, '')}/lathund`;
---

<Base title={`Lathund: ${d.titel}`} description={`Snabbguide till ${d.titel}: metoden i korthet, ett pass steg för steg, mallen och vad du behöver. Skriv ut i liggande A4 eller ladda ner som Word-fil.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="lathund">
    <header class="lathund-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${m.id}`}>{d.titel}</a> · Lathund</p>
      <h1>Lathund: {d.titel}</h1>
      <p class="ingress">Fyra sidor att ha bredvid sig: metoden i korthet, ett pass steg för steg, mallen och vad du behöver. Skriv ut i liggande A4 eller ladda ner som Word-fil.</p>
      <p class="lathund-knappar">
        <span class="bara-js"><button type="button" class="knapp" data-skriv-ut>Skriv ut lathunden (fyra sidor)</button></span>
        {' '}<Filval fil={`/stodundervisning/${m.id}-lathund`} namn={`${m.id}-lathund`} rubrik="Lathunden" pdf pptx />
      </p>
      <nav class="metod-nav lathund-nav" aria-label="Lathundens sidor">
        <span class="nav-etikett" aria-hidden="true">Lathundens sidor</span>
        <ul>
          <li><a href="#lathund-metoden">1 Metoden</a></li>
          <li><a href="#lathund-pass">2 Ett pass</a></li>
          <li><a href="#lathund-mall">3 Mallen</a></li>
          <li><a href="#lathund-material">4 Material</a></li>
        </ul>
      </nav>
    </header>
    <Lathund d={d} />
    <p class="upphov">{UPPHOV}. Lathund till {d.titel}{d.uppdaterad && `, uppdaterad ${datumText(d.uppdaterad)}`}. {adress}</p>
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<style is:global>
  @media print {
    @page {
      size: A4 landscape;
      margin: 9mm 11mm 13mm;
      @bottom-center { content: var(--tryck-text, ''); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 8pt; color: #555; }
    }
    @page staende {
      size: A4 portrait;
      margin: 20mm 22mm 22mm;
      @bottom-center { content: var(--tryck-text, ''); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 8pt; color: #555; }
    }
    body.tryck-bara-text { page: staende; }
  }
</style>

<script>
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-skriv-ut]')) {
    knapp.addEventListener('click', () => window.print());
  }
  // Tillbaka till metodbanken med samma filter som läsaren hade (sparas av listan i sessionStorage).
  try {
    const filter = sessionStorage.getItem('metodfilter');
    if (filter) for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href="/stodundervisning"]')) a.href = `/stodundervisning${filter}`;
  } catch { /* utan lagring */ }
  // Bara mallen eller bara elevtexten: de andra delarna döljs under utskriften (body.tryck-bara-* i global.css).
  const skrivUtDel = (klass: string) => {
    document.body.classList.add(klass);
    const stad = () => { document.body.classList.remove(klass); window.removeEventListener('afterprint', stad); };
    window.addEventListener('afterprint', stad);
    window.print();
    setTimeout(stad, 2000);
  };
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-skriv-ut-mall]')) knapp.addEventListener('click', () => skrivUtDel('tryck-bara-mall'));
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-skriv-ut-text]')) knapp.addEventListener('click', () => skrivUtDel('tryck-bara-text'));
</script>
