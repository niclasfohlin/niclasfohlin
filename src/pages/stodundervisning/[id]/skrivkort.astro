---
import Base from '../../../layouts/Base.astro';
import { publicerade } from '../../../lib/innehall';
import { metodAdress, UPPHOV } from '../../../lib/metod';
import { kortAdress, kortData, kortPdfNamn, skrivkortAv, skrivkortAdress, SKRIVKORT_LANK } from '../../../lib/skrivkort';
import { kortdataAdress } from '../../../lib/kortdata';
import Delning from '../../../components/Delning.astro';
import Klocka from '../../../components/Klocka.astro';
import TillMetoden from '../../../components/TillMetoden.astro';
import { delningPa } from '../../../lib/delning';
import { site } from '../../../data/site';

// /stodundervisning/<id>/skrivkort: sidan som slumpar skrivkort ur metodens bibliotek (src/lib/skrivkort.ts), som
// Niclas beskrev den 2026-10-14 (metodriggens out/TILL-SAJTEN.md, under Sidan som slumpar):
//
//   Urvalet   Läraren väljer ett kort eller tio och trycker på Alla, Bas, Medel eller Avancerat. Varje tryck slumpar nya
//             kort ur det urvalet, så att läraren kan trycka om och om igen tills ett kort passar.
//   Ett kort  visas stort, med klockan bredvid. Tio kort visas tillsammans, och ett tryck på ett av dem visar det ensamt
//             och stort med klockan.
//   Klockan   räknar ned och visar tiden som en yta som krymper, som en time timer: 1 till 99 minuter, går att pausa
//             och starta om, och ringer när tiden är slut, med en knapp för ljudet. Kortet och klockan syns samtidigt.
//   Utskrift  Det som har slumpats går att skriva ut, ett kort eller alla tio. Utskriften är kortets sida ur nivåns
//             Word-fil, som Word har sparat som pdf (src/lib/skrivkortform.ts, scripts/bankpdf.mjs, scripts/pdfdelar.mjs),
//             så att utskriften och Word-filen är samma sida (METODER.md under Utskriften). Tio kort fogas ihop i
//             webbläsaren av de tio sidorna.
//
// Sajten avgjorde resten: ljudet är en klocka som ringer tre gånger, gjord i webbläsaren utan ljudfil; antalet, den
// senaste nivån, minuterna och ljudet sparas i webbläsaren till nästa gång, liksom vilka kort som har visats, så att ett
// kort inte kommer igen förrän urvalets alla kort har varit framme (riggens förslag 2026-10-13); och på en smal skärm står
// klockan under kortet. Adressen bär korten (#bas-017), så att en omladdning visar samma kort. Knapparna heter bara som
// nivåerna, utan årskurser (Niclas 2026-10-14: "Kalla dem bara Bas, Medel och Avancerat").
//
// Pixabays licens låter bilden stå på kortet men inte delas ut som lös fil (riggens brev), så sidan har ingen knapp som
// laddar ner en bild för sig. Det läraren behöver veta om kortet, bildens motiv, en händelses bakgrund och en översättning,
// står under kortet i en rad som fälls ut och aldrig på kortet.
export async function getStaticPaths() {
  const metoder = await publicerade('stodundervisning');
  return metoder.filter((m) => skrivkortAv(m.id)).map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props;
const d = m.data;
const b = skrivkortAv(m.id)!;
const adress = `${metodAdress(site.url, m.id).replace(/^https?:\/\//, '')}/skrivkort`;
// Den korta adressen, som läraren kan skriva på tavlan (src/lib/skrivkortlank.ts).
const kort = `${site.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}${kortAdress(m.id)}`;
// Det sidans skript ritar korten ur (src/lib/skrivkort.ts, kortData), i en egen fil bredvid sidan (src/lib/kortdata.ts).
const data = kortData(m.id, b);
const kortdata = kortdataAdress(skrivkortAdress(m.id), data);
const antal = (niva: string) => b.kort.filter((k) => k.niva === niva).length;
---

<Base title={`${SKRIVKORT_LANK}: ${d.titel}`} description={`Slumpa fram ett skrivkort eller tio ur ${b.kort.length} kort på Bas, Medel och Avancerat, visa kortet stort med en klocka som alla ser, och skriv ut det.`} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="skrivkortsida" data-metod={m.id} data-titel={d.titel} data-kortdata={kortdata}>
    {/* Statistiken (DRIFT.md under Besöksstatistik): besöken räknas under metoden som "på Ta fram ett skrivkort",
        utskrifterna som utskrift:<id>/skrivkort och …:tio, helskärmen och när klockan startas som skrivkort:<id>:…
        Varje tryck på en nivå räknas inte, så att statistiken och GoatCounters tak inte fylls av slumpningen. */}
    <header class="sk-huvud">
      <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${m.id}`}>{d.titel}</a> · Skrivkort</p>
      <h1>{SKRIVKORT_LANK}</h1>
      <p class="ingress">Välj ett kort eller tio och tryck på en nivå. Varje tryck ger nya kort. Visa kortet stort med klockan, eller skriv ut det.</p>
    </header>

    <div class="sk-val">
      <div class="sk-valrad" role="group" aria-labelledby="sk-antal-etikett">
        <span class="sk-etikett" id="sk-antal-etikett">Antal</span>
        <div class="sk-segment">
          <button type="button" class="sk-antal" data-antal="1" aria-pressed="true">Ett kort</button>
          <button type="button" class="sk-antal" data-antal="10" aria-pressed="false">Tio kort</button>
        </div>
      </div>
      <div class="sk-valrad" role="group" aria-labelledby="sk-niva-etikett">
        <span class="sk-etikett" id="sk-niva-etikett">Slumpa ur</span>
        <div class="sk-nivaknappar">
          <button type="button" class="sk-niva" data-niva="Alla">Alla</button>
          {b.nivaer.map((n) => (
            <button type="button" class="sk-niva" data-niva={n.namn} style={`--niva:#${n.farg}`}>{n.namn}</button>
          ))}
        </div>
      </div>
      <TillMetoden metod={m.id} titel={d.titel} verktyg={SKRIVKORT_LANK} handelse={`skrivkort:${m.id}:metoden`} />
    </div>

    <div class="sk-scen" id="sk-scen" data-lage="tom">
      <p class="sk-tom">Tryck på Alla, Bas, Medel eller Avancerat.</p>
      <div class="sk-ett" id="sk-ett" hidden>
        <div class="sk-kortplats" id="sk-kortplats" tabindex="-1" aria-label="Kortet"></div>
        <div class="sk-sidospalt">
        <Klocka />
        <div class="sk-atgarder">
          <a class="knapp sekundar" id="sk-skrivut-ett" href="#" target="_blank" rel="noopener" data-goatcounter-click={`utskrift:${m.id}/skrivkort`} data-goatcounter-title={`${d.titel}: utskrift av ett skrivkort`}>Skriv ut kortet</a>
          <button type="button" class="knapp sekundar" id="sk-helskarm" hidden data-goatcounter-click={`skrivkort:${m.id}:helskarm`} data-goatcounter-title={`${d.titel}: skrivkortet i helskärm`}>Helskärm</button>
          <button type="button" class="knapp sekundar" id="sk-tillbaka" hidden>Tillbaka till de tio</button>
        </div>
        <details class="sk-om" id="sk-om" hidden>
          <summary>Om kortet, till dig</summary>
          <div id="sk-om-text"></div>
        </details>
        </div>
      </div>
      <div class="sk-tio-ram" id="sk-tio-ram" hidden>
        <div class="sk-atgarder sk-tio-rad">
          <p class="sk-tio-not">Tryck på ett kort för att visa det stort med klockan.</p>
          <a class="knapp sekundar" id="sk-skrivut-tio" href="#" target="_blank" rel="noopener" data-goatcounter-click={`utskrift:${m.id}/skrivkort:tio`} data-goatcounter-title={`${d.titel}: utskrift av tio skrivkort`}>Skriv ut alla tio</a>
        </div>
        <ol class="sk-tio" id="sk-tio"></ol>
      </div>
    </div>

    <noscript><p class="sk-tom">Sidan behöver JavaScript för att slumpa korten och visa klockan.</p></noscript>

    <p class="upphov">{UPPHOV}. Skrivkorten till <a href={`/stodundervisning/${m.id}`}>{d.titel}</a>: {b.kort.length} kort, {b.nivaer.map((n) => `${antal(n.namn)} på ${n.namn}`).join(', ')}. Bildernas upphov står i kortets fot. Sidans korta adress är {kort}.</p>

    {/* Varje korts pdf, med filens version i adressen (scripts/filversion.mjs sätter den i länkarna efter bygget), så att
        webbläsaren aldrig ger ett äldre kort än sidan. Skriptet läser adresserna härifrån. */}
    <template id="sk-pdf">{b.kort.map((k) => <a data-kort={k.id} href={`/stodundervisning/${kortPdfNamn(m.id, k.id)}.pdf`}></a>)}</template>
    {/* Delningsraden, som på metodens sida: sidan har ett eget delningskort med tre skrivkort och klockan
        (src/lib/delningskort.ts), så att den går att dela direkt (Niclas 2026-10-14). */}
    {delningPa && <Delning sida={skrivkortAdress(m.id)} titel={`${SKRIVKORT_LANK}: ${d.titel}`} medKort />}
  </article>
</Base>

<script>
  import { el, kortet as ritaKort, passa, type Data, type Kort } from '../../../scripts/skrivkortet';
  import { klocka } from '../../../scripts/klocka';
  import { ettkortLank, flerakortKnapp } from '../../../scripts/pdfutskrift';
  import { hamtaKortdata } from '../../../scripts/kortdata';

  const sida = document.querySelector<HTMLElement>('.skrivkortsida')!;
  const metod = sida.dataset.metod!;
  const data = await hamtaKortdata<Data>(sida);
  const kortMed = new Map(data.kort.map((k) => [k.id, k]));
  const pdfFor = new Map([...(document.getElementById('sk-pdf') as HTMLTemplateElement).content.querySelectorAll<HTMLAnchorElement>('a[data-kort]')].map((a) => [a.dataset.kort!, a.getAttribute('href')!]));
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // Det som sparas till nästa gång, i den här webbläsaren. Utan lagring (privat fönster) fungerar sidan ändå.
  const NYCKEL = `skrivkort:${metod}`;
  type Sparat = { antal: number; niva?: string; minuter: number; ljud: boolean; sedda: string[] };
  const sparat: Sparat = (() => {
    const forval: Sparat = { antal: 1, minuter: 3, ljud: true, sedda: [] };
    try { return { ...forval, ...JSON.parse(localStorage.getItem(NYCKEL) ?? '{}') }; } catch { return forval; }
  })();
  const spara = () => { try { localStorage.setItem(NYCKEL, JSON.stringify(sparat)); } catch { /* utan lagring */ } };

  // ---------- Slumpen ----------
  // Ett kort kommer inte igen förrän urvalets alla kort har varit framme. När det inte finns nog med kort som inte har
  // visats börjar urvalet om, och de kort som redan står på skärmen dras inte igen i samma tryck.
  const slumpa = <T,>(xs: T[]) => { const a = [...xs]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  function dra(niva: string, n: number): Kort[] {
    const urval = data.kort.filter((k) => niva === 'Alla' || k.niva === niva);
    const sedda = new Set(sparat.sedda);
    let nya = urval.filter((k) => !sedda.has(k.id));
    const valda: Kort[] = slumpa(nya).slice(0, n);
    if (valda.length < n) {
      // Urvalet börjar om: dess kort räknas inte längre som visade.
      const iUrvalet = new Set(urval.map((k) => k.id));
      sparat.sedda = sparat.sedda.filter((id) => !iUrvalet.has(id));
      nya = urval.filter((k) => !valda.includes(k));
      valda.push(...slumpa(nya).slice(0, n - valda.length));
    }
    sparat.sedda.push(...valda.map((k) => k.id));
    spara();
    return valda;
  }

  // ---------- Kortet ----------
  // Kortets form står i src/scripts/skrivkortet.ts, som delningskortet för sidan också ritar med.
  const kortet = (k: Kort, liten: boolean) => ritaKort(data, k, liten);

  // ---------- Läget ----------
  const scen = $('sk-scen');
  const valrad = document.querySelector<HTMLElement>('.sk-val')!;
  const ett = $('sk-ett');
  const tioRam = $('sk-tio-ram');
  const tio = $<HTMLOListElement>('sk-tio');
  const plats = $('sk-kortplats');
  const tillbaka = $<HTMLButtonElement>('sk-tillbaka');
  const skrivutEtt = $<HTMLAnchorElement>('sk-skrivut-ett');
  const skrivutTio = $<HTMLAnchorElement>('sk-skrivut-tio');
  const helskarmKnapp = $<HTMLButtonElement>('sk-helskarm');
  // Efter en dragning står korten direkt under urvalet, så att kortet och klockan syns hela och urvalet går att trycka
  // på igen utan att rulla.
  const tillScenen = () => {
    const under = valrad.getBoundingClientRect().bottom;
    const topp = scen.getBoundingClientRect().top;
    const fast = getComputedStyle(valrad).position === 'sticky';
    const mal = fast ? under + 12 : 12;
    if (Math.abs(topp - mal) > 4) window.scrollBy({ top: topp - mal, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  };
  const om = $<HTMLDetailsElement>('sk-om');
  let dragna: Kort[] = [];

  function omKortet(k: Kort) {
    const ut = $('sk-om-text');
    ut.replaceChildren();
    const bild = k.bild ? data.bilder[k.bild] : undefined;
    const p = (text: string) => ut.append(el('p', undefined, text));
    if (k.handelse) { if (k.handelse.plats) p(`Platsen: ${k.handelse.plats}.`); if (k.handelse.bakgrund) p(k.handelse.bakgrund); }
    if (k.citat?.oversatt) p(k.citat.oversatt);
    if (bild?.motiv) p(`Bilden: ${bild.motiv}.`.replace(/\.\.$/, '.'));
    if (bild?.bakgrund) p(bild.bakgrund);
    if (bild) {
      const kalla = el('p', 'sk-kalla');
      kalla.append(`${bild.rad} `);
      if (bild.adress) { const a = el('a', undefined, 'Bildens källa') as HTMLAnchorElement; a.href = bild.adress; a.rel = 'noopener'; a.target = '_blank'; kalla.append(a); }
      if (bild.licensadress && bild.licens) { kalla.append(', '); const a = el('a', undefined, bild.licens) as HTMLAnchorElement; a.href = bild.licensadress; a.rel = 'noopener'; a.target = '_blank'; kalla.append(a); }
      kalla.append('.');
      ut.append(kalla);
    }
    om.hidden = !ut.childElementCount;
  }

  function visaEtt(k: Kort, franTio: boolean) {
    scen.dataset.lage = 'ett';
    tioRam.hidden = true;
    ett.hidden = false;
    const kort = kortet(k, false);
    plats.replaceChildren(kort);
    kort.querySelector('img')?.addEventListener('load', () => passa(kort), { once: true });
    passa(kort);
    // Elevens typsnitt, Anton och Cinzel hämtas först när ett kort visas, och texten tar annan plats när de har kommit.
    void document.fonts?.ready.then(() => { if (kort.isConnected) passa(kort); });
    tillbaka.hidden = !franTio;
    plats.setAttribute('aria-label', `Kortet ${k.niva} ${k.nr}`);
    skrivutEtt.href = pdfFor.get(k.id) ?? '#';
    helskarmKnapp.hidden = !document.fullscreenEnabled;
    omKortet(k);
    om.open = false;
    history.replaceState(null, '', `#${franTio ? `${dragna.map((x) => x.id).join(',')}/${k.id}` : k.id}`);
  }
  function visaTio() {
    scen.dataset.lage = 'tio';
    ett.hidden = true;
    tioRam.hidden = false;
    if (document.fullscreenElement) void document.exitFullscreen();
    tio.replaceChildren(...dragna.map((k) => {
      const li = el('li');
      const knapp = el('button', 'sk-val-kort') as HTMLButtonElement;
      knapp.type = 'button';
      knapp.dataset.kort = k.id;
      const namn = k.form === 'citat' ? `citat av ${k.citat?.vem}` : k.form === 'handelse' ? `${k.handelse?.ar}` : (k.bild ? data.bilder[k.bild].alt : '');
      knapp.setAttribute('aria-label', `Visa ${k.niva} ${k.nr} stort: ${namn}`);
      knapp.append(kortet(k, true));
      // Fokus följer med till kortet, eftersom knappen göms när kortet visas.
      knapp.addEventListener('click', () => { visaEtt(k, true); tillScenen(); plats.focus({ preventScroll: true }); });
      li.append(knapp);
      return li;
    }));
    history.replaceState(null, '', `#${dragna.map((x) => x.id).join(',')}`);
  }

  // ---------- Urvalet ----------
  const antalKnappar = [...document.querySelectorAll<HTMLButtonElement>('.sk-antal')];
  const nivaKnappar = [...document.querySelectorAll<HTMLButtonElement>('.sk-niva')];
  const visaAntal = () => antalKnappar.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.antal) === sparat.antal)));
  const visaNiva = (niva?: string) => nivaKnappar.forEach((b) => b.classList.toggle('senast', b.dataset.niva === niva));
  antalKnappar.forEach((b) => b.addEventListener('click', () => { sparat.antal = Number(b.dataset.antal); spara(); visaAntal(); }));
  nivaKnappar.forEach((b) => b.addEventListener('click', () => {
    const niva = b.dataset.niva!;
    sparat.niva = niva;
    visaNiva(niva);
    dragna = dra(niva, sparat.antal);
    if (sparat.antal === 1) visaEtt(dragna[0], false); else visaTio();
    tillScenen();
  }));
  tillbaka.addEventListener('click', () => { const fran = plats.querySelector<HTMLElement>('.skrivkort')?.dataset.kort; visaTio(); tillScenen(); tio.querySelector<HTMLButtonElement>(`button[data-kort="${fran}"]`)?.focus({ preventScroll: true }); });
  visaAntal();
  visaNiva(sparat.niva);

  // Korten i adressen: #bas-017 är ett kort, #bas-017,medel-002,… är tio, och /bas-017 efter tio är det som visas stort.
  (() => {
    const [lista, valt] = decodeURIComponent(location.hash.slice(1)).split('/');
    const kort = (lista ?? '').split(',').map((id) => kortMed.get(id)).filter((k): k is Kort => !!k);
    if (!kort.length) return;
    dragna = kort;
    // Ett kort som öppnas via adressen (länkarna i tabellen Börja här) räknas som visat, som ett slumpat.
    for (const k of kort) if (!sparat.sedda.includes(k.id)) sparat.sedda.push(k.id);
    spara();
    if (kort.length === 1) visaEtt(kort[0], false);
    else if (valt && kortMed.has(valt)) visaEtt(kortMed.get(valt)!, true);
    else visaTio();
  })();

  // ---------- Utskriften ----------
  // Ett kort är kortets pdf, klippt ur nivåns pdf, och tio kort fogas ihop i webbläsaren (src/scripts/pdfutskrift.ts).
  ettkortLank(skrivutEtt);
  flerakortKnapp(skrivutTio, () => ({ adresser: dragna.map((k) => pdfFor.get(k.id)!), titel: `Skrivkort: ${dragna.map((k) => `${k.niva} ${k.nr}`).join(', ')}` }));

  // ---------- Helskärm ----------
  // Knappen Helskärm står under klockan. I helskärm lämnar knappen med ikonen bredvid tiden den, och Esc eller
  // telefonens bakåt gör det också.
  helskarmKnapp.addEventListener('click', () => { void ett.requestFullscreen?.(); });
  document.querySelector<HTMLButtonElement>('.sk-lamna')!.addEventListener('click', () => { if (document.fullscreenElement) void document.exitFullscreen(); });
  document.addEventListener('fullscreenchange', () => {
    const kort = plats.querySelector<HTMLElement>('.skrivkort');
    if (kort) requestAnimationFrame(() => passa(kort));
  });
  new ResizeObserver(() => { const kort = plats.querySelector<HTMLElement>('.skrivkort'); if (kort && Number(kort.dataset.bredd) !== kort.clientWidth) passa(kort); }).observe(plats);

  // ---------- Klockan ----------
  // Klockan står i src/scripts/klocka.ts, som sidan Ta fram en brainbreak delar. En klocka som startar från början räknas
  // i statistiken, en som fortsätter efter paus inte.
  klocka(document.querySelector<HTMLElement>('.sk-klocka')!, {
    val: { minuter: sparat.minuter, ljud: sparat.ljud },
    spara: (v) => { sparat.minuter = v.minuter; sparat.ljud = v.ljud; spara(); },
    vidStart: () => (window as { goatcounter?: { count: (v: object) => void } }).goatcounter?.count({ path: `skrivkort:${metod}:klocka`, title: `${sida.dataset.titel}: klockan startad`, event: true }),
  });
</script>
