---
// /stodundervisning/<id>/planera: Planera insatsen (K-489), för varje metod som kan planeras (src/lib/insatsplan.ts).
// Bygget stannar på en metod vars plan inte går att läsa, så att en metod aldrig får en plan som räknar fel.
import Planera from '../../../components/Planera.astro';
import PlaneraKurser from '../../../components/PlaneraKurser.astro';
import { publicerade } from '../../../lib/innehall';
import { insatsplanFel, planbar, planensData } from '../../../lib/insatsplan';
import { metodensLektionskort } from '../../../lib/lektionskort';

export async function getStaticPaths() {
  const metoder = (await publicerade('stodundervisning')).filter((m) => planbar(m.data));
  const fel = (await Promise.all(metoder.map(insatsplanFel))).flat();
  if (fel.length) throw new Error(`Planera insatsen: ${fel.length} fel i metodernas plan (METODER.md under Planera insatsen):\n  ${fel.join('\n  ')}`);
  return metoder.map((m) => ({ params: { id: m.id }, props: { m, antal: metoder.length } }));
}

const { m, antal } = Astro.props;
const data = await planensData(m);
const lektionskort = metodensLektionskort(m.data, m.id);
// En serie med lektionsbank (K-551): varje lektions lektionskort, som veckan visar när lektionen är vald.
const lektionerna = data.lektioner ? (await publicerade('stodundervisning')).filter((x) => x.data.serie === m.id && x.data.formaga !== undefined) : [];
const lektionernasKort = Object.fromEntries(lektionerna.map((x) => [x.data.formaga!, metodensLektionskort(x.data, x.id)]));
// Och varje lektions snabbmall, som veckan skriver ut när lektionen är vald (Rimligheten 2026-10-27: texten ledde till
// lektionens snabbmall och knappen skrev ut seriens).
const lektionernasMallar = Object.fromEntries(lektionerna.filter((x) => x.data.snabbmall).map((x) => [x.data.formaga!, { id: x.id, rubrik: x.data.snabbmall!.rubrik, titel: x.data.titel }]));
---

{data.versionsval?.kurser ? <PlaneraKurser data={data} /> : <Planera data={data} lektionskort={lektionskort} lektionernasKort={lektionernasKort} lektionernasMallar={lektionernasMallar} antal={antal} snabbmall={m.data.snabbmall ? { rubrik: m.data.snabbmall.rubrik, period: m.data.snabbmall.period } : undefined} />}
