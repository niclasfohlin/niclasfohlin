---
import Base from '../../layouts/Base.astro';
import Taggar from '../../components/Taggar.astro';
import Metod from '../../components/Metod.astro';
import Nedladdning from '../../components/Nedladdning.astro';
import Seriemeny from '../../components/Seriemeny.astro';
import Seriefot from '../../components/Seriefot.astro';
import Delning from '../../components/Delning.astro';
import { delningPa } from '../../lib/delning';
import Kommentarer from '../../components/Kommentarer.astro';
import { kommentarerPa } from '../../lib/kommentarer';
import { publicerade, formateraDatum } from '../../lib/innehall';
import { arskursText, ejBryt, harLathund, harMallar, metodAdress, SAJT, UPPHOV } from '../../lib/metod';
import { byggSerier, serieKoppling } from '../../lib/serie';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const metoder = await publicerade('stodundervisning');
  const serier = byggSerier(metoder);
  return metoder.map((m) => ({ params: { id: m.id }, props: { m, alla: metoder, koppling: serieKoppling(m.id, m.data, serier) } }));
}

const { m, alla, koppling } = Astro.props;
const d = m.data;
// En lektion har sin serie i menyn och sist på sidan, så att Hör ihop med bara visar metoder utanför serien.
const iSerien = (x: (typeof alla)[number]) => Boolean(koppling) && (x.id === koppling!.serie.id || x.data.serie === koppling!.serie.id);
const relaterade = alla.filter((x) => d.relaterade.includes(x.id) && !iSerien(x));
const adress = metodAdress(site.url, m.id).replace(/^https?:\/\//, '');
const serie = koppling?.serie;
const lektion = koppling?.lektion;
const antalLektioner = serie?.lektioner.length ?? 0;
---

<Base title={d.titel} description={d.ingress} typ="article" tryckText={`${UPPHOV} · ${adress}`}>
  <article class="metod" data-serie-adress={lektion && serie ? `/stodundervisning/${serie.id}` : undefined} data-serie-titel={lektion && serie ? serie.titel : undefined}>
    {koppling && <Seriemeny koppling={koppling} />}
    <div class="metod-topp">
      <header class="metod-huvud">
        {lektion && serie
          ? <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · <a href={`/stodundervisning/${serie.id}`}>{serie.titel}</a></p>
          : <p class="meta brodsmula"><a href="/stodundervisning">Stödundervisning</a> · {d.omrade} · {arskursText(d)}</p>}
        <h1>{d.titel}</h1>
        {d.undertitel && <p class="undertitel">{ejBryt(d.undertitel)}</p>}
        <p class="ingress">{ejBryt(d.ingress)}</p>
      </header>
      <div class="faktaruta">
        <p class="faktaruta-etikett">I korthet</p>
        <dl>
          {lektion && serie && <><dt>Hör till</dt><dd><a href={`/stodundervisning/${serie.id}`}>{serie.titel}</a>, förmåga {lektion.formaga} av {serie.formagor.length}: {koppling?.formaga?.namn}</dd></>}
          <dt>Område</dt><dd>{d.omrade}</dd>
          <dt>Årskurs</dt><dd>{arskursText(d)}</dd>
          {d.format.length > 0 && <><dt>Format</dt><dd>{d.format.join(', ')}</dd></>}
          {d.tid && <><dt>Tid</dt><dd>{d.tid}</dd></>}
          {d.period && <><dt>Period</dt><dd>{d.period}</dd></>}
          {d.grupp && <><dt>Grupp</dt><dd>{d.grupp}</dd></>}
          {serie && !lektion && antalLektioner > 0 && <><dt>Lektioner</dt><dd><a href="#lektionsbank">{antalLektioner === 1 ? 'En' : antalLektioner} i lektionsbanken</a></dd></>}
          {d.material.length > 0 && <><dt>Material</dt><dd>{d.material.join('. ')}.</dd></>}
          {d.uppdaterad && <><dt>Uppdaterad</dt><dd>{formateraDatum(d.uppdaterad)}</dd></>}
        </dl>
      </div>
      {delningPa && <Delning sida={`/stodundervisning/${m.id}`} titel={d.titel} plats="topp" />}
      <Nedladdning id={m.id} titel={d.titel} harMallar={harMallar(d)} harLathund={harLathund(d)} ramar={d.ramar?.rubrik.toLowerCase()} />
    </div>

    <Metod d={d} id={m.id} koppling={koppling} />

    {koppling && lektion && <Seriefot koppling={koppling} />}

    <footer class="metod-fot">
      <Taggar taggar={d.taggar} nivaer={d.arskurs} />
      {relaterade.length > 0 && (
        <section class="relaterade">
          <h2>Hör ihop med</h2>
          <ul>
            {relaterade.map((r) => <li><a href={`/stodundervisning/${r.id}`}>{r.data.titel}</a>{' '}<span class="meta">{r.data.omrade} · {arskursText(r.data)}</span></li>)}
          </ul>
        </section>
      )}
      <p class="upphov">{UPPHOV}. Metoden får användas i undervisning. Ange {SAJT} som källa när den sprids vidare. {adress}</p>
    </footer>
    {delningPa && <Delning sida={`/stodundervisning/${m.id}`} titel={d.titel} />}
    {kommentarerPa && <Kommentarer sida={`/stodundervisning/${m.id}`} titel={d.titel} />}
  </article>
  <div class="tryck-fot" aria-hidden="true">{UPPHOV} · {adress}</div>
</Base>

<script>
  // En lektions hänvisningar till den generella metoden blir länkar till avsnittet där (Ljudlek i grupp, riggens
  // TILL-SAJTEN): "Ordbanken i Ljudlek i grupp" går till #ordbanken, "bokstavskartan i Ljudlek i grupp" till
  // #bokstavskartan, och en mening utan känt avsnitt till sidans början. Ankarna sätter Metod.astro ur rubrikerna. Utan
  // JavaScript står texten som den är, och seriens meny och vägen tillbaka länkar ändå till den generella metoden.
  const artikel = document.querySelector<HTMLElement>('article[data-serie-adress]');
  if (artikel) {
    const adress = artikel.dataset.serieAdress!;
    const titel = artikel.dataset.serieTitel!;
    const avsnitt: [RegExp, string][] = [
      [/Ordbanken|ordgrupperna/, 'ordbanken'], [/bokstavskartan/i, 'bokstavskartan'], [/ljudkollen/i, 'ljudkollen-elevens-blad'],
      [/Dagens ljud/, 'dagens-ljud'], [/Paren och trion|gruppen|dagens elever/, 'gruppen'], [/ljudstart/i, 'ljudstarten'],
      [/felsökning/i, 'felsokning'], [/Observation av ett pass/, 'observation-av-ett-pass'],
    ];
    const mal = (mening: string) => { const t = avsnitt.map(([re, id]) => ({ i: mening.search(re), id })).filter((x) => x.i >= 0).sort((a, b) => a.i - b.i)[0]; return t ? `${adress}#${t.id}` : adress; };
    const falt = artikel.querySelectorAll('.metod-text, .faktaruta dd');
    for (const del of falt) {
      const noder: Text[] = [];
      const gang = document.createTreeWalker(del, NodeFilter.SHOW_TEXT, { acceptNode: (n) => (n.nodeValue?.includes(titel) && !n.parentElement?.closest('a, h1, h2, h3, h4, .serie-meny') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT) });
      while (gang.nextNode()) noder.push(gang.currentNode as Text);
      for (const nod of noder) {
        const text = nod.nodeValue!;
        const helhet = nod.parentElement?.textContent ?? text;
        const bitar = text.split(titel);
        const frag = document.createDocumentFragment();
        let pos = 0;
        bitar.forEach((bit, i) => {
          frag.append(bit);
          pos += bit.length;
          if (i === bitar.length - 1) return;
          // Meningen runt hänvisningen avgör avsnittet.
          const start = Math.max(0, helhet.lastIndexOf('.', helhet.indexOf(text) + pos) + 1);
          const slut = helhet.indexOf('.', helhet.indexOf(text) + pos);
          const a = document.createElement('a');
          a.href = mal(helhet.slice(start, slut < 0 ? undefined : slut));
          a.textContent = titel;
          frag.append(a);
          pos += titel.length;
        });
        nod.replaceWith(frag);
      }
    }
  }

  // Tillbaka till metodbanken med samma filter som läsaren hade (sparas av listan i sessionStorage).
  try {
    const filter = sessionStorage.getItem('metodfilter');
    if (filter) for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href="/stodundervisning"]')) a.href = `/stodundervisning${filter}`;
  } catch { /* utan lagring */ }
</script>
