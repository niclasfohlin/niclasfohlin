---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { allaTaggar, samlingarnasPoster } from '../../lib/innehall';
import { SAMLINGARNA } from '../../lib/samlingar';

// Antalet poster med taggen i alla samlingar med sidor (src/lib/samlingar.ts); scripts/cacheprov.mjs stannar när talet inte
// är taggens poster.
const poster = await samlingarnasPoster();
const antal = new Map<string, number>();
for (const post of SAMLINGARNA.flatMap((s) => poster[s] as { data: { taggar: string[] } }[])) {
  for (const t of post.data.taggar) antal.set(t, (antal.get(t) ?? 0) + 1);
}
const omraden = ['Läsning', 'Skrivning', 'Matematik', 'Socialt', 'Allmänt'];
const taggar = allaTaggar().filter((t) => (antal.get(t.id) ?? 0) > 0);
---

<Base title={site.sidor.taggar.titel} description={site.sidor.taggar.beskrivning}>
  <h1>Taggar</h1>
  {omraden.map((o) => {
    const lista = taggar.filter((t) => t.omrade === o);
    if (lista.length === 0) return null;
    return (
      <section>
        <h2>{o}</h2>
        <ul class="taggar">
          {lista.map((t) => <li><a class="tagg" href={`/taggar/${t.id}`}>{t.label} ({antal.get(t.id)})</a></li>)}
        </ul>
      </section>
    );
  })}
</Base>
