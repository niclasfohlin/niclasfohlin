---
import Base from '../../layouts/Base.astro';
import Taggar from '../../components/Taggar.astro';
import { artiklarSorterade, formateraDatum, publikationNamn } from '../../lib/innehall';
const artiklar = await artiklarSorterade();
---

<Base title="Artiklar" description="Publicerade artiklar, krönikor och debattinlägg om skola, undervisning och särskilt stöd.">
  <h1>Artiklar</h1>
  <p class="text">Texter jag publicerat i Vi Lärare, Göteborgs-Posten och andra tidningar. Varje post länkar till originalet.</p>
  {artiklar.length === 0 && <p>Inga artiklar ännu.</p>}
  {artiklar.map((a) => (
    <article class="kort">
      <p class="meta">{formateraDatum(a.data.datum)} · {publikationNamn(a.data.publikation)}</p>
      <h2><a href={`/artiklar/${a.id}`}>{a.data.titel}</a></h2>
      <p>{a.data.ingress}</p>
      <Taggar taggar={a.data.taggar} />
    </article>
  ))}
</Base>
