---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Taggar from '../../components/Taggar.astro';
import Kalla from '../../components/Kalla.astro';
import Delning from '../../components/Delning.astro';
import Kommentarer from '../../components/Kommentarer.astro';
import { kommentarerPa } from '../../lib/kommentarer';
import { delningPa } from '../../lib/delning';
import { publicerade, formateraDatum, publikationNamn, typLabel } from '../../lib/innehall';
import { sattInLyftcitat } from '../../lib/lyftcitat';

export async function getStaticPaths() {
  const artiklar = await publicerade('artiklar');
  return artiklar.map((a) => ({ params: { id: a.id }, props: { a } }));
}

const { a } = Astro.props;
const { Content } = await render(a);
// Lyftcitaten sätts in i textens färdiga html, som glob-laddaren har i posten och som <Content /> annars ritar
// (src/lib/lyftcitat.ts). En text utan citat ritas som förut. Texterna har inga bilder som Astro behandlar (bilderna
// ligger under public/), så html:en i posten är densamma som <Content /> ger.
const medCitat = a.data.citat ? sattInLyftcitat(a.rendered?.html ?? '', a.data.citat, a.id) : undefined;
// "A, B och C" i stället för "A och B och C" när flera medförfattare står på texten.
const medforfattare = new Intl.ListFormat('sv', { type: 'conjunction' }).format(a.data.medforfattare);
const namn = publikationNamn(a.data.publikation);
---

<Base title={a.data.titel} description={a.data.ingress} typ="article">
  <article class="artikel">
    <header class="artikel-huvud">
      <p class="meta">{typLabel(a.data.typ)} · {namn} · {formateraDatum(a.data.datum)}</p>
      <h1>{a.data.titel}</h1>
      <p class="ingress">{a.data.ingress}</p>
      {a.data.medforfattare.length > 0 && <p class="meta">Tillsammans med {medforfattare}</p>}
      <Kalla publikation={a.data.publikation} originalUrl={a.data.originalUrl} datum={a.data.datum} typ={a.data.typ} />
    </header>
    <div class="brod">
      {medCitat ? <Fragment set:html={medCitat} /> : <Content />}
    </div>
    <footer class="artikel-fot">
      <Taggar taggar={a.data.taggar} />
      {a.data.heltext && a.data.originalUrl && (
        <p class="meta">Texten publicerades först i {namn}. <a href={a.data.originalUrl} rel="noopener">Läs originalet där</a>.</p>
      )}
    </footer>
    {delningPa && <Delning sida={`/artiklar/${a.id}`} titel={a.data.titel} />}
    {kommentarerPa && <Kommentarer sida={`/artiklar/${a.id}`} titel={a.data.titel} />}
  </article>
</Base>
