---
import Base from '../layouts/Base.astro';
import Metodkort from '../components/Metodkort.astro';
import TextKort from '../components/TextKort.astro';
import BokKort from '../components/BokKort.astro';
import { site } from '../data/site';
import { artiklarSorterade, metoderSenaste, metodSerier, bockerSorterade, publicerade } from '../lib/innehall';
import { serieTaggar } from '../lib/serie';

const artiklar = await artiklarSorterade();
const utvalda = artiklar.filter((a) => a.data.utvald).slice(0, 3);
const senaste = (utvalda.length > 0 ? utvalda : artiklar).slice(0, 3);
const metoder = (await metoderSenaste()).slice(0, 3);
const serier = await metodSerier();
const allaMetoder = await publicerade('stodundervisning');
const bocker = (await bockerSorterade()).slice(0, 4);
---

<Base>
  {/* Startsidans huvud (K-620; Niclas 2026-10-29: "Länkarna nere är lite lång text och kanske en rad för dem eller symbol?"):
      porträttet bredvid raden, rubriken, texten, metoderna som knapp och Om mig och mejlen på en rad med symboler. */}
  <section class="hero">
    <div class="hero-person">
      <img class="portratt-rund" src={site.portratt} alt="" width="480" height="558" />
      <p class="meta">{site.rad}</p>
    </div>
    <h1>Texter och verktyg för en skola som fungerar bättre.</h1>
    <p class="hero-text">Jag är speciallärare och specialpedagog. Här samlar jag mina krönikor och debattartiklar om skolan, böckerna om undervisning och metoder för stödundervisning i läsning, skrivning, matematik och socialt samspel.</p>
    <a class="knapp hero-knapp" href="/stodundervisning">Hitta en metod för stödpasset</a>
    <ul class="hero-lankar">
      <li><a href="/om"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>Om mig</a></li>
      <li><a href="/prenumerera"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 7 8.5-7" /></svg>Få mejl om nytt</a></li>
    </ul>
  </section>

  <section>
    <h2>{utvalda.length > 0 ? 'Utvalda texter' : 'Senaste texter'}</h2>
    <div class="rutnat">
      {senaste.map((a) => (
        <TextKort a={a} />
      ))}
    </div>
    <p class="lankrad"><a href="/artiklar">Alla {artiklar.length} texter</a></p>
  </section>

  {bocker.length > 0 && (
    <section>
      <h2>Böcker</h2>
      <p class="text">Böcker om kooperativt lärande, undervisning och läsinlärning, de flesta skrivna tillsammans med Jennie Wilson.</p>
      <div class="rutnat bokrad">
        {bocker.map((b) => (
          <BokKort b={b} />
        ))}
      </div>
      <p class="lankrad"><a href="/bocker">Alla böcker</a></p>
    </section>
  )}

  {metoder.length > 0 && (
    <section>
      <h2>Stödundervisning</h2>
      <p class="text">De senaste metoderna. Hela metodbanken är sorterad på område, årskurs och vad metoderna tränar.</p>
      <div class="rutnat">
        {metoder.map((m) => { const serie = serier.get(m.id); return <Metodkort m={m} serie={serie} taggar={serie && serieTaggar(serie, allaMetoder)} forsmak />; })}
      </div>
      <p class="lankrad"><a href="/stodundervisning">Hela metodbanken</a></p>
    </section>
  )}

  <aside class="rop">
    <h2>Ett mejl när det kommer nytt</h2>
    <p>Nya texter, böcker och metoder skickas till dem som prenumererar. Inget annat, och du kan avsluta när som helst.</p>
    <p><a class="knapp" href="/prenumerera">Prenumerera</a></p>
  </aside>
</Base>
