---
// Statistiken (K-086, Niclas 2026-09-28): besök och nedladdningar i sajtens kategorier, med metodernas topp 3 och
// filernas topp 5 och delningarna från delningsraden (K-088), för i dag, sju och trettio dagar och ett år, med
// besöken över tid, varifrån besökarna kommer och om de har mobil eller dator (det som WordPress och GoatCounters panel visar och som Niclas har nytta av). Siffrorna hämtas i webbläsaren direkt från GoatCounters API
// (https://www.goatcounter.com/help/api), som tillåter anrop från andra adresser. Niclas klistrar in en nyckel med
// rätten att läsa statistik en gång; den sparas bara i hans webbläsare och skickas bara till GoatCounter. Sidan
// har ingen egen data, länkas inte från menyn, har noindex, står utanför sitemap och räknas inte själv (Base, dold).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { samlingarnasPoster } from '../lib/innehall';
import { planbar } from '../lib/planbar';
import { SAMLINGARNA, samlingen } from '../lib/samlingar';
import { SAMLINGARNAS_LED, uppraknat } from '../lib/standard/index.js';
const bas = (site.statistik ?? '').replace(/\/count$/, '');
// Besöken sorteras efter samlingarna med sidor, ur roten över samlingarna (src/lib/samlingar.ts): en ruta per samling, med
// postens sida, lathunden och undersidorna under namnet, och efter en samling med en plan planens ruta. En ny samling får sin
// ruta av sig själv. Postens namn kommer ur samlingen, så att en post heter rätt också när bara dess undersidor eller verktyg
// har besök i perioden (granskningen av statistiken 2026-10-19: temats sida heter "Vatten: Ta fram en faktatext", utan
// metodens namn).
const poster = await samlingarnasPoster();
const namnen = Object.fromEntries(SAMLINGARNA.map((s) => [samlingen(s).led, Object.fromEntries((poster[s] as { id: string; data: { titel: string } }[]).map((p) => [p.id, p.data.titel]))]));
// Planens ruta (K-504, K-628): besökarna på planens sida per metod, och under namnet planens händelser med orden här. Planera
// insatsens andra knappar står bland Knapparna i verktygen och pagar under Pågående insatser, och alla Lär dig metodens
// händelser står i dess ruta (Niclas 2026-10-31), med trycken på länkarna i planen ihop. Händelsernas förled är samlingens i
// standarden (SAMLINGARNAS_LED). En samling med plan utan sin rad här stannar bygget.
const PLANENS_RUTA: Record<string, { forklaring: string; ord: Record<string, [string, string]>; alltid?: string; ovriga?: string; utan?: string[] }> = {
  stodundervisning: { forklaring: 'Besökare på planens sida. Under namnet står hur många som sparade en plan.', ord: { spara: ['sparad', 'sparade'], folj: ['valde Följ insatsen', 'valde Följ insatsen'], kalender: ['hämtade kalenderfilen', 'hämtade kalenderfilen'] }, alltid: 'spara', utan: ['pagar'] },
  metoder: { forklaring: 'Besökare på sidan Lär dig metoden. Under namnet står hur många som sparade en plan, och vad de gjorde i planen.', ord: { spara: ['sparad', 'sparade'], avsluta: ['avslutade planen', 'avslutade planen'], 'sammanstallning-pdf': ['hämtade sammanställningen', 'hämtade sammanställningen'] }, alltid: 'spara', ovriga: 'tryck på länkarna i planen' },
};
const delarna = SAMLINGARNA.map((s) => {
  const { led, namn, bestamd, plan } = samlingen(s);
  const handelse = plan && (SAMLINGARNAS_LED as Record<string, string>)[led];
  if (plan && (!handelse || !PLANENS_RUTA[led])) throw new Error(`Statistiken: ${namn} har planen ${plan.namn} men ${!handelse ? 'inget förled i SAMLINGARNAS_LED i standarden' : 'ingen rad i PLANENS_RUTA i src/pages/statistik.astro'}.`);
  return { led, namn, bestamd, plan: plan && handelse ? { ...plan, handelse, ...PLANENS_RUTA[led] } : undefined };
});
const medPlan = delarna.filter((d) => d.plan);
const utanPlan = delarna.filter((d) => !d.plan);
// Metoderna i Stödundervisning som kan planeras, vars pågående insatser sidan hämtar med namn (Pågående insatser nedan).
const planbara = poster.stodundervisning.filter((m) => planbar(m.data)).map((m) => m.id);
---

<Base title="Statistik" description="Besök, nedladdningar och delningar på niclasfohlin.se." dold>
  <article class="statistik" id="statistik" data-bas={bas} data-namnen={JSON.stringify(namnen)} data-delarna={JSON.stringify(delarna)} data-planbara={JSON.stringify(planbara)}>
    <h1>Statistik</h1>
    <p class="ingress">Besökare, nedladdningar och delningar ur GoatCounter, ordnade som sajten: {uppraknat([...medPlan.map((d) => d.bestamd), 'filerna', 'delningarna', ...utanPlan.map((d) => d.bestamd)])}. Nedladdningarna räknar också utskrifterna, och en delning räknas när någon trycker på en knapp i raden Dela, också om hen sedan avbryter.</p>

    <noscript><p>Sidan hämtar siffrorna med JavaScript.</p></noscript>

    <form class="stat-nyckel" data-nyckel hidden>
      <label for="stat-nyckel">Nyckel till GoatCounter</label>
      <input id="stat-nyckel" name="nyckel" type="password" autocomplete="off" spellcheck="false" required />
      <button type="submit">Spara och visa</button>
      <p class="meta">Skapa nyckeln i GoatCounter: klicka på din e-postadress uppe till höger, välj API och kryssa bara i Read statistics. Nyckeln sparas bara i den här webbläsaren och skickas bara till GoatCounter.</p>
    </form>

    <div data-vy hidden>
      {/* Pågående insatser (K-504, Niclas 2026-10-25) står ovanför perioderna: talet gäller den här veckan, vilken period
          som än är vald. */}
      {planbara.length > 0 && (
        <section class="stat-kategori" data-pagar>
          <h2>Pågående insatser</h2>
          <p class="meta stat-forklaring">Sparade planer i Planera insatsen som är inne i sina veckor och har öppnats den här veckan. Talet är detsamma i alla perioder och räknas sedan 25 oktober 2026.</p>
          <div data-pagar-innehall><p class="meta">Hämtar …</p></div>
        </section>
      )}
      <div class="stat-perioder" role="group" aria-label="Period">
        <button type="button" data-period="dag" aria-pressed="true">I dag</button>
        <button type="button" data-period="vecka" aria-pressed="false">7 dagar</button>
        <button type="button" data-period="manad" aria-pressed="false">30 dagar</button>
        <button type="button" data-period="ar" aria-pressed="false">1 år</button>
      </div>
      <div class="stat-summa" data-summa aria-live="polite"></div>

      <section class="stat-kategori">
        <h2>Över tid</h2>
        <div class="stat-diagram" data-diagram role="img"></div>
        <div class="stat-axel" data-axel aria-hidden="true"></div>
        <p class="meta stat-diagram-text" data-diagram-text></p>
        <dl class="stat-popular" data-popular hidden></dl>
      </section>

      {/* Samlingarna med en plan, med planens ruta efter sig, och de andra efter delningarna (delarna ovan). */}
      {medPlan.map((d) => (
        <>
          <section class="stat-kategori" data-kategori={d.led} data-topp="3">
            <h2>{d.namn}</h2>
          </section>
          <section class="stat-kategori" data-kategori={d.plan!.handelse} data-topp="5">
            <h2>{d.plan!.namn}</h2>
            <p class="meta stat-forklaring" data-fast>{d.plan!.forklaring}</p>
          </section>
        </>
      ))}
      <section class="stat-kategori" data-kategori="filer" data-topp="5">
        <h2>Filerna</h2>
      </section>
      <section class="stat-kategori" data-kategori="delningar" data-topp="5">
        <h2>Mest delade</h2>
      </section>
      <section class="stat-kategori" data-kategori="kanaler" data-topp="6">
        <h2>Delat via</h2>
      </section>
      {utanPlan.map((d) => (
        <section class="stat-kategori" data-kategori={d.led} data-topp="3">
          <h2>{d.namn}</h2>
        </section>
      ))}
      <section class="stat-kategori" data-kategori="utskrifter" data-topp="3">
        <h2>Utskrifterna</h2>
      </section>
      <section class="stat-kategori" data-kategori="verktyg" data-topp="5">
        <h2>Knapparna i verktygen</h2>
      </section>
      <section class="stat-kategori" data-kategori="filter" data-topp="5">
        <h2>Valen i metodbanken</h2>
      </section>
      <section class="stat-kategori" data-kategori="ovriga" data-topp="5">
        <h2>Övriga sidor</h2>
      </section>
      <section class="stat-kategori" data-kategori="kallor" data-topp="5">
        <h2>Varifrån besökarna kommer</h2>
      </section>
      <section class="stat-kategori" data-kategori="enheter" data-topp="3">
        <h2>Mobil eller dator</h2>
      </section>

      <p class="meta stat-fot"><a href={bas}>Hela statistiken i GoatCounter</a>{' · '}<button type="button" class="stat-lank" data-glom>Byt nyckel</button></p>
    </div>

    <p class="meta" data-status role="status" aria-live="polite"></p>
  </article>

  <script>
    import { CENTRALA } from '../lib/centrala';
    type Hit = { path: string; path_id: number; title: string; event: boolean; count: number };
    // syns: raden står med fast antalet är 0, som en metod vars verktyg eller undersidor har besök men inte metodsidan.
    type Rad = { namn: string; under?: string; antal: number; syns?: boolean };

    const rot = document.getElementById('statistik') as HTMLElement;
    const bas = rot.dataset.bas ?? '';
    // Samlingarna med sidor i rotens ordning, med planens ruta, och postens namn per samling (src/lib/samlingar.ts).
    type Del = { led: string; namn: string; plan?: { sida: string; namn: string; handelse: string; ord: Record<string, [string, string]>; alltid?: string; ovriga?: string; utan?: string[] } };
    const DELARNA: Del[] = JSON.parse(rot.dataset.delarna ?? '[]');
    const NAMNEN: Record<string, Record<string, string>> = JSON.parse(rot.dataset.namnen ?? '{}');
    // Metoderna i Stödundervisning, vars pågående insatser sidan räknar.
    const METODNAMN = NAMNEN.stodundervisning ?? {};
    const PLANBARA: string[] = JSON.parse(rot.dataset.planbara ?? '[]');
    const form = rot.querySelector('[data-nyckel]') as HTMLFormElement;
    const vy = rot.querySelector('[data-vy]') as HTMLElement;
    const status = rot.querySelector('[data-status]') as HTMLElement;
    const summa = rot.querySelector('[data-summa]') as HTMLElement;
    const NYCKEL = 'goatcounter-nyckel';
    const PERIOD = 'statistik-period';

    // Nyckeln och den senaste perioden i webbläsarens lagring; går den inte att läsa frågar sidan efter nyckeln igen.
    const las = (k: string) => { try { return localStorage.getItem(k) ?? ''; } catch { return ''; } };
    const skriv = (k: string, v: string) => { try { if (v) localStorage.setItem(k, v); else localStorage.removeItem(k); } catch { /* bara den här sidvisningen */ } };
    let nyckel = las(NYCKEL);

    // GoatCounter vill ha hela timmar: från periodens början till nästa hela timme. En period börjar tidigast när
    // räkningen började, 28 september 2026: GoatCounter fyller annars i varje timme för varje sida för hela perioden,
    // och ett år var 16,7 MB per 100 sidor mot 120 kB från 28 september (uppmätt 2026-09-29, K-095).
    const RAKNINGEN_BORJADE = new Date(2026, 8, 28);
    const iso = (d: Date) => d.toISOString().replace(/\.\d{3}Z$/, 'Z');
    function periodStart(period: string) {
      const nu = new Date();
      const dagar = period === 'vecka' ? 7 : period === 'manad' ? 30 : 365;
      const start = period === 'dag' ? new Date(nu.getFullYear(), nu.getMonth(), nu.getDate()) : new Date(nu.getTime() - dagar * 86400000);
      start.setMinutes(0, 0, 0);
      return start;
    }
    const borjarForeRakningen = (period: string) => periodStart(period) < RAKNINGEN_BORJADE;
    function tider(period: string) {
      const slut = new Date();
      slut.setMinutes(0, 0, 0);
      slut.setHours(slut.getHours() + 1);
      const start = borjarForeRakningen(period) ? new Date(RAKNINGEN_BORJADE) : periodStart(period);
      return { start: iso(start), end: iso(slut) };
    }

    class NyckelFel extends Error {}
    // GoatCounter tar emot 4 anrop per sekund, och före varje anrop med nyckeln gör webbläsaren en förfrågan
    // (preflight) som också räknas. Stoppas förfrågan svarar GoatCounter 429, och då säger webbläsaren bara
    // Failed to fetch (7 dagar, 30 dagar och år 2026-09-29, K-094). Anropen går därför ett i taget med
    // MELLANRUM mellan sig, så att högst två anrop och deras förfrågningar hamnar i samma sekund, ett anrop som
    // stoppas görs om efter en dryg sekund, och svaren sparas i fem minuter, så att bytet mellan perioderna inte
    // kostar nya anrop.
    const MELLANRUM = 650;
    const sov = (ms: number) => new Promise((klar) => setTimeout(klar, ms));
    let tur: Promise<void> = Promise.resolve();
    let senast = 0;
    const sparade = new Map<string, { tid: number; json: unknown }>();
    // Ett anrop för en period som läsaren redan lämnat görs inte och tar ingen plats i kön (korning i visa), så att
    // den period som läsaren valde sist kommer fram fort.
    class Avbruten extends Error {}
    // GoatCounter tar emot högst 500 anrop i timmen från samma internetanslutning, förfrågningarna inräknade
    // (handlers.go i GoatCounters källkod). När gränsen är nådd svarar den inte förrän timmen gått, och då säger
    // sidan det i stället för webbläsarens Failed to fetch.
    class Grans extends Error {}
    function iTur(aktuell: () => boolean) {
      const min = tur.then(async () => {
        if (!aktuell()) return false;
        const vanta = senast + MELLANRUM - Date.now();
        if (vanta > 0) await sov(vanta);
        if (!aktuell()) return false;
        senast = Date.now();
        return true;
      });
      tur = min.then(() => undefined);
      return min;
    }
    // Svaret har olika form per anrop (hits, total, toprefs, sizes) och läses fält för fält där det används.
    async function hamta(vag: string, parametrar: Record<string, string | number | (string | number)[]>, aktuell = () => true): Promise<any> {
      const url = new URL(bas + vag);
      for (const [k, v] of Object.entries(parametrar)) for (const x of Array.isArray(v) ? v : [v]) url.searchParams.append(k, String(x));
      const sparat = sparade.get(url.href);
      if (sparat && Date.now() - sparat.tid < 5 * 60 * 1000) return sparat.json;
      for (let forsok = 1; ; forsok++) {
        if (!(await iTur(aktuell))) throw new Avbruten();
        let svar: Response;
        try {
          svar = await fetch(url, { headers: { Authorization: `Bearer ${nyckel}` } });
        } catch {
          // Förfrågan stoppades av gränsen, eller nätet svarade inte: försök igen, högst tre gånger i allt, så att
          // sidan inte själv äter upp timmens anrop.
          if (forsok < 3) { await sov(1100); continue; }
          throw new Grans();
        }
        if (svar.status === 429) {
          if (forsok < 3) { await sov(1100); continue; }
          throw new Grans();
        }
        if (svar.status === 401 || svar.status === 403) throw new NyckelFel();
        if (!svar.ok) {
          // GoatCounters egen förklaring följer med i beskedet, så att felet syns utan att någon behöver gissa.
          let orsak = '';
          try {
            const text = await svar.text();
            const fel = JSON.parse(text);
            orsak = String(fel.error ?? JSON.stringify(fel.errors ?? fel)).slice(0, 160);
          } catch { /* inget läsbart svar */ }
          throw new Error(`GoatCounter svarade ${svar.status}${orsak ? `: ${orsak}` : ''}`);
        }
        const json = await svar.json();
        sparade.set(url.href, { tid: Date.now(), json });
        return json;
      }
    }
    // Sidorna och händelserna i perioden, 100 i taget (GoatCounters största limit, api.json), tills GoatCounter säger att
    // inget mer finns, högst 20 omgångar (2 000). De som redan hämtats skickas som en kommaseparerad exclude_paths:
    // GoatCounter läser bara det första värdet om parametern upprepas, och då kom samma 100 tillbaka fem gånger och
    // räknades dubbelt (K-095). En sida som redan finns räknas aldrig igen, och hämtningen slutar när en omgång inte ger
    // något nytt. Nedladdningarna och delningarna räknas ur listan, så en lista som inte är hel säger sidan (hela), i
    // stället för att visa för låga tal som hela (Codex-granskningen 2026-10-19: högst 500 tappade det som kom efter).
    async function allaHits(t: { start: string; end: string }, aktuell: () => boolean) {
      const ut: Hit[] = [];
      const sedda = new Set<number>();
      let hela = false;
      for (let i = 0; i < 20; i++) {
        const svar = await hamta('/api/v0/stats/hits', { ...t, limit: 100, ...(sedda.size ? { exclude_paths: [...sedda].join(',') } : {}) }, aktuell);
        const nya = ((svar.hits ?? []) as Hit[]).filter((h) => !sedda.has(h.path_id));
        for (const h of nya) {
          sedda.add(h.path_id);
          ut.push(h);
        }
        if (!svar.more || nya.length === 0) { hela = true; break; }
      }
      return { hits: ut, hela };
    }

    // Sidans titel utan sajtens namn; händelsernas titlar är redan "Upprepad läsning: lathunden som pdf".
    const utanSajt = (t: string) => (t || '').replace(/\s*·\s*Niclas Fohlin\s*$/, '').trim();
    // Delningsraden (Delning.astro) räknar dela:<kanal>:<sida> med titeln "<sidans titel>: delad på Facebook".
    const KANAL: Record<string, string> = { facebook: 'Facebook', linkedin: 'LinkedIn', instagram: 'Instagram', mejl: 'Mejl', kopiera: 'Kopiera länk', fler: 'Fler appar' };
    const DELAD = /: (delad på .+|skickad med mejl|länken kopierad|delad i en annan app)$/;
    // De centrala sidorna som hör till en metod (src/data/centrala.json), som Ta fram ett skrivkort och Ta fram en
    // aktivitet: besöken räknas under metoden, med sidans namn.
    const CENTRALA_SIDOR = new Map(CENTRALA.filter((c) => c.slag === 'sida' && c.metod).map((c) => [c.adress, c]));
    // Planens händelser per förled, som planera:<metod>:<vad> och lardig:<metod>:<vad>.
    const PLANENS_DEL = new Map(DELARNA.filter((d) => d.plan).map((d) => [d.plan!.handelse, d]));
    function kategorier(hits: Hit[]) {
      // Varje samlings poster: besöken på postens sida, och under namnet lathunden, de centrala sidorna och undersidorna.
      type Post = { namn: string; sida: number; lathund: number; enheter: number; centrala: Map<string, number> };
      const posterna = new Map<string, Map<string, Post>>(DELARNA.map((d) => [d.led, new Map()]));
      const filer = new Map<string, Rad>();
      const delningar = new Map<string, { namn: string; antal: number; kanaler: Map<string, number> }>();
      // Planens ruta per samling med plan (K-504, K-628): besökarna på planens sida, och planens händelser med orden i
      // PLANENS_RUTA, där '' är trycken på länkarna i planen. Planera insatsens pagar räknas bara under Pågående insatser.
      const planerna = new Map<string, Map<string, { oppnade: number; handelser: Map<string, number> }>>(DELARNA.filter((d) => d.plan).map((d) => [d.led, new Map()]));
      const plan = (led: string, id: string) => {
        const p = planerna.get(led)!;
        let x = p.get(id);
        if (!x) { x = { oppnade: 0, handelser: new Map() }; p.set(id, x); }
        return x;
      };
      let delade = 0;
      const k: Record<string, Rad[]> = { utskrifter: [], verktyg: [], filter: [], ovriga: [] };
      // Nedladdningarna: filerna och utskrifterna, inte knapparna i verktygen (granskningen av statistiken 2026-10-19).
      let nedladdade = 0;
      const post = (led: string, id: string) => {
        const p = posterna.get(led)!;
        let x = p.get(id);
        if (!x) { x = { namn: NAMNEN[led]?.[id] ?? id, sida: 0, lathund: 0, enheter: 0, centrala: new Map() }; p.set(id, x); }
        return x;
      };
      for (const h of hits) {
        const titel = utanSajt(h.title);
        if (h.event) {
          const d = h.path.match(/^dela:([^:]+):(.+)$/);
          if (d) {
            // En sida rankas efter alla sina delningar; kanalerna står under namnet.
            const x = delningar.get(d[2]) ?? { namn: d[2], antal: 0, kanaler: new Map<string, number>() };
            x.antal += h.count;
            x.kanaler.set(d[1], (x.kanaler.get(d[1]) ?? 0) + h.count);
            if (DELAD.test(titel)) x.namn = titel.replace(DELAD, '');
            delningar.set(d[2], x);
            delade += h.count;
            continue;
          }
          const pl = h.path.match(/^([^:]+):([^:]+):([^:]+)(?::\d+)?$/);
          const planensDel = pl ? PLANENS_DEL.get(pl[1]) : undefined;
          if (pl && planensDel?.plan) {
            const { ord, ovriga, utan = [] } = planensDel.plan;
            const vad = pl[3] in ord ? pl[3] : ovriga ? '' : undefined;
            if (utan.includes(pl[3])) continue;
            if (vad !== undefined) {
              const x = plan(planensDel.led, pl[2]);
              x.handelser.set(vad, (x.handelser.get(vad) ?? 0) + h.count);
              continue;
            }
          }
          if (/^utskrift/.test(h.path)) { k.utskrifter.push({ namn: titel || h.path, antal: h.count }); nedladdade += h.count; continue; }
          // Filerna hette först bara filnamnet (upprepad-lasning-lathund.pdf, drive-…); de slås ihop med fil:-namnen.
          const nyckelFil = h.path.replace(/^fil:/, '').replace(/^drive-/, 'drive:');
          if (/^fil:/.test(h.path) || /\.(pdf|docx|pptx)$/i.test(h.path)) {
            const rad = filer.get(nyckelFil) ?? { namn: '', under: nyckelFil.replace(/^drive:/, 'Drive · '), antal: 0 };
            rad.antal += h.count;
            if (titel.includes(':') || !rad.namn) rad.namn = titel || nyckelFil;
            filer.set(nyckelFil, rad);
            nedladdade += h.count;
            continue;
          }
          // Valen i metodbankens formulär (K-463): vad lärarna väljer, Tränar Läsflyt eller Upplägg Intensivträning.
          if (/^filter:/.test(h.path)) { k.filter.push({ namn: (titel || h.path).replace(/^Metodbanken:\s*/, ''), under: h.path, antal: h.count }); continue; }
          // Det som är kvar är knapparna i verktygen och metodbankens ruta: Visa stort, lösningsförslaget, modellen,
          // helskärmen, klockan, musiken, listans länk, Till metoden och rutan Verktyg och Stödmaterial.
          k.verktyg.push({ namn: titel || h.path, under: h.path, antal: h.count });
          continue;
        }
        // En sida i en samling med sidor: postens sida /<led>/<id>, lathunden, planens sida och undersidorna.
        const s = h.path.match(/^\/([^/]+)\/([^/]+)(?:\/(.+))?$/);
        const del = s ? DELARNA.find((d) => d.led === s[1]) : undefined;
        if (s && del && !s[3]) { const x = post(del.led, s[2]); x.sida += h.count; if (titel) x.namn = titel; continue; }
        if (s && del && s[3] === 'lathund') { const x = post(del.led, s[2]); x.lathund += h.count; if (x.namn === s[2] && titel) x.namn = titel.replace(/^Lathund:\s*/, ''); continue; }
        if (s && del?.plan && s[3] === del.plan.sida) { plan(del.led, s[2]).oppnade += h.count; continue; }
        // De centrala sidorna hör till metoder i Stödundervisning (src/data/centrala.json).
        const central = CENTRALA_SIDOR.get(h.path);
        if (central) { const x = post('stodundervisning', central.metod!); x.centrala.set(central.namn, (x.centrala.get(central.namn) ?? 0) + h.count); continue; }
        // Ett problems eller en texts egen sida i en bank (src/lib/bank.ts), "Äpplena · Bas, problem 1 · Problemlösning i
        // grupp", och sidorna under ett verktyg, som temats sida och lärarhandledningen (/<id>/texter/vatten): räknas
        // under metoden, som lathunden.
        if (s && del && !s[2].includes('.')) { const x = post(del.led, s[2]); x.enheter += h.count; if (x.namn === s[2] && titel) x.namn = titel.split(' · ').at(-1) ?? x.namn; continue; }
        k.ovriga.push({ namn: titel || h.path, under: h.path, antal: h.count });
      }
      // En post rankas efter besöken på postens sida; lathundens och undersidornas besök står under namnet.
      const postRader = Object.fromEntries([...posterna].map(([led, p]): [string, Rad[]] => [led, [...p.values()].map((x) => {
        const fler = [x.lathund && `${x.lathund} på lathunden`, ...[...x.centrala].map(([namn, n]) => `${n} på ${namn}`), x.enheter && `${x.enheter} på undersidorna`].filter(Boolean);
        return { namn: x.namn, under: fler.length ? `och ${fler.join(', ')}` : undefined, antal: x.sida, syns: fler.length > 0 };
      })]));
      const delRader: Rad[] = [...delningar.values()].map((x) => ({
        namn: x.namn,
        under: [...x.kanaler].sort((a, b) => b[1] - a[1]).map(([kanal, n]) => `${KANAL[kanal] ?? kanal} ${n}`).join(' · '),
        antal: x.antal,
      }));
      // Kanalerna över alla sidor: vilken knapp i delningsraden som används mest.
      const perKanal = new Map<string, number>();
      for (const x of delningar.values()) for (const [kanal, n] of x.kanaler) perKanal.set(kanal, (perKanal.get(kanal) ?? 0) + n);
      const kanalRader: Rad[] = [...perKanal].map(([kanal, n]) => ({ namn: KANAL[kanal] ?? kanal, antal: n }));
      // En metod rankas efter besökarna på planens sida. De sparade står alltid under namnet, också när de är noll, så
      // att en plan som många öppnar men ingen sparar syns (Sonnets förslag 2026-10-25), och de andra händelserna när de finns.
      const planRader = Object.fromEntries(DELARNA.filter((d) => d.plan).map((d): [string, Rad[]] => {
        const { handelse, ord, alltid, ovriga } = d.plan!;
        return [handelse, [...planerna.get(d.led)!].map(([id, x]) => {
          const tal = (vad: string) => x.handelser.get(vad) ?? 0;
          const under = [...Object.entries(ord).filter(([vad]) => vad === alltid || tal(vad) > 0).map(([vad, [en, flera]]) => `${tal(vad)} ${tal(vad) === 1 ? en : flera}`), ...(ovriga && tal('') ? [`${tal('')} ${ovriga}`] : [])];
          return { namn: NAMNEN[d.led]?.[id] ?? id, under: under.join(' · '), antal: x.oppnade, syns: [...x.handelser.values()].some((n) => n > 0) };
        })];
      }));
      return { rader: { ...postRader, ...planRader, filer: [...filer.values()], delningar: delRader, kanaler: kanalRader, ...k }, delade, nedladdade };
    }

    function lista(rader: Rad[], klass: string) {
      const ol = document.createElement('ol');
      ol.className = `stat-lista ${klass}`;
      const storst = Math.max(1, ...rader.map((r) => r.antal));
      for (const r of rader) {
        const li = document.createElement('li');
        const namn = document.createElement('span');
        namn.className = 'stat-namn';
        namn.textContent = r.namn;
        const antal = document.createElement('span');
        antal.className = 'stat-antal';
        antal.textContent = String(r.antal);
        li.append(namn, antal);
        if (r.under) {
          const under = document.createElement('span');
          under.className = 'stat-under';
          under.textContent = r.under;
          li.append(under);
        }
        const stapel = document.createElement('span');
        stapel.className = 'stat-stapel';
        stapel.setAttribute('aria-hidden', 'true');
        stapel.style.setProperty('--andel', String(r.antal / storst));
        li.append(stapel);
        ol.append(li);
      }
      return ol;
    }

    function visaKategori(namn: string, rader: Rad[]) {
      const sektion = rot.querySelector(`[data-kategori="${namn}"]`) as HTMLElement;
      const topp = Number(sektion.dataset.topp) || 3;
      for (const el of [...sektion.children]) if (el.tagName !== 'H2' && !el.hasAttribute('data-fast')) el.remove();
      const sorterade = rader.filter((r) => r.antal > 0 || r.syns).sort((a, b) => b.antal - a.antal || a.namn.localeCompare(b.namn, 'sv'));
      if (!sorterade.length) {
        const p = document.createElement('p');
        p.className = 'meta';
        p.textContent = 'Inget i perioden.';
        sektion.append(p);
        return;
      }
      sektion.append(lista(sorterade.slice(0, topp), 'stat-topp'));
      if (sorterade.length > topp) {
        const detaljer = document.createElement('details');
        const rubrik = document.createElement('summary');
        rubrik.textContent = `Visa alla ${sorterade.length}`;
        detaljer.append(rubrik, lista(sorterade, ''));
        sektion.append(detaljer);
      }
    }

    // Över tid, ur /stats/total: timmar i dag, dagar för 7 och 30 dagar och månader för året. GoatCounters besök,
    // nedladdningarna och trycken på Dela inräknade, i sajtens tidszon i GoatCounter.
    type Dag = { day: string; hourly?: number[]; daily?: number };
    const VECKODAG = ['sön', 'mån', 'tis', 'ons', 'tors', 'fre', 'lör'];
    const MANAD = ['jan', 'feb', 'mar', 'apr', 'maj', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
    const tva = (n: number) => String(n).padStart(2, '0');
    const lokalDag = (d: Date) => `${d.getFullYear()}-${tva(d.getMonth() + 1)}-${tva(d.getDate())}`;
    function visaDiagram(period: string, dagar: Dag[]) {
      const diagram = rot.querySelector('[data-diagram]') as HTMLElement;
      const axel = rot.querySelector('[data-axel]') as HTMLElement;
      const text = rot.querySelector('[data-diagram-text]') as HTMLElement;
      let staplar: { etikett: string; antal: number; namn: string }[] = [];
      let enhet = 'dag';
      if (period === 'dag') {
        enhet = 'timme';
        const idag = dagar.find((d) => d.day === lokalDag(new Date())) ?? dagar[dagar.length - 1];
        const timmar = (idag?.hourly ?? []).slice(0, new Date().getHours() + 1);
        staplar = timmar.map((n, i) => ({ etikett: i % 6 === 0 ? tva(i) : '', antal: n, namn: `klockan ${tva(i)}` }));
      } else if (period === 'ar') {
        enhet = 'månad';
        const per = new Map<string, number>();
        for (const d of dagar) per.set(d.day.slice(0, 7), (per.get(d.day.slice(0, 7)) ?? 0) + (d.daily ?? 0));
        staplar = [...per].map(([k, n]) => {
          const m = Number(k.slice(5, 7)) - 1;
          return { etikett: MANAD[m], antal: n, namn: `${MANAD[m]} ${k.slice(0, 4)}` };
        });
      } else {
        staplar = dagar.map((d, i) => {
          const datum = new Date(`${d.day}T12:00:00`);
          const etikett = period === 'vecka' ? VECKODAG[datum.getDay()] : i % 5 === 0 ? String(datum.getDate()) : '';
          return { etikett, antal: d.daily ?? 0, namn: `${VECKODAG[datum.getDay()]} ${datum.getDate()} ${MANAD[datum.getMonth()]}` };
        });
      }
      diagram.replaceChildren();
      axel.replaceChildren();
      const storst = Math.max(1, ...staplar.map((s) => s.antal));
      for (const s of staplar) {
        const stapel = document.createElement('span');
        stapel.style.setProperty('--hojd', String(s.antal / storst));
        stapel.title = `${s.namn}: ${s.antal}`;
        diagram.append(stapel);
        const etikett = document.createElement('span');
        etikett.textContent = s.etikett;
        axel.append(etikett);
      }
      const flest = staplar.reduce<(typeof staplar)[number] | undefined>((a, s) => (!a || s.antal > a.antal ? s : a), undefined);
      const beskrivning = flest && flest.antal > 0 ? `Flest per ${enhet}: ${flest.antal}, ${flest.namn}.` : 'Inga besök i perioden.';
      diagram.setAttribute('aria-label', `Besök, nedladdningar och delningar per ${enhet}. ${beskrivning}`);
      text.textContent = beskrivning;
    }

    // Populäraste dagen och tiden, som i WordPress: veckodagen och timmen med flest besök i perioden och deras andel.
    // Veckodagen visas inte för i dag.
    const VECKODAG_LANG = ['söndag', 'måndag', 'tisdag', 'onsdag', 'torsdag', 'fredag', 'lördag'];
    function visaPopular(period: string, dagar: Dag[]) {
      const ruta = rot.querySelector('[data-popular]') as HTMLElement;
      const perDag = new Array<number>(7).fill(0);
      const perTimme = new Array<number>(24).fill(0);
      for (const d of dagar) {
        perDag[new Date(`${d.day}T12:00:00`).getDay()] += d.daily ?? 0;
        (d.hourly ?? []).forEach((n, h) => { if (h < 24) perTimme[h] += n; });
      }
      const summa = (a: number[]) => a.reduce((x, y) => x + y, 0);
      const storsta = (a: number[]) => a.indexOf(Math.max(...a));
      const rad = (rubrik: string, varde: string, andel: number, av: number) => {
        const div = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = rubrik;
        const dd = document.createElement('dd');
        const del = document.createElement('span');
        del.textContent = `${Math.round((100 * andel) / av)} % av besöken`;
        dd.append(varde, del);
        div.append(dt, dd);
        return div;
      };
      ruta.replaceChildren();
      if (period !== 'dag' && summa(perDag) > 0) {
        const vd = storsta(perDag);
        ruta.append(rad('Populäraste dagen', VECKODAG_LANG[vd], perDag[vd], summa(perDag)));
      }
      if (summa(perTimme) > 0) {
        const h = storsta(perTimme);
        ruta.append(rad('Populäraste tiden', `kl. ${tva(h)}–${tva((h + 1) % 24)}`, perTimme[h], summa(perTimme)));
      }
      ruta.hidden = !ruta.children.length;
    }

    // Mobil eller dator, ur GoatCounters skärmstorlekar (/stats/sizes) i tre grupper.
    type Stat = { id?: string; name?: string; count: number };
    const ENHET: Record<string, string> = { phone: 'Mobil', largephone: 'Mobil', tablet: 'Surfplatta', desktop: 'Dator', desktophd: 'Dator', unknown: 'Okänt' };
    function enheter(stats: Stat[]): Rad[] {
      const per = new Map<string, number>();
      for (const s of stats) {
        const n = s.name ?? '';
        const namn = ENHET[(s.id ?? '').toLowerCase()] ?? (/phone/i.test(n) ? 'Mobil' : /tablet/i.test(n) ? 'Surfplatta' : /computer|monitor|desktop/i.test(n) ? 'Dator' : 'Okänt');
        per.set(namn, (per.get(namn) ?? 0) + s.count);
      }
      return [...per].map(([namn, antal]) => ({ namn, antal }));
    }

    // Byter läsaren period medan siffrorna hämtas visas bara den senast valda (korning).
    let korning = 0;
    async function visa(period: string) {
      const denna = ++korning;
      const aktuell = () => denna === korning;
      for (const b of rot.querySelectorAll<HTMLButtonElement>('[data-period]')) b.setAttribute('aria-pressed', String(b.dataset.period === period));
      skriv(PERIOD, period);
      status.textContent = 'Hämtar …';
      try {
        const t = tider(period);
        const [{ hits, hela }, total] = await Promise.all([allaHits(t, aktuell), hamta('/api/v0/stats/total', t, aktuell)]);
        if (denna !== korning) return;
        const { rader: k, delade, nedladdade } = kategorier(hits);
        const handelser = total.total_events ?? 0;
        // Överst tre rutor, som i WordPress: talet stort och ordet under (Niclas 2026-09-29).
        const ruta = (tal: number, ord: string) => {
          const div = document.createElement('div');
          div.className = 'stat-tal';
          const siffra = document.createElement('strong');
          siffra.textContent = tal.toLocaleString('sv-SE');
          const text = document.createElement('span');
          text.textContent = ord;
          div.append(siffra, text);
          return div;
        };
        summa.replaceChildren(
          ruta((total.total ?? 0) - handelser, 'besökare'),
          ruta(nedladdade, 'nedladdningar'),
          ruta(delade, 'delningar'),
        );
        for (const [namn, rader] of Object.entries(k)) visaKategori(namn, rader);
        visaDiagram(period, total.stats ?? []);
        visaPopular(period, total.stats ?? []);
        if (borjarForeRakningen(period)) {
          const diagramText = rot.querySelector('[data-diagram-text]') as HTMLElement;
          diagramText.textContent = `${diagramText.textContent} GoatCounter räknar sedan 28 september 2026, så perioden börjar där.`;
        }
        // Varifrån besökarna kommer och vilken skärm de har: GoatCounters listor. Svarar en inte döljs dess ruta.
        const extra = async (namn: string, vag: string, gor: (stats: Stat[]) => Rad[]) => {
          const sektion = rot.querySelector(`[data-kategori="${namn}"]`) as HTMLElement;
          try {
            const svar = await hamta(vag, { ...t, limit: 20 }, aktuell);
            if (denna !== korning) return;
            sektion.hidden = false;
            visaKategori(namn, gor(svar.stats ?? []));
          } catch (e) {
            if (e instanceof NyckelFel) throw e;
            if (denna !== korning) return;
            sektion.hidden = true;
          }
        };
        await Promise.all([
          extra('kallor', '/api/v0/stats/toprefs', (s) => s.map((x) => ({ namn: x.name || 'Direkt, utan hänvisning', antal: x.count }))),
          extra('enheter', '/api/v0/stats/sizes', enheter),
        ]);
        if (denna !== korning) return;
        const nu = new Date();
        status.textContent = `Hämtat ${nu.toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' })}.${hela ? '' : ' Perioden har fler än 2 000 sidor och händelser, och bara de 2 000 första är med, så nedladdningarna, delningarna och listorna är för låga.'}`;
      } catch (e) {
        if (denna !== korning) return;
        if (e instanceof NyckelFel) { visaForm('Nyckeln fungerar inte. Skapa en ny med rätten Read statistics och klistra in den.'); return; }
        if (e instanceof Grans) {
          status.textContent = navigator.onLine === false
            ? 'Telefonen eller datorn är inte uppkopplad. Försök igen när nätet fungerar.'
            : 'GoatCounter tar inte emot fler anrop från den här internetanslutningen just nu. Gränsen är 500 i timmen, så försök igen om en stund.';
          return;
        }
        status.textContent = `Det gick inte att hämta siffrorna: ${(e as Error).message}. Ladda om sidan och försök igen.`;
      }
    }

    // Pågående insatser (K-504): planerna som är inne i sina veckor säger det till GoatCounter en gång i veckan, måndag
    // till söndag, med händelsen planera:<metod>:pagar, och :2 och :3 för fler planer för samma metod i samma webbläsare
    // (src/scripts/insatser-lagring.ts). Sidan hämtar bara de namnen, i ett anrop från förra veckans måndag
    // (include_paths med path_by_name, api.json), och summerar dagarna i den här veckan och i förra. Talet gäller den här
    // veckan vilken period som än är vald, och förra veckan står under namnet, så att raden inte är tom på måndag morgon.
    const PAGAR_HOGST = 3;
    const pagarRuta = rot.querySelector('[data-pagar]') as HTMLElement | null;
    const mandagen = (d: Date) => { const m = new Date(d.getFullYear(), d.getMonth(), d.getDate()); m.setDate(m.getDate() - ((m.getDay() + 6) % 7)); return m; };
    async function visaPagaende() {
      const innehall = pagarRuta?.querySelector('[data-pagar-innehall]') as HTMLElement | null;
      if (!pagarRuta || !innehall) return;
      const denna = mandagen(new Date());
      const forra = new Date(denna);
      forra.setDate(forra.getDate() - 7);
      const slut = new Date();
      slut.setMinutes(0, 0, 0);
      slut.setHours(slut.getHours() + 1);
      const namn = PLANBARA.flatMap((id) => Array.from({ length: PAGAR_HOGST }, (_, i) => `planera:${id}:pagar${i ? `:${i + 1}` : ''}`));
      try {
        const svar = await hamta('/api/v0/stats/hits', { start: iso(forra), end: iso(slut), limit: 100, path_by_name: 'true', include_paths: namn.join(',') });
        const fran = lokalDag(forra), nu = lokalDag(denna);
        const per = new Map<string, { nu: number; forra: number }>();
        for (const h of (svar.hits ?? []) as (Hit & { stats?: Dag[] })[]) {
          const m = h.path.match(/^planera:([^:]+):pagar(?::\d+)?$/);
          if (!m) continue;
          const x = per.get(m[1]) ?? { nu: 0, forra: 0 };
          for (const d of h.stats ?? []) { if (d.day >= nu) x.nu += d.daily ?? 0; else if (d.day >= fran) x.forra += d.daily ?? 0; }
          per.set(m[1], x);
        }
        const rader: Rad[] = [...per].map(([id, x]) => ({ namn: METODNAMN[id] ?? id, antal: x.nu, under: x.forra ? `${x.forra} förra veckan` : undefined, syns: x.forra > 0 }));
        const summa = (f: 'nu' | 'forra') => [...per.values()].reduce((a, x) => a + x[f], 0);
        const metoder = [...per.values()].filter((x) => x.nu > 0).length;
        innehall.replaceChildren();
        if (!summa('nu') && !summa('forra')) {
          const p = document.createElement('p');
          p.className = 'meta';
          p.textContent = 'Ingen pågående insats har öppnats den här veckan eller förra veckan.';
          innehall.append(p);
          return;
        }
        // Det stora talet i samma form som Populäraste dagen.
        const dl = document.createElement('dl');
        dl.className = 'stat-popular stat-pagar';
        const div = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = 'Den här veckan';
        const dd = document.createElement('dd');
        const del = document.createElement('span');
        const n = summa('nu'), f = summa('forra');
        del.textContent = [n ? `i ${metoder} ${metoder === 1 ? 'metod' : 'metoder'}` : '', f ? `${f} förra veckan` : ''].filter(Boolean).join(', ');
        dd.append(`${n} ${n === 1 ? 'insats' : 'insatser'}`, del);
        div.append(dt, dd);
        dl.append(div);
        innehall.append(dl);
        const sorterade = rader.filter((r) => r.antal > 0 || r.syns).sort((a, b) => b.antal - a.antal || a.namn.localeCompare(b.namn, 'sv'));
        innehall.append(lista(sorterade.slice(0, 3), 'stat-topp'));
        if (sorterade.length > 3) {
          const detaljer = document.createElement('details');
          const rubrik = document.createElement('summary');
          rubrik.textContent = `Visa alla ${sorterade.length}`;
          detaljer.append(rubrik, lista(sorterade, ''));
          innehall.append(detaljer);
        }
      } catch (e) {
        // Ett fel här ska inte läsas som noll. En nyckel som inte fungerar säger resten av sidan till om.
        innehall.replaceChildren();
        const p = document.createElement('p');
        p.className = 'meta';
        p.textContent = e instanceof Grans ? 'Kunde inte hämtas just nu, eftersom GoatCounters gräns för timmen är nådd.' : 'Kunde inte hämtas. Ladda om sidan och försök igen.';
        if (!(e instanceof NyckelFel)) innehall.append(p);
      }
    }

    function visaForm(text = '') {
      vy.hidden = true;
      form.hidden = false;
      status.textContent = text;
      (form.querySelector('input') as HTMLInputElement).focus();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const falt = form.querySelector('input') as HTMLInputElement;
      nyckel = falt.value.trim();
      if (!nyckel) return;
      skriv(NYCKEL, nyckel);
      falt.value = '';
      form.hidden = true;
      vy.hidden = false;
      visa(las(PERIOD) || 'dag');
      void visaPagaende();
    });
    for (const b of rot.querySelectorAll<HTMLButtonElement>('[data-period]')) b.addEventListener('click', () => visa(b.dataset.period ?? 'dag'));
    (rot.querySelector('[data-glom]') as HTMLButtonElement).addEventListener('click', () => { nyckel = ''; skriv(NYCKEL, ''); visaForm(); });

    if (!bas) status.textContent = 'Besöksstatistiken är avstängd (site.statistik är tom).';
    else if (nyckel) { vy.hidden = false; visa(las(PERIOD) || 'dag'); void visaPagaende(); }
    else visaForm();
  </script>
</Base>
