---
// Mallen för delningskortet för en metod under Metoder, /metoder/<id>, 1200 × 630 (Niclas 2026-10-31: "Bygg gärna ert eget
// snyggt delningskort för metoder ... Något lite mer intressant än standard"). Till vänster titeln stort, faktan (Lektion,
// Hur ofta och Årskurs) och Lärande totalt med staplarna och ordet i metodens bläck och kommentaren under. Till höger,
// där kortet för en post annars har porträttet, ett utsnitt av metodkortet på metodens sida (src/components/Metodprofil.astro):
// huvudet, Primär evidens och raderna för områdena, Svårighet och Kostnad, så att kortet visar vad en metod här är. Faktan
// och Lärande totalt står till vänster och inte i utsnittet. Staplarna är metodkortets (src/components/Staplar.astro), gröna
// för forskningen som på sidan. Vad som står på kortet räknas ut i src/lib/delningskort.ts (UNDERVISNINGSMETODSMALL), och
// mallen räknas bara in i de korten. Sidan finns bara för att scripts/delningskort.mjs ska fotografera den; den länkas inte
// och indexeras inte.
import '../../../styles/global.css';
import { site } from '../../../data/site';
import { allaKort, type Kort } from '../../../lib/delningskort';
import { publicerade } from '../../../lib/innehall';
import { kortetUrFil, OMRADEN } from '../../../lib/metodprofil';
import Metodprofil from '../../../components/Metodprofil.astro';
import Staplar from '../../../components/Staplar.astro';

export async function getStaticPaths() {
  return (await allaKort()).filter((kort) => kort.undervisningsmetod).map((kort) => ({ params: { namn: kort.namn }, props: { kort } }));
}

const { kort } = Astro.props as { kort: Kort };
const um = kort.undervisningsmetod!;
const post = (await publicerade('undervisningsmetoder')).find((p) => p.id === um.id);
if (!post) throw new Error(`Delningskortet för ${kort.sida}: metoden ${um.id} är inte publicerad.`);
const m = kortetUrFil(post.id, post.data);
// Faktan till vänster: lektionens längd, hur ofta och årskursen. De första veckorna står i utsnittet av metodkortet på sidan.
const fakta = um.fakta.filter(([rubrik]) => ['Lektion', 'Hur ofta', 'Årskurs'].includes(rubrik));
const l = um.larande;
const n = kort.titel.length;
const storlek = n <= 22 ? 78 : n <= 34 ? 64 : 54;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{kort.titel}</title>
    <style is:global>
      html, body { margin: 0; padding: 0; background: #fff; }
      .dk { position: relative; width: 1200px; height: 630px; overflow: hidden; background: var(--farg-yta); color: var(--farg-text); font-family: var(--typsnitt-rubrik); }
      .dk-streck { position: absolute; left: 0; top: 0; bottom: 0; width: 18px; background: var(--farg-mork); }
      /* Textens spalt går från 107 till 660 punkter, och utsnittet av metodkortet står till höger om den. */
      .dk-text { position: absolute; left: 107px; top: 0; bottom: 0; width: 553px; display: flex; flex-direction: column; padding: 42px 0 36px; }
      .dk-etikett { margin: 0 0 14px; font-size: 22px; line-height: 1.25; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--farg-mork); }
      .dk-titel { margin: 0; font-size: var(--dk-storlek); font-weight: 800; letter-spacing: -0.02em; line-height: 1.02; color: var(--farg-mork); text-wrap: balance; }
      /* Faktan i en rad, som metodkortets celler: etiketten över och värdet i fet vikt. */
      .dk-fakta { display: flex; gap: 0 40px; margin: 20px 0 0; }
      .dk-fakta div { display: flex; flex-direction: column; gap: 2px; }
      .dk-fakta dt { font: 600 20px/1.3 var(--typsnitt-ui); color: var(--farg-text-svag); }
      .dk-fakta dd { margin: 0; font: 700 30px/1.2 var(--typsnitt-ui); color: var(--farg-mork); white-space: nowrap; }
      /* Lärande totalt: namnet, staplarna stora och ordet i metodens bläck, och kommentaren under med staplarnas kant. */
      .dk-larande { margin: 20px 0 0; padding-top: 14px; border-top: 2px solid var(--farg-kant); font-family: var(--typsnitt-ui); }
      .dk-larande-namn { margin: 0 0 6px; font-size: 22px; font-weight: 600; color: var(--farg-text-svag); }
      .dk-larande-rad { display: flex; align-items: center; gap: 18px; margin: 0; }
      .dk-larande .mp-staplar { gap: 6px; }
      .dk-larande .mp-staplar i { height: 36px; border-left-width: 20px; }
      .dk-larande-ord { font-size: 38px; font-weight: 800; line-height: 1.1; color: var(--farg-mork); }
      .dk-larande-ord.mp-negativ { color: var(--farg-socialt); }
      .dk-kommentar { margin: 10px 0 0; padding: 2px 0 2px 14px; border-left: 4px solid var(--farg-stapel); font-size: 21px; line-height: 1.35; color: var(--farg-text-svag); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .dk-fot { margin-top: auto; display: flex; align-items: center; gap: 16px; }
      .dk-fot img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--farg-kant); }
      .dk-namn { font-size: 21px; line-height: 1.2; font-weight: 700; }
      .dk-adress { font-size: 18px; line-height: 1.3; color: var(--farg-text-svag); }

      /* Utsnittet av metodkortet: kortet som på metodens sida, lite större, lutat och avskuret av kortets nederkant. Faktan
         och Lärande totalt står till vänster. */
      .utsnitt { position: absolute; left: 712px; top: 40px; width: 440px; transform: rotate(1.6deg); transform-origin: top left; }
      .utsnitt > .skala-in { width: 366px; transform: scale(1.2); transform-origin: top left; }
      .utsnitt .metodprofil { margin: 0; border: 0; border-radius: 12px; box-shadow: 0 14px 34px rgba(20, 32, 43, 0.22), 0 0 0 1px var(--farg-kant); }
      .utsnitt .metodprofil .kort-fakta, .utsnitt .metodprofil .mp-total { display: none; }
      .utsnitt .metodprofil .mp-primar { border-top: 0; padding-top: 0.2rem; }
      /* Pilarna som fäller ut en rad på sidan går inte att trycka på i en bild. */
      .utsnitt .metodprofil .mp-rad > summary::after { display: none; }
    </style>
  </head>
  <body>
    <div class="dk" style={`--dk-storlek: ${storlek}px`}>
      <div class="dk-streck"></div>
      <div class="dk-text">
        <p class="dk-etikett">{kort.etikett}</p>
        <h1 class="dk-titel">{kort.titel}</h1>
        <dl class="dk-fakta">
          {fakta.map(([rubrik, text]) => <div><dt>{rubrik}</dt><dd>{text}</dd></div>)}
        </dl>
        <div class="dk-larande">
          <p class="dk-larande-namn">{OMRADEN[0].namn}</p>
          <p class="dk-larande-rad">
            {l.slag === 'niva' && <Staplar niva={l.niva} />}
            <span class={`dk-larande-ord${l.slag === 'niva' && l.negativ ? ' mp-negativ' : ''}`}>{l.ord}</span>
          </p>
          {um.kommentar && <p class="dk-kommentar">{um.kommentar}</p>}
        </div>
        <div class="dk-fot">
          <img src={site.portratt} alt="" />
          <div>
            <div class="dk-namn">{site.namn}</div>
            <div class="dk-adress">niclasfohlin.se{kort.sida}</div>
          </div>
        </div>
      </div>
      <div class="utsnitt"><div class="skala-in"><Metodprofil m={m} /></div></div>
    </div>
  </body>
</html>
