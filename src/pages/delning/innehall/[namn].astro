---
// Mallen för delningskortet till verktyget Innehåll (K-793), 1200 × 630, i verktygskortens form (Niclas 2026-11-02: "Alla
// verktyg ska alltid ha ett mer spännande delningskort än standard"): titeln och frågan till vänster, och till höger
// verktygets bild, boken som spegel och fönster, ovanför de fem frågorna ur rutan Börja här. Färgerna är verktygets bruna
// och kräm, skrivna här så att kortets kontrollsumma (src/lib/delningskort.ts) följer dem. Sidan finns bara för att
// scripts/delningskort.mjs ska fotografera den; den länkas inte och indexeras inte.
import '../../../styles/global.css';
import { site } from '../../../data/site';
import { allaKort, type Kort } from '../../../lib/delningskort';

export async function getStaticPaths() {
  return (await allaKort()).filter((kort) => kort.innehall).map((kort) => ({ params: { namn: kort.namn }, props: { kort } }));
}

const { kort } = Astro.props as { kort: Kort };
const innehall = kort.innehall!;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{kort.titel}</title>
    <style>
      html, body { margin: 0; padding: 0; background: #fff; }
      .dk { display: flex; width: 1200px; height: 630px; overflow: hidden; background: #fff; color: var(--farg-text); font-family: var(--typsnitt-ui); }
      .dk-streck { flex: none; width: 18px; background: #8a5a1e; }
      .dk-text { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 56px 36px 56px 60px; }
      .dk-etikett { margin: 0 0 22px; font-size: 24px; line-height: 1.25; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: #8a5a1e; }
      .dk-titel { margin: 0; font-family: var(--typsnitt-antikva); font-size: 104px; line-height: 1; font-weight: 700; letter-spacing: -0.03em; color: var(--farg-text); }
      .dk-under { margin: 18px 0 0; font-family: var(--typsnitt-antikva); font-size: 44px; line-height: 1.2; font-style: italic; color: #5c3a10; }
      .dk-innehall { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-bottom: 12px; }
      .dk-fot { flex: none; display: flex; align-items: center; gap: 18px; }
      .dk-fot img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--farg-kant); }
      .dk-namn { font-size: 27px; line-height: 1.2; font-weight: 700; }
      .dk-adress { font-size: 23px; line-height: 1.3; color: var(--farg-text-svag); }
      .dk-hoger { flex: none; width: 620px; box-sizing: border-box; padding: 34px 40px 30px; background: #fbf3e4; border-left: 1px solid #e7d3b1; display: flex; flex-direction: column; justify-content: center; }
      .dk-bild { display: block; width: 470px; max-width: 100%; height: auto; margin: 0 auto; }
      .dk-fragor { margin: 10px 0 0; padding: 0; list-style: none; }
      .dk-fragor li { display: flex; align-items: baseline; gap: 14px; padding: 7px 0; border-top: 1.5px solid #e7d3b1; font-family: var(--typsnitt-antikva); font-size: 27px; line-height: 1.15; font-weight: 700; color: var(--farg-text); }
      .dk-fragor li:last-child { border-bottom: 1.5px solid #e7d3b1; }
      .dk-nr { flex: none; width: 24px; color: #8a5a1e; }
    </style>
  </head>
  <body>
    <div class="dk">
      <div class="dk-streck"></div>
      <div class="dk-text">
        <div class="dk-innehall">
          {kort.etikett && <p class="dk-etikett">{kort.etikett}</p>}
          <h1 class="dk-titel">{kort.titel}</h1>
          {kort.undertitel && <p class="dk-under">{kort.undertitel}</p>}
        </div>
        <div class="dk-fot">
          <img src={site.portratt} alt="" />
          <div>
            <div class="dk-namn">{site.namn}</div>
            <div class="dk-adress">niclasfohlin.se</div>
          </div>
        </div>
      </div>
      <div class="dk-hoger">
        <img class="dk-bild" src={`/innehall/${innehall.bild}`} alt="" width="900" height="560" />
        <ol class="dk-fragor">
          {innehall.fragor.map((f) => <li><span class="dk-nr">{f.nr}</span><span>{f.fraga}</span></li>)}
        </ol>
      </div>
    </div>
  </body>
</html>
