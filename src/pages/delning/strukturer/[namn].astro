---
// Mallen för delningskortet till verktyget Strukturer, 1200 × 630 (Niclas 2026-11-02: "Fixa delningskortet för strukturer
// så det blir lite mer spännande. Alla verktyg ska alltid ha ett mer spännande delningskort än standard"). Den har
// verktygskortens form, som Ta fram-korten (src/pages/delning/tafram/[namn].astro): titeln till vänster, och till höger tre
// strukturer, en ur varje slag, i en solfjäder och i kortets form på /strukturer (Strukturkortet.astro), med bilden som
// bildmotorn ritar ur scenen, namnet, syftet och slagets färg. Strukturerna står i src/lib/delningskort.ts
// (STRUKTURERNAS_KORT). Sidan finns bara för att scripts/delningskort.mjs ska fotografera den; den länkas inte och
// indexeras inte.
import '../../../styles/global.css';
import { site } from '../../../data/site';
import { allaKort, type Kort } from '../../../lib/delningskort';
import { bildensAdress, slagensStil } from '../../../lib/strukturer';

export async function getStaticPaths() {
  return (await allaKort()).filter((kort) => kort.strukturer).map((kort) => ({ params: { namn: kort.namn }, props: { kort } }));
}

const { kort } = Astro.props as { kort: Kort };
const n = kort.titel.length;
const storlek = n <= 18 ? 76 : n <= 36 ? 62 : 52;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{kort.titel}</title>
    <style>
      html, body { margin: 0; padding: 0; background: #fff; }
      .dk { display: flex; width: 1200px; height: 630px; overflow: hidden; background: var(--farg-yta); color: var(--farg-text); font-family: var(--typsnitt-rubrik); }
      .dk-streck { flex: none; width: 18px; background: var(--dk-farg); }
      .dk-text { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 56px 40px 56px 64px; }
      .dk-etikett { margin: 0 0 26px; max-width: none; font-size: 24px; line-height: 1.25; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--dk-farg); }
      .dk-titel { margin: 0; max-width: none; font-size: var(--dk-storlek); line-height: 1.06; font-weight: 800; letter-spacing: -0.015em; color: var(--farg-text); text-wrap: balance; }
      .dk-under { margin: 22px 0 0; max-width: none; font-size: 32px; line-height: 1.3; font-weight: 500; color: var(--farg-text-svag); text-wrap: pretty; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .dk-innehall { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-bottom: 16px; }
      .dk-fot { flex: none; display: flex; align-items: center; gap: 18px; }
      .dk-fot img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--farg-kant); }
      .dk-namn { font-size: 27px; line-height: 1.2; font-weight: 700; }
      .dk-adress { font-size: 23px; line-height: 1.3; color: var(--farg-text-svag); }
      .dk-korten { position: relative; flex: none; width: 640px; overflow: hidden; background: var(--farg-ton); }
      /* En struktur som på /strukturer: bilden överst, namnet och syftet under, ramen i slagets färg. */
      .dk-st { position: absolute; top: 196px; width: 250px; box-sizing: border-box; border: 2.5px solid color-mix(in srgb, var(--slag) 55%, white); border-radius: 14px; background: #fff; overflow: hidden; box-shadow: 0 14px 34px rgba(20, 32, 43, 0.24); font-family: var(--typsnitt-ui); }
      /* Mittenkortet står högre, så att sidokortens namn syns under det. */
      .dk-st:nth-child(1) { left: 14px; transform: rotate(-6deg); }
      .dk-st:nth-child(2) { left: 195px; top: 46px; z-index: 2; }
      .dk-st:nth-child(3) { left: 376px; transform: rotate(6deg); }
      .dk-st img { display: block; width: 100%; height: auto; aspect-ratio: 900 / 560; background: #fff; }
      .dk-st-text { display: block; padding: 12px 16px 16px; border-top: 1.5px solid color-mix(in srgb, var(--slag) 30%, white); background: color-mix(in srgb, var(--slag-ljus) 55%, white); }
      .dk-st-slag { display: block; margin: 0 0 4px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--slag) 85%, black); }
      .dk-st-namn { display: block; font-size: 23px; line-height: 1.15; font-weight: 800; color: var(--farg-text); }
      .dk-st-rad { display: -webkit-box; margin-top: 6px; font-size: 15px; line-height: 1.35; color: var(--farg-text-svag); -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    </style>
  </head>
  <body>
    <div class="dk" style={`--dk-farg: var(${kort.farg}); --dk-storlek: ${storlek}px`}>
      <div class="dk-streck"></div>
      <div class="dk-text">
        <div class="dk-innehall">
          {kort.etikett && <p class="dk-etikett">{kort.etikett}</p>}
          <h1 class="dk-titel">{kort.titel}</h1>
          {kort.undertitel && <p class="dk-under">{kort.undertitel}</p>}
        </div>
        <div class="dk-fot">
          <img src={site.portratt} alt="" />
          <div>
            <div class="dk-namn">{site.namn}</div>
            <div class="dk-adress">niclasfohlin.se</div>
          </div>
        </div>
      </div>
      <div class="dk-korten">
        {kort.strukturer!.map((s) => (
          <div class="dk-st" style={slagensStil(s.slag)}>
            <img src={bildensAdress(s.id)} alt="" width="900" height="560" />
            <span class="dk-st-text">
              <span class="dk-st-slag">{s.slagNamn}</span>
              <span class="dk-st-namn">{s.namn}</span>
              <span class="dk-st-rad">{s.syfte}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
    <script>
      // scripts/delningskort.mjs väntar på dkKlar, så att typsnitten och bilderna är inne innan kortet fotograferas.
      (window as Window & { dkKlar?: Promise<unknown> }).dkKlar = document.fonts.ready
        .then(() => Promise.all([...document.images].map((i) => (i.complete ? 1 : new Promise((r) => { i.onload = i.onerror = r; })))));
    </script>
  </body>
</html>
