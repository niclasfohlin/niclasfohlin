---
// Mallen för delningskortet för Metoder, /metoder, 1200 × 630 (Niclas 2026-10-31: "Bygg gärna ert eget snyggt delningskort
// för metoder som du förut byggde för stödundervisning. Något lite mer intressant än standard"). Den har metodbankens anda
// (src/pages/delning/metodbank/[namn].astro): titeln och raden till vänster, och till höger bankens metodkort i en trappa,
// ritade med bankens eget kort (src/components/Metodprofil.astro med bank och forsmak), så att bilden visar korten som de
// ser ut i banken. Korten visar titeln, faktan och Lärande totalt med staplarna, ordet och kommentaren; ingressen står inte
// på kortet, så att Lärande totalt syns också på det främsta kortet. Trappan har de publicerade metoderna i bankens ordning,
// högst tre, och formen håller för en, två och tre (TRAPPAN). Vad som står på kortet räknas ut i src/lib/delningskort.ts
// (METODERMALL), och mallen räknas bara in i det kortet. Sidan finns bara för att scripts/delningskort.mjs ska fotografera
// den; den länkas inte och indexeras inte.
import '../../../styles/global.css';
import { site } from '../../../data/site';
import { allaKort, type Kort } from '../../../lib/delningskort';
import { publicerade } from '../../../lib/innehall';
import { kortetUrFil } from '../../../lib/metodprofil';
import Metodprofil from '../../../components/Metodprofil.astro';

export async function getStaticPaths() {
  return (await allaKort()).filter((kort) => kort.metoder).map((kort) => ({ params: { namn: kort.namn }, props: { kort } }));
}

const { kort } = Astro.props as { kort: Kort };
const poster = await publicerade('undervisningsmetoder');
const korten = kort.metoder!.map((m) => {
  const post = poster.find((p) => p.id === m.id);
  if (!post) throw new Error(`Delningskortet för Metoder: ${m.id} är inte publicerad.`);
  return kortetUrFil(post.id, post.data);
});
// Trappan efter antalet kort: det första högst upp till vänster och det sista främst, längst ned till höger, så att varje
// titel syns och det främsta visar faktan och Lärande totalt; med tre kort klipps det främstas kommentar av kortets
// nederkant, som det främsta kortet på metodbankens kort. Ett ensamt kort står mitt i spalten.
const TRAPPAN: Record<number, { x: number; y: number; vrid: number }[]> = {
  1: [{ x: 650, y: 132, vrid: -1.2 }],
  2: [{ x: 600, y: 54, vrid: -2 }, { x: 694, y: 296, vrid: 1.2 }],
  3: [{ x: 582, y: 36, vrid: -2.2 }, { x: 640, y: 186, vrid: -0.4 }, { x: 698, y: 336, vrid: 1.4 }],
};
const platser = TRAPPAN[korten.length];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{kort.titel}</title>
    <style is:global>
      html, body { margin: 0; padding: 0; background: #fff; }
      .dk { position: relative; width: 1200px; height: 630px; overflow: hidden; background: var(--farg-yta); color: var(--farg-text); font-family: var(--typsnitt-rubrik); }
      .dk-streck { position: absolute; left: 0; top: 0; bottom: 0; width: 18px; background: var(--farg-mork); }
      /* Textens spalt går från 107 till 577 punkter, och korten tar resten. */
      .dk-text { position: absolute; left: 107px; top: 0; bottom: 0; width: 470px; display: flex; flex-direction: column; padding: 58px 0 52px; }
      .dk-etikett { margin: 0 0 30px; font-size: 22px; line-height: 1.25; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--farg-mork); }
      .dk-titel { margin: 0; font-size: 104px; font-weight: 800; letter-spacing: -0.03em; line-height: 0.98; color: var(--farg-mork); }
      .dk-under { margin: 22px 0 0; font-size: 36px; font-weight: 500; line-height: 1.22; color: var(--farg-text-svag); text-wrap: balance; }
      .dk-fot { margin-top: auto; display: flex; align-items: center; gap: 18px; }
      .dk-fot img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--farg-kant); }
      .dk-namn { font-size: 25px; line-height: 1.2; font-weight: 700; }
      .dk-adress { font-size: 21px; line-height: 1.3; color: var(--farg-text-svag); }

      /* Bankens kort i en trappa, i bankens bredd och lite större, så att faktan och staplarna går att läsa i ett flöde. */
      .bild { position: absolute; width: 494px; transform-origin: top left; }
      .bild > .skala-in { width: 380px; transform: scale(1.3); transform-origin: top left; }
      .bild .metodkort { margin: 0; border-radius: 12px; box-shadow: 0 14px 34px rgba(20, 32, 43, 0.22), 0 0 0 1px var(--farg-kant); }
      .bild .metodkort .ingress { display: none; }
      /* Titeln är en länk i banken, men på en bild går den inte att trycka på. */
      .bild .metodkort .kort-topp h3 a { text-decoration: none; }
      .bild .metodkort .mp-bank-total { border-bottom: 0; }
    </style>
  </head>
  <body>
    <div class="dk">
      <div class="dk-streck"></div>
      <div class="dk-text">
        <p class="dk-etikett">{kort.etikett}</p>
        <h1 class="dk-titel">{kort.titel}</h1>
        <p class="dk-under">{kort.undertitel}</p>
        <div class="dk-fot">
          <img src={site.portratt} alt="" />
          <div>
            <div class="dk-namn">{site.namn}</div>
            <div class="dk-adress">niclasfohlin.se{kort.sida}</div>
          </div>
        </div>
      </div>
      {korten.map((m, i) => (
        <div class="bild" style={`left: ${platser[i].x}px; top: ${platser[i].y}px; transform: rotate(${platser[i].vrid}deg)`}>
          <div class="skala-in"><Metodprofil m={m} bank forsmak /></div>
        </div>
      ))}
    </div>
  </body>
</html>
