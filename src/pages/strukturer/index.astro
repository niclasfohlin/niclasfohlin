---
// /strukturer: verktyget Strukturer (K-650, underlag/prov/strukturer/UPPDRAGET.md), som Niclas beställde 2026-10-31: "I den
// ska man kunna sortera alla strukturer i Klass, Grupp och Par strukturer ... Man ska kunna välja strukturer och skriva ut
// strukturkort (bild på framsida med titel, stegen på baksidan med titel) ... Man ska kunna välja enskilda strukturer, de
// man väljer ut som plockas ihop och alla."
//
//   Topplistan  De sex strukturer som visats och skrivits ut mest de senaste 30 dagarna, när minst sex har besök (Niclas:
//               "en topplista över de 5 mest tittade på och nedladdade strukturerna i verktyget", och 2026-11-01 "Vi kör
//               sex", så att korten fyller hela rader i telefonen och på datorn; TOPPLISTANS_ANTAL i standarden). Bygget skriver
//               listan som den var (src/data/strukturer-topp.json), och sidan visar den.
//   Raderna     Par, Grupp och Klass som rader i slagets färg som fälls ut, med korten i två spalter i telefonen och tre på
//               en bred skärm (formen som valdes i fas 0, underlag/prov/strukturer/granskning/ide-*.md).
//   Bocken      Varje kort har en bock som lägger strukturen i listan Att skriva ut (Kortlistan.astro), som på Ta fram
//               en aktivitet.
//   Alla        Filen med alla kort, två på varje A4, i radernas ordning (scripts/strukturer/kort.mjs).
import Base from '../../layouts/Base.astro';
import Kortlistan from '../../components/Kortlistan.astro';
import Kortet from '../../components/Strukturkortet.astro';
import { strukturerna, strukturernasMetod, ALLA_KORTENS_ADRESS, allaKortensStorlek, topplistanIBygget, slagensStil, SLAGEN, TVA_PA_A4 } from '../../lib/strukturer';
import { symbol } from '../../../scripts/strukturer/symboler.mjs';
import { TOPPLISTANS_ANTAL } from '../../lib/standard/index.js';

const alla = await strukturerna();
const medId = new Map(alla.map((s) => [s.id, s]));
const topp = topplistanIBygget(new Set(medId.keys())).map((id) => medId.get(id)!);
const metoden = await strukturernasMetod();
const rader = SLAGEN.map((s) => ({ ...s, strukturer: alla.filter((x) => x.data.slag === s.slag) }));
const PIL = '<svg class="st-hylla-pil" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
const titel = 'Strukturer';
const beskrivning = `${alla.length} strukturer för samarbete i par, i grupp och i hela klassen, med stegen, förslag på användning och strukturkort att skriva ut, två på varje A4.`;
---

<Base title={titel} description={beskrivning} tryckText="© Niclas Fohlin · niclasfohlin.se/strukturer">
  <div class="st-yta">
    <article class="st-sida">
      <header>
        <p class="meta brodsmula"><a href="/metoder">Metoder</a>{metoden && <> · <a href={`/metoder/${metoden.id}`}>{metoden.data.titel}</a></>} · Strukturer</p>
        <h1>{titel}</h1>
        <p class="ingress">Kort för samarbete i par, i grupp och i hela klassen. Tryck på en struktur för stegen och förslag på användning, och på bocken för att lägga kortet i listan att skriva ut.</p>
        {/* Syftet först (Niclas 2026-11-01: "någon text i hela att viktigast inte att pressa på med strukturer. Utan att
            undervisningen syfte är det viktiga. Strukturer kan däremot hjälpa läraren effektivisera samarbete och hjälpa eleverna
            ha fokus på lärandet än hur de ska samarbeta. Särskilt när de känner igen strukturen från förut"). */}
        <p class="st-syftet">En struktur är ett hjälpmedel, och lektionens syfte är det viktiga. Ta en struktur när den hjälper eleverna att lära sig det lektionen handlar om. Den gör samarbetet snabbare att komma igång med och låter eleverna lägga kraften på lärandet, särskilt när de känner igen strukturen från förut.</p>
        <div class="st-utskrift">
          <a class="knapp sekundar" href={ALLA_KORTENS_ADRESS} target="_blank" rel="noopener" data-goatcounter-click="utskrift:strukturer/alla" data-goatcounter-title="Strukturer: alla kort">Skriv ut alla {alla.length} kort (pdf, {allaKortensStorlek()})</a>
        </div>
        <p class="st-utskriftsrad">{TVA_PA_A4}</p>
      </header>

      {/* Topplistan: bygget skriver den som den var (topp), och sidan hämtar dagens lista från funktionen
          netlify/functions/strukturer-topp.mjs, som svarar 503 utan nyckel och då står listan från bygget kvar (K-665). */}
      <section id="st-topp" aria-labelledby="st-topp-rubrik" hidden={topp.length !== TOPPLISTANS_ANTAL}>
        <h2 class="st-rubrik2" id="st-topp-rubrik">Mest använda den senaste månaden</h2>
        <ol class="st-kort-lista st-topp">
          {topp.map((s, i) => <Kortet s={s} nr={i + 1} />)}
        </ol>
      </section>

      <h2 class="st-rubrik2">Alla strukturer</h2>
      {rader.map((r, i) => (
        <details class="st-hylla" data-slag={r.slag} style={slagensStil(r.slag)} open={i === 0}>
          <summary><Fragment set:html={symbol(r.slag)} /><span class="st-hylla-namn">{r.namn}</span><span class="st-hylla-antal">{r.strukturer.length} strukturer</span><Fragment set:html={PIL} /></summary>
          <div class="st-hylla-inne">
            <p class="st-hylla-text">{r.text}</p>
            <ol class="st-kort-lista">
              {r.strukturer.map((s) => <Kortet s={s} />)}
            </ol>
          </div>
        </details>
      ))}


      <p class="upphov">Strukturerna kommer ur Niclas Fohlins bank för kooperativt lärande. Bilderna och korten © Niclas Fohlin.</p>
    </article>
    <Kortlistan verktyg="strukturer" />
  </div>
</Base>

<script>
  // Dagens topplista ur funktionen (K-665): korten tas ur raderna, så att bilden, namnet och bocken är desamma, och de sex
  // får sin plats. Svarar funktionen inte, eller har färre än sex strukturer besök, står listan från bygget kvar.
  import { TOPPLISTANS_ANTAL } from '../../lib/standard/index.js';
  const sektion = document.getElementById('st-topp');
  fetch('/api/strukturer-topp').then((r) => (r.ok ? r.json() : null)).then((d: { strukturer?: { id: string; antal: number }[] } | null) => {
    if (!sektion || !d?.strukturer) return;
    const kort = new Map([...document.querySelectorAll<HTMLElement>('.st-hylla [data-valj]')].map((b) => [b.dataset.valj!, b.closest('li')!]));
    const ids = d.strukturer.filter((x) => x.antal > 0 && kort.has(x.id)).map((x) => x.id).slice(0, TOPPLISTANS_ANTAL);
    if (ids.length < TOPPLISTANS_ANTAL) return;
    sektion.querySelector('ol')!.replaceChildren(...ids.map((id, i) => {
      const li = kort.get(id)!.cloneNode(true) as HTMLElement;
      const nr = document.createElement('span');
      nr.className = 'st-nr';
      nr.textContent = String(i + 1);
      nr.setAttribute('aria-label', `Plats ${i + 1}`);
      li.querySelector('.st-kort')!.append(nr);
      li.querySelector('img')?.setAttribute('loading', 'eager');
      return li;
    }));
    sektion.hidden = false;
    document.dispatchEvent(new CustomEvent('strukturer:ritad'));
  }).catch(() => { /* listan från bygget står kvar */ });
</script>
