# Kopiera till .env för lokal utveckling. .env ignoreras av git.
# I produktion sätts värdena i Netlify (netlify env:set NAMN värde) och hämtas
# automatiskt av "netlify dev". Claude Code läser aldrig .env.

# Brevo (prenumeration). Skapas i Brevo under SMTP & API > API keys.
BREVO_API_KEY=
# Numeriskt id på listan som prenumeranter läggs i (Brevo > Contacts > Lists).
BREVO_LIST_ID=
# Numeriskt id på mallen för dubbel opt-in (Brevo > Campaigns > Templates).
BREVO_DOI_TEMPLATE_ID=

# Publik adress till sajten. Används för bekräftelselänkar.
SITE_URL=https://niclasfohlin.se
